# 이 파일을 .env.local 로 복사하고 값을 채운다. 로컬 스크립트가 쓰는 값은 아래 둘뿐이다.
# 값은 원래 쓰던 맥의 .env.local 에서 옮긴다(git·채팅에 붙이지 않는다).

# KOPIS 공연 수집(npm run kopis:*). https://www.kopis.or.kr OpenAPI 메뉴 또는 data.go.kr 에서 발급.
KOPIS_SERVICE_KEY=

# 클릭·알림 구독·공연 요청 리포트(npm run clicks:report, push:report, requests:report).
# Vercel 프로젝트(concert-festival-carendar) 환경변수의 같은 이름 값과 같아야 한다.
CLICK_REPORT_TOKEN=

# 나머지(KV_*, UPSTASH_*, REDIS_URL, VAPID_*, QSTASH_*, PUSH_*)는 Vercel 서버에서만 쓴다.
# 로컬에서 서버 함수까지 돌려야 하면 `vercel env pull .env.local` 로 받는다.
