---
// 랜딩 최상단: 서비스가 무엇인지 한 문장으로 말하는 제목 + 부제 + 핵심 행동 두 개.
// 수치는 빌드 시점의 실제 데이터에서 계산한다(지어낸 숫자 금지).
import Mascot from './Mascot.astro';
import { upcomingEvents, upcomingTicketOpens } from '../lib/events';

const upcoming = upcomingEvents();
const opening = upcomingTicketOpens(50).length;
---
<section class="intro" aria-labelledby="home-title">
  <div class="intro-text">
    <h1 id="home-title">내한공연, 예매부터 직관까지</h1>
    <p class="lead">예매처·시야·셔틀·MD를 공연마다 한 페이지에.</p>
    <div class="intro-cta">
      <a class="btn primary" href="/events/">전체 공연 {upcoming.length}개</a>
      <a class="btn" href="/ticket-open/">티켓오픈 일정{opening > 0 ? ` ${opening}` : ''}</a>
    </div>
  </div>
  <div class="intro-cat" aria-hidden="true">
    <Mascot size={120} pose="wave" />
  </div>
</section>
<style>
  .intro { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin: 0.25rem 0 1.5rem; }
  .intro-text { min-width: 0; }
  .intro h1 { margin: 0 0 0.75rem; font-size: clamp(1.6rem, 4.6vw, 2.1rem); line-height: 1.25; letter-spacing: -0.02em; }
  .lead { margin: 0 0 1rem; color: #a9a9b0; }
  .intro-cta { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .btn { display: inline-block; padding: 0.65rem 1.15rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.22); color: var(--fg); text-decoration: none; font-weight: 700; font-size: 0.92rem; }
  .btn:hover { border-color: #fff; }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #0e0e10; }
  .btn.primary:hover { background: #ff7bb2; border-color: #ff7bb2; }
  .intro-cat { flex-shrink: 0; }
  @media (max-width: 640px) {
    .intro { flex-direction: column-reverse; align-items: flex-start; gap: 0.5rem; }
    .intro-cat :global(svg) { width: 72px; height: auto; }
  }
</style>
