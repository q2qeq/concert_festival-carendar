---
import { spotlightEvents, hasTicketsOnSale, isBuzzing, TICKETING_DIFFICULTY_LABEL as DIFFICULTY_LABEL } from '../lib/events';
import Mascot from './Mascot.astro';

const picks = spotlightEvents(6);

// 랜딩 화면에서 처음 들어온 사람이 "이 사이트가 뭘 해주는지" 바로 알 수 있도록,
// 직관냥이 말하는 말풍선 안에서 기능을 소개한다 (기존에 말풍선 아래 따로 있던
// FeatureHighlights 박스 그리드를 대체 - 상세 페이지에서 실제로 렌더링되는
// 기능만 나열한다. 과장하거나 아직 데이터가 안 채워진 기능은 넣지 않는다).
const features = [
  { tag: '예매', text: '여러 판매처를 한 곳에' },
  { tag: '시야', text: '구역별 실제 시야 검색' },
  { tag: '셔틀', text: '3사 셔틀 정보 항상 확인' },
  { tag: '공연장', text: '오시는 길·주차·맛집' },
  { tag: '캘린더', text: '버튼 하나로 일정 등록' },
  { tag: '셋리스트', text: '지난 투어 셋리스트 미리보기' },
  { tag: '떼창·콜', text: '가이드 영상 바로 검색' },
  { tag: '업데이트', text: '취소·연기·변경 타임라인' },
];

function fmt(iso: string) {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getMonth() + 1}.${d.getDate()}`;
}
---
<section class="hero-intro-section">
  <div class="hero-intro">
    <Mascot size={104} />
    <div class="hero-bubble">
      <p class="hero-bubble-kicker">직관냥이 알려주는 이 사이트 사용법</p>
      <p class="hero-bubble-text">공연 하나만 눌러도 예매·시야·셔틀·캘린더·셋리스트·떼창가이드까지 다 나온다냥. 뭐가 있는지 한눈에 보자면 —</p>
      <div class="hero-feature-chips">
        {features.map((f) => (
          <span class="hero-feature-chip">
            <strong>{f.tag}</strong>
            <span>{f.text}</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

{picks.length > 0 && (
  <section class="hero" id="picks">
    <div class="hero-rail-head">
      <h2>🔥 티켓오픈 임박 · 화제 공연</h2>
      <p>놓치면 피눈물! 직관냥이 오늘 물어온 소식부터 모아봤다냥.</p>
    </div>
    <div class="hero-rail">
      {picks.map((e, i) => {
        const onSale = hasTicketsOnSale(e);
        const buzzing = isBuzzing(e);
        return (
          <a class={`hero-card${buzzing ? ' is-buzzing' : ''}`} href={`/events/${e.id}/`}>
            {buzzing && <span class="hero-buzz-ribbon">🔥 화제</span>}
            <div class="hero-card-poster-wrap">
              <div class="hero-card-glow" style={`background-image:url(${e.posterUrl})`}></div>
              <img
                class="hero-card-poster"
                src={e.posterUrl}
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              <div
                class="dday-badge hero-dday"
                data-dday-start={e.startDate}
                data-dday-end={e.endDate}
                data-status={e.status ?? 'scheduled'}
              >
                —
              </div>
            </div>
            <div class="hero-card-seam"></div>
            <div class="hero-card-body">
              <div class="hero-card-tags">
                {e.ticketingDifficulty && (
                  <span class={`difficulty-tag difficulty-${e.ticketingDifficulty}`}>
                    {DIFFICULTY_LABEL[e.ticketingDifficulty]}
                  </span>
                )}
                {onSale && <span class="hero-onsale-tag">예매 가능</span>}
              </div>
              <h3>{e.artist}</h3>
              <p class="hero-card-meta">{fmt(e.startDate)} · {e.venue}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
<style>
  .hero-intro-section { margin: 0 0 1.75rem; }
  .hero-intro {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .hero-bubble {
    position: relative;
    flex: 1;
    min-width: 0;
    background: linear-gradient(155deg, rgba(255,255,255,0.05), rgba(255, 95, 162, 0.05));
    border: 1px solid rgba(255, 95, 162, 0.25);
    border-radius: 18px 18px 18px 4px;
    padding: 0.9rem 1.1rem 1rem;
  }
  .hero-bubble-kicker {
    margin: 0 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: #ff8fbe;
    letter-spacing: -0.01em;
  }
  .hero-bubble-text { margin: 0 0 0.75rem; font-size: 0.96rem; color: var(--fg); line-height: 1.55; }
  .hero-feature-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .hero-feature-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: #d8d5ef;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .hero-feature-chip strong { color: #6ee7ff; font-weight: 800; }
  @media (max-width: 560px) {
    .hero-intro { align-items: flex-start; }
    .hero-bubble { border-radius: 16px; }
    .hero-feature-chips { gap: 0.35rem; }
    .hero-feature-chip { font-size: 0.72rem; padding: 0.26rem 0.55rem; }
  }

  .hero { margin: 0 0 2.25rem; scroll-margin-top: 5rem; }
  .hero-rail-head { margin-bottom: 0.9rem; }
  .hero-rail-head h2 { margin: 0 0 0.2rem; font-size: 1.1rem; letter-spacing: -0.01em; }
  .hero-rail-head p { margin: 0; color: var(--muted); font-size: 0.88rem; }
  .hero-rail {
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    padding: 0.15rem 0.15rem 0.75rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .hero-card {
    scroll-snap-align: start;
    flex: 0 0 190px;
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 16px;
    overflow: hidden;
    background: var(--card);
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    transition: transform 0.18s, box-shadow 0.18s;
  }
  .hero-card:hover { transform: translateY(-4px); box-shadow: 0 14px 32px rgba(0,0,0,0.45); }
  .hero-card.is-buzzing {
    box-shadow: 0 8px 24px rgba(0,0,0,0.35), 0 0 0 1.5px rgba(255, 95, 162, 0.55);
  }
  .hero-card.is-buzzing:hover {
    box-shadow: 0 14px 32px rgba(0,0,0,0.45), 0 0 0 1.5px rgba(255, 95, 162, 0.75);
  }
  .hero-buzz-ribbon {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    font-size: 0.68rem;
    font-weight: 800;
    color: #101018;
    background: linear-gradient(120deg, #ffd166, #ff5fa2);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    box-shadow: 0 4px 12px rgba(255, 95, 162, 0.4);
  }
  .hero-card-poster-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #05050a;
  }
  .hero-card-glow {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(20px) saturate(1.5) brightness(0.7);
    transform: scale(1.25);
  }
  .hero-card-poster {
    position: relative;
    z-index: 1;
    display: block;
    width: 70%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    margin: 9% auto 0;
    border-radius: 8px;
    box-shadow: 0 10px 26px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.08);
  }
  .hero-dday {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 2;
    background: rgba(16, 16, 24, 0.75);
    backdrop-filter: blur(2px);
  }
  .hero-card-seam {
    position: relative;
    height: 0;
    border-top: 1px dashed rgba(255,255,255,0.18);
  }
  .hero-card-seam::before,
  .hero-card-seam::after {
    content: '';
    position: absolute;
    top: -8px;
    width: 16px;
    height: 16px;
    background: var(--bg);
    border-radius: 50%;
  }
  .hero-card-seam::before { left: -8px; }
  .hero-card-seam::after { right: -8px; }
  .hero-card-body {
    position: relative;
    z-index: 1;
    padding: 0.7rem 0.75rem 0.85rem;
  }
  .hero-card-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }
  .difficulty-tag {
    font-size: 0.68rem;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .difficulty-hard { color: #ff8a8a; border: 1px solid rgba(255,138,138,0.4); background: rgba(255,138,138,0.1); }
  .difficulty-normal { color: #7ed957; border: 1px solid rgba(126,217,87,0.4); background: rgba(126,217,87,0.1); }
  .difficulty-easy { color: #ffd166; border: 1px solid rgba(255,209,102,0.4); background: rgba(255,209,102,0.1); }
  .hero-onsale-tag {
    font-size: 0.68rem;
    color: #6ee7ff;
    border: 1px solid rgba(110,231,255,0.4);
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .hero-card h3 {
    margin: 0 0 0.15rem;
    font-size: 0.92rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hero-card-meta {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 520px) {
    .hero-card { flex-basis: 168px; }
  }
</style>
