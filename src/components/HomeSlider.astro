---
// 랜딩 "지금 많이 보는 공연" 슬라이더 - 3개만. 자동 재생 없이 좌우 버튼/스와이프/점으로 넘긴다.
// 선정 기준은 lib/events.ts spotlightEvents(demand·티켓오픈 임박·최근 업데이트·예매 오픈).
import { spotlightEvents, hasTicketsOnSale, isBuzzing, ticketOpenInDays } from '../lib/events';

import sharp from 'sharp';
import path from 'node:path';

const picks = spotlightEvents(3, undefined, true);
// 포스터 방향을 빌드 때 읽어서, 가로형이면 세로 여백 없이 원본 비율로 보여준다.
const landscape = new Set<string>();
for (const e of picks) {
  try {
    const m = await sharp(path.join(process.cwd(), 'public', e.posterUrl as string)).metadata();
    if ((m.width ?? 0) > (m.height ?? 0)) landscape.add(e.id);
  } catch {}
}
function fmt(iso: string) {
  const d = new Date(iso + 'T00:00:00');
  const w = ['일', '월', '화', '수', '목', '금', '토'][d.getDay()];
  return `${d.getMonth() + 1}월 ${d.getDate()}일 (${w})`;
}
---
{picks.length > 0 && (
  <section class="slider" aria-roledescription="carousel" aria-label="지금 많이 보는 공연">
    <div class="slider-head">
      <h2>지금 많이 보는 공연</h2>
      {picks.length > 1 && (
        <div class="slider-ctrl">
          <button type="button" id="sl-prev" aria-label="이전 공연">←</button>
          <button type="button" id="sl-next" aria-label="다음 공연">→</button>
        </div>
      )}
    </div>
    <div class="slides" id="slides" tabindex="0">
      {picks.map((e, i) => {
        const openIn = ticketOpenInDays(e);
        return (
          <article class={`slide${landscape.has(e.id) ? ' is-landscape' : ''}`} aria-roledescription="slide" aria-label={`${i + 1} / ${picks.length}`}>
            <a class="slide-poster" href={`/events/${e.id}/`} tabindex="-1" aria-hidden="true">
              <img src={e.posterUrl} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
            </a>
            <div class="slide-body">
              <div class="slide-tags">
                <span class="dday-badge" data-dday-start={e.startDate} data-dday-end={e.endDate} data-status={e.status ?? 'scheduled'}>—</span>
                {isBuzzing(e) && <span class="tag hot">화제</span>}
                {openIn !== null && openIn <= 14 && <span class="tag">{openIn === 0 ? '오늘 티켓오픈' : `티켓오픈 D-${openIn}`}</span>}
                {hasTicketsOnSale(e) && <span class="tag">예매 오픈중</span>}
              </div>
              <h3><a href={`/events/${e.id}/`}>{e.artist}</a></h3>
              <p class="slide-meta">{fmt(e.startDate)} · {e.venue}</p>
              <a class="slide-cta" href={`/events/${e.id}/`}>공연 정보 보기 →</a>
            </div>
          </article>
        );
      })}
    </div>
    {picks.length > 1 && (
      <div class="dots" id="sl-dots" role="tablist" aria-label="슬라이드 선택">
        {picks.map((_, i) => <button type="button" role="tab" aria-label={`${i + 1}번째 공연`} aria-selected={i === 0 ? 'true' : 'false'} data-i={i}></button>)}
      </div>
    )}
  </section>
)}
<script>
  const track = document.getElementById('slides');
  const dots = document.querySelectorAll<HTMLButtonElement>('#sl-dots button');
  if (track) {
    const slides = Array.from(track.children) as HTMLElement[];
    const go = (i: number) => {
      const n = Math.max(0, Math.min(slides.length - 1, i));
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: slides[n].offsetLeft - track.offsetLeft, behavior: calm ? 'auto' : 'smooth' });
    };
    const current = () => {
      const x = track.scrollLeft + track.clientWidth / 2;
      return Math.max(0, slides.findIndex((s) => x >= s.offsetLeft - track.offsetLeft && x < s.offsetLeft - track.offsetLeft + s.offsetWidth));
    };
    document.getElementById('sl-prev')?.addEventListener('click', () => go(current() - 1));
    document.getElementById('sl-next')?.addEventListener('click', () => go(current() + 1));
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.i))));
    track.addEventListener('scroll', () => {
      const c = current();
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === c)));
    }, { passive: true });
    track.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowRight') { ev.preventDefault(); go(current() + 1); }
      if (ev.key === 'ArrowLeft') { ev.preventDefault(); go(current() - 1); }
    });
  }
</script>
<style>
  .slider { margin: 0 0 2.5rem; }
  .slider-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 0.8rem; }
  .slider-head h2 { margin: 0; font-size: 1.15rem; }
  .slider-ctrl { display: flex; gap: 0.4rem; flex-shrink: 0; }
  .slider-ctrl button { width: 2.2rem; height: 2.2rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2); background: transparent; color: var(--fg); font-size: 1rem; cursor: pointer; }
  .slider-ctrl button:hover { border-color: #fff; }
  .slides { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; border-radius: 8px; background: #151517; }
  .slides::-webkit-scrollbar { display: none; }
  .slides:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .slide { flex: 0 0 100%; scroll-snap-align: start; display: flex; align-items: stretch; min-width: 0; }
  .slide-poster { flex: 0 0 58%; height: 460px; display: flex; align-items: center; justify-content: center; background: #0e0e10; }
  .slide.is-landscape .slide-poster { height: auto; align-self: center; }
  .slide.is-landscape .slide-poster img { width: 100%; }
  .slide.is-landscape .slide-body { padding-block: 1.6rem; }
  .slide-poster img { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .slide-body { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 0.35rem; min-width: 0; padding: 1.5rem 1.6rem; }
  .slide-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.6rem; align-items: center; }
  .tag { font-size: 0.74rem; padding: 0.18rem 0.5rem; border: 1px solid rgba(255,255,255,0.22); border-radius: 4px; color: #c4c4c8; }
  .tag.hot { border-color: var(--accent); color: var(--accent); }
  .slide h3 { margin: 0; font-size: 1.7rem; line-height: 1.25; letter-spacing: -0.02em; }
  .slide h3 a { color: var(--fg); text-decoration: none; }
  .slide h3 a:hover { text-decoration: underline; }
  .slide-meta { margin: 0 0 1rem; color: #a9a9b0; }
  .slide-cta { align-self: flex-start; padding: 0.65rem 1.2rem; border-radius: 6px; background: var(--accent); color: #0e0e10; font-weight: 700; font-size: 0.95rem; text-decoration: none; }
  .slide-cta:hover { background: #ff7bb2; }
  .dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: 0.8rem; }
  .dots button { width: 0.55rem; height: 0.55rem; padding: 0; border-radius: 50%; border: 0; background: rgba(255,255,255,0.25); cursor: pointer; }
  .dots button[aria-selected="true"] { background: var(--accent); }
  @media (max-width: 640px) {
    .slide { flex-direction: column; }
    .slide-poster { flex-basis: auto; height: 340px; }
    .slide.is-landscape .slide-poster { height: auto; }
    .slide-body { padding: 1rem 1rem 1.2rem; }
    .slide h3 { font-size: 1.25rem; }
    .slide-meta { margin-bottom: 0.8rem; }
  }
</style>
