---
// 공연 페이지의 "눌러서 이동하는 줄" 한 칸. 도구·관련 공연·외부 가이드가 모두 같은 모양을 쓴다.
// 오른쪽 화살표가 이동 방식을 알려 준다: → 사이트 안, ↗ 새 창, ↓ 파일 받기.
interface Props {
  href: string;
  title: string;
  sub?: string;
  external?: boolean;
  download?: string;
}
const { href, title, sub, external = false, download } = Astro.props;
const mark = download ? '↓' : external ? '↗' : '→';
---
<a
  class="link-row"
  href={href}
  download={download}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="lr-body">
    <span class="lr-title">{title}</span>
    {sub && <span class="lr-sub">{sub}</span>}
  </span>
  <span class="lr-mark" aria-hidden="true">{mark}</span>
</a>
<style>
  .link-row { display: flex; align-items: center; gap: 0.9rem; min-width: 0; min-height: 3.5rem; padding: 0.7rem 0.1rem; color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--line); }
  .lr-body { display: flex; flex-direction: column; gap: 0.15rem; flex: 1; min-width: 0; }
  .lr-title { font-size: 0.95rem; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .lr-sub { color: var(--fg-3); font-size: 0.8rem; line-height: 1.4; }
  .lr-mark { flex: none; color: var(--muted); font-size: 1rem; }
  .link-row:hover .lr-title, .link-row:hover .lr-mark { color: var(--cheese); }
</style>
