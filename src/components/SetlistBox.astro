---
// Past-tour setlists, collapsed by default per show so a page with several tour
// legs doesn't turn into a wall of song titles. Always labeled with which show
// the setlist is from (see SetlistEntry) so readers don't mistake it for a
// guaranteed Korea-show setlist unless it explicitly is one.
import type { SetlistEntry } from '../lib/events';
// 공연 기간 안 날짜(date)가 적힌 항목은 이 공연의 실제 셋리스트다(공연 다음날 채움, npm run setlists:due).
// 그런 항목이 있으면 맨 위로 올리고 첫 항목을 펼쳐 둔다. 제목·안내도 '미리보기'가 아니라 '이번 공연'으로 바뀐다.
interface Props { setlists: SetlistEntry[]; startDate?: string; endDate?: string }
const { setlists: raw, startDate, endDate } = Astro.props;
const isThisShow = (s: SetlistEntry) =>
  Boolean(startDate && endDate && /^\d{4}-\d{2}-\d{2}$/.test(s.date ?? '') && (s.date as string) >= startDate && (s.date as string) <= endDate);
const own = raw.filter(isThisShow).sort((a, b) => String(a.date).localeCompare(String(b.date)));
const setlists = [...own, ...raw.filter((s) => !isThisShow(s))];
const hasOwn = own.length > 0;
---
{setlists.length > 0 && (
  <section class="setlist-box">
    <h2>{hasOwn ? '이번 공연 셋리스트' : '셋리스트 미리보기'}</h2>
    <p class="setlist-caveat">{hasOwn
      ? '공연이 끝난 뒤 공개된 셋리스트를 모았어요. 출처마다 앵콜 순서가 조금 다를 수 있어요.'
      : '실제 이번 공연 셋리스트는 투어 진행에 따라 달라질 수 있어요. 아래는 참고용이에요.'}</p>
    <div class="setlist-group">
      {setlists.map((s, i) => (
        <details class="setlist-item" open={hasOwn && i === 0}>
          <summary>
            <span class="setlist-label">{s.label}</span>
            {(s.date || s.venue) && (
              <span class="setlist-meta">{[s.date, s.venue].filter(Boolean).join(' · ')}</span>
            )}
            <span class="setlist-count">{s.songs.length}곡 보기</span>
          </summary>
          <ol class="setlist-songs">
            {s.songs.map((song) => <li>{song}</li>)}
          </ol>
          {s.note && <p class="setlist-note">{s.note}</p>}
          {s.sourceUrl && (
            <a class="setlist-source" href={s.sourceUrl} target="_blank" rel="noopener noreferrer">출처 보기 ↗</a>
          )}
        </details>
      ))}
    </div>
  </section>
)}
<style>
  .setlist-box { margin: 1.75rem 0; }
  .setlist-box h2 { margin: 0 0 0.35rem; font-size: 1.05rem; color: var(--fg-2); }
  .setlist-caveat { margin: 0 0 0.8rem; color: var(--muted); font-size: 0.85rem; }
  .setlist-group { display: flex; flex-direction: column; gap: 0.6rem; }
  .setlist-item { background: rgba(255,255,255,0.04); border-radius: 8px; overflow: hidden; }
  .setlist-item summary {
    cursor: pointer; list-style: none; padding: 0.75rem 1rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem;
  }
  .setlist-item summary::-webkit-details-marker { display: none; }
  .setlist-label { font-weight: 700; color: var(--fg); font-size: 0.92rem; }
  .setlist-meta { color: var(--muted); font-size: 0.82rem; }
  .setlist-count { margin-left: auto; color: var(--cheese); font-size: 0.82rem; font-weight: 600; }
  .setlist-songs { margin: 0; padding: 0 1rem 0.9rem 2.1rem; color: var(--fg-2); font-size: 0.9rem; line-height: 1.75; }
  .setlist-note { margin: 0 1rem 0.8rem; color: var(--muted); font-size: 0.82rem; }
  .setlist-source { display: block; margin: 0 1rem 0.9rem; font-size: 0.8rem; color: var(--fg-2); }
</style>
