---
// Notable YouTube clips (official live performances, viral fancams from a
// previous tour stop). Lazy-loaded iframes via youtube-nocookie to keep the
// event page's initial load light.
import type { YoutubeVideo } from '../lib/events';
interface Props { videos: YoutubeVideo[] }
const { videos } = Astro.props;
---
{videos.length > 0 && (
  <section class="yt-box">
    <h2>직관냥이 찾은 영상</h2>
    <div class="yt-grid">
      {videos.map((v) => (
        <figure class="yt-item">
          <div class="yt-frame" style={`background-image: url(https://i.ytimg.com/vi/${v.videoId}/hqdefault.jpg)`}>
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v.videoId}`}
              title={v.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
          <figcaption>
            <strong>{v.title}</strong>
            {v.note && <span class="yt-note">{v.note}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
<style>
  .yt-box { margin: 1.75rem 0; }
  .yt-box h2 { margin: 0 0 0.8rem; font-size: 1.05rem; color: var(--fg-2); }
  .yt-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
  /* iframe이 늦게 로드되는 동안 검은 칸 대신 그 영상의 썸네일을 깔아 둔다 */
  .yt-frame { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; background-color: var(--card); background-size: cover; background-position: center; }
  .yt-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .yt-item figcaption { margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .yt-item strong { color: var(--fg); font-size: 0.9rem; }
  .yt-note { color: var(--muted); font-size: 0.8rem; }
</style>
