---
// Shuttle bus info for a venue.
//
// 콘서트 셔틀버스는 대부분 카카오 T 셔틀·꽃가마·퀸즈스마일 3사가 운영한다.
// 이 3사는 확정된 셔틀 정보 유무와 무관하게 항상 눈에 띄게 노출한다
// (shuttle-major-apps 블록). 예전에는 업체마다 X(트위터) 실시간 검색 버튼을
// 따로 뒀지만, 카카오 T 셔틀은 검색·사이트 버튼이 사실상 같은 페이지로
// 중복 연결되고 꽃가마·퀸즈스마일은 X 검색 결과가 신뢰하기 어려워 전부
// 제거했다. 대신 업체별 앱/사이트로 가는 버튼 하나 + 그 안에서 셔틀을
// 어떻게 찾는지 간단한 사용법 문구만 보여준다.
//   - 앱·사이트 버튼 - 데스크톱에서는 공식 사이트로, 모바일(iOS/Android)에서는
//     스크립트가 각 스토어 링크로 자동 전환한다. 앱이 이미 설치돼 있으면
//     스토어가 "열기"를, 없으면 "설치"를 보여주므로 - 우리가 알지 못하는
//     커스텀 URL 스킴을 추측해서 딥링크를 거는 것보다 훨씬 안전하게 "설치돼
//     있으면 열기, 없으면 스토어로" 동작을 얻을 수 있다.
// 스토어 링크는 전부 실제 존재 확인 + 승객용 앱인지 확인(퀸즈스마일은 기사용
// 앱이 별도로 있어 잘못 연결하면 안 됨 - id6446111931/kr.co.queenssmile.qz2023
// 가 승객용, id6745771299/com.queenssmile.driver는 기사 전용이라 제외).
//
// 이후는 두 모드로 나뉜다:
// 1) shuttleBus.length > 0 - 위 3사 중 하나거나 그 외 실제 확인된 전세버스 등
//    구체적으로 sourced된 서비스(ShuttleBusInfo, lib/events.ts 참고)를 그대로
//    보여준다.
// 2) 확정된 shuttleBus 데이터가 없음 - 그래도 빈 화면 대신 위 3사 안내 + 예매처
//    공지 확인 안내를 보여준다. 절대 추측한 셔틀 정보를 만들어내지 않는다.
//    (네이버/구글 일반 검색 링크는 실제로 셔틀 정보를 찾아준다는 보장이 없어
//    제거했다.)
import type { ShuttleBusInfo } from '../lib/events';
import { kakaoShuttleSearchUrl, GGOGGAMA_URL, QUEENS_SMILE_URL } from '../lib/venues';
interface Props {
  shuttleBus: ShuttleBusInfo[];
  venue?: string;
  artist?: string;
  ticketUrl?: string;
}
const { shuttleBus, artist, ticketUrl } = Astro.props;
const kakaoQuery = [artist, '콘서트 셔틀'].filter(Boolean).join(' ');
const kakaoUrl = kakaoShuttleSearchUrl(kakaoQuery);

const MAJOR_SHUTTLE_OPERATORS = [
  {
    name: '카카오 T 셔틀',
    siteUrl: kakaoUrl,
    iosUrl: 'https://apps.apple.com/kr/app/id981110422',
    androidUrl: 'https://play.google.com/store/apps/details?id=com.kakao.taxi',
    howTo: `사이트 접속 시 "${artist ?? '아티스트'}" 태그로 자동 검색돼요. 앱에서는 셔틀 탭에서 같은 태그로 찾아보세요.`,
  },
  {
    name: '꽃가마',
    siteUrl: GGOGGAMA_URL,
    iosUrl: 'https://apps.apple.com/kr/app/id6450586451',
    androidUrl: 'https://play.google.com/store/apps/details?id=com.ggoggama.app',
    howTo: '앱 또는 사이트에서 이 공연/행사 셔틀이 등록돼 있는지 목록에서 확인해보세요.',
  },
  {
    name: '퀸즈스마일',
    siteUrl: QUEENS_SMILE_URL,
    iosUrl: 'https://apps.apple.com/kr/app/id6446111931',
    androidUrl: 'https://play.google.com/store/apps/details?id=kr.co.queenssmile.qz2023',
    howTo: '앱 또는 사이트에서 이 공연/행사 셔틀이 등록돼 있는지 목록에서 확인해보세요.',
  },
];
---
<section class="shuttle-box">
  <h2>셔틀버스 정보</h2>

  <div class="shuttle-major-apps">
    {MAJOR_SHUTTLE_OPERATORS.map((op) => (
      <div class="shuttle-op">
        <div class="shuttle-op-head">
          <span class="shuttle-op-name">{op.name}</span>
          <a
            class="shuttle-op-app"
            href={op.siteUrl}
            data-ios={op.iosUrl}
            data-android={op.androidUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            앱/사이트 열기 ↗
          </a>
        </div>
        <p class="shuttle-op-howto">{op.howTo}</p>
      </div>
    ))}
  </div>

  {shuttleBus.length > 0 ? (
    <div class="shuttle-list">
      {shuttleBus.map((s) => (
        <article class="shuttle-item">
          <h3>{s.operator}{s.appName && s.appName !== s.operator && <span class="shuttle-app">{s.appName}</span>}</h3>
          {s.routes && s.routes.length > 0 && (
            <ul class="shuttle-routes">
              {s.routes.map((r) => <li>{r}</li>)}
            </ul>
          )}
          {s.note && <p class="shuttle-note">{s.note}</p>}
          {s.url && (
            <a class="shuttle-link" href={s.url} target="_blank" rel="noopener noreferrer">
              예매/노선 확인하기 ↗
            </a>
          )}
        </article>
      ))}
    </div>
  ) : (
    <div class="shuttle-fallback">
      <p>
        아직 이 공연의 확정된 셔틀버스 정보는 찾지 못했어요. 위 3개 업체 앱/사이트에서
        "{artist ?? '이 공연'}" 셔틀이 등록돼 있는지 먼저 확인해보시고, 예매처 공지사항도
        함께 살펴보세요.
      </p>
      {ticketUrl && (
        <div class="shuttle-fallback-links">
          <a href={ticketUrl} target="_blank" rel="noopener noreferrer">예매처 공지사항에서 확인 ↗</a>
        </div>
      )}
    </div>
  )}
</section>
<script>
  // 모바일(iOS/Android)에서는 "앱/사이트 열기" 링크를 해당 스토어 링크로 바꿔치기
  // 한다 - 앱이 이미 설치돼 있으면 스토어가 자체적으로 "열기"를 보여주고,
  // 없으면 "설치"를 보여주므로 커스텀 URL 스킴을 추측하지 않고도 "설치돼
  // 있으면 앱으로, 없으면 스토어로" 동작을 안전하게 얻을 수 있다.
  const ua = navigator.userAgent;
  const isIOS = /iPhone|iPad|iPod/.test(ua);
  const isAndroid = /Android/.test(ua);
  if (isIOS || isAndroid) {
    document.querySelectorAll<HTMLAnchorElement>('.shuttle-op-app').forEach((a) => {
      const url = isIOS ? a.dataset.ios : a.dataset.android;
      if (url) {
        a.href = url;
        a.textContent = '앱 열기·설치 ↗';
      }
    });
  }
</script>
<style>
  .shuttle-box { margin: 1.75rem 0; padding: 1.1rem 1.25rem; background: rgba(255, 200, 110, 0.06); border: 1px solid rgba(255, 200, 110, 0.22); border-radius: 14px; }
  .shuttle-box h2 { margin: 0 0 0.8rem; font-size: 1rem; color: #ffdca8; }
  .shuttle-list { display: flex; flex-direction: column; gap: 1rem; }
  .shuttle-item:not(:last-child) { padding-bottom: 1rem; border-bottom: 1px dashed rgba(255,255,255,0.1); }
  .shuttle-item h3 { margin: 0 0 0.35rem; font-size: 0.94rem; color: #f5f3ff; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .shuttle-app { font-size: 0.78rem; font-weight: 600; color: #ffcb6e; }
  .shuttle-routes { margin: 0 0 0.4rem; padding-left: 1.1rem; color: #d8d5ef; font-size: 0.9rem; line-height: 1.6; }
  .shuttle-note { margin: 0 0 0.5rem; color: #d8d5ef; font-size: 0.88rem; line-height: 1.6; }
  .shuttle-link { display: inline-block; font-size: 0.86rem; font-weight: 600; color: #ffcb6e; text-decoration: none; }
  .shuttle-link:hover { text-decoration: underline; }
  .shuttle-major-apps {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0 0 1.2rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px dashed rgba(255,255,255,0.14);
  }
  .shuttle-op { display: flex; flex-direction: column; gap: 0.3rem; }
  .shuttle-op-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }
  .shuttle-op-name { font-size: 0.9rem; font-weight: 700; color: #f5f3ff; min-width: 6.5em; }
  .shuttle-op-howto { margin: 0; font-size: 0.82rem; color: #d8d5ef; line-height: 1.5; }
  .shuttle-op-app {
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    color: #ffcb6e;
    background: rgba(255,200,110,0.08);
    border: 1px solid rgba(255,200,110,0.3);
  }
  .shuttle-op-app:hover { background: rgba(255,200,110,0.16); }
  .shuttle-fallback p { margin: 0 0 0.9rem; color: #d8d5ef; font-size: 0.9rem; line-height: 1.6; }
  .shuttle-fallback-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .shuttle-fallback-links a {
    font-size: 0.85rem;
    color: #ffcb6e;
    text-decoration: none;
    background: rgba(255,200,110,0.08);
    border: 1px solid rgba(255,200,110,0.3);
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
  }
  .shuttle-fallback-links a:hover { background: rgba(255,200,110,0.16); }
</style>
