---
// 알림 받는 법(/alerts/)의 단계별 화면 그림. 실제 캡처가 아니라 "어디를 누르는지"만 보여 주는 단순한 그림이다.
// 누를 곳은 주황 테두리(--cheese)로 표시한다. 실제 휴대폰 캡처가 생기면 public/alerts/<kind>.png를 두고
// src 속성으로 넘기면 그림 대신 캡처를 보여 준다.
interface Props {
  kind: 'ios-share' | 'ios-sheet' | 'ios-add' | 'ios-home' | 'ios-allow' | 'android-allow' | 'android-install' | 'inapp-menu';
  caption?: string;
  src?: string;
}
const { kind, caption, src } = Astro.props;
const ICON = '/icons/icon-192.png';
---
<figure class="shot">
  {src ? (
    <img src={src} alt={caption ?? ''} loading="lazy" />
  ) : (
    <svg viewBox="0 0 260 470" role="img" aria-label={caption ?? '휴대폰 화면 그림'} xmlns="http://www.w3.org/2000/svg">
      <rect class="frame" x="2" y="2" width="256" height="466" rx="30" />
      <rect class="screen" x="12" y="12" width="236" height="446" rx="22" />
      <rect class="notch" x="100" y="20" width="60" height="14" rx="7" />

      {kind === 'ios-share' && (
        <g>
          <rect class="blk" x="28" y="56" width="140" height="14" rx="3" />
          <rect class="blk2" x="28" y="80" width="204" height="90" rx="6" />
          <rect class="blk" x="28" y="182" width="180" height="9" rx="3" />
          <rect class="blk" x="28" y="198" width="150" height="9" rx="3" />
          <rect class="blk" x="28" y="214" width="190" height="9" rx="3" />
          <rect class="bar" x="12" y="352" width="236" height="106" />
          <rect class="pill" x="26" y="362" width="208" height="30" rx="10" />
          <text class="t-sm" x="130" y="381" text-anchor="middle">jikgwannyang.com</text>
          <path class="ico" d="M44 420 l-7 7 l7 7" />
          <path class="ico" d="M84 420 l7 7 l-7 7" />
          <g transform="translate(130 427)">
            <rect class="ico" x="-8" y="-4" width="16" height="15" rx="2" />
            <path class="ico" d="M0 -13 v15 M-5 -8 l5 -5 l5 5" />
          </g>
          <path class="ico" d="M166 420 h10 a4 4 0 0 1 4 4 v12 h-14 z M180 424 h0" />
          <rect class="ico" x="202" y="420" width="14" height="14" rx="3" />
          <circle class="hit" cx="130" cy="427" r="20" />
          <text class="t-hit" x="130" y="340" text-anchor="middle">공유 버튼</text>
        </g>
      )}

      {kind === 'ios-sheet' && (
        <g>
          <rect class="dim" x="12" y="12" width="236" height="446" rx="22" />
          <rect class="sheet" x="12" y="120" width="236" height="338" rx="18" />
          <image href={ICON} x="28" y="136" width="34" height="34" />
          <text class="t" x="72" y="150">직관냥</text>
          <text class="t-sm" x="72" y="165">jikgwannyang.com</text>
          {['복사', '읽기 목록에 추가', '책갈피 추가', '즐겨찾기에 추가'].map((t, i) => (
            <g>
              <rect class="row" x="24" y={190 + i * 40} width="212" height="36" rx="8" />
              <text class="t" x="38" y={213 + i * 40}>{t}</text>
            </g>
          ))}
          <rect class="row" x="24" y="350" width="212" height="36" rx="8" />
          <text class="t" x="38" y="373">홈 화면에 추가</text>
          <g transform="translate(214 368)">
            <rect class="ico" x="-8" y="-8" width="16" height="16" rx="3" />
            <path class="ico" d="M0 -4 v8 M-4 0 h8" />
          </g>
          <rect class="hit-r" x="20" y="346" width="220" height="44" rx="10" />
          <text class="t-hit" x="130" y="412" text-anchor="middle">목록을 내려 "홈 화면에 추가"</text>
        </g>
      )}

      {kind === 'ios-add' && (
        <g>
          <rect class="sheet" x="12" y="44" width="236" height="414" rx="18" />
          <text class="t" x="30" y="76">취소</text>
          <text class="t-b" x="130" y="76" text-anchor="middle">홈 화면에 추가</text>
          <text class="t-b" x="216" y="76" text-anchor="middle">추가</text>
          <rect class="hit-r" x="196" y="58" width="40" height="26" rx="8" />
          <rect class="row" x="24" y="100" width="212" height="74" rx="10" />
          <image href={ICON} x="36" y="112" width="50" height="50" />
          <text class="t" x="98" y="132">직관냥</text>
          <text class="t-sm" x="98" y="152">jikgwannyang.com</text>
          <rect class="row" x="24" y="186" width="212" height="40" rx="10" />
          <text class="t" x="38" y="211">웹 앱으로 열기</text>
          <rect class="tog" x="194" y="196" width="32" height="20" rx="10" />
          <circle class="tog-k" cx="216" cy="206" r="8" />
          <text class="t-hit" x="130" y="262" text-anchor="middle">켜진 채로 두고 오른쪽 위 "추가"</text>
        </g>
      )}

      {kind === 'ios-home' && (
        <g>
          {Array.from({ length: 16 }).map((_, i) => {
            const x = 30 + (i % 4) * 52, y = 60 + Math.floor(i / 4) * 66;
            return i === 9 ? (
              <g>
                <image href={ICON} x={x} y={y} width="40" height="40" />
                <text class="t-xs" x={x + 20} y={y + 54} text-anchor="middle">직관냥</text>
                <rect class="hit-r" x={x - 6} y={y - 6} width="52" height="66" rx="12" />
              </g>
            ) : (
              <g>
                <rect class="app" x={x} y={y} width="40" height="40" rx="10" />
                <rect class="blk" x={x + 8} y={y + 48} width="24" height="5" rx="2" />
              </g>
            );
          })}
          <rect class="dock" x="24" y="388" width="212" height="56" rx="18" />
          <text class="t-hit" x="130" y="350" text-anchor="middle">이 아이콘으로 열어요</text>
        </g>
      )}

      {kind === 'ios-allow' && (
        <g>
          <rect class="blk" x="28" y="56" width="120" height="14" rx="3" />
          <rect class="blk2" x="28" y="80" width="204" height="70" rx="6" />
          <rect class="btn" x="28" y="162" width="110" height="32" rx="6" />
          <text class="t-ink" x="83" y="183" text-anchor="middle">오픈 알림 받기</text>
          <rect class="dim" x="12" y="12" width="236" height="446" rx="22" />
          <rect class="alert" x="34" y="170" width="192" height="130" rx="14" />
          <text class="t-b" x="130" y="200" text-anchor="middle">'직관냥'에서 알림을</text>
          <text class="t-b" x="130" y="218" text-anchor="middle">보내고자 합니다</text>
          <text class="t-sm" x="130" y="240" text-anchor="middle">알림에는 소리, 배지가 포함될 수 있어요</text>
          <line class="sep" x1="34" y1="256" x2="226" y2="256" />
          <line class="sep" x1="130" y1="256" x2="130" y2="300" />
          <text class="t" x="82" y="283" text-anchor="middle">허용 안 함</text>
          <text class="t-b" x="178" y="283" text-anchor="middle">허용</text>
          <rect class="hit-r" x="134" y="260" width="88" height="36" rx="8" />
          <text class="t-hit" x="130" y="340" text-anchor="middle">"허용"을 눌러요</text>
        </g>
      )}

      {kind === 'android-allow' && (
        <g>
          <rect class="pill" x="24" y="46" width="212" height="28" rx="14" />
          <text class="t-sm" x="130" y="64" text-anchor="middle">jikgwannyang.com</text>
          <rect class="blk2" x="28" y="90" width="204" height="70" rx="6" />
          <rect class="btn" x="28" y="172" width="110" height="32" rx="6" />
          <text class="t-ink" x="83" y="193" text-anchor="middle">오픈 알림 받기</text>
          <rect class="dim" x="12" y="12" width="236" height="446" rx="22" />
          <rect class="alert" x="28" y="200" width="204" height="150" rx="16" />
          <text class="t-b" x="44" y="232">jikgwannyang.com에서</text>
          <text class="t-b" x="44" y="250">알림을 보내려고 합니다</text>
          <rect class="row" x="40" y="268" width="180" height="32" rx="16" />
          <text class="t-b" x="130" y="289" text-anchor="middle">허용</text>
          <rect class="hit-r" x="36" y="264" width="188" height="40" rx="18" />
          <text class="t" x="130" y="328" text-anchor="middle">허용 안함</text>
          <text class="t-hit" x="130" y="384" text-anchor="middle">"허용"을 눌러요</text>
        </g>
      )}

      {kind === 'android-install' && (
        <g>
          <rect class="pill" x="24" y="46" width="180" height="28" rx="14" />
          <text class="t-sm" x="114" y="64" text-anchor="middle">jikgwannyang.com</text>
          <circle class="ico-f" cx="226" cy="54" r="2" />
          <circle class="ico-f" cx="226" cy="60" r="2" />
          <circle class="ico-f" cx="226" cy="66" r="2" />
          <circle class="hit" cx="226" cy="60" r="14" />
          <rect class="sheet" x="96" y="84" width="146" height="200" rx="10" />
          {['새 탭', '방문 기록', '다운로드', '공유'].map((t, i) => (
            <text class="t" x="110" y={112 + i * 34}>{t}</text>
          ))}
          <text class="t" x="110" y="248">홈 화면에 추가</text>
          <rect class="hit-r" x="100" y="228" width="138" height="30" rx="8" />
          <text class="t-hit" x="130" y="320" text-anchor="middle">⋮ → "홈 화면에 추가"</text>
          <text class="t-sm" x="130" y="340" text-anchor="middle">("앱 설치"로 보이기도 해요)</text>
        </g>
      )}

      {kind === 'inapp-menu' && (
        <g>
          <rect class="bar" x="12" y="12" width="236" height="56" />
          <text class="t-sm" x="130" y="52" text-anchor="middle">jikgwannyang.com</text>
          <rect class="blk2" x="28" y="84" width="204" height="70" rx="6" />
          <rect class="blk" x="28" y="166" width="180" height="9" rx="3" />
          <rect class="bar" x="12" y="410" width="236" height="48" />
          <circle class="ico-f" cx="212" cy="434" r="2" />
          <circle class="ico-f" cx="220" cy="434" r="2" />
          <circle class="ico-f" cx="228" cy="434" r="2" />
          <circle class="hit" cx="220" cy="434" r="16" />
          <rect class="sheet" x="70" y="250" width="172" height="146" rx="10" />
          <text class="t" x="84" y="278">새로고침</text>
          <text class="t" x="84" y="310">링크 복사</text>
          <text class="t" x="84" y="342">공유하기</text>
          <text class="t-b" x="84" y="376">다른 브라우저로 열기</text>
          <rect class="hit-r" x="74" y="358" width="164" height="30" rx="8" />
          <text class="t-hit" x="130" y="232" text-anchor="middle">⋯ 메뉴 → 다른 브라우저로 열기</text>
        </g>
      )}
    </svg>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot { margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .shot svg, .shot img { width: 100%; max-width: 220px; height: auto; display: block; }
  .shot img { border-radius: 22px; }
  figcaption { font-size: 0.82rem; color: var(--muted); line-height: 1.5; }
  .frame { fill: var(--card-2); stroke: var(--line-2); stroke-width: 2; }
  .screen { fill: var(--bg-deep); }
  .notch { fill: var(--card-2); }
  .blk { fill: var(--line); }
  .blk2 { fill: var(--card); }
  .bar { fill: var(--card); }
  .pill { fill: var(--card-2); }
  .sheet { fill: var(--card); }
  .row { fill: var(--card-2); }
  .dim { fill: var(--bg-deep); opacity: 0.7; }
  .alert { fill: var(--card-2); }
  .sep { stroke: var(--line-2); stroke-width: 1; }
  .app { fill: var(--card-2); }
  .dock { fill: var(--card); }
  .btn { fill: var(--btn); }
  .tog { fill: var(--eye); }
  .tog-k { fill: var(--fg); }
  .ico { fill: none; stroke: var(--fg-2); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ico-f { fill: var(--fg-2); }
  .hit, .hit-r { fill: none; stroke: var(--cheese); stroke-width: 2.5; }
  text { font-family: inherit; }
  .t { fill: var(--fg-2); font-size: 12px; }
  .t-b { fill: var(--fg); font-size: 12.5px; font-weight: 700; }
  .t-sm { fill: var(--muted); font-size: 9.5px; }
  .t-xs { fill: var(--fg-2); font-size: 9px; }
  .t-ink { fill: var(--ink); font-size: 11px; font-weight: 800; }
  .t-hit { fill: var(--cheese); font-size: 12px; font-weight: 800; }
</style>
