---
// 신규 공연 알림 배너 - addedAt 7일 안이고 promoBanner 문구가 있는 공연 하나를 헤더 아래에 한 줄로 보여준다.
// 닫으면 그 공연 id를 이 브라우저에 기억해서 다시 안 보여준다(localStorage). 팝업(모달)은 쓰지 않는다.
// 해당 공연 페이지 자체에서는 숨긴다.
import { bannerEvent } from '../lib/events';
const ev = bannerEvent();
const onOwnPage = ev ? Astro.url.pathname.startsWith(`/events/${ev.id}`) : false;
---
{ev && !onOwnPage && (
  <aside class="new-banner" data-banner-id={ev.id} hidden aria-label="신규 공연 알림">
    <a class="nb-link" href={`/events/${ev.id}/`}>
      <span class="nb-tag">신규</span>
      <span class="nb-text">{ev.promoBanner}</span>
      <span class="nb-go">자세히 →</span>
    </a>
    <button class="nb-close" type="button" aria-label="알림 닫기">닫기</button>
  </aside>
)}
<script>
  const el = document.querySelector<HTMLElement>('.new-banner');
  if (el) {
    const id = el.dataset.bannerId ?? '';
    const KEY = 'krconcerts:banner-dismissed';
    let dismissed = '';
    try { dismissed = localStorage.getItem(KEY) ?? ''; } catch { /* 저장소를 못 쓰면 매번 보여줘도 괜찮다 */ }
    if (dismissed !== id) el.hidden = false;
    el.querySelector('.nb-close')?.addEventListener('click', () => {
      el.hidden = true;
      try { localStorage.setItem(KEY, id); } catch { /* 무시 */ }
    });
  }
</script>
<style>
  .new-banner { display: flex; align-items: center; gap: 0.5rem; max-width: 1180px; margin: 0 auto; padding: 0.55rem 1.25rem; border-bottom: 1px solid #2a2a30; font-size: 0.9rem; }
  .new-banner[hidden] { display: none; }
  .nb-link { flex: 1; min-width: 0; display: flex; align-items: center; gap: 0.7rem; color: #f4f4f0; text-decoration: none; }
  .nb-tag { flex: none; padding: 0.12rem 0.5rem; border-radius: 4px; background: #ff5fa2; color: #0e0e10; font-size: 0.72rem; font-weight: 800; }
  .nb-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
  .nb-go { flex: none; color: #8f8f97; font-size: 0.82rem; }
  .nb-link:hover .nb-go { color: #ff5fa2; }
  .nb-close { all: unset; cursor: pointer; flex: none; padding: 0.2rem 0.4rem; color: #8f8f97; font-size: 0.8rem; }
  .nb-close:hover { color: #f4f4f0; }
  @media (max-width: 560px) { .nb-go { display: none; } }
</style>
