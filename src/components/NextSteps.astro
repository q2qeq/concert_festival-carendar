---
// 공연 상세 페이지의 "지금 할 일" 한 문장. 도구를 나열하지 않고 공연 상태에 맞는 한 가지만 권한다.
//   티켓 오픈 전·오픈 중: 그리지 않는다. 상단 카운트다운(OpenCountdown)이 시계·알림·연습을 안내한다.
//   예매 중: 취소표 → 취켓팅 연습
//   공연 7일 전부터 마지막 날까지: 돌아오는 차편 → 막차 계산
//   끝났거나 연기·취소, 예매 링크가 없는 공연: 그리지 않는다.
// 예전에는 도구 링크 묶음이 모든 공연에 똑같이 나와서 도구 페이지를 옮겨 놓은 것처럼 보였다(2026-11-18).
// 나머지 도구는 질문이 생기는 자리에 둔다: 비용 계산기는 가격표 밑, 막차 계산기는 공연장 정보.
// 정적 빌드라 두 문장을 모두 그려 두고, 브라우저가 오늘 날짜로 보여 줄 것을 다시 고른다.
import type { ConcertEvent } from '../lib/events';
import { ticketOpenStages, hasTicketsOnSale } from '../lib/events';
import { getVenueInfo } from '../lib/venues';
import { nextStepKind } from '../lib/nextStep';
interface Props { event: ConcertEvent }
const { event } = Astro.props;

const stages = ticketOpenStages(event);
const scheduled = (event.status ?? 'scheduled') === 'scheduled';
const onSale = hasTicketsOnSale(event);
const built = nextStepKind({ start: event.startDate, end: event.endDate, stages, onSale }, Date.now());
const returnHref = getVenueInfo(event.venue) ? `/return-trip/#venue=${encodeURIComponent(event.venue)}` : '/return-trip/';
---
{scheduled && (
  <section
    class="now"
    aria-label="지금 할 일"
    data-now
    data-start={event.startDate}
    data-end={event.endDate}
    data-on-sale={onSale ? '1' : '0'}
    data-stages={JSON.stringify(stages)}
    hidden={built.kind === 'none'}
  >
    <div class="now-item" data-now-kind="sale" hidden={built.kind !== 'sale'}>
      <div class="now-text">
        <p class="now-k">예매 중 · 공연까지 <span class="mono" data-now-days>{built.days}</span>일</p>
        <p class="now-s">매진이어도 취소표는 예고 없이 풀려요</p>
        <p class="now-sub">뜨는 순간 누를 수 있게 손을 풀어 두세요.</p>
      </div>
      <a class="now-btn" href="/practice/?stage=cancel">취켓팅 연습하기</a>
    </div>
    <div class="now-item" data-now-kind="week" hidden={built.kind !== 'week'}>
      <div class="now-text">
        <p class="now-k">공연 주간</p>
        <p class="now-s" data-now-week>
          {built.days > 0 ? <>공연이 <em class="mono">{built.days}일</em> 남았어요</> : <>오늘 공연이에요</>}
        </p>
        <p class="now-sub">{event.venue}에서 돌아오는 차편을 먼저 확인하세요. <a href="#venue">공연장 가는 길</a></p>
      </div>
      <a class="now-btn" href={returnHref}>막차 계산하기</a>
    </div>
  </section>
)}
<script>
  import { nextStepKind } from '../lib/nextStep';
  const box = document.querySelector<HTMLElement>('[data-now]');
  if (box) {
    let stages = [];
    try { stages = JSON.parse(box.dataset.stages ?? '[]'); } catch { /* 빌드 시점 표시를 그대로 둔다 */ }
    const now = nextStepKind({ start: box.dataset.start ?? '', end: box.dataset.end ?? '', stages, onSale: box.dataset.onSale === '1' }, Date.now());
    box.hidden = now.kind === 'none';
    box.querySelectorAll<HTMLElement>('[data-now-kind]').forEach((el) => { el.hidden = el.dataset.nowKind !== now.kind; });
    const days = box.querySelector('[data-now-days]');
    if (days) days.textContent = String(now.days);
    const week = box.querySelector('[data-now-week]');
    if (week && now.kind === 'week') {
      week.textContent = '';
      if (now.days > 0) {
        const em = document.createElement('em');
        em.className = 'mono';
        em.textContent = `${now.days}일`;
        week.append('공연이 ', em, ' 남았어요');
      } else {
        week.textContent = '오늘 공연이에요';
      }
    }
  }
</script>
<style>
  .now { margin: 2rem 0 0; padding: 1.1rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .now-item { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.9rem 1.5rem; }
  .now-item[hidden] { display: none; }
  .now-text { flex: 1 1 18rem; min-width: 0; }
  .now-k { margin: 0; font-size: 0.8rem; color: var(--muted); }
  .now-s { margin: 0.15rem 0 0; font-size: 1.25rem; font-weight: 800; line-height: 1.35; letter-spacing: -0.02em; text-wrap: balance; color: var(--fg); }
  .now-s :global(em) { font-style: normal; color: var(--cheese); }
  .now-sub { margin: 0.3rem 0 0; font-size: 0.86rem; color: var(--fg-3); }
  .now-sub a { color: var(--fg-2); text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 0.2em; white-space: nowrap; }
  .now-sub a:hover { color: var(--cheese); text-decoration-color: var(--cheese); }
  .now-btn { display: inline-flex; align-items: center; padding: 0.65rem 1.1rem; border-radius: 4px; background: var(--btn); color: var(--ink); font-size: 0.92rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .now-btn:hover { background: var(--btn-hi); }
</style>
