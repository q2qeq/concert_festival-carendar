---
// 공연 상세 페이지 상단 "다음 행동" 블록 - 이 페이지에서 답을 얻은 사람이 바로
// 이어서 할 만한 일(티켓팅 시계 / 같은 날·같은 공연장 공연 / 내 찜)을 한곳에 모은다.
// 이탈률 개선용 (2026-11-02). 목록은 실제 데이터에 있는 것만 보여주고, 없으면 그 줄을 숨긴다.
import type { ConcertEvent } from '../lib/events';
import { sameDayEvents, sameVenueUpcoming } from '../lib/events';
import { getVenueInfo } from '../lib/venues';
import { ticketOpenIcs, ticketOpenGoogleUrl, icsDataUri } from '../lib/ticketAlert';
interface Props { event: ConcertEvent }
const { event } = Astro.props;

const sameDay = sameDayEvents(event);
const returnHref = getVenueInfo(event.venue) ? `/return-trip/?venue=${encodeURIComponent(event.venue)}` : '/return-trip/';
const sameVenue = sameVenueUpcoming(event);
const hasOpen = Boolean(event.ticketOpenAt) && new Date(event.ticketOpenAt as string).getTime() > Date.now();
const clockHref = hasOpen
  ? `/ticketing-clock?open=${encodeURIComponent(event.ticketOpenAt as string)}&artist=${encodeURIComponent(event.artist)}`
  : '/ticketing-clock';
const alertEvent = hasOpen ? { id: event.id, artist: event.artist, ticketOpenAt: event.ticketOpenAt as string } : null;
const googleHref = alertEvent ? ticketOpenGoogleUrl(alertEvent) : '';
const icsHref = alertEvent ? icsDataUri(ticketOpenIcs([alertEvent])) : '';
const shortDate = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getMonth() + 1}.${d.getDate()}`;
};
---
<section class="next-steps" aria-label="다음 행동">
  <div class="ns-actions">
    <a class="ns-btn ns-primary" href={clockHref}>
      {hasOpen ? '이 공연 오픈 카운트다운' : '티켓팅 시계 켜기'}
    </a>
    <a class="ns-btn" href="/practice/">티켓팅 연습하기</a>
    <a class="ns-btn" href="/internet-speed/">인터넷 속도 측정</a>
    <a class="ns-btn" href={returnHref}>막차 계산</a>
    <a class="ns-btn" href="/my/">내 찜 모아보기</a>
  </div>
  {alertEvent && (
    <div class="ns-row">
      <span class="ns-label">오픈 알림 (10분 전·하루 전)</span>
      <div class="ns-links">
        <a href={googleHref} target="_blank" rel="noopener noreferrer">구글 캘린더</a>
        <a href={icsHref} download={`${event.id}-ticket-open.ics`}>.ics 파일</a>
      </div>
    </div>
  )}
  {sameDay.length > 0 && (
    <div class="ns-row">
      <span class="ns-label">같은 날 열리는 공연</span>
      <div class="ns-links">
        {sameDay.map((e) => <a href={`/events/${e.id}/`}>{e.artist}</a>)}
      </div>
    </div>
  )}
  {sameVenue.length > 0 && (
    <div class="ns-row">
      <span class="ns-label">{event.venue}의 다음 공연</span>
      <div class="ns-links">
        {sameVenue.map((e) => <a href={`/events/${e.id}/`}>{e.artist} <small>{shortDate(e.startDate)}</small></a>)}
      </div>
    </div>
  )}
</section>
<style>
  /* 상자 안에 상자를 넣지 않는다: 위아래 선으로만 묶고, 주 동작(시계) 하나만 버튼, 나머지는 글자 링크 */
  .next-steps { margin: 1.4rem 0 1.4rem; padding: 0.9rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ns-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0 1.2rem; }
  .ns-btn { padding: 0.7rem 0; font-size: 0.88rem; font-weight: 600; text-decoration: none; color: var(--fg-2); }
  .ns-btn:hover { color: var(--cheese); }
  .ns-primary { padding: 0.65rem 1.1rem; margin-right: 0.3rem; border-radius: 4px; font-weight: 700; background: var(--btn); color: var(--ink); }
  .ns-primary:hover { color: var(--ink); background: var(--btn-hi); }
  .ns-row { margin-top: 0.6rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.9rem; }
  .ns-label { color: var(--muted); font-size: 0.82rem; }
  .ns-links { display: flex; flex-wrap: wrap; gap: 0 0.9rem; }
  .ns-links a { padding: 0.45rem 0; font-size: 0.88rem; color: var(--fg); text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 0.25em; }
  .ns-links a:hover { color: var(--cheese); text-decoration-color: var(--cheese); }
  .ns-links small { color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
