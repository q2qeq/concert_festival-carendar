---
// 공연 상세 페이지의 "다음 행동" 블록 - 이 페이지에서 답을 얻은 사람이 바로
// 이어서 할 만한 일(도구 / 오픈 알림 / 같은 날·같은 공연장 공연)을 한곳에 모은다.
// 이탈률 개선용 (2026-11-02). 목록은 실제 데이터에 있는 것만 보여주고, 없으면 그 구역을 숨긴다.
// 버튼·글자 링크·밑줄 링크가 섞여 헷갈린다는 피드백으로 모두 LinkRow 한 모양으로 통일했다(2026-11-18).
import type { ConcertEvent } from '../lib/events';
import { sameDayEvents, sameVenueUpcoming } from '../lib/events';
import { getVenueInfo } from '../lib/venues';
import { ticketOpenIcs, ticketOpenGoogleUrl, icsDataUri } from '../lib/ticketAlert';
import LinkList from './LinkList.astro';
import LinkRow from './LinkRow.astro';
interface Props { event: ConcertEvent }
const { event } = Astro.props;

const sameDay = sameDayEvents(event);
const returnHref = getVenueInfo(event.venue) ? `/return-trip/#venue=${encodeURIComponent(event.venue)}` : '/return-trip/';
const sameVenue = sameVenueUpcoming(event);
const hasOpen = Boolean(event.ticketOpenAt) && new Date(event.ticketOpenAt as string).getTime() > Date.now();
const clockHref = hasOpen
  ? `/ticketing-clock/#open=${encodeURIComponent(event.ticketOpenAt as string)}&artist=${encodeURIComponent(event.artist)}`
  : '/ticketing-clock';
const alertEvent = hasOpen ? { id: event.id, artist: event.artist, ticketOpenAt: event.ticketOpenAt as string } : null;
const googleHref = alertEvent ? ticketOpenGoogleUrl(alertEvent) : '';
const icsHref = alertEvent ? icsDataUri(ticketOpenIcs([alertEvent])) : '';
const WEEKDAYS = ['일', '월', '화', '수', '목', '금', '토'];
const dayLabel = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getMonth() + 1}월 ${d.getDate()}일 (${WEEKDAYS[d.getDay()]})`;
};
---
<div class="next-steps">
  {alertEvent && (
    <LinkList title="티켓 오픈 알림">
      <LinkRow href={googleHref} external title="구글 캘린더에 추가" sub="오픈 10분 전과 하루 전에 알려 줘요" />
      <LinkRow href={icsHref} download={`${event.id}-ticket-open.ics`} title="캘린더 파일 받기" sub="애플 캘린더 등에서 쓰는 .ics 파일이에요" />
    </LinkList>
  )}

  <LinkList title="직관 준비 도구">
    <LinkRow href={clockHref} title={hasOpen ? '이 공연 오픈 카운트다운' : '티켓팅 시계'} sub="오픈 순간을 밀리초까지" />
    <LinkRow href="/practice/" title="티켓팅 연습" sub="30초 손풀기 게임" />
    <LinkRow href="/internet-speed/" title="인터넷 속도 측정" sub="내 인터넷 속도, 10초면 확인돼요" />
    <LinkRow href={returnHref} title="막차 계산기" sub="공연 끝나고 집에 갈 수 있을까" />
    <LinkRow href="/trip-cost/" title="직관 비용 계산기" sub="티켓·교통·숙박·굿즈 총비용" />
    <LinkRow href="/my/" title="내 찜 모아보기" sub="찜한 공연을 한곳에서" />
  </LinkList>

  {(sameDay.length > 0 || sameVenue.length > 0) && (
    <div class:list={['ns-events', { 'two-up': sameDay.length > 0 && sameVenue.length > 0 }]}>
      {sameDay.length > 0 && (
        <LinkList title="같은 날 열리는 공연" columns={1}>
          {sameDay.map((e) => <LinkRow href={`/events/${e.id}/`} title={e.artist} sub={e.venue} />)}
        </LinkList>
      )}
      {sameVenue.length > 0 && (
        <LinkList title={`${event.venue}의 다음 공연`} columns={1}>
          {sameVenue.map((e) => <LinkRow href={`/events/${e.id}/`} title={e.artist} sub={dayLabel(e.startDate)} />)}
        </LinkList>
      )}
    </div>
  )}
</div>
<style>
  .next-steps { display: flex; flex-direction: column; gap: 2rem; margin: 2.5rem 0 0; }
  .ns-events { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem 2.4rem; align-items: start; }
  @media (min-width: 640px) {
    .ns-events.two-up { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
