---
// Calendar popover content - meant to sit next to the "캘린더 추가" trigger
// button in the sticky action bar ([id].astro), not as a standalone block in
// the page body. It's a quick utility action, not content, so clicking the
// button should surface these two options immediately instead of scrolling
// to a section.
// Renders a Google Calendar link (prefilled fields) + a static-generated
// .ics file link (data: URI, no backend needed - Apple Calendar/Outlook
// understand this format). All-day event only (ConcertEvent doesn't
// reliably carry start times), so DTEND/dates use the exclusive-end-date
// convention (end date + 1 day).
interface Props {
  event: {
    id: string;
    artist: string;
    startDate: string;
    endDate: string;
    venue: string;
    city: string;
    description?: string;
  };
}
const { event } = Astro.props;

function toYYYYMMDD(iso: string) {
  return iso.replaceAll('-', '');
}
function addDays(iso: string, days: number) {
  const d = new Date(iso + 'T00:00:00Z');
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

const startYmd = toYYYYMMDD(event.startDate);
const endExclusiveYmd = toYYYYMMDD(addDays(event.endDate, 1));

const title = `${event.artist} (${event.venue})`;
const location = `${event.venue}, ${event.city}`;
const details = event.description ?? `${event.artist} - ${event.venue}, ${event.city}`;

const googleUrl =
  `https://calendar.google.com/calendar/render?action=TEMPLATE` +
  `&text=${encodeURIComponent(title)}` +
  `&dates=${startYmd}/${endExclusiveYmd}` +
  `&details=${encodeURIComponent(details)}` +
  `&location=${encodeURIComponent(location)}`;

function escIcs(s: string) {
  return s.replace(/\\/g, '\\\\').replace(/,/g, '\\,').replace(/;/g, '\\;').replace(/\n/g, '\\n');
}

const icsLines = [
  'BEGIN:VCALENDAR',
  'VERSION:2.0',
  'PRODID:-//공연캘린더//KO',
  'CALSCALE:GREGORIAN',
  'BEGIN:VEVENT',
  `UID:${event.id}@krconcerts`,
  `DTSTAMP:${startYmd}T000000Z`,
  `DTSTART;VALUE=DATE:${startYmd}`,
  `DTEND;VALUE=DATE:${endExclusiveYmd}`,
  `SUMMARY:${escIcs(title)}`,
  `LOCATION:${escIcs(location)}`,
  `DESCRIPTION:${escIcs(details)}`,
  'END:VEVENT',
  'END:VCALENDAR',
].join('\r\n');

const icsDataUrl = `data:text/calendar;charset=utf-8,${encodeURIComponent(icsLines)}`;
---
<div class="atc-popover" id="calendar-popover" role="menu" aria-label="캘린더에 추가" hidden>
  <a class="atc-option" href={googleUrl} target="_blank" rel="noopener noreferrer" role="menuitem">Google 캘린더</a>
  <a class="atc-option" href={icsDataUrl} download={`${event.id}.ics`} role="menuitem">Apple·Outlook (.ics)</a>
</div>
<style>
  .atc-popover {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 35;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 190px;
    padding: 0.5rem;
    background: rgba(20, 20, 30, 0.97);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .atc-option {
    display: block;
    font-size: 0.85rem;
    color: #f5f3ff;
    text-decoration: none;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    white-space: nowrap;
  }
  .atc-option:hover { background: rgba(255,95,162,0.16); }
</style>
