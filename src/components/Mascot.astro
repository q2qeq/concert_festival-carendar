---
// 직관냥 캐릭터. 그림은 src/lib/mascot.mjs에 있다.
//   who: duo(둘 다) · godeung(고등어) · cheese(치즈)
//   pose="face"는 얼굴만 그린다(로고처럼 작은 자리용).
import { mascot } from '../lib/mascot.mjs';

interface Props {
  size?: number; // 가로 폭(px)
  class?: string;
  pose?: 'watch' | 'wave' | 'cheer' | 'sleep' | 'search' | 'heart' | 'shock' | 'ticket' | 'face';
  who?: 'duo' | 'godeung' | 'cheese';
}
const { size = 120, class: className = '', pose = 'watch', who = 'duo' } = Astro.props;
const m = mascot(pose, who);
const h = Math.round((size * m.h) / m.w);
const label = who === 'duo' && pose !== 'face' && pose !== 'sleep' ? '직관냥 고양이 고등어와 치즈' : '직관냥 고양이';
---
<svg
  class={`mascot-illust ${className}`}
  width={size}
  height={h}
  viewBox={m.viewBox}
  role="img"
  aria-label={label}
  xmlns="http://www.w3.org/2000/svg"
  set:html={m.body}
/>
<style>
  .mascot-illust { display: block; overflow: visible; flex-shrink: 0; }
</style>
