---
interface Props {
  size?: number;
  class?: string;
  pose?: 'watch' | 'wave' | 'cheer';
}
const { size = 120, class: className = '', pose = 'watch' } = Astro.props;
const h = Math.round(size * 1.1);
---
<svg
  class={`mascot-illust ${className}`}
  width={size}
  height={h}
  viewBox="0 0 200 220"
  role="img"
  aria-label="직관냥 캐릭터"
  xmlns="http://www.w3.org/2000/svg"
>
  <ellipse cx="100" cy="168" rx="64" ry="50" fill="#f5f2ff" stroke="#1a1a24" stroke-width="4" />
  <ellipse cx="100" cy="180" rx="30" ry="26" fill="#ffffff" opacity="0.6" />

  {pose === 'watch' && (
    <>
      <path d="M155,182 Q198,176 192,128 Q188,96 158,104" fill="none" stroke="#1a1a24" stroke-width="26" stroke-linecap="round" />
      <path d="M155,182 Q198,176 192,128 Q188,96 158,104" fill="none" stroke="#f5f2ff" stroke-width="20" stroke-linecap="round" />
      <path d="M182,118 Q188,112 186,100" fill="none" stroke="#ff5fa2" stroke-width="10" stroke-linecap="round" opacity="0.85" />
      <ellipse cx="70" cy="208" rx="16" ry="11" fill="#f5f2ff" stroke="#1a1a24" stroke-width="4" />
      <ellipse cx="140" cy="150" rx="15" ry="11" fill="#f5f2ff" stroke="#1a1a24" stroke-width="4" transform="rotate(-35 140 150)" />
      <g transform="rotate(-14 168 118)">
        <rect x="150" y="106" width="38" height="24" rx="4" fill="#6ee7ff" stroke="#1a1a24" stroke-width="3.5" />
        <line x1="169" y1="110" x2="169" y2="126" stroke="#1a1a24" stroke-width="2" stroke-dasharray="3 3" />
        <path d="M158,118 l1.6,-3.4 l3.4,-0.2 l-2.6,-2.4 l0.8,-3.4 l-3.2,1.8 l-3.2,-1.8 l0.8,3.4 l-2.6,2.4 l3.4,0.2 Z" fill="#101018" opacity="0.85" />
      </g>
    </>
  )}

  {pose === 'wave' && (
    <>
      <ellipse cx="70" cy="208" rx="16" ry="11" fill="#f5f2ff" stroke="#1a1a24" stroke-width="4" />
      <path d="M138,170 Q184,156 178,110 Q175,90 160,84" fill="none" stroke="#1a1a24" stroke-width="26" stroke-linecap="round" class="mascot-wave-arm" />
      <path d="M138,170 Q184,156 178,110 Q175,90 160,84" fill="none" stroke="#f5f2ff" stroke-width="20" stroke-linecap="round" class="mascot-wave-arm" />
      <ellipse cx="160" cy="84" rx="17" ry="14" fill="#f5f2ff" stroke="#1a1a24" stroke-width="4" transform="rotate(18 160 84)" class="mascot-wave-arm" />
      <path d="M150,74 L152,64 M160,70 L161,59 M170,74 L173,64" stroke="#1a1a24" stroke-width="3" stroke-linecap="round" class="mascot-wave-arm" />
    </>
  )}

  {pose === 'cheer' && (
    <>
      <path d="M148,176 Q184,150 172,104" fill="none" stroke="#1a1a24" stroke-width="24" stroke-linecap="round" />
      <path d="M148,176 Q184,150 172,104" fill="none" stroke="#f5f2ff" stroke-width="18" stroke-linecap="round" />
      <path d="M52,176 Q16,150 28,104" fill="none" stroke="#1a1a24" stroke-width="24" stroke-linecap="round" />
      <path d="M52,176 Q16,150 28,104" fill="none" stroke="#f5f2ff" stroke-width="18" stroke-linecap="round" />
      <ellipse cx="172" cy="100" rx="15" ry="13" fill="#f5f2ff" stroke="#1a1a24" stroke-width="4" transform="rotate(-18 172 100)" />
      <ellipse cx="28" cy="100" rx="15" ry="13" fill="#f5f2ff" stroke="#1a1a24" stroke-width="4" transform="rotate(18 28 100)" />
      <path class="sparkle" d="M190,72 L192,78 L198,80 L192,82 L190,88 L188,82 L182,80 L188,78 Z" fill="#ffd166" />
      <path class="sparkle delay" d="M10,72 L12,78 L18,80 L12,82 L10,88 L8,82 L2,80 L8,78 Z" fill="#ffd166" />
    </>
  )}

  <circle cx="100" cy="96" r="54" fill="#f5f2ff" stroke="#1a1a24" stroke-width="4" />

  <polygon points="56,58 36,10 78,46" fill="#f5f2ff" stroke="#1a1a24" stroke-width="4" stroke-linejoin="round" />
  <polygon points="58,50 47,24 70,44" fill="#ff5fa2" />
  <polygon points="144,58 164,10 122,46" fill="#f5f2ff" stroke="#1a1a24" stroke-width="4" stroke-linejoin="round" />
  <polygon points="142,50 153,24 130,44" fill="#ff5fa2" />

  <ellipse cx="66" cy="106" rx="9" ry="5.5" fill="#ff5fa2" opacity="0.35" />
  <ellipse cx="134" cy="106" rx="9" ry="5.5" fill="#ff5fa2" opacity="0.35" />

  <line x1="52" y1="96" x2="18" y2="88" stroke="#1a1a24" stroke-width="3" stroke-linecap="round" />
  <line x1="52" y1="104" x2="16" y2="104" stroke="#1a1a24" stroke-width="3" stroke-linecap="round" />
  <line x1="52" y1="112" x2="18" y2="120" stroke="#1a1a24" stroke-width="3" stroke-linecap="round" />
  <line x1="148" y1="96" x2="182" y2="88" stroke="#1a1a24" stroke-width="3" stroke-linecap="round" />
  <line x1="148" y1="104" x2="184" y2="104" stroke="#1a1a24" stroke-width="3" stroke-linecap="round" />
  <line x1="148" y1="112" x2="182" y2="120" stroke="#1a1a24" stroke-width="3" stroke-linecap="round" />

  {pose === 'cheer' ? (
    <>
      <path d="M74,88 Q80,80 86,88" fill="none" stroke="#1a1a24" stroke-width="4" stroke-linecap="round" />
      <path d="M114,88 Q120,80 126,88" fill="none" stroke="#1a1a24" stroke-width="4" stroke-linecap="round" />
    </>
  ) : (
    <>
      <circle cx="80" cy="92" r="7" fill="#1a1a24" />
      <circle cx="82.5" cy="89" r="2" fill="#ffffff" />
      <path d="M110,92 Q120,84 130,92" fill="none" stroke="#1a1a24" stroke-width="4" stroke-linecap="round" />
    </>
  )}

  <polygon points="95,104 105,104 100,111" fill="#ff5fa2" stroke="#1a1a24" stroke-width="1.5" stroke-linejoin="round" />
  <path d="M100,111 L100,115" stroke="#1a1a24" stroke-width="2.5" stroke-linecap="round" />
  {pose === 'cheer' ? (
    <path d="M85,118 Q100,132 115,118" fill="none" stroke="#1a1a24" stroke-width="3" stroke-linecap="round" />
  ) : (
    <>
      <path d="M91,120 Q100,126 100,115" fill="none" stroke="#1a1a24" stroke-width="3" stroke-linecap="round" />
      <path d="M109,120 Q100,126 100,115" fill="none" stroke="#1a1a24" stroke-width="3" stroke-linecap="round" />
    </>
  )}

  {pose !== 'cheer' && (
    <>
      <path class="sparkle" d="M28,42 L31,50 L39,53 L31,56 L28,64 L25,56 L17,53 L25,50 Z" fill="#6ee7ff" />
      <path class="sparkle delay" d="M176,64 L178,70 L184,72 L178,74 L176,80 L174,74 L168,72 L174,70 Z" fill="#6ee7ff" />
    </>
  )}
</svg>
<style>
  .mascot-illust { display: block; overflow: visible; flex-shrink: 0; }
  .mascot-illust .sparkle {
    transform-origin: center;
    animation: mascot-twinkle 2.4s ease-in-out infinite;
  }
  .mascot-illust .sparkle.delay { animation-delay: 1.1s; }
  .mascot-illust .mascot-wave-arm {
    transform-origin: 138px 170px;
    animation: mascot-wave 1.6s ease-in-out infinite;
  }
  @keyframes mascot-twinkle {
    0%, 100% { opacity: 0.3; transform: scale(0.75); }
    50% { opacity: 1; transform: scale(1.1); }
  }
  @keyframes mascot-wave {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(10deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mascot-illust .sparkle { animation: none; opacity: 0.8; }
    .mascot-illust .mascot-wave-arm { animation: none; }
  }
</style>
