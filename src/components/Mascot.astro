---
interface Props {
  size?: number;
  class?: string;
  pose?: 'watch' | 'wave' | 'cheer' | 'sleep' | 'search' | 'heart' | 'shock' | 'ticket';
}
const { size = 120, class: className = '', pose = 'watch' } = Astro.props;
const h = Math.round(size * 1.1);
const happy = pose === 'cheer' || pose === 'heart';
const bigEyes = pose === 'search' || pose === 'shock';
---
<svg
  class={`mascot-illust ${className}`}
  width={size}
  height={h}
  viewBox="0 0 200 220"
  role="img"
  aria-label="직관냥 캐릭터"
  xmlns="http://www.w3.org/2000/svg"
>
  <ellipse cx="100" cy="168" rx="64" ry="50" fill="#ededea" stroke="#151517" stroke-width="4" />
  <ellipse cx="100" cy="180" rx="30" ry="26" fill="#ffffff" opacity="0.6" />

  {pose === 'watch' && (
    <>
      <path d="M155,182 Q198,176 192,128 Q188,96 158,104" fill="none" stroke="#151517" stroke-width="26" stroke-linecap="round" />
      <path d="M155,182 Q198,176 192,128 Q188,96 158,104" fill="none" stroke="#ededea" stroke-width="20" stroke-linecap="round" />
      <path d="M182,118 Q188,112 186,100" fill="none" stroke="#ff5fa2" stroke-width="10" stroke-linecap="round" opacity="0.85" />
      <ellipse cx="70" cy="208" rx="16" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
      <ellipse cx="140" cy="150" rx="15" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" transform="rotate(-35 140 150)" />
      <g transform="rotate(-14 168 118)">
        <rect x="150" y="106" width="38" height="24" rx="4" fill="#c9c9cf" stroke="#151517" stroke-width="3.5" />
        <line x1="169" y1="110" x2="169" y2="126" stroke="#151517" stroke-width="2" stroke-dasharray="3 3" />
        <path d="M158,118 l1.6,-3.4 l3.4,-0.2 l-2.6,-2.4 l0.8,-3.4 l-3.2,1.8 l-3.2,-1.8 l0.8,3.4 l-2.6,2.4 l3.4,0.2 Z" fill="#0e0e10" opacity="0.85" />
      </g>
    </>
  )}

  {pose === 'wave' && (
    <>
      <ellipse cx="70" cy="208" rx="16" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
      <path d="M138,170 Q184,156 178,110 Q175,90 160,84" fill="none" stroke="#151517" stroke-width="26" stroke-linecap="round" class="mascot-wave-arm" />
      <path d="M138,170 Q184,156 178,110 Q175,90 160,84" fill="none" stroke="#ededea" stroke-width="20" stroke-linecap="round" class="mascot-wave-arm" />
      <ellipse cx="160" cy="84" rx="17" ry="14" fill="#ededea" stroke="#151517" stroke-width="4" transform="rotate(18 160 84)" class="mascot-wave-arm" />
      <path d="M150,74 L152,64 M160,70 L161,59 M170,74 L173,64" stroke="#151517" stroke-width="3" stroke-linecap="round" class="mascot-wave-arm" />
    </>
  )}


  {pose === 'sleep' && (
    <>
      <ellipse cx="70" cy="208" rx="16" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
      <ellipse cx="130" cy="208" rx="16" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
      <path d="M155,182 Q198,176 192,140 Q190,124 172,128" fill="none" stroke="#151517" stroke-width="26" stroke-linecap="round" />
      <path d="M155,182 Q198,176 192,140 Q190,124 172,128" fill="none" stroke="#ededea" stroke-width="20" stroke-linecap="round" />
      <text x="150" y="42" font-family="Pretendard, sans-serif" font-size="30" font-weight="800" fill="#8f8f97" class="mascot-z">z</text>
      <text x="170" y="22" font-family="Pretendard, sans-serif" font-size="22" font-weight="800" fill="#8f8f97" class="mascot-z delay">z</text>
    </>
  )}

  {pose === 'search' && (
    <>
      <ellipse cx="70" cy="208" rx="16" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
      <path d="M138,170 Q176,160 168,124" fill="none" stroke="#151517" stroke-width="26" stroke-linecap="round" />
      <path d="M138,170 Q176,160 168,124" fill="none" stroke="#ededea" stroke-width="20" stroke-linecap="round" />
      <line x1="166" y1="100" x2="171" y2="116" stroke="#151517" stroke-width="7" stroke-linecap="round" />
      <circle cx="178" cy="76" r="22" fill="#ffffff" fill-opacity="0.5" stroke="#151517" stroke-width="5" />
      <path d="M166,70 Q168,62 176,60" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" />
      <ellipse cx="170" cy="124" rx="14" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
    </>
  )}

  {pose === 'heart' && (
    <>
      <ellipse cx="70" cy="208" rx="16" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
      <path d="M138,172 Q180,160 172,126" fill="none" stroke="#151517" stroke-width="26" stroke-linecap="round" />
      <path d="M138,172 Q180,160 172,126" fill="none" stroke="#ededea" stroke-width="20" stroke-linecap="round" />
      <ellipse cx="172" cy="122" rx="14" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
      <path d="M172,112 C160,96 148,82 160,70 C166,64 174,66 178,72 C184,64 196,64 200,74 C206,90 188,100 172,112 Z" fill="#ff5fa2" stroke="#151517" stroke-width="3.5" stroke-linejoin="round" class="mascot-beat" />
    </>
  )}

  {pose === 'shock' && (
    <>
      <ellipse cx="70" cy="208" rx="16" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
      <ellipse cx="130" cy="208" rx="16" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
      <path d="M60,170 Q40,150 52,126" fill="none" stroke="#151517" stroke-width="24" stroke-linecap="round" />
      <path d="M60,170 Q40,150 52,126" fill="none" stroke="#ededea" stroke-width="18" stroke-linecap="round" />
      <path d="M140,170 Q160,150 148,126" fill="none" stroke="#151517" stroke-width="24" stroke-linecap="round" />
      <path d="M140,170 Q160,150 148,126" fill="none" stroke="#ededea" stroke-width="18" stroke-linecap="round" />
      <path d="M182,40 L186,66" stroke="#ff5fa2" stroke-width="7" stroke-linecap="round" />
      <circle cx="187" cy="78" r="4.5" fill="#ff5fa2" />
      <path d="M16,50 L20,70" stroke="#ff5fa2" stroke-width="6" stroke-linecap="round" />
      <circle cx="21" cy="80" r="4" fill="#ff5fa2" />
    </>
  )}

  {pose === 'ticket' && (
    <>
      <ellipse cx="70" cy="208" rx="16" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
      <path d="M138,172 Q182,160 174,126" fill="none" stroke="#151517" stroke-width="26" stroke-linecap="round" />
      <path d="M138,172 Q182,160 174,126" fill="none" stroke="#ededea" stroke-width="20" stroke-linecap="round" />
      <g transform="rotate(-12 170 100)">
        <path d="M146,86 h52 v10 a6,6 0 0 0 0,12 v10 h-52 v-10 a6,6 0 0 0 0,-12 Z" fill="#ff5fa2" stroke="#151517" stroke-width="3.5" stroke-linejoin="round" />
        <line x1="178" y1="88" x2="178" y2="116" stroke="#151517" stroke-width="2" stroke-dasharray="3 3" />
      </g>
      <ellipse cx="172" cy="124" rx="14" ry="11" fill="#ededea" stroke="#151517" stroke-width="4" />
    </>
  )}

  {pose === 'cheer' && (
    <>
      <path d="M148,176 Q184,150 172,104" fill="none" stroke="#151517" stroke-width="24" stroke-linecap="round" />
      <path d="M148,176 Q184,150 172,104" fill="none" stroke="#ededea" stroke-width="18" stroke-linecap="round" />
      <path d="M52,176 Q16,150 28,104" fill="none" stroke="#151517" stroke-width="24" stroke-linecap="round" />
      <path d="M52,176 Q16,150 28,104" fill="none" stroke="#ededea" stroke-width="18" stroke-linecap="round" />
      <ellipse cx="172" cy="100" rx="15" ry="13" fill="#ededea" stroke="#151517" stroke-width="4" transform="rotate(-18 172 100)" />
      <ellipse cx="28" cy="100" rx="15" ry="13" fill="#ededea" stroke="#151517" stroke-width="4" transform="rotate(18 28 100)" />
      <path class="sparkle" d="M190,72 L192,78 L198,80 L192,82 L190,88 L188,82 L182,80 L188,78 Z" fill="#ffd166" />
      <path class="sparkle delay" d="M10,72 L12,78 L18,80 L12,82 L10,88 L8,82 L2,80 L8,78 Z" fill="#ffd166" />
    </>
  )}

  <circle cx="100" cy="96" r="54" fill="#ededea" stroke="#151517" stroke-width="4" />

  <polygon points="56,58 36,10 78,46" fill="#ededea" stroke="#151517" stroke-width="4" stroke-linejoin="round" />
  <polygon points="58,50 47,24 70,44" fill="#ff5fa2" />
  <polygon points="144,58 164,10 122,46" fill="#ededea" stroke="#151517" stroke-width="4" stroke-linejoin="round" />
  <polygon points="142,50 153,24 130,44" fill="#ff5fa2" />

  <ellipse cx="66" cy="106" rx="9" ry="5.5" fill="#ff5fa2" opacity="0.35" />
  <ellipse cx="134" cy="106" rx="9" ry="5.5" fill="#ff5fa2" opacity="0.35" />

  <line x1="52" y1="96" x2="18" y2="88" stroke="#151517" stroke-width="3" stroke-linecap="round" />
  <line x1="52" y1="104" x2="16" y2="104" stroke="#151517" stroke-width="3" stroke-linecap="round" />
  <line x1="52" y1="112" x2="18" y2="120" stroke="#151517" stroke-width="3" stroke-linecap="round" />
  <line x1="148" y1="96" x2="182" y2="88" stroke="#151517" stroke-width="3" stroke-linecap="round" />
  <line x1="148" y1="104" x2="184" y2="104" stroke="#151517" stroke-width="3" stroke-linecap="round" />
  <line x1="148" y1="112" x2="182" y2="120" stroke="#151517" stroke-width="3" stroke-linecap="round" />

  {happy ? (
    <>
      <path d="M74,92 Q80,83 86,92" fill="none" stroke="#151517" stroke-width="4" stroke-linecap="round" />
      <path d="M114,92 Q120,83 126,92" fill="none" stroke="#151517" stroke-width="4" stroke-linecap="round" />
    </>
  ) : pose === 'sleep' ? (
    <>
      <path d="M72,92 Q80,100 88,92" fill="none" stroke="#151517" stroke-width="4" stroke-linecap="round" />
      <path d="M112,92 Q120,100 128,92" fill="none" stroke="#151517" stroke-width="4" stroke-linecap="round" />
    </>
  ) : bigEyes ? (
    <>
      <circle cx="80" cy="92" r="9" fill="#ffffff" stroke="#151517" stroke-width="3" />
      <circle cx="80" cy="93" r="4.5" fill="#151517" />
      <circle cx="120" cy="92" r="9" fill="#ffffff" stroke="#151517" stroke-width="3" />
      <circle cx="120" cy="93" r="4.5" fill="#151517" />
    </>
  ) : (
    <>
      <circle cx="80" cy="92" r="7" fill="#151517" />
      <circle cx="82.5" cy="89" r="2" fill="#ffffff" />
      <path d="M110,92 Q120,84 130,92" fill="none" stroke="#151517" stroke-width="4" stroke-linecap="round" />
    </>
  )}

  <polygon points="95,104 105,104 100,111" fill="#ff5fa2" stroke="#151517" stroke-width="1.5" stroke-linejoin="round" />
  <path d="M100,111 L100,115" stroke="#151517" stroke-width="2.5" stroke-linecap="round" />
  {happy ? (
    <path d="M85,118 Q100,132 115,118" fill="none" stroke="#151517" stroke-width="3" stroke-linecap="round" />
  ) : pose === 'shock' ? (
    <ellipse cx="100" cy="124" rx="6" ry="8" fill="#151517" />
  ) : pose === 'sleep' ? (
    <path d="M94,120 Q100,124 106,120" fill="none" stroke="#151517" stroke-width="3" stroke-linecap="round" />
  ) : (
    <>
      <path d="M91,120 Q100,126 100,115" fill="none" stroke="#151517" stroke-width="3" stroke-linecap="round" />
      <path d="M109,120 Q100,126 100,115" fill="none" stroke="#151517" stroke-width="3" stroke-linecap="round" />
    </>
  )}

  {pose === 'watch' || pose === 'wave' || pose === 'ticket' ? (
    <>
      <path class="sparkle" d="M28,42 L31,50 L39,53 L31,56 L28,64 L25,56 L17,53 L25,50 Z" fill="#c9c9cf" />
      <path class="sparkle delay" d="M176,64 L178,70 L184,72 L178,74 L176,80 L174,74 L168,72 L174,70 Z" fill="#c9c9cf" />
    </>
  ) : null}
</svg>
<style>
  .mascot-illust { display: block; overflow: visible; flex-shrink: 0; }
  .mascot-illust .sparkle {
    transform-origin: center;
    animation: mascot-twinkle 2.4s ease-in-out infinite;
  }
  .mascot-illust .sparkle.delay { animation-delay: 1.1s; }
  .mascot-illust .mascot-wave-arm {
    transform-origin: 138px 170px;
    animation: mascot-wave 1.6s ease-in-out infinite;
  }
  .mascot-illust .mascot-z { animation: mascot-float 2.6s ease-in-out infinite; }
  .mascot-illust .mascot-z.delay { animation-delay: 1.2s; }
  .mascot-illust .mascot-beat { transform-origin: 175px 90px; animation: mascot-beat 1.4s ease-in-out infinite; }
  @keyframes mascot-float { 0%,100% { opacity: .35; transform: translateY(2px); } 50% { opacity: 1; transform: translateY(-4px); } }
  @keyframes mascot-beat { 0%,100% { transform: scale(1); } 50% { transform: scale(1.12); } }
  @keyframes mascot-twinkle {
    0%, 100% { opacity: 0.3; transform: scale(0.75); }
    50% { opacity: 1; transform: scale(1.1); }
  }
  @keyframes mascot-wave {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(10deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mascot-illust .sparkle { animation: none; opacity: 0.8; }
    .mascot-illust .mascot-wave-arm, .mascot-illust .mascot-z, .mascot-illust .mascot-beat { animation: none; }
  }
</style>
