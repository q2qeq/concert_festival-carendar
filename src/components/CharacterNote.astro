---
// A recurring "column" box voiced by the site's mascot, 직관냥 - a cat that
// supposedly shows up to every show. Used to carry researched trivia/context
// (funFacts) so event pages read like something a person actually dug into,
// not a bare data dump.
interface Props {
  facts: string[];
  title?: string;
}
const { facts, title = '직관냥이 짚어주는 포인트' } = Astro.props;

// Facts may contain simple markdown links, e.g. to cross-link another event
// page ([평화누리 피크닉 페스티벌](/events/...)). No other markdown is supported -
// this is just enough to make cross-references clickable.
function linkify(text: string) {
  const escaped = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escaped.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2">$1</a>'
  );
}
---
{facts.length > 0 && (
  <aside class="character-note">
    <div class="character-note-head">
      <span class="character-avatar" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="28" height="28">
          <path fill="currentColor" d="M12 6 L18 16 L14 16 Z" />
          <path fill="currentColor" d="M36 6 L30 16 L34 16 Z" />
          <circle cx="24" cy="26" r="16" fill="currentColor" />
          <circle cx="18.5" cy="24" r="2.2" fill="#101018" />
          <circle cx="29.5" cy="24" r="2.2" fill="#101018" />
          <path fill="none" stroke="#101018" stroke-width="1.6" stroke-linecap="round" d="M22 31 q2 2 4 0" />
        </svg>
      </span>
      <h2>{title}</h2>
    </div>
    <ul class="character-note-list">
      {facts.map((fact) => <li set:html={linkify(fact)} />)}
    </ul>
  </aside>
)}
<style>
  .character-note {
    margin: 1.75rem 0;
    padding: 1.1rem 1.25rem 1.3rem;
    background: linear-gradient(155deg, rgba(255, 95, 162, 0.12), rgba(110, 231, 255, 0.06));
    border: 1px solid rgba(255, 95, 162, 0.25);
    border-radius: 14px;
  }
  .character-note-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .character-avatar {
    display: inline-flex;
    flex-shrink: 0;
    color: #ff8fbe;
  }
  .character-note h2 {
    margin: 0;
    font-size: 1rem;
    color: #ffd7e9;
  }
  .character-note-list {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .character-note-list li {
    color: #e5e2f7;
    font-size: 0.94rem;
    line-height: 1.6;
  }
  .character-note-list :global(a) { color: #6ee7ff; }
</style>
