---
// A recurring "column" voiced by the site's mascot, 직관냥 - a cat that
// supposedly shows up to every show. Used to carry researched trivia/context
// (funFacts) so event pages read like an actual blog-style column someone
// wrote after digging into the artist/show, not a bare bullet-point data
// dump. Each string in `facts` renders as its own paragraph (blog-post
// pacing) rather than a compact <li> - write them long and entertaining,
// not just factual one-liners, while still only ever containing real,
// sourced material (see sources.ts / SourceList for citations).
interface Props {
  facts: string[];
  title?: string;
}
const { facts, title = '직관냥이 짚어주는 포인트' } = Astro.props;

// Facts may contain simple markdown links, e.g. to cross-link another event
// page ([평화누리 피크닉 페스티벌](/events/...)). No other markdown is supported -
// this is just enough to make cross-references clickable.
function linkify(text: string) {
  const escaped = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escaped.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2">$1</a>'
  );
}
---
{facts.length > 0 && (
  <aside class="character-note">
    <div class="character-note-head">
      <span class="character-avatar" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="28" height="28">
          <path fill="currentColor" d="M12 6 L18 16 L14 16 Z" />
          <path fill="currentColor" d="M36 6 L30 16 L34 16 Z" />
          <circle cx="24" cy="26" r="16" fill="currentColor" />
          <circle cx="18.5" cy="24" r="2.2" fill="#0e0e10" />
          <circle cx="29.5" cy="24" r="2.2" fill="#0e0e10" />
          <path fill="none" stroke="#0e0e10" stroke-width="1.6" stroke-linecap="round" d="M22 31 q2 2 4 0" />
        </svg>
      </span>
      <div>
        <h2>{title}</h2>
        <p class="character-note-kicker">직관냥이 파본 뒷이야기</p>
      </div>
    </div>
    <div class="character-note-body">
      {facts.map((fact) => <p set:html={linkify(fact)} />)}
    </div>
  </aside>
)}
<style>
  .character-note {
    margin: 1.75rem 0;
    padding: 0.2rem 0 0.2rem 1.1rem;
    background: transparent;
    border-left: 3px solid var(--cheese);
    border-radius: 0;
  }
  .character-note-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }
  .character-avatar {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--cheese);
  }
  .character-note h2 {
    margin: 0;
    font-size: 1rem;
    color: var(--fg);
  }
  .character-note-kicker {
    margin: 0.1rem 0 0;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .character-note-body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .character-note-body p {
    margin: 0;
    color: var(--fg-2);
    font-size: 0.96rem;
    line-height: 1.75;
  }
  .character-note-body :global(a) { color: var(--fg-2); }
</style>
