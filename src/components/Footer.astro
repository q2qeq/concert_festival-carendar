---
import { SITE_TITLE } from '../consts';
import { allGenres, genreSlug } from '../lib/events';
const year = new Date().getFullYear();
const genres = allGenres();
---
<footer class="site-footer">
  <div class="wrap">
    {genres.length > 0 && (
      <div class="tag-links">
        <span class="tag-links-label">장르별 보기</span>
        {genres.map((g) => (
          <a href={`/tag/${genreSlug(g)}/`}>{g}</a>
        ))}
        <a href="/events/archive">지난 공연</a>
      </div>
    )}
    <p>&copy; {year} {SITE_TITLE}. 공연 일정은 주최측 사정에 따라 변경될 수 있으니 예매 전 공식 채널에서 최종 확인하세요.</p>
    <p class="credit">일부 공연 데이터 출처: 공연예술통합전산망(KOPIS)</p>
    <div class="links">
      <a href="/privacy-policy">개인정보처리방침</a>
      <a href="/about">소개</a>
      <a href="/contact">문의</a>
    </div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid rgba(255,255,255,0.08); margin-top: 3rem; }
  .wrap { max-width: 880px; margin: 0 auto; padding: 2rem 1.25rem; color: #a9a4c9; font-size: 0.85rem; display: flex; flex-direction: column; gap: 1rem; }
  .wrap > p, .wrap > .links { align-self: stretch; }
  .tag-links { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .tag-links-label { font-size: 0.72rem; color: #7d78a0; text-transform: uppercase; letter-spacing: 0.06em; margin-right: 0.2rem; }
  .tag-links a { color: #a9a4c9; text-decoration: none; font-size: 0.82rem; }
  .tag-links a:hover { color: #fff; }
  .links { display: flex; gap: 1rem; white-space: nowrap; flex-wrap: wrap; }
  .links a { color: #a9a4c9; }
  .credit { font-size: 0.78rem; opacity: 0.7; }
</style>
