---
import { SITE_TITLE } from '../consts';
import Mascot from './Mascot.astro';

const { pathname } = Astro.url;
const NAV = [
  { href: '/', label: '전체 일정' },
  { href: '/venues', label: '공연장' },
  { href: '/events/archive', label: '지난 공연' },
  { href: '/blog', label: '이슈' },
  { href: '/ticketing-clock', label: '티켓팅 시계' },
  { href: '/about', label: '소개' },
  { href: '/contact', label: '문의' },
];
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---
<header class="site-header">
  <nav>
    <a class="brand" href="/">
      <Mascot size={30} />
      <span>{SITE_TITLE}</span>
    </a>
    <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="메뉴 열기">
      <span></span><span></span><span></span>
    </button>
    <div class="links" id="nav-links">
      {NAV.map((item) => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
<script>
  // Mobile nav: on narrow screens the full link list collapses behind a
  // hamburger toggle (see @media rule below) instead of wrapping into
  // 2-3 lines under the sticky header on every page.
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
  links?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      links.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    background: rgba(16, 16, 24, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  nav { position: relative; max-width: 880px; margin: 0 auto; padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; }
  .brand { display: flex; align-items: center; gap: 0.4rem; font-weight: 800; font-size: 1.2rem; color: #fff; text-decoration: none; letter-spacing: -0.02em; }
  .links { display: flex; gap: 1.1rem; }
  .links a {
    color: #a9a4c9;
    text-decoration: none;
    font-size: 0.9rem;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
  }
  .links a:hover { color: #fff; }
  .links a.active { color: #fff; font-weight: 700; border-bottom-color: var(--accent, #ff5fa2); }
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 34px;
    height: 34px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: #f5f3ff;
    border-radius: 2px;
    transition: transform 0.15s, opacity 0.15s;
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 720px) {
    .nav-toggle { display: flex; }
    .links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: #14141f;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 12px 24px rgba(0,0,0,0.35);
    }
    .links.is-open { display: flex; }
    .links a {
      padding: 0.85rem 1.25rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .links a.active { border-bottom: 1px solid rgba(255,255,255,0.06); background: rgba(255,95,162,0.08); }
  }
</style>
