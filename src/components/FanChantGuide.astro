---
// 떼창/콜 파트 안내 - "진짜 덕후"가 공연 전에 챙겨보는 자료. 우리가 직접
// 특정 곡의 떼창 타이밍·가사를 만들어내는 건 절대 하지 않는다(틀릴 위험이
// 크고, 이 사이트의 다른 기능들과 같은 원칙 - 절대 추측/생성하지 않는다).
// 대신 두 계층으로 제공한다:
//   1) event.fanChantGuide - 실제로 확인된 공식 응원법/콜 가이드(기획사 배포
//      PDF·이미지, 크레딧이 명확한 팬 제작 가이드 등)가 있을 때만 노출. 대부분의
//      공연은 이 데이터가 없을 것이고, 그래도 괜찮다 - 아래 검색이 항상 있다.
//   2) 곡명을 입력하면(선택) 유튜브·네이버 블로그·나무위키에서 "{아티스트}
//      {곡명} 떼창"을 검색하는 딥링크 - SightlineSearch.astro와 같은 패턴.
//      떼창 가이드는 대부분 영상(타이밍·발음)이나 블로그 후기로 존재해서
//      유튜브/블로그 중심으로 구성했다.
import type { FanChantGuideEntry } from '../lib/events';
interface Props {
  artist: string;
  guides?: FanChantGuideEntry[];
}
const { artist, guides = [] } = Astro.props;

function chantQuery(artist: string, song?: string) {
  return song ? `${artist} ${song} 떼창` : `${artist} 떼창 가이드`;
}
const defaultQuery = chantQuery(artist);
const defaultQueryEncoded = encodeURIComponent(defaultQuery);
---
<section class="fanchant-box" data-artist={artist}>
  <h2>떼창·콜 가이드</h2>

  {guides.length > 0 && (
    <div class="fanchant-official">
      {guides.map((g) => (
        <a class="fanchant-official-link" href={g.url} target="_blank" rel="noopener noreferrer">
          {g.title}{g.note && <span class="fanchant-official-note"> · {g.note}</span>} ↗
        </a>
      ))}
    </div>
  )}

  <p class="fanchant-desc">
    특정 곡을 입력하면 그 곡의 떼창·콜 파트만 따로 검색할 수 있어요. 비워두면 아티스트 전체
    가이드를 찾아드려요.
  </p>
  <div class="fanchant-row">
    <input
      type="text"
      class="fanchant-input"
      placeholder="예: Attention (비워두면 아티스트 전체로 검색)"
      autocomplete="off"
    />
  </div>
  <div class="fanchant-links">
    <a class="fc-link fc-yt" href={`https://www.youtube.com/results?search_query=${defaultQueryEncoded}`} target="_blank" rel="noopener noreferrer">
      유튜브에서 "{defaultQuery}" 검색 →
    </a>
    <a class="fc-link fc-naver" href={`https://search.naver.com/search.naver?where=blog&query=${defaultQueryEncoded}`} target="_blank" rel="noopener noreferrer">
      네이버 블로그에서 "{defaultQuery}" 검색 →
    </a>
    <a class="fc-link fc-namu" href={`https://namu.wiki/Search?q=${defaultQueryEncoded}`} target="_blank" rel="noopener noreferrer">
      나무위키에서 "{defaultQuery}" 검색 →
    </a>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.fanchant-box').forEach((box) => {
    const artist = box.dataset.artist || '';
    const input = box.querySelector<HTMLInputElement>('.fanchant-input');
    const ytLink = box.querySelector<HTMLAnchorElement>('.fc-yt');
    const naverLink = box.querySelector<HTMLAnchorElement>('.fc-naver');
    const namuLink = box.querySelector<HTMLAnchorElement>('.fc-namu');

    const update = () => {
      const song = input?.value.trim();
      const query = song ? `${artist} ${song} 떼창` : `${artist} 떼창 가이드`;
      const q = encodeURIComponent(query);
      if (ytLink) {
        ytLink.href = `https://www.youtube.com/results?search_query=${q}`;
        ytLink.textContent = `유튜브에서 "${query}" 검색 →`;
      }
      if (naverLink) {
        naverLink.href = `https://search.naver.com/search.naver?where=blog&query=${q}`;
        naverLink.textContent = `네이버 블로그에서 "${query}" 검색 →`;
      }
      if (namuLink) {
        namuLink.href = `https://namu.wiki/Search?q=${q}`;
        namuLink.textContent = `나무위키에서 "${query}" 검색 →`;
      }
    };
    input?.addEventListener('input', update);
    input?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter') ev.preventDefault();
    });
  });
</script>
<style>
  .fanchant-box { margin: 1.75rem 0; padding: 1.1rem 1.25rem; background: rgba(255, 95, 162, 0.06); border: 1px solid rgba(255, 95, 162, 0.2); border-radius: 14px; }
  .fanchant-box h2 { margin: 0 0 0.8rem; font-size: 1rem; color: #ffd7e9; }
  .fanchant-official { display: flex; flex-direction: column; gap: 0.4rem; margin: 0 0 1rem; padding-bottom: 1rem; border-bottom: 1px dashed rgba(255,255,255,0.14); }
  .fanchant-official-link { font-size: 0.88rem; font-weight: 700; color: #ff8fbe; text-decoration: none; }
  .fanchant-official-link:hover { text-decoration: underline; }
  .fanchant-official-note { font-weight: 400; color: #a9a4c9; }
  .fanchant-desc { margin: 0 0 0.65rem; color: #a9a4c9; font-size: 0.85rem; line-height: 1.55; }
  .fanchant-row { display: flex; margin-bottom: 0.65rem; }
  .fanchant-input {
    flex: 1;
    min-width: 180px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.16);
    color: #f5f3ff;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
  }
  .fanchant-input::placeholder { color: #7d78a0; }
  .fanchant-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .fc-link {
    font-size: 0.85rem;
    color: #ff8fbe;
    text-decoration: none;
    background: rgba(255,95,162,0.08);
    border: 1px solid rgba(255,95,162,0.3);
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
  }
  .fc-link:hover { background: rgba(255,95,162,0.16); }
</style>
