---
import type { ConcertEvent } from '../lib/events';
import { badgeText } from '../lib/openPhase';
import { isNewlyAdded, hasRecentUpdate, hasTicketsOnSale, isBuzzing, ticketOpenStages, hasUpcomingOpen, TICKETING_DIFFICULTY_LABEL as DIFFICULTY_LABEL } from '../lib/events';
interface Props { event: ConcertEvent }
const { event } = Astro.props;

function fmt(iso: string) {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getMonth() + 1}.${d.getDate()}`;
}
const dateLabel = event.startDate === event.endDate
  ? fmt(event.startDate)
  : `${fmt(event.startDate)} - ${fmt(event.endDate)}`;

const status = event.status ?? 'scheduled';
const STATUS_LABEL: Record<string, string> = {
  postponed: '연기',
  cancelled: '취소',
};
const isFresh = hasRecentUpdate(event);
const isNew = isNewlyAdded(event);
const onSale = hasTicketsOnSale(event);
// 오픈 전(또는 막 열린) 공연은 "예매 오픈중" 대신 티켓오픈 D-배지를 보여준다 (브라우저가 시각에 맞춰 갱신).
const openStages = ticketOpenStages(event).map(({ label, at, until }) => ({ label, at, until }));
const openSoon = (event.status ?? 'scheduled') === 'scheduled' && hasUpcomingOpen(event);
const openBadge = openSoon ? badgeText(openStages, Date.now()) : null;
const buzzing = isBuzzing(event);
---
<a class={`event-card${status !== 'scheduled' ? ' is-' + status : ''}${buzzing ? ' is-buzzing' : ''}`} href={`/events/${event.id}/`}>
  {event.posterUrl && (
    <img class="thumb" src={event.posterUrl} alt="" loading="lazy" width="60" height="82" />
  )}
  <div class="dday-badge" data-dday-start={event.startDate} data-dday-end={event.endDate} data-status={status}>—</div>
  <div class="info">
    <h3>{event.artist}</h3>
    <p class="meta"><strong class="meta-date">{dateLabel}</strong> · <strong class="meta-venue">{event.venue}</strong> ({event.city}) · {event.genre}</p>
  </div>
  <div class="tags">
    {buzzing && <span class="buzz-tag">화제</span>}
    {isNew && <span class="new-tag">신규</span>}
    {isFresh && !isNew && <span class="fresh-tag">새 소식</span>}
    {status !== 'scheduled' && <span class={`status-tag status-${status}`}>{STATUS_LABEL[status]}</span>}
    {openSoon && openBadge && (
      <span class={`open-tag${openBadge.hot ? ' is-hot' : ''}`} data-open-badge data-stages={JSON.stringify(openStages)} data-onsale={onSale ? '1' : '0'}>{openBadge.text}</span>
    )}
    {status === 'scheduled' && onSale && !openSoon && <span class="ticket-tag">예매 오픈중</span>}
    {status === 'scheduled' && !onSale && !openSoon && event.ticketingAnnounced && <span class="announced-tag">티켓오픈 예정</span>}
    {event.ticketingDifficulty && (
      <span class={`difficulty-tag difficulty-${event.ticketingDifficulty}`}>{DIFFICULTY_LABEL[event.ticketingDifficulty]}</span>
    )}
  </div>
  <button
    class="bookmark-btn"
    data-bookmark-id={event.id}
    aria-label={`${event.artist} 찜하기`}
    aria-pressed="false"
  >♡</button>
</a>
<style>
  .event-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 2.1rem 0.9rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }
  .event-card .bookmark-btn {
    position: absolute;
    top: 0.7rem;
    right: 0.4rem;
  }
  .difficulty-tag {
    font-size: 0.72rem;
    padding: 0.22rem 0.55rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  .difficulty-hard { color: #ff8a8a; border: 1px solid rgba(255,138,138,0.4); background: rgba(255,138,138,0.1); }
  .difficulty-normal { color: #7ed957; border: 1px solid rgba(126,217,87,0.4); background: rgba(126,217,87,0.1); }
  .difficulty-easy { color: #ffd166; border: 1px solid rgba(255,209,102,0.4); background: rgba(255,209,102,0.1); }
  .event-card:hover { background: rgba(255,255,255,0.04); }
  .event-card:hover h3 { color: #ff5fa2; }
  .thumb {
    flex-shrink: 0;
    width: 60px;
    height: 82px;
    object-fit: cover;
    border-radius: 6px;
    background: rgba(255,255,255,0.05);
  }
  @media (max-width: 420px) {
    .thumb { width: 48px; height: 66px; }
  }
  .event-card.is-buzzing {
    background: rgba(255,255,255,0.04);
    border-bottom-color: rgba(255, 95, 162, 0.35);
  }
  .event-card.is-buzzing:hover { background: rgba(255,255,255,0.04); }
  .buzz-tag {
    font-size: 0.72rem;
    font-weight: 800;
    color: #0e0e10;
    background: #ff5fa2;
    padding: 0.22rem 0.6rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  .event-card.is-postponed,
  .event-card.is-cancelled { opacity: 0.6; }
  .event-card.is-cancelled h3 { text-decoration: line-through; text-decoration-color: rgba(255,107,107,0.6); }
  .info { flex: 1; min-width: 0; }
  h3 { margin: 0 0 0.2rem; font-size: 1.05rem; transition: color 0.15s; }
  .meta { margin: 0; color: #8f8f97; font-size: 0.92rem; }
  .meta-date, .meta-venue { color: #ededea; font-weight: 700; }
  .tags { display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem; flex-shrink: 0; }
  .ticket-tag {
    font-size: 0.75rem;
    color: #c9c9cf;
    border: 1px solid rgba(255,255,255,0.4);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  .announced-tag {
    font-size: 0.75rem;
    color: #c9c9cf;
    border: 1px dashed rgba(255,255,255,0.5);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  .new-tag {
    font-size: 0.72rem;
    font-weight: 800;
    color: #0e0e10;
    background: #f4f4f0;
    padding: 0.22rem 0.6rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  .fresh-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: #0e0e10;
    background: #ff5fa2;
    padding: 0.22rem 0.6rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  .status-tag {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  .status-tag.status-postponed { color: #ffb84c; border: 1px solid rgba(255,184,76,0.4); background: rgba(255,184,76,0.1); }
  .status-tag.status-cancelled { color: #ff6b6b; border: 1px solid rgba(255,107,107,0.4); background: rgba(255,107,107,0.1); }
  .open-tag { font-size: 0.75rem; font-weight: 700; color: #ededea; border: 1px solid rgba(255,255,255,0.45); padding: 0.25rem 0.6rem; border-radius: 6px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .open-tag.is-hot { color: #ff5fa2; border-color: #ff5fa2; }
</style>

<script>
  import '../lib/openBadges.client';
</script>
