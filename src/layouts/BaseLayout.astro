---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewEventBanner from '../components/NewEventBanner.astro';
import { SITE_TITLE, SITE_DESCRIPTION, ADSENSE_PUBLISHER_ID } from '../consts';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean; // 전폭 레이아웃(랜딩): main 폭 제한을 풀고 섹션이 직접 컨테이너를 잡는다
  image?: string; // absolute or site-relative URL for og:image / twitter:image (e.g. event poster)
  noindex?: boolean; // 개인용 페이지(내 찜 등)는 검색 색인에서 뺀다
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION, image, wide = false, noindex = false } = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(image, Astro.site).toString() : undefined;
const isHome = Astro.url.pathname === '/';
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: new URL('/', Astro.site).toString(),
  description: SITE_DESCRIPTION,
  inLanguage: 'ko-KR',
};
const adsenseEnabled = ADSENSE_PUBLISHER_ID.length > 0;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="iL2NwKpeKybcFdSpo6P5jImaxaWELMUhdq5GZ3VfYKQ" />
    <meta name="naver-site-verification" content="a4ba26df2c873f2fbe0afb1502163a53a5daa9f9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 홈 화면에 추가(PWA): 설치하면 앱처럼 열리고 티켓오픈 푸시 알림을 받을 수 있다 -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#11100e" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="직관냥" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- Pretendard was already in the CSS font stack but never actually
         loaded, so non-Mac/iOS visitors (Windows, Android) silently fell
         back to Segoe UI / Roboto. Self-hosting via jsDelivr fixes that. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />}
    {adsenseEnabled && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUBLISHER_ID}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <Header wide={wide} />
    <NewEventBanner />
    <main class={wide ? 'wide' : undefined}>
      <slot />
    </main>
    <Footer wide={wide} />

    <!-- Vercel Analytics 활성화 컴포넌트 -->
    <Analytics />
    <!-- Vercel Speed Insights: 모바일 비중이 높아 실사용자 속도(RES/LCP/INP)를 측정 -->
    <SpeedInsights />

    <script>
      import '../lib/outboundTrack';
    </script>

    <script>
      // 서비스워커 등록 - 푸시 알림 수신용(페이지 캐시는 하지 않는다). 실패해도 사이트 이용엔 영향 없다.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
      }
    </script>

    <script>
      // Client-side D-day computation so it stays accurate between rebuilds/redeploys.
      function updateDday() {
        const todayISO = new Date().toISOString().slice(0, 10);
        document.querySelectorAll('[data-dday-start]').forEach((el) => {
          const status = el.getAttribute('data-status') || 'scheduled';
          // A countdown to a date that's no longer happening is misleading, so
          // postponed/cancelled shows get a status label instead of D-day math.
          if (status === 'postponed') {
            el.textContent = '연기';
            el.classList.add('is-postponed');
            return;
          }
          if (status === 'cancelled') {
            el.textContent = '취소';
            el.classList.add('is-cancelled');
            return;
          }
          const start = el.getAttribute('data-dday-start') || '';
          const end = el.getAttribute('data-dday-end') || start;
          let label = '';
          if (end < todayISO) {
            label = '종료';
          } else if (start <= todayISO && todayISO <= end) {
            label = 'D-DAY';
          } else {
            const diffDays = Math.ceil(
              (new Date(start + 'T00:00:00').getTime() - new Date(todayISO + 'T00:00:00').getTime()) /
                86400000
            );
            label = `D-${diffDays}`;
          }
          el.textContent = label;
          if (label === '종료') el.classList.add('is-past');
          if (/^D-\d+$/.test(label) && Number(label.slice(2)) <= 7) el.classList.add('is-soon');
          if (label === 'D-DAY') el.classList.add('is-today');
        });
      }
      updateDday();

      // Local, login-free '찜하기' (bookmark) - stored client-side only, per
      // browser. Any element with [data-bookmark-id] anywhere on the site
      // becomes a toggle button; state syncs across every button for the same
      // id (e.g. if the same event ever appears twice on a page) and a
      // 'bookmarks:changed' event fires so a listing page (index.astro) can
      // re-filter a '찜한 공연만' view without a full reload.
      const BOOKMARK_KEY = 'krconcerts:bookmarks';
      function getBookmarks() {
        try {
          const raw = localStorage.getItem(BOOKMARK_KEY);
          return raw ? JSON.parse(raw) : [];
        } catch {
          return [];
        }
      }
      function setBookmarks(ids) {
        try {
          localStorage.setItem(BOOKMARK_KEY, JSON.stringify(ids));
        } catch {
          // Storage unavailable (private mode, disabled cookies, etc.) - bookmark
          // buttons just won't persist between visits; not worth surfacing an error.
        }
      }
      function syncBookmarkButtons() {
        const ids = new Set(getBookmarks());
        document.querySelectorAll('[data-bookmark-id]').forEach((btn) => {
          const id = btn.getAttribute('data-bookmark-id') || '';
          const active = ids.has(id);
          btn.classList.toggle('is-bookmarked', active);
          btn.setAttribute('aria-pressed', String(active));
          btn.textContent = active ? '♥' : '♡';
        });
      }
      document.querySelectorAll('[data-bookmark-id]').forEach((btn) => {
        btn.addEventListener('click', (ev) => {
          ev.preventDefault();
          ev.stopPropagation();
          const id = btn.getAttribute('data-bookmark-id') || '';
          const ids = getBookmarks();
          const idx = ids.indexOf(id);
          if (idx >= 0) ids.splice(idx, 1);
          else ids.push(id);
          setBookmarks(ids);
          syncBookmarkButtons();
          window.dispatchEvent(new CustomEvent('bookmarks:changed'));
        });
      });
      syncBookmarkButtons();
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* 바탕: 따뜻한 검정과 크림 */
    --bg: #11100e;
    --bg-deep: #0a0908;
    --card: #1a1816;
    --card-2: #221f1c;
    --line: #2e2a26;
    --line-2: #403b35;
    --fg: #f3eee4;
    --fg-2: #cfc8bb;
    --fg-3: #aaa397;
    --muted: #8c867c;
    --faint: #6e685f;
    --ink: #11100e; /* 색 면 위에 올리는 글자 */
    /* 포인트 색 셋. 역할을 섞어 쓰지 않는다 */
    --cheese: #ef8a3a; /* 날짜, D-day, 링크·호버 */
    --eye: #d3d65c; /* 티켓오픈 시각, 신규 */
    --pink: #ff5fa2; /* 예매 버튼만 */
    --pink-hi: #ff7bb2;
    --btn: var(--fg); /* 예매가 아닌 주요 버튼 */
    --btn-hi: #ffffff;
    --accent: var(--cheese);
    --accent-2: var(--fg-2);
    --max-width: 880px;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--fg); font-family: Pretendard, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.65; }
  main { max-width: var(--max-width); margin: 0 auto; padding: 2rem 1.25rem 4rem; }
  main.wide { max-width: none; padding: 0 0 4rem; }
  /* 페이지 제목 공통 톤 (랜딩/목록과 통일) */
  main > h1, main .intro > h1, main .page-intro > h1 { margin: 0 0 0.9rem; font-size: clamp(2.1rem, 6vw, 3.6rem); line-height: 1; letter-spacing: -.055em; font-weight: 900; }
  main .intro, main .page-intro { margin-bottom: 1.6rem; }
  a { color: var(--accent-2); }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
  h1, h2, h3 { line-height: 1.3; }
  .dday-badge {
    display: inline-block;
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--fg);
    min-width: 3rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .dday-badge.is-soon { background: rgba(239, 138, 58, 0.16); color: var(--cheese); }
  .dday-badge.is-today { background: var(--cheese); color: var(--ink); }
  .dday-badge.is-past { background: rgba(255,255,255,0.08); color: var(--muted); }
  .dday-badge.is-postponed { background: rgba(255, 184, 76, 0.18); color: #ffb84c; }
  .dday-badge.is-cancelled { background: rgba(255, 95, 95, 0.18); color: #ff6b6b; }
  .bookmark-btn {
    all: unset;
    cursor: pointer;
    font-size: 1.15rem;
    line-height: 1;
    color: var(--muted);
    padding: 0.15rem 0.3rem;
  }
  .bookmark-btn.is-bookmarked { color: var(--pink); }
  .bookmark-btn:hover { color: var(--pink); }
</style>