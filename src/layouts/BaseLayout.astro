---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, ADSENSE_PUBLISHER_ID } from '../consts';

interface Props {
  title?: string;
  description?: string;
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const adsenseEnabled = ADSENSE_PUBLISHER_ID.length > 0;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    {adsenseEnabled && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUBLISHER_ID}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // Client-side D-day computation so it stays accurate between rebuilds/redeploys.
      function updateDday() {
        const todayISO = new Date().toISOString().slice(0, 10);
        document.querySelectorAll('[data-dday-start]').forEach((el) => {
          const status = el.getAttribute('data-status') || 'scheduled';
          // A countdown to a date that's no longer happening is misleading, so
          // postponed/cancelled shows get a status label instead of D-day math.
          if (status === 'postponed') {
            el.textContent = '연기';
            el.classList.add('is-postponed');
            return;
          }
          if (status === 'cancelled') {
            el.textContent = '취소';
            el.classList.add('is-cancelled');
            return;
          }
          const start = el.getAttribute('data-dday-start') || '';
          const end = el.getAttribute('data-dday-end') || start;
          let label = '';
          if (end < todayISO) {
            label = '종료';
          } else if (start <= todayISO && todayISO <= end) {
            label = 'D-DAY';
          } else {
            const diffDays = Math.ceil(
              (new Date(start + 'T00:00:00').getTime() - new Date(todayISO + 'T00:00:00').getTime()) /
                86400000
            );
            label = `D-${diffDays}`;
          }
          el.textContent = label;
          if (label === '종료') el.classList.add('is-past');
          if (label === 'D-DAY') el.classList.add('is-today');
        });
      }
      updateDday();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #101018;
    --fg: #f5f3ff;
    --muted: #a9a4c9;
    --accent: #ff5fa2;
    --accent-2: #6ee7ff;
    --card: #181826;
    --max-width: 880px;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--fg); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Pretendard, Roboto, sans-serif; line-height: 1.65; }
  main { max-width: var(--max-width); margin: 0 auto; padding: 2rem 1.25rem 4rem; }
  a { color: var(--accent-2); }
  h1, h2, h3 { line-height: 1.3; }
  .dday-badge {
    display: inline-block;
    font-weight: 800;
    font-size: 0.9rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 95, 162, 0.15);
    color: var(--accent);
    min-width: 3.5rem;
    text-align: center;
  }
  .dday-badge.is-today { background: var(--accent); color: #101018; }
  .dday-badge.is-past { background: rgba(255,255,255,0.08); color: var(--muted); }
  .dday-badge.is-postponed { background: rgba(255, 184, 76, 0.18); color: #ffb84c; }
  .dday-badge.is-cancelled { background: rgba(255, 95, 95, 0.18); color: #ff6b6b; }
</style>
