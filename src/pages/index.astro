---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { upcomingEvents, allGenres, allCities, monthLabel } from '../lib/events';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const events = upcomingEvents();
const genres = allGenres();
const cities = allCities();

const groups: { label: string; items: typeof events }[] = [];
for (const e of events) {
  const label = monthLabel(e.startDate);
  let group = groups.find((g) => g.label === label);
  if (!group) {
    group = { label, items: [] };
    groups.push(group);
  }
  group.items.push(e);
}
---
<BaseLayout>
  <section class="intro">
    <h1>{SITE_TITLE}</h1>
    <p>{SITE_DESCRIPTION}</p>
  </section>

  {genres.length > 0 && (
    <div class="filter-group">
      <p class="filter-caption">장르</p>
      <div class="filters" id="genre-filters">
        <button class="chip active" data-genre="all">전체</button>
        {genres.map((g) => (
          <button class="chip" data-genre={g}>{g}</button>
        ))}
      </div>
    </div>
  )}

  {cities.length > 0 && (
    <div class="filter-group">
      <p class="filter-caption">지역</p>
      <div class="filters" id="city-filters">
        <button class="chip active" data-city="all">전체 지역</button>
        {cities.map((c) => (
          <button class="chip" data-city={c}>{c}</button>
        ))}
      </div>
    </div>
  )}

  <div class="search-row">
    <input
      type="search"
      id="artist-search"
      class="search-input"
      placeholder="아티스트 검색 (초성 가능: 예) ㅂㄴㅂ, ㅂㄷ)"
      autocomplete="off"
    />
    <button class="chip fav-toggle" id="fav-toggle" type="button">🤍 찜한 공연만</button>
  </div>

  <AdSlot slot="home-top" />

  {groups.map((group) => (
    <section class="month-group">
      <h2>{group.label}</h2>
      {group.items.map((e) => (
        <div class="card-wrap" data-genre={e.genre} data-city={e.city} data-id={e.id}>
          <EventCard event={e} />
        </div>
      ))}
    </section>
  ))}

  {events.length === 0 && <p>현재 등록된 예정 공연이 없습니다. 곧 업데이트할게요.</p>}
</BaseLayout>

<script>
  const genreButtons = document.querySelectorAll<HTMLButtonElement>('#genre-filters .chip');
  const cityButtons = document.querySelectorAll<HTMLButtonElement>('#city-filters .chip');
  const cards = document.querySelectorAll<HTMLElement>('.card-wrap');
  const searchInput = document.querySelector<HTMLInputElement>('#artist-search');
  const favToggle = document.querySelector<HTMLButtonElement>('#fav-toggle');

  let activeGenre = 'all';
  let activeCity = 'all';
  let activeSearch = '';
  let favoritesOnly = false;

  // Hangul 초성(initial-consonant) search, e.g. "ㅂㄴㅂ" should match "back number".
  const CHOSUNG = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
  function getChosung(str: string) {
    let out = '';
    for (const ch of str) {
      const code = ch.charCodeAt(0) - 0xac00;
      out += code >= 0 && code <= 11171 ? CHOSUNG[Math.floor(code / 588)] : ch;
    }
    return out;
  }
  function isChosungQuery(q: string) {
    return /^[ㄱ-ㅎ]+$/.test(q.replace(/\s/g, ''));
  }
  function matchesSearch(artistText: string, query: string) {
    if (!query) return true;
    const q = query.trim();
    if (isChosungQuery(q)) return getChosung(artistText).includes(q);
    return artistText.toLowerCase().includes(q.toLowerCase());
  }
  function getBookmarkSet() {
    try {
      const raw = localStorage.getItem('krconcerts:bookmarks');
      return new Set<string>(raw ? JSON.parse(raw) : []);
    } catch {
      return new Set<string>();
    }
  }

  function applyFilters() {
    const bookmarks = favoritesOnly ? getBookmarkSet() : null;
    cards.forEach((card) => {
      const genreMatch = activeGenre === 'all' || card.dataset.genre === activeGenre;
      const cityMatch = activeCity === 'all' || card.dataset.city === activeCity;
      const artistText = card.querySelector('h3')?.textContent ?? '';
      const searchMatch = matchesSearch(artistText, activeSearch);
      const favMatch = !bookmarks || bookmarks.has(card.dataset.id ?? '');
      card.style.display = genreMatch && cityMatch && searchMatch && favMatch ? '' : 'none';
    });
    document.querySelectorAll<HTMLElement>('.month-group').forEach((section) => {
      const anyVisible = Array.from(section.querySelectorAll<HTMLElement>('.card-wrap')).some(
        (c) => c.style.display !== 'none'
      );
      section.style.display = anyVisible ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', () => {
    activeSearch = searchInput.value;
    applyFilters();
  });

  favToggle?.addEventListener('click', () => {
    favoritesOnly = !favoritesOnly;
    favToggle.classList.toggle('active', favoritesOnly);
    favToggle.textContent = favoritesOnly ? '❤️ 찜한 공연만' : '🤍 찜한 공연만';
    applyFilters();
  });

  // A heart toggled from a card re-runs the favorites-only filter live.
  window.addEventListener('bookmarks:changed', () => {
    if (favoritesOnly) applyFilters();
  });

  genreButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      genreButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeGenre = btn.dataset.genre ?? 'all';
      applyFilters();
    });
  });

  cityButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      cityButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCity = btn.dataset.city ?? 'all';
      applyFilters();
    });
  });
</script>

<style>
  .intro { padding: 1rem 0 1.5rem; }
  .intro h1 { font-size: 2rem; margin-bottom: 0.5rem; }
  .intro p { color: #d8d5ef; }
  .filter-group { margin-bottom: 1.25rem; }
  .filter-caption {
    font-size: 0.72rem;
    color: #7d78a0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.4rem;
  }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .search-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.25rem; }
  .search-input {
    flex: 1;
    min-width: 200px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    color: #f5f3ff;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
  }
  .search-input::placeholder { color: #7d78a0; }
  .fav-toggle.active { background: #ff5fa2; border-color: #ff5fa2; color: #101018; font-weight: 700; }
  .chip {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: #d8d5ef;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .chip.active { background: #ff5fa2; border-color: #ff5fa2; color: #101018; font-weight: 700; }
  .month-group { margin-top: 2rem; }
  .month-group h2 { font-size: 1.15rem; color: #a9a4c9; margin-bottom: 0.25rem; }
</style>
