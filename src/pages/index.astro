---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HomeSlider from '../components/HomeSlider.astro';
import ToolStrip from '../components/ToolStrip.astro';
import PosterCard from '../components/PosterCard.astro';
import AdSlot from '../components/AdSlot.astro';
import RecentIssues from '../components/RecentIssues.astro';
import { upcomingEvents, upcomingTicketOpens } from '../lib/events';

const all = upcomingEvents();
const next = all.slice(0, 8);
const opens = upcomingTicketOpens(4);

function fmtOpen(iso: string) {
  const d = new Date(iso);
  const kst = new Date(d.getTime() + 9 * 3600_000);
  const m = kst.getUTCMonth() + 1;
  const day = kst.getUTCDate();
  const h = kst.getUTCHours();
  const mi = String(kst.getUTCMinutes()).padStart(2, '0');
  return `${m}월 ${day}일 ${h}:${mi}`;
}
---
<BaseLayout title="내한공연·페스티벌 일정 캘린더 D-day" description="해외 아티스트 내한공연과 페스티벌 일정을 D-day로 한눈에. 티켓오픈 일정, 예매처, 구역별 시야, 공연장 셔틀버스, MD 굿즈 정보까지 직관냥에서 확인하세요.">
  <Hero />

  <HomeSlider />

  <ToolStrip />

  {opens.length > 0 && (
    <section class="soon" aria-labelledby="soon-title">
      <div class="sec-head">
        <h2 id="soon-title">곧 티켓이 열려요</h2>
        <a href="/ticket-open/">티켓오픈 일정 전체 →</a>
      </div>
      <ul>
        {opens.map((e) => (
          <li>
            <a href={`/events/${e.id}/`}>
              <span class="soon-when">{fmtOpen(e.ticketOpenAt as string)}</span>
              <span class="soon-name">{e.artist}</span>
              <span class="soon-venue">{e.venue}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <AdSlot slot="home-top" />

  <section class="next" aria-labelledby="next-title">
    <div class="sec-head">
      <h2 id="next-title">다가오는 공연</h2>
      <a href="/events/">전체 {all.length}개 보기 →</a>
    </div>
    <div class="poster-grid">
      {next.map((e) => (
        <div class="card-wrap"><PosterCard event={e} /></div>
      ))}
    </div>
    <div class="more">
      <a class="more-btn" href="/events/">전체 공연 일정 보기 <span>({all.length})</span></a>
    </div>
  </section>

  <RecentIssues limit={3} heading="공연 소식·이슈" compact />
</BaseLayout>

<style>
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.8rem; }
  .sec-head h2 { margin: 0; font-size: 1.15rem; }
  .sec-head a { font-size: 0.85rem; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .sec-head a:hover { color: var(--fg); }

  .soon { margin: 0 0 2.5rem; }
  .soon ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(255,255,255,0.1); }
  .soon li a { display: grid; grid-template-columns: 8.5rem 1fr auto; gap: 0.8rem; align-items: baseline; padding: 0.75rem 0.2rem; border-bottom: 1px solid rgba(255,255,255,0.1); color: var(--fg); text-decoration: none; }
  .soon li a:hover { background: rgba(255,255,255,0.04); }
  .soon-when { font-size: 0.86rem; font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
  .soon-name { font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .soon-venue { font-size: 0.82rem; color: var(--muted); white-space: nowrap; }

  .next { margin: 0 0 2.5rem; }
  .poster-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem 0.85rem; }
  @media (min-width: 640px) { .poster-grid { grid-template-columns: repeat(4, 1fr); } }
  .more { margin-top: 1.4rem; text-align: center; }
  .more-btn { display: inline-block; padding: 0.75rem 1.6rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.3); color: var(--fg); text-decoration: none; font-weight: 700; }
  .more-btn:hover { border-color: #fff; }
  .more-btn span { color: var(--muted); font-weight: 600; }

  @media (max-width: 560px) {
    .soon li a { grid-template-columns: 1fr; gap: 0.1rem; }
    .soon-venue { display: none; }
  }
</style>
