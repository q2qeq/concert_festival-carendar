---
import BaseLayout from '../layouts/BaseLayout.astro';
import PosterCard from '../components/PosterCard.astro';
import Hero from '../components/Hero.astro';
import Mascot from '../components/Mascot.astro';
import CalendarNav from '../components/CalendarNav.astro';
import AdSlot from '../components/AdSlot.astro';
import { upcomingEvents, allGenres, allCities, monthLabel } from '../lib/events';
import { SITE_TITLE } from '../consts';

const events = upcomingEvents();
const genres = allGenres();
const cities = allCities();

const groups: { label: string; items: typeof events }[] = [];
for (const e of events) {
  const label = monthLabel(e.startDate);
  let group = groups.find((g) => g.label === label);
  if (!group) {
    group = { label, items: [] };
    groups.push(group);
  }
  group.items.push(e);
}
---
<BaseLayout>
  <h1 class="visually-hidden">{SITE_TITLE}</h1>

  <Hero />

  <CalendarNav events={events} />

  <section id="find" class="finder">
    <div class="filter-row">
      {genres.length > 0 && (
        <select class="filter-select" id="genre-select" aria-label="장르 선택">
          <option value="all">전체 장르</option>
          {genres.map((g) => (
            <option value={g}>{g}</option>
          ))}
        </select>
      )}

      {cities.length > 0 && (
        <select class="filter-select" id="city-select" aria-label="지역 선택">
          <option value="all">전체 지역</option>
          {cities.map((c) => (
            <option value={c}>{c}</option>
          ))}
        </select>
      )}

      <button class="chip fav-toggle" id="fav-toggle" type="button">♡ 찜한 공연만</button>
    </div>

    <input
      type="search"
      id="artist-search"
      class="search-input"
      placeholder="아티스트 검색 (초성 가능: 예) ㅂㄴㅂ, ㅂㄷ)"
      autocomplete="off"
    />
  </section>

  <AdSlot slot="home-top" />

  <section id="listing" class="listing">
    {groups.map((group) => (
      <div class="month-group">
        <h3>{group.label}</h3>
        <div class="poster-grid">
          {group.items.map((e) => (
            <div class="card-wrap" data-genre={e.genre} data-city={e.city} data-id={e.id} data-date={e.startDate}>
              <PosterCard event={e} />
            </div>
          ))}
        </div>
      </div>
    ))}

    {events.length === 0 && (
      <p class="empty">
        <Mascot size={40} pose="wave" />
        현재 등록된 예정 공연이 없습니다. 곧 업데이트할게요.
      </p>
    )}
  </section>
</BaseLayout>

<script>
  const genreSelect = document.querySelector<HTMLSelectElement>('#genre-select');
  const citySelect = document.querySelector<HTMLSelectElement>('#city-select');
  const cards = document.querySelectorAll<HTMLElement>('.card-wrap');
  const searchInput = document.querySelector<HTMLInputElement>('#artist-search');
  const favToggle = document.querySelector<HTMLButtonElement>('#fav-toggle');

  let activeGenre = 'all';
  let activeCity = 'all';
  let activeSearch = '';
  let favoritesOnly = false;

  // Hangul 초성(initial-consonant) search, e.g. "ㅂㄴㅂ" should match "back number".
  const CHOSUNG = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
  function getChosung(str: string) {
    let out = '';
    for (const ch of str) {
      const code = ch.charCodeAt(0) - 0xac00;
      out += code >= 0 && code <= 11171 ? CHOSUNG[Math.floor(code / 588)] : ch;
    }
    return out;
  }
  function isChosungQuery(q: string) {
    return /^[ㄱ-ㅎ]+$/.test(q.replace(/\s/g, ''));
  }
  function matchesSearch(artistText: string, query: string) {
    if (!query) return true;
    const q = query.trim();
    if (isChosungQuery(q)) return getChosung(artistText).includes(q);
    return artistText.toLowerCase().includes(q.toLowerCase());
  }
  function getBookmarkSet() {
    try {
      const raw = localStorage.getItem('krconcerts:bookmarks');
      return new Set<string>(raw ? JSON.parse(raw) : []);
    } catch {
      return new Set<string>();
    }
  }

  function applyFilters() {
    const bookmarks = favoritesOnly ? getBookmarkSet() : null;
    cards.forEach((card) => {
      const genreMatch = activeGenre === 'all' || card.dataset.genre === activeGenre;
      const cityMatch = activeCity === 'all' || card.dataset.city === activeCity;
      const artistText = card.querySelector('h3')?.textContent ?? '';
      const searchMatch = matchesSearch(artistText, activeSearch);
      const favMatch = !bookmarks || bookmarks.has(card.dataset.id ?? '');
      card.style.display = genreMatch && cityMatch && searchMatch && favMatch ? '' : 'none';
    });
    document.querySelectorAll<HTMLElement>('.month-group').forEach((section) => {
      const anyVisible = Array.from(section.querySelectorAll<HTMLElement>('.card-wrap')).some(
        (c) => c.style.display !== 'none'
      );
      section.style.display = anyVisible ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', () => {
    activeSearch = searchInput.value;
    applyFilters();
  });

  favToggle?.addEventListener('click', () => {
    favoritesOnly = !favoritesOnly;
    favToggle.classList.toggle('active', favoritesOnly);
    favToggle.textContent = favoritesOnly ? '♥ 찜한 공연만' : '♡ 찜한 공연만';
    applyFilters();
  });

  // A heart toggled from a card re-runs the favorites-only filter live.
  window.addEventListener('bookmarks:changed', () => {
    if (favoritesOnly) applyFilters();
  });

  genreSelect?.addEventListener('change', () => {
    activeGenre = genreSelect.value || 'all';
    applyFilters();
  });

  citySelect?.addEventListener('change', () => {
    activeCity = citySelect.value || 'all';
    applyFilters();
  });
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .finder {
    scroll-margin-top: 5rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 0.85rem 0.95rem 0.95rem;
    margin-bottom: 1.5rem;
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.65rem;
  }
  .filter-select {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    color: #f5f3ff;
    padding: 0.4rem 0.6rem;
    border-radius: 999px;
    font-size: 0.78rem;
    cursor: pointer;
  }
  .search-input {
    flex: 1;
    min-width: 180px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    color: #f5f3ff;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: 0.82rem;
  }
  .search-input::placeholder { color: #7d78a0; }
  .fav-toggle.active { background: #ff5fa2; border-color: #ff5fa2; color: #101018; font-weight: 700; }
  .chip {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: #d8d5ef;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.76rem;
    cursor: pointer;
  }
  .chip.active { background: #ff5fa2; border-color: #ff5fa2; color: #101018; font-weight: 700; }

  .listing { scroll-margin-top: 5rem; }
  .month-group { margin-top: 2rem; }
  .month-group h3 { font-size: 1.05rem; font-weight: 700; color: #a9a4c9; margin-bottom: 0.7rem; }
  .poster-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem 0.85rem;
  }
  @media (min-width: 640px) { .poster-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .poster-grid { grid-template-columns: repeat(4, 1fr); gap: 1.3rem 1rem; } }
  .empty { color: var(--muted); display: flex; align-items: center; gap: 0.6rem; }
</style>
