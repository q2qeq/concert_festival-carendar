---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSpotlight from '../components/HomeSpotlight.astro';
import ToolStrip from '../components/ToolStrip.astro';
import PosterCard from '../components/PosterCard.astro';
import AdSlot from '../components/AdSlot.astro';
import RecentIssues from '../components/RecentIssues.astro';
import { upcomingEvents, upcomingTicketOpens } from '../lib/events';

const all = upcomingEvents();
const next = all.slice(0, 8);
const opens = upcomingTicketOpens(4);

function when(iso: string) {
  const k = new Date(new Date(iso).getTime() + 9 * 3600_000);
  const md = `${k.getUTCMonth() + 1}.${String(k.getUTCDate()).padStart(2, '0')}`;
  const hm = `${String(k.getUTCHours()).padStart(2, '0')}:${String(k.getUTCMinutes()).padStart(2, '0')}`;
  return { md, hm };
}
---
<BaseLayout wide title="내한공연·페스티벌 일정 캘린더 D-day" description="해외 아티스트 내한공연과 페스티벌 일정을 D-day로 한눈에. 티켓오픈 일정, 예매처, 구역별 시야, 공연장 셔틀버스, MD 굿즈 정보까지 직관냥에서 확인하세요.">
  <HomeSpotlight />

  <div class="wrap">
    <ToolStrip />

    {opens.length > 0 && (
      <section class="soon" aria-labelledby="soon-title">
        <div class="sec-head">
          <h2 id="soon-title" class="mono">TICKET OPEN SOON</h2>
          <a href="/ticket-open/">티켓오픈 일정 →</a>
        </div>
        <div class="rows">
          {opens.map((e) => {
            const w = when(e.ticketOpenAt as string);
            return (
              <a href={`/events/${e.id}/`}>
                <span class="t mono">{w.md} <span>{w.hm}</span></span>
                <span class="nm">{e.artist}</span>
                <span class="v">{e.venue}</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="cal-sub" aria-label="캘린더 구독" data-track-kind="calendar">
      <p><b>티켓오픈 알림을 캘린더로 받아보세요.</b> 한 번 추가하면 오픈 하루 전·10분 전에 알려주고, 새 공연도 자동으로 들어와요. 가입은 필요 없어요.</p>
      <div class="cal-acts">
        <a class="cal-btn" href={`https://calendar.google.com/calendar/r?cid=${encodeURIComponent('webcal://jikgwannyang.com/calendar/ticket-open.ics')}`} target="_blank" rel="noopener noreferrer">구글 캘린더에 구독</a>
        <a class="cal-link" href="/calendar/">애플 캘린더·장르별 구독 →</a>
      </div>
    </section>

    <AdSlot slot="home-top" />

    <section class="next" aria-labelledby="next-title">
      <div class="sec-head">
        <h2 id="next-title" class="mono">UPCOMING</h2>
        <a href="/events/">전체 {all.length}개 →</a>
      </div>
      <div class="poster-grid">
        {next.map((e) => (
          <div class="card-wrap"><PosterCard event={e} /></div>
        ))}
      </div>
      <a class="more" href="/events/">전체 공연 일정 보기 →</a>
    </section>

    <RecentIssues limit={3} heading="공연 소식·이슈" compact />
  </div>
</BaseLayout>

<style>
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 2.8rem 0 0.8rem; border-bottom: 1px solid #2a2a30; }
  .sec-head h2 { margin: 0; font-size: 0.82rem; letter-spacing: .14em; color: #8f8f97; font-weight: 700; }
  .sec-head a { font-size: 0.85rem; color: #8f8f97; text-decoration: none; white-space: nowrap; }
  .sec-head a:hover { color: #f4f4f0; }

  .cal-sub { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin: 2rem 0 0; padding: 1.2rem 1.4rem; border: 1px solid #2a2a30; border-radius: 4px; }
  .cal-sub p { margin: 0; flex: 1 1 22rem; color: #c4c4c8; font-size: 0.92rem; line-height: 1.65; }
  .cal-sub p b { color: #f4f4f0; }
  .cal-acts { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.2rem; }
  .cal-btn { padding: 0.6rem 1.1rem; border-radius: 4px; background: #ff5fa2; color: #0e0e10; font-weight: 800; font-size: 0.9rem; text-decoration: none; white-space: nowrap; }
  .cal-btn:hover { background: #ff7db4; }
  .cal-link { color: #8f8f97; font-size: 0.85rem; text-decoration: none; white-space: nowrap; }
  .cal-link:hover { color: #f4f4f0; }

  .rows a { display: grid; font-size: clamp(1.7rem, 4.2vw, 3.6rem); grid-template-columns: 6.9em 1fr auto; column-gap: 1.4rem; align-items: baseline; padding: 1.3rem 0; border-bottom: 1px solid #2a2a30; color: #f4f4f0; text-decoration: none; transition: padding-left .2s, color .2s; }
  .rows a:hover { padding-left: .8rem; color: #ff5fa2; }
  .rows .t { font-size: 1em; white-space: nowrap; font-weight: 900; letter-spacing: -.05em; line-height: 1; }
  .rows .t span { color: #8f8f97; }
  .rows .nm { font-size: clamp(1.05rem, 2vw, 1.6rem); font-weight: 700; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rows .v { font-size: 0.82rem; color: #8f8f97; white-space: nowrap; }

  .poster-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem 0.9rem; padding-top: 1.4rem; }
  @media (min-width: 720px) { .poster-grid { grid-template-columns: repeat(4, 1fr); } }
  .more { display: block; margin: 2.2rem 0 0.5rem; padding: 1.4rem; border: 1px solid #3a3a42; border-radius: 4px; text-align: center; font-weight: 900; font-size: 1.2rem; color: #f4f4f0; text-decoration: none; }
  .more:hover { background: #ff5fa2; border-color: #ff5fa2; color: #0e0e10; }

  @media (max-width: 560px) {
    .rows a { grid-template-columns: 1fr; row-gap: 0.2rem; }
    .rows .v { display: none; }
  }
</style>
