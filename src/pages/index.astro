---
import BaseLayout from '../layouts/BaseLayout.astro';
import PosterCard from '../components/PosterCard.astro';
import Hero from '../components/Hero.astro';
import AdSlot from '../components/AdSlot.astro';
import { upcomingEvents, allGenres, allCities, monthLabel } from '../lib/events';
import { SITE_TITLE } from '../consts';

const events = upcomingEvents();
const genres = allGenres();
const cities = allCities();

const groups: { label: string; items: typeof events }[] = [];
for (const e of events) {
  const label = monthLabel(e.startDate);
  let group = groups.find((g) => g.label === label);
  if (!group) {
    group = { label, items: [] };
    groups.push(group);
  }
  group.items.push(e);
}
---
<BaseLayout>
  <h1 class="visually-hidden">{SITE_TITLE}</h1>

  <Hero />

  <nav class="quicknav" aria-label="바로가기">
    <a href="#find">공연 찾기</a>
    <a href="#listing">전체 일정 ({events.length})</a>
    <a href="/blog">이슈</a>
  </nav>

  <section id="find" class="finder">
    <h2>공연 찾기</h2>

    {genres.length > 0 && (
      <div class="filter-group">
        <p class="filter-caption">장르</p>
        <div class="filters" id="genre-filters">
          <button class="chip active" data-genre="all">전체</button>
          {genres.map((g) => (
            <button class="chip" data-genre={g}>{g}</button>
          ))}
        </div>
      </div>
    )}

    {cities.length > 0 && (
      <div class="filter-group">
        <p class="filter-caption">지역</p>
        <div class="filters" id="city-filters">
          <button class="chip active" data-city="all">전체 지역</button>
          {cities.map((c) => (
            <button class="chip" data-city={c}>{c}</button>
          ))}
        </div>
      </div>
    )}

    <div class="search-row">
      <input
        type="search"
        id="artist-search"
        class="search-input"
        placeholder="아티스트 검색 (초성 가능: 예) ㅂㄴㅂ, ㅂㄷ)"
        autocomplete="off"
      />
      <button class="chip fav-toggle" id="fav-toggle" type="button">♡ 찜한 공연만</button>
    </div>
  </section>

  <AdSlot slot="home-top" />

  <section id="listing" class="listing">
    <div class="listing-header">
      <h2>전체 일정</h2>
      <span class="listing-count">{events.length}건</span>
    </div>

    {groups.map((group) => (
      <div class="month-group">
        <h3>{group.label}</h3>
        <div class="poster-grid">
          {group.items.map((e) => (
            <div class="card-wrap" data-genre={e.genre} data-city={e.city} data-id={e.id}>
              <PosterCard event={e} />
            </div>
          ))}
        </div>
      </div>
    ))}

    {events.length === 0 && <p class="empty">현재 등록된 예정 공연이 없습니다. 곧 업데이트할게요.</p>}
  </section>
</BaseLayout>

<script>
  const genreButtons = document.querySelectorAll<HTMLButtonElement>('#genre-filters .chip');
  const cityButtons = document.querySelectorAll<HTMLButtonElement>('#city-filters .chip');
  const cards = document.querySelectorAll<HTMLElement>('.card-wrap');
  const searchInput = document.querySelector<HTMLInputElement>('#artist-search');
  const favToggle = document.querySelector<HTMLButtonElement>('#fav-toggle');

  let activeGenre = 'all';
  let activeCity = 'all';
  let activeSearch = '';
  let favoritesOnly = false;

  // Hangul 초성(initial-consonant) search, e.g. "ㅂㄴㅂ" should match "back number".
  const CHOSUNG = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
  function getChosung(str: string) {
    let out = '';
    for (const ch of str) {
      const code = ch.charCodeAt(0) - 0xac00;
      out += code >= 0 && code <= 11171 ? CHOSUNG[Math.floor(code / 588)] : ch;
    }
    return out;
  }
  function isChosungQuery(q: string) {
    return /^[ㄱ-ㅎ]+$/.test(q.replace(/\s/g, ''));
  }
  function matchesSearch(artistText: string, query: string) {
    if (!query) return true;
    const q = query.trim();
    if (isChosungQuery(q)) return getChosung(artistText).includes(q);
    return artistText.toLowerCase().includes(q.toLowerCase());
  }
  function getBookmarkSet() {
    try {
      const raw = localStorage.getItem('krconcerts:bookmarks');
      return new Set<string>(raw ? JSON.parse(raw) : []);
    } catch {
      return new Set<string>();
    }
  }

  function applyFilters() {
    const bookmarks = favoritesOnly ? getBookmarkSet() : null;
    cards.forEach((card) => {
      const genreMatch = activeGenre === 'all' || card.dataset.genre === activeGenre;
      const cityMatch = activeCity === 'all' || card.dataset.city === activeCity;
      const artistText = card.querySelector('h3')?.textContent ?? '';
      const searchMatch = matchesSearch(artistText, activeSearch);
      const favMatch = !bookmarks || bookmarks.has(card.dataset.id ?? '');
      card.style.display = genreMatch && cityMatch && searchMatch && favMatch ? '' : 'none';
    });
    document.querySelectorAll<HTMLElement>('.month-group').forEach((section) => {
      const anyVisible = Array.from(section.querySelectorAll<HTMLElement>('.card-wrap')).some(
        (c) => c.style.display !== 'none'
      );
      section.style.display = anyVisible ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', () => {
    activeSearch = searchInput.value;
    applyFilters();
  });

  favToggle?.addEventListener('click', () => {
    favoritesOnly = !favoritesOnly;
    favToggle.classList.toggle('active', favoritesOnly);
    favToggle.textContent = favoritesOnly ? '♥ 찜한 공연만' : '♡ 찜한 공연만';
    applyFilters();
  });

  // A heart toggled from a card re-runs the favorites-only filter live.
  window.addEventListener('bookmarks:changed', () => {
    if (favoritesOnly) applyFilters();
  });

  genreButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      genreButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeGenre = btn.dataset.genre ?? 'all';
      applyFilters();
    });
  });

  cityButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      cityButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCity = btn.dataset.city ?? 'all';
      applyFilters();
    });
  });
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .quicknav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .quicknav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
  }
  .quicknav a:hover { color: #fff; border-color: rgba(255,255,255,0.25); }

  .finder {
    scroll-margin-top: 5rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 0.85rem 0.95rem 0.95rem;
    margin-bottom: 1.5rem;
  }
  .finder h2 {
    margin: 0 0 0.65rem;
    font-size: 0.85rem;
    color: var(--fg);
  }
  .filter-group { margin-bottom: 0.65rem; }
  .filter-group:last-of-type { margin-bottom: 0; }
  .filter-caption {
    font-size: 0.66rem;
    color: #7d78a0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.3rem;
  }
  .filters { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .search-row { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.75rem; }
  .search-input {
    flex: 1;
    min-width: 180px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    color: #f5f3ff;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: 0.82rem;
  }
  .search-input::placeholder { color: #7d78a0; }
  .fav-toggle.active { background: #ff5fa2; border-color: #ff5fa2; color: #101018; font-weight: 700; }
  .chip {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: #d8d5ef;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.76rem;
    cursor: pointer;
  }
  .chip.active { background: #ff5fa2; border-color: #ff5fa2; color: #101018; font-weight: 700; }

  .listing { scroll-margin-top: 5rem; }
  .listing-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .listing-header h2 { margin: 0; font-size: 1.3rem; }
  .listing-count { color: var(--muted); font-size: 0.85rem; }
  .month-group { margin-top: 2rem; }
  .month-group h3 { font-size: 1.05rem; font-weight: 700; color: #a9a4c9; margin-bottom: 0.7rem; }
  .poster-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem 0.85rem;
  }
  @media (min-width: 640px) { .poster-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .poster-grid { grid-template-columns: repeat(4, 1fr); gap: 1.3rem 1rem; } }
  .empty { color: var(--muted); }
</style>
