---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
---
<BaseLayout title="페이지를 찾을 수 없어요" description="요청하신 페이지를 찾을 수 없어요. 전체 공연 일정이나 홈으로 이동해 주세요.">
  <section class="nf">
    <Mascot size={140} pose="shock" />
    <h1>찾는 페이지가 없어요</h1>
    <p>주소가 바뀌었거나 이미 종료된 공연일 수 있어요.</p>
    <div class="nf-cta">
      <a class="primary" href="/events/">전체 공연 일정 보기</a>
      <a href="/">홈으로</a>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 3rem 0; gap: 0.5rem; }
  .nf h1 { margin: 0.8rem 0 0; font-size: 1.5rem; }
  .nf p { margin: 0; color: var(--muted); }
  .nf-cta { display: flex; gap: 0.6rem; margin-top: 1.2rem; }
  .nf-cta a { padding: 0.6rem 1.1rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2); color: var(--fg); text-decoration: none; font-weight: 600; font-size: 0.92rem; }
  .nf-cta a.primary { background: var(--accent); border-color: var(--accent); color: #0e0e10; }
</style>
