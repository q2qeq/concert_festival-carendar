---
// 월별/연도별 내한공연 일정 - "12월 내한공연 일정", "2027 내한공연 일정" 같은 포괄 검색어를 받는 페이지.
// 데이터는 events.json에서 빌드 때 계산한다(지어낸 문구 없음). 취소 공연은 제외.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { scheduleEvents, schedulePeriods, periodLabel, ticketStatusText, hasTicketsOnSale } from '../../lib/events';
import type { ConcertEvent } from '../../lib/events';
import { SITE_URL } from '../../../astro.config.mjs';

export function getStaticPaths() {
  const { months, years } = schedulePeriods();
  return [...months, ...years].map((period) => ({ params: { period } }));
}

const { period } = Astro.params as { period: string };
const { months, years } = schedulePeriods();
const isYear = /^\d{4}$/.test(period);
const label = periodLabel(period);
const list = scheduleEvents().filter((e) => e.startDate.startsWith(period)).sort((a, b) => a.startDate.localeCompare(b.startDate));
const n = list.length;

const WD = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
function dayParts(e: ConcertEvent) {
  const s = new Date(e.startDate + 'T00:00:00');
  const md = `${String(s.getMonth() + 1).padStart(2, '0')}.${String(s.getDate()).padStart(2, '0')}`;
  const end = e.endDate !== e.startDate ? `–${e.endDate.slice(8)}` : '';
  return { md: md + end, wd: WD[s.getDay()] };
}

const onSale = list.filter((e) => hasTicketsOnSale(e)).length;
const soon = list.filter((e) => ticketStatusText(e).tone === 'soon');
const genreCount = new Map<string, number>();
for (const e of list) genreCount.set(e.genre, (genreCount.get(e.genre) ?? 0) + 1);
const genres = Array.from(genreCount.entries()).sort((a, b) => b[1] - a[1]);

// 연도 페이지: 월별 요약
const byMonth = isYear
  ? months.filter((m) => m.startsWith(period)).map((m) => {
      const items = list.filter((e) => e.startDate.startsWith(m));
      return { m, items };
    })
  : [];

// 월 페이지: 달력 그리드(일요일 시작). 날짜별로 그날 시작하는 공연을 담는다.
const gridWeeks: { date: string | null; day: number; items: ConcertEvent[] }[][] = [];
if (!isYear && n >= 0) {
  const y = Number(period.slice(0, 4)), m = Number(period.slice(5, 7));
  const first = new Date(Date.UTC(y, m - 1, 1));
  const daysInMonth = new Date(Date.UTC(y, m, 0)).getUTCDate();
  const cells: { date: string | null; day: number; items: ConcertEvent[] }[] = [];
  for (let i = 0; i < first.getUTCDay(); i++) cells.push({ date: null, day: 0, items: [] });
  for (let d = 1; d <= daysInMonth; d++) {
    const iso = `${period}-${String(d).padStart(2, '0')}`;
    cells.push({ date: iso, day: d, items: list.filter((e) => e.startDate === iso) });
  }
  while (cells.length % 7 !== 0) cells.push({ date: null, day: 0, items: [] });
  for (let i = 0; i < cells.length; i += 7) gridWeeks.push(cells.slice(i, i + 7));
}
const firstOfDay = new Set<string>();
const rowId = (e: ConcertEvent) => (firstOfDay.has(e.startDate) ? undefined : (firstOfDay.add(e.startDate), `d-${e.startDate}`));

// 월 페이지: 이전/다음 달
const idx = months.indexOf(period);
const prev = !isYear && idx > 0 ? months[idx - 1] : null;
const next = !isYear && idx >= 0 && idx < months.length - 1 ? months[idx + 1] : null;

const title = isYear ? `${period} 내한공연·페스티벌 일정 총정리 (${n}개)` : `${label} 내한공연·페스티벌 일정 (${n}개) - 티켓오픈·예매처`;
const description = isYear
  ? `${period}년에 예정된 내한공연과 페스티벌 ${n}개를 월별로 정리했어요. 티켓오픈 일정과 예매 상태, 공연장을 한눈에 확인하세요.`
  : `${label}에 열리는 내한공연·페스티벌 ${n}개를 날짜순으로 정리했어요. 예매 오픈 여부, 티켓오픈 일시, 공연장을 한눈에 확인하세요.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  numberOfItems: n,
  itemListElement: list.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/events/${e.id}/`, SITE_URL).toString(),
    name: e.artist,
  })),
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <p class="breadcrumb"><a href="/schedule/">← 월별 일정</a></p>

  <section class="head">
    <h1>{label} 내한공연 일정</h1>
    <p class="count mono"><b>{n}</b>개 공연</p>
  </section>

  <p class="lead">
    {label}에 열리는 내한공연·페스티벌 {n}개를 {isYear ? '월별로' : '날짜순으로'} 정리했어요.
    예매 상태는 확인된 것만 표시하고, 아직 공지가 없는 공연은 "예매 일정 미정"으로 둬요.
  </p>

  <ul class="facts mono">
    <li>예매 오픈중 <b>{onSale}</b></li>
    <li>티켓오픈 예정 <b>{soon.length}</b></li>
    {genres.slice(0, 4).map(([g, c]) => <li>{g} <b>{c}</b></li>)}
  </ul>

  {isYear ? (
    <section class="months">
      {byMonth.map(({ m, items }) => (
        <a class="mcard" href={`/schedule/${m}/`}>
          <span class="mm mono">{m.slice(5)}<small>월</small></span>
          <span class="mn mono">{items.length}개</span>
          <span class="mt">{items.slice(0, 3).map((e) => e.artist.replace(/\s*\(.*$/, '')).join(' · ')}{items.length > 3 ? ` 외 ${items.length - 3}` : ''}</span>
        </a>
      ))}
    </section>
  ) : (
    <>
      {soon.length > 0 && (
        <section class="soonbox">
          <h2 class="sec mono">곧 열리는 티켓</h2>
          <ul>
            {soon.map((e) => (
              <li><a href={`/events/${e.id}/`}>{e.artist.replace(/\s*\(.*$/, '')} <span class="mono">{ticketStatusText(e).text.replace('티켓오픈 ', '')}</span></a></li>
            ))}
          </ul>
        </section>
      )}

      <AdSlot slot="home-top" />

      {gridWeeks.length > 0 && (
        <table class="cal" aria-label={`${label} 달력`}>
          <thead><tr>{['일', '월', '화', '수', '목', '금', '토'].map((d, i) => <th class={i === 0 ? 'sun' : ''}>{d}</th>)}</tr></thead>
          <tbody>
            {gridWeeks.map((w) => (
              <tr>
                {w.map((c) => (
                  <td class={c.date ? (c.items.length ? 'has' : '') : 'blank'} data-date={c.date ?? undefined}>
                    {c.date && <a class="dn mono" href={c.items.length ? `#d-${c.date}` : undefined}>{c.day}</a>}
                    {c.items.slice(0, 2).map((e) => <a class="ce" href={`/events/${e.id}/`} title={e.artist}>{e.artist.replace(/\s*\(.*$/, '')}</a>)}
                    {c.items.length > 2 && <a class="more" href={`#d-${c.date}`}>+{c.items.length - 2}</a>}
                    {c.items.length > 0 && <span class="dot mono" aria-hidden="true">{c.items.length}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <ol class="rows">
        {list.map((e) => {
          const d = dayParts(e);
          const st = ticketStatusText(e);
          return (
            <li id={rowId(e)}>
              <a class="row" href={`/events/${e.id}/`}>
                <span class="d mono">{d.md}<small>{d.wd}</small></span>
                {e.posterUrl ? <img class="th" src={e.posterUrl} alt="" loading="lazy" width="56" height="76" /> : <span class="th ph" aria-hidden="true"></span>}
                <span class="b"><strong>{e.artist}</strong><em>{e.venue} · {e.city} · {e.genre}</em></span>
                <span class={`st st-${st.tone}`}>{st.text}</span>
              </a>
            </li>
          );
        })}
      </ol>
      {n === 0 && <p class="empty">이 달에 등록된 공연이 아직 없어요.</p>}
    </>
  )}

  <nav class="pager" aria-label="다른 기간">
    {prev && <a href={`/schedule/${prev}/`}>← {periodLabel(prev)}</a>}
    {next && <a class="r" href={`/schedule/${next}/`}>{periodLabel(next)} →</a>}
  </nav>

  <section class="others">
    <h2 class="sec mono">더 보기</h2>
    <div class="chips">
      {years.map((y) => <a href={`/schedule/${y}/`} class={y === period ? 'on' : ''}>{y}년 전체</a>)}
      {months.filter((m) => !isYear || m.startsWith(period)).map((m) => <a href={`/schedule/${m}/`} class={m === period ? 'on' : ''}>{periodLabel(m)}</a>)}
    </div>
    <p class="links"><a href="/events/">전체 공연 일정(필터·검색)</a> · <a href="/ticket-open/">티켓오픈 일정</a></p>
  </section>
</BaseLayout>
<script>
  // 오늘 칸 표시(정적 빌드라 날짜는 브라우저에서 계산)
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(new Date());
  document.querySelector(`.cal td[data-date="${today}"]`)?.classList.add('today');
</script>

<style>
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin: 0 0 1rem; }
  .head h1 { margin: 0; font-size: clamp(2rem, 6vw, 3.6rem); line-height: 1; letter-spacing: -.055em; font-weight: 900; }
  .count { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .count b { color: var(--cheese); font-size: 1.1rem; letter-spacing: 0; margin-right: 0.1rem; }
  .lead { max-width: 40rem; color: var(--fg-3); margin: 0 0 1rem; }
  .facts { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.6rem; padding: 0; font-size: 0.78rem; }
  .facts li { padding: 0.3rem 0.65rem; border: 1px solid var(--line-2); border-radius: 4px; color: var(--fg-2); }
  .facts b { color: var(--fg); margin-left: 0.3rem; }
  .sec { margin: 0 0 0.6rem; font-size: 1.05rem; letter-spacing: -.02em; color: var(--fg); font-weight: 800; }
  .soonbox { margin: 0 0 1.6rem; padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: 4px; }
  .soonbox ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  .soonbox a { color: var(--fg); text-decoration: none; font-weight: 600; }
  .soonbox a span { color: var(--cheese); font-size: 0.82rem; margin-left: 0.3rem; }
  .cal { width: 100%; table-layout: fixed; border-collapse: collapse; margin: 0 0 1.8rem; }
  .cal th { padding: 0.4rem 0; font-size: 0.72rem; font-weight: 500; color: var(--muted); text-align: left; border-bottom: 1px solid var(--line); }
  .cal th.sun { color: var(--cheese); }
  .cal td { vertical-align: top; height: 5.4rem; padding: 0.35rem 0.4rem; border-bottom: 1px solid var(--card-2); border-right: 1px solid var(--card-2); overflow: hidden; position: relative; }
  .cal td:last-child { border-right: 0; }
  .cal td.blank { background: rgba(255,255,255,0.015); }
  .cal td.today { background: rgba(239, 138, 58,0.08); }
  .cal .dn { display: block; font-size: 0.78rem; color: var(--muted); text-decoration: none; margin-bottom: 0.2rem; }
  .cal td.has .dn { color: var(--fg); font-weight: 700; }
  .cal .ce { display: block; font-size: 0.72rem; line-height: 1.3; color: var(--fg); text-decoration: none; padding: 0.1rem 0.25rem; margin-bottom: 2px; background: rgba(255,255,255,0.07); border-left: 2px solid var(--cheese); border-radius: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cal .ce:hover { background: rgba(255,255,255,0.14); }
  .cal .more { font-size: 0.7rem; color: var(--muted); text-decoration: none; }
  .cal .dot { display: none; }
  .rows li:target .row { background: rgba(239, 138, 58,0.08); }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 6.2rem 3.5rem 1fr auto; gap: 1rem; align-items: center; padding: 0.9rem 0.2rem; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; transition: background .15s; }
  .row:hover { background: rgba(255,255,255,0.03); }
  .d { white-space: nowrap; font-size: 1.25rem; font-weight: 900; letter-spacing: -.04em; line-height: 1.1; }
  .d small { display: block; font-size: 0.66rem; font-weight: 500; color: var(--muted); }
  .th { width: 3.5rem; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 2px; background: var(--card); }
  .th.ph { display: block; }
  .b { min-width: 0; }
  .b strong { display: block; font-size: 1.02rem; line-height: 1.3; }
  .b em { display: block; font-style: normal; font-size: 0.82rem; color: var(--muted); margin-top: 0.15rem; }
  .st { font-size: 0.76rem; font-weight: 700; white-space: nowrap; color: var(--muted); }
  .st-on { color: var(--fg); }
  .st-soon { color: var(--eye); }
  .months { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.8rem; }
  .mcard { display: flex; flex-direction: column; gap: 0.4rem; padding: 1rem; border: 1px solid var(--line); border-radius: 4px; color: inherit; text-decoration: none; }
  .mcard:hover { border-color: var(--cheese); }
  .mm { font-size: 2.4rem; font-weight: 900; letter-spacing: -.06em; line-height: 1; }
  .mm small { font-size: 0.9rem; letter-spacing: 0; margin-left: 0.2rem; color: var(--muted); }
  .mn { font-size: 0.72rem; color: var(--cheese); }
  .mt { font-size: 0.86rem; color: var(--fg-3); line-height: 1.5; }
  .pager { display: flex; justify-content: space-between; margin: 1.8rem 0 0; }
  .pager a { color: var(--fg); text-decoration: none; font-weight: 700; }
  .pager a:hover { color: var(--cheese); }
  .others { margin-top: 2.4rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.9rem; }
  .chips a { padding: 0.4rem 0.75rem; border: 1px solid var(--line-2); border-radius: 4px; color: var(--fg-2); text-decoration: none; font-size: 0.84rem; }
  .chips a.on { background: var(--btn); border-color: var(--btn); color: var(--ink); font-weight: 700; }
  .links { color: var(--muted); font-size: 0.86rem; }
  .links a { color: var(--fg-2); }
  .empty { color: var(--muted); }
  .breadcrumb a { color: var(--muted); font-size: 0.9rem; text-decoration: none; }
  @media (max-width: 600px) {
    .cal td { height: 3.2rem; padding: 0.25rem; }
    .cal .ce, .cal .more { display: none; }
    .cal .dot { display: inline-block; position: absolute; right: 0.3rem; bottom: 0.25rem; min-width: 1.15rem; padding: 0 0.3rem; text-align: center; font-size: 0.7rem; font-weight: 700; color: var(--ink); background: var(--btn); border-radius: 3px; }
    .row { grid-template-columns: 4.6rem 3rem 1fr; gap: 0.7rem; }
    .d { font-size: 1.05rem; }
    .th { width: 3rem; }
    .st { grid-column: 3; justify-self: start; margin-top: -0.2rem; }
  }
</style>
