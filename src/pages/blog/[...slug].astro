---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import RecentIssues from '../../components/RecentIssues.astro';
import { relatedPosts } from '../../lib/posts';
import OpenCountdown from '../../components/OpenCountdown.astro';
import PostToolShelf from '../../components/PostToolShelf.astro';
import { events, ticketOpenStages, hasUpcomingOpen } from '../../lib/events';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const related = await relatedPosts(post, 4);

// 본문에 링크된 공연 중 티켓오픈 시각이 확인된 공연 (본문에 나온 순서, 최대 2개).
// 오픈 전이면 카운트다운, 오픈 후 30일 안이면 취소표 안내로 글 상단에 붙는다.
const body = post.body ?? '';
const nowMs = Date.now();
const openEvents = events
  .map((e) => ({ e, pos: body.indexOf(`/events/${e.id}/`) }))
  .filter(({ e, pos }) => {
    if (pos < 0) return false;
    const stages = ticketOpenStages(e);
    if (stages.length === 0) return false;
    const last = new Date(stages[stages.length - 1].at).getTime();
    return hasUpcomingOpen(e, nowMs) || nowMs - last < 30 * 86400_000;
  })
  .sort((a, b) => a.pos - b.pos)
  .slice(0, 2)
  .map(({ e }) => e);

function fmt(d: Date) {
  return `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일`;
}
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.body?.match(/!\[[^\]]*\]\((\/[^)\s]+)\)/)?.[1]}>
  <article class="post">
    <p class="breadcrumb"><a href="/blog/">← 이슈 목록</a></p>
    <p class="post-date">{fmt(post.data.pubDate)}</p>
    <h1>{post.data.title}</h1>
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="post-tags">
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    )}

    {openEvents.map((e) => <OpenCountdown event={e} variant="post" />)}

    <AdSlot slot="post-top" />

    <div class="prose">
      <Content />
    </div>

    <PostToolShelf body={body} />

    <AdSlot slot="post-bottom" />

    <RecentIssues posts={related} heading="다른 이슈도 읽어보세요" />
  </article>
</BaseLayout>

<style>
  .breadcrumb a { color: #8f8f97; font-size: 0.9rem; text-decoration: none; }
  .post-date { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .1em; color: #8f8f97; font-size: 0.78rem; margin: 1.4rem 0 0.7rem; }
  h1 { margin: 0 0 0.9rem; font-size: clamp(1.8rem, 4.6vw, 2.9rem); line-height: 1.12; letter-spacing: -.045em; font-weight: 900; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.5rem; }
  .tag {
    font-size: 0.75rem;
    color: #c9c9cf;
    border: 1px solid rgba(255,255,255,0.35);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }
  .prose { margin-top: 1.5rem; color: #dcdcd8; font-size: 1.02rem; line-height: 1.8; }
  .prose :global(h2) { font-size: 1.25rem; margin: 2rem 0 0.75rem; color: #ededea; }
  .prose :global(p) { margin: 0 0 1rem; }
  .prose :global(a) { color: #ff5fa2; text-decoration: underline; }
  .prose :global(img) { display: block; max-width: min(100%, 420px); height: auto; margin: 1.2rem 0 0.4rem; border-radius: 8px; }
  .prose :global(p > em:only-child) { color: #8f8f97; font-size: 0.85rem; }
  .prose :global(ul) { margin: 0 0 1rem; padding-left: 1.3rem; }
  .prose :global(hr) { border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 2rem 0; }
  .prose :global(em) { color: #8f8f97; font-size: 0.9rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; margin: 0 0 1rem; }
</style>
