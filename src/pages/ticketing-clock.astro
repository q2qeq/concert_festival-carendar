---
import BaseLayout from '../layouts/BaseLayout.astro';
import { upcomingTicketOpens, onSaleEvents } from '../lib/events';

const opens = upcomingTicketOpens(8);
const onSale = onSaleEvents(6);
const shortDate = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getMonth() + 1}.${d.getDate()}`;
};

const PLATFORMS = [
  { id: 'yes24', name: 'YES24 티켓', url: 'https://ticket.yes24.com' },
  { id: 'melon', name: '멜론티켓', url: 'https://ticket.melon.com' },
  { id: 'nol', name: 'NOL(인터파크)', url: 'https://nol.interpark.com/ticket' },
  { id: 'ticketlink', name: '티켓링크', url: 'https://www.ticketlink.co.kr' },
];

// FAQ 구조화 데이터 - "nol 티켓팅 시계"처럼 특정 예매 사이트 이름 + "티켓팅 시계"로
// 검색해도 이 페이지가 어떤 사이트에나 쓸 수 있는 범용 도구라는 걸 검색엔진이
// 바로 이해하도록. 실제로 페이지에 보이는 문구와 동일한 내용만 담는다.
const faq = [
  {
    q: 'YES24·멜론티켓·NOL·티켓링크 아무 사이트에나 써도 되나요?',
    a: '네. 특정 예매처 전용이 아니라 표준시에 맞춘 범용 정밀 시계예요. 원하는 예매 사이트를 아래에서 선택해두면 그 사이트 탭을 바로 열 수 있어요.',
  },
  {
    q: '자동 예매(매크로)인가요?',
    a: '아니에요. 자동으로 클릭하거나 새로고침하지 않아요. 정확한 시각을 보여줘서 수동 클릭 타이밍을 맞추는 데만 도움을 줘요.',
  },
  {
    q: '예매 시계는 예매 사이트의 서버시간과 같은가요?',
    a: '완전히 같다고 보장할 수는 없어요. 이 시계는 표준시 서버와 동기화한 값이라 내 기기 시계보다는 믿을 만하지만, 예매 사이트 서버 시계와는 수십~수백 ms 차이가 날 수 있어요. 오픈 시각은 항상 예매처 공지를 기준으로 하세요.',
  },
  {
    q: '티켓팅 몇 분 전부터 준비하면 되나요?',
    a: '로그인·본인인증·결제수단 등록은 전날까지 끝내두고, 오픈 10분 전에는 예매 페이지와 시계를 띄워두는 걸 권장해요. 사이트마다 대기 방식이 달라서 정확한 안내는 해당 공연의 예매처 공지를 확인하세요.',
  },
  {
    q: '대기 번호가 나오면 새로고침해도 되나요?',
    a: '대기열이 있는 사이트에서는 새로고침이나 뒤로 가기를 하면 순번이 초기화될 수 있다고 안내하는 경우가 많아요. 대기 화면에서는 그대로 기다리라는 안내를 따르세요.',
  },
  {
    q: '티켓팅 연습은 어디서 할 수 있나요?',
    a: '직관냥의 티켓팅 연습 페이지에서 예매 버튼 타이밍과 좌석 선택을 연습할 수 있어요. 실제 예매와는 다르니 손풀기용으로만 생각해주세요.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="티켓팅 시계·예매 시계 - 서버시간 (YES24·멜론티켓·NOL·티켓링크)"
  description="콘서트 예매 시계·티켓팅 시계. YES24·멜론티켓·NOL(인터파크)·티켓링크 서버시간 기준으로 내 기기 오차를 보정해 밀리초 단위로 보여줘요. 오픈 일정 확인과 티켓팅 연습까지."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <h1>티켓팅 시계</h1>
  <p class="intro">
    표준시 서버와 동기화한 정밀 시계로, 예매 오픈 순간에 맞춰 클릭하도록 도와드려요.
    <strong>자동 예매·매크로가 아니라 수동 클릭을 돕는 시계</strong>예요.
  </p>

  <div id="countdown-banner" class="countdown-banner" hidden>
    <span id="cd-artist"></span> 티켓 오픈까지
    <span id="cd-time" class="cd-time">--:--:--</span>
  </div>

  <div class="clock-card">
    <div id="clock-display" class="clock-display" aria-live="off">--:--:--.---</div>
    <div id="clock-date" class="clock-date"></div>
    <div id="sync-status" class="sync-status">동기화하는 중...</div>
  </div>

  <section class="schedule" aria-label="티켓오픈 일정">
    <h2>곧 오픈하는 티켓</h2>
    {opens.length > 0 ? (
      <ul class="sched-list" id="open-list">
        {opens.map((e) => (
          <li data-open-at={e.ticketOpenAt}>
            <a class="sched-main" href={`/ticketing-clock?open=${encodeURIComponent(e.ticketOpenAt as string)}&artist=${encodeURIComponent(e.artist)}`}>
              <strong>{e.artist}</strong>
              <span class="sched-when">{e.ticketOpenDate ?? e.ticketOpenAt}</span>
            </a>
            <span class="sched-left" data-left></span>
            <a class="sched-side" href={`/events/${e.id}/`}>상세</a>
            <button class="bookmark-btn" type="button" data-bookmark-id={e.id} aria-label={`${e.artist} 찜하기`} aria-pressed="false">♡</button>
          </li>
        ))}
      </ul>
    ) : (
      <p class="sched-empty">지금 확인된 오픈 예정 티켓은 없어요. 매일 아침 티켓 사이트 공지를 확인해서 새 오픈이 보이는 대로 여기에 올려요.</p>
    )}

    {onSale.length > 0 && (
      <>
        <h2>지금 예매 중인 공연</h2>
        <ul class="sched-list">
          {onSale.map((e) => (
            <li>
              <a class="sched-main" href={`/events/${e.id}/`}>
                <strong>{e.artist}</strong>
                <span class="sched-when">{shortDate(e.startDate)} · {e.venue}</span>
              </a>
              <button class="bookmark-btn" type="button" data-bookmark-id={e.id} aria-label={`${e.artist} 찜하기`} aria-pressed="false">♡</button>
            </li>
          ))}
        </ul>
      </>
    )}
    <p class="sched-more"><a href="/my/">♥ 내 찜 목록에서 한눈에 보기</a> · <a href="/practice/">🎫 티켓팅 연습으로 손풀기</a></p>
  </section>

  <details class="calibrate">
    <summary>수동 보정 (동기화가 안 될 때)</summary>
    <div class="calibrate-row">
      <input type="time" id="calibrate-input" step="1" />
      <button type="button" id="calibrate-btn">지금 이 시각으로 맞추기</button>
    </div>
  </details>

  <h2>예매 사이트 선택</h2>
  <p class="platform-help">예매하는 사이트를 골라두면 바로가기 버튼이 그 사이트를 기억해요.</p>
  <div class="platform-grid" id="platform-grid">
    {PLATFORMS.map((p) => (
      <div class="platform-item" data-platform={p.id}>
        <button type="button" class="platform-select" data-platform-select={p.id} aria-pressed="false">
          <span class="platform-check" aria-hidden="true">✓</span> {p.name}
        </button>
        <a class="platform-open" href={p.url} target="_blank" rel="noopener noreferrer">열기 ↗</a>
      </div>
    ))}
  </div>
  <p id="platform-active-note" class="platform-active-note" hidden></p>

  <section class="guide" id="guide" aria-label="티켓팅 가이드">
    <h2>티켓팅 가이드</h2>
    <p class="guide-lead">예매 시계로 시간을 맞춘 다음에도 결과를 가르는 건 준비 상태예요. 어느 예매처든 공통으로 챙기면 좋은 것들을 순서대로 정리했어요.</p>

    <h3>1. 오픈 전날까지</h3>
    <ul>
      <li><strong>회원가입·로그인 상태 확인</strong> - 오픈 직전에 비밀번호를 찾느라 시간을 쓰는 경우가 의외로 많아요.</li>
      <li><strong>본인인증·결제수단 등록</strong> - 카드와 간편결제를 미리 등록해두면 결제 단계가 훨씬 빨라져요. 무통장입금은 입금 기한이 짧을 수 있어요.</li>
      <li><strong>선예매 조건 확인</strong> - 팬클럽 선예매는 가입 기간이나 회원 인증이 필요한 경우가 있어서, 조건은 공연 공지에서 확인하세요.</li>
      <li><strong>좌석 우선순위 정하기</strong> - 가고 싶은 구역을 1~3순위까지 정해두면 선택 화면에서 망설이지 않아요. 공연장 시야는 <a href="/venues/">공연장 페이지</a>에서 볼 수 있어요.</li>
      <li><strong>매수와 수령 방법</strong> - 1인 예매 가능 매수, 현장수령인지 배송인지, 취소 수수료 기준도 미리 봐두세요.</li>
    </ul>

    <h3>2. 오픈 10분 전</h3>
    <ul>
      <li>예매 페이지를 열어두고, 이 시계로 정각을 확인하세요. 오픈 시각은 예매처 공지를 기준으로 삼고, 시계는 타이밍 보조용으로 쓰세요.</li>
      <li>가능하면 안정적인 네트워크(유선 또는 신호가 좋은 Wi-Fi)를 쓰고, 다른 앱의 다운로드와 영상 재생은 꺼두세요.</li>
      <li>같은 계정으로 여러 기기·탭을 동시에 쓰면 접속이 막히는 사이트도 있어서, 예매처의 안내를 확인하세요.</li>
      <li>팝업 차단과 자동 번역 같은 브라우저 기능이 예매 창을 방해하지 않는지 확인하세요.</li>
    </ul>

    <h3>3. 오픈 순간</h3>
    <ul>
      <li>예매 버튼이 활성화되는 시점은 사이트와 공연마다 달라요. 정각 직전에 대기하고, 버튼이 열리면 바로 누르는 게 기본이에요.</li>
      <li>대기열이 나오면 새로고침하지 말고 안내를 따르세요. 순번이 초기화될 수 있다고 안내하는 사이트가 많아요.</li>
      <li>보안문자와 좌석 선택 화면에서는 1~3순위로 정해둔 구역을 빠르게 훑으세요. 좌석을 잡은 뒤 결제 제한시간이 짧으니, 결제 정보는 미리 준비해두세요.</li>
    </ul>

    <h3>4. 실패했다면</h3>
    <ul>
      <li><strong>취소표(취켓팅)</strong> - 결제 기한이 지난 좌석이나 취소된 좌석이 다시 풀리는 시간대에 예매 페이지를 확인해보세요. 취소 마감 직전에 많이 풀리는 편이에요.</li>
      <li><strong>추가 오픈 확인</strong> - 일반 예매 후 추가 좌석이 열리는 공연도 있어서, 직관냥의 <a href="#open-list">오픈 일정</a>과 공연 공지를 함께 확인해보세요.</li>
      <li>다음 티켓팅에 대비해 <a href="/practice/">티켓팅 연습</a>으로 손을 풀어두세요.</li>
    </ul>

    <h3>꼭 알아둘 것: 매크로와 암표</h3>
    <p>자동 예매 프로그램(매크로)과 부정 거래는 처벌 대상이고, 2026년 8월 28일부터는 부정구매와 부정판매 자체를 처벌하는 규정이 시행됐어요. 이 시계는 정확한 시간만 보여줄 뿐 자동으로 아무것도 하지 않아요. 배경이 궁금하다면 <a href="/blog/post9/">암표방지법 시행과 티켓팅 이야기</a>를 읽어보세요.</p>

    <h3>예매처별 바로가기</h3>
    <p>예매 사이트는 위의 <a href="#platform-grid">예매 사이트 선택</a>에서 고를 수 있어요. 공연별 예매처와 오픈 일정은 <a href="/">공연 일정</a>의 각 공연 페이지에 정리돼 있어요.</p>
  </section>

  <h2>자주 묻는 질문</h2>
  <div class="faq">
    {faq.map((f) => (
      <details class="faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>

  <p class="disclaimer">
    동기화도 네트워크를 거치는 이상 수십~수백 ms 오차가 있을 수 있고, 예매 사이트 서버
    시계와의 오차는 저희가 직접 측정하지 않았어요 - "내 기기 시계보다는 믿을 만한 기준"
    정도로 봐주세요. 동기화 실패 시 기기 자체 시계로 표시돼요.
  </p>
</BaseLayout>

<style>
  .sched-list { list-style: none; margin: 0 0 1.2rem; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .sched-list li { position: relative; display: flex; align-items: center; gap: 0.6rem; padding: 0.65rem 2.4rem 0.65rem 0.85rem; background: rgba(255,255,255,0.05); border-radius: 10px; }
  .sched-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; color: inherit; text-decoration: none; }
  .sched-main strong { font-size: 0.96rem; }
  .sched-main:hover strong { color: #ff8fbe; }
  .sched-when { color: #a9a4c9; font-size: 0.82rem; }
  .sched-left { color: #6ee7ff; font-size: 0.82rem; font-weight: 700; white-space: nowrap; }
  .sched-side { color: #a9a4c9; font-size: 0.8rem; text-decoration: none; padding: 0.2rem 0.5rem; border: 1px solid rgba(255,255,255,0.15); border-radius: 999px; }
  .sched-list li .bookmark-btn { position: absolute; top: 50%; right: 0.5rem; transform: translateY(-50%); }
  .sched-empty { color: #a9a4c9; font-size: 0.9rem; line-height: 1.6; padding: 0.85rem 1rem; background: rgba(255,255,255,0.04); border-radius: 10px; margin: 0 0 1.2rem; }
  .sched-more { margin: 0 0 1.5rem; font-size: 0.9rem; }
  .sched-more a { color: #ff8fbe; }
  .intro { color: #d9d6ee; line-height: 1.7; }
  .countdown-banner {
    margin: 1rem 0;
    padding: 0.85rem 1.1rem;
    border-radius: 10px;
    background: rgba(255, 95, 162, 0.14);
    color: #ff8fc0;
    font-weight: 700;
    font-size: 1rem;
    text-align: center;
  }
  .cd-time { font-variant-numeric: tabular-nums; font-size: 1.15rem; margin-left: 0.35rem; }
  .clock-card {
    margin: 1.5rem 0;
    padding: 2rem 1.5rem;
    background: rgba(20, 20, 30, 0.9);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    text-align: center;
  }
  .clock-display {
    font-family: 'SF Mono', 'Menlo', 'Consolas', ui-monospace, monospace;
    font-size: clamp(2.4rem, 10vw, 4.2rem);
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  .clock-date { margin-top: 0.4rem; color: #a9a4c9; font-size: 0.95rem; }
  .sync-status { margin-top: 0.9rem; font-size: 0.85rem; color: #6ee7ff; }
  .sync-status.is-error { color: #ffb84c; }
  .calibrate { margin: 1rem 0; padding: 0.9rem 1.1rem; background: rgba(255,255,255,0.05); border-radius: 10px; }
  .calibrate summary { cursor: pointer; font-weight: 700; color: #f5f3ff; }
  .calibrate-row { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-top: 0.7rem; }
  .calibrate-row input {
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.16);
    background: rgba(255,255,255,0.06);
    color: #fff;
    font-size: 0.95rem;
  }
  .calibrate-row button {
    padding: 0.55rem 0.9rem;
    border-radius: 8px;
    border: none;
    background: var(--accent, #ff5fa2);
    color: #1a1424;
    font-weight: 700;
    cursor: pointer;
  }
  .platform-help { margin: 0 0 0.8rem; color: #a9a4c9; font-size: 0.88rem; }
  .platform-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin: 0 0 0.5rem; }
  @media (max-width: 480px) { .platform-grid { grid-template-columns: 1fr; } }
  .platform-item {
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
    border-radius: 10px;
    overflow: hidden;
  }
  .platform-select {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 1rem;
    border-radius: 10px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: #f5f3ff;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    text-align: left;
  }
  .platform-select .platform-check { opacity: 0; color: #101018; }
  .platform-select[aria-pressed="true"] {
    background: linear-gradient(120deg, #ff5fa2, #ff8fbe);
    border-color: transparent;
    color: #101018;
  }
  .platform-select[aria-pressed="true"] .platform-check { opacity: 1; }
  .platform-open {
    display: flex;
    align-items: center;
    padding: 0 0.85rem;
    border-radius: 10px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    color: #a9a4c9;
    text-decoration: none;
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .platform-open:hover { color: #6ee7ff; border-color: rgba(110,231,255,0.4); }
  .platform-active-note {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: #ff8fbe;
    font-weight: 600;
  }
  .guide { margin: 1.5rem 0 2rem; padding: 1.2rem 1.2rem 1rem; background: rgba(255,255,255,0.04); border-radius: 12px; }
  .guide h2 { margin-top: 0; }
  .guide h3 { font-size: 1rem; margin: 1.2rem 0 0.5rem; color: #f5f3ff; }
  .guide-lead { color: #d9d6ee; line-height: 1.7; margin: 0; }
  .guide ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .guide li, .guide p { color: #cfcbe8; font-size: 0.92rem; line-height: 1.65; }
  .guide p { margin: 0.3rem 0 0; }
  .guide a { color: #ff8fbe; }
  .guide li strong { color: #f5f3ff; }
  .faq { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.5rem; }
  .faq-item { padding: 0.85rem 1rem; background: rgba(255,255,255,0.05); border-radius: 10px; }
  .faq-item summary { cursor: pointer; font-weight: 700; color: #f5f3ff; font-size: 0.94rem; }
  .faq-item p { margin: 0.6rem 0 0; color: #a9a4c9; font-size: 0.88rem; line-height: 1.6; }
  .disclaimer { margin-top: 1.5rem; padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 8px; color: #a9a4c9; font-size: 0.82rem; line-height: 1.6; }
</style>

<script>
  // Precision synced clock: fetch an accurate KST time once, derive an offset
  // from this device's Date.now(), then keep the display moving locally
  // (no repeated network calls needed for smoothness) and re-sync periodically
  // to correct drift. Manual calibration is the fallback when the network sync
  // fails or the user trusts a different clock more.
  let offsetMs = 0; // serverTime - Date.now() at time of last sync

  function nowSynced() {
    return Date.now() + offsetMs;
  }

  async function syncClock() {
    const statusEl = document.getElementById('sync-status');
    const t0 = Date.now();
    try {
      const res = await fetch('https://timeapi.io/api/Time/current/zone?timeZone=Asia/Seoul', {
        cache: 'no-store',
      });
      const t1 = Date.now();
      if (!res.ok) throw new Error('bad status');
      const data = await res.json();
      // data.dateTime is a local (KST) ISO string without timezone offset - treat
      // it as Asia/Seoul explicitly rather than trusting the browser's default tz.
      const serverMs = new Date(`${data.dateTime}+09:00`).getTime();
      // Roughly correct for one-way network latency using half the round trip.
      const roundTrip = t1 - t0;
      const estServerNow = serverMs + roundTrip / 2;
      offsetMs = estServerNow - t1;
      if (statusEl) {
        statusEl.textContent = `표준시 서버와 동기화됨 · 오차 범위 약 ±${Math.round(roundTrip / 2)}ms · 방금 확인`;
        statusEl.classList.remove('is-error');
      }
    } catch (e) {
      offsetMs = 0;
      if (statusEl) {
        statusEl.textContent = '동기화 실패 - 이 기기 자체 시계로 표시 중입니다. 아래 수동 보정을 이용해보세요.';
        statusEl.classList.add('is-error');
      }
    }
  }

  function pad(n: number, len = 2) {
    return String(n).padStart(len, '0');
  }

  function tick() {
    const d = new Date(nowSynced());
    const display = document.getElementById('clock-display');
    const dateEl = document.getElementById('clock-date');
    if (display) {
      display.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}.${pad(d.getMilliseconds(), 3)}`;
    }
    if (dateEl) {
      const days = ['일', '월', '화', '수', '목', '금', '토'];
      dateEl.textContent = `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())} (${days[d.getDay()]})`;
    }
    updateCountdown(d);
    requestAnimationFrame(tick);
  }

  function updateCountdown(now: Date) {
    const params = new URLSearchParams(window.location.search);
    const openParam = params.get('open');
    if (!openParam) return;
    const target = new Date(openParam);
    if (isNaN(target.getTime())) return;
    const banner = document.getElementById('countdown-banner');
    const artistEl = document.getElementById('cd-artist');
    const timeEl = document.getElementById('cd-time');
    if (!banner || !timeEl) return;
    banner.hidden = false;
    if (artistEl) {
      const artist = params.get('artist');
      artistEl.textContent = artist ? decodeURIComponent(artist) : '이 공연';
    }
    const diff = target.getTime() - now.getTime();
    if (diff <= 0) {
      timeEl.textContent = '오픈 시각이 지났어요';
      return;
    }
    const totalSec = Math.floor(diff / 1000);
    const days = Math.floor(totalSec / 86400);
    const hours = Math.floor((totalSec % 86400) / 3600);
    const minutes = Math.floor((totalSec % 3600) / 60);
    const seconds = totalSec % 60;
    const ms = diff % 1000;
    timeEl.textContent = days > 0
      ? `${days}일 ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`
      : `${pad(hours)}:${pad(minutes)}:${pad(seconds)}.${pad(ms, 3)}`;
  }

  document.getElementById('calibrate-btn')?.addEventListener('click', () => {
    const input = document.getElementById('calibrate-input') as HTMLInputElement | null;
    if (!input || !input.value) return;
    const [h, m, s] = input.value.split(':').map(Number);
    const now = new Date();
    now.setHours(h || 0, m || 0, s || 0, 0);
    offsetMs = now.getTime() - Date.now();
    const statusEl = document.getElementById('sync-status');
    if (statusEl) {
      statusEl.textContent = '수동 보정된 시각으로 표시 중';
      statusEl.classList.remove('is-error');
    }
  });

  // 예매 사이트 선택 - 누르면 그 사이트를 "내가 쓰는 사이트"로 저장하고(다음
  // 방문에도 기억), 버튼 스타일이 활성화된다. 실제 예매창 이동은 별도의
  // "열기" 링크가 담당 - 선택 버튼 자체는 페이지를 벗어나지 않는다.
  const PLATFORM_KEY = 'krconcerts:ticketing-clock-platform';
  const PLATFORM_NAMES: Record<string, string> = {
    yes24: 'YES24 티켓',
    melon: '멜론티켓',
    nol: 'NOL(인터파크)',
    ticketlink: '티켓링크',
  };

  function applyPlatformSelection(id: string | null) {
    document.querySelectorAll<HTMLButtonElement>('[data-platform-select]').forEach((btn) => {
      const active = btn.dataset.platformSelect === id;
      btn.setAttribute('aria-pressed', String(active));
    });
    const note = document.getElementById('platform-active-note');
    if (note) {
      if (id && PLATFORM_NAMES[id]) {
        note.hidden = false;
        note.textContent = `✓ ${PLATFORM_NAMES[id]} 기준으로 설정했어요. 다음에 다시 와도 기억해요.`;
      } else {
        note.hidden = true;
      }
    }
  }

  function getSavedPlatform() {
    try {
      return localStorage.getItem(PLATFORM_KEY);
    } catch {
      return null;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-platform-select]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.platformSelect ?? null;
      const current = getSavedPlatform();
      const next = current === id ? null : id; // 다시 누르면 선택 해제
      try {
        if (next) localStorage.setItem(PLATFORM_KEY, next);
        else localStorage.removeItem(PLATFORM_KEY);
      } catch {
        // storage unavailable - selection just won't persist, no need to surface an error
      }
      applyPlatformSelection(next);
    });
  });
  applyPlatformSelection(getSavedPlatform());

  // 곧 오픈하는 티켓 목록: 남은 시간 표시, 이미 지난 건 숨김 (빌드 이후 시간이 흘렀을 수 있으므로).
  function updateOpenList() {
    document.querySelectorAll<HTMLElement>('#open-list li[data-open-at]').forEach((li) => {
      const t = new Date(li.dataset.openAt ?? '').getTime();
      const left = li.querySelector<HTMLElement>('[data-left]');
      if (isNaN(t) || !left) return;
      const diff = t - nowSynced();
      if (diff < -3600_000) { li.style.display = 'none'; return; }
      if (diff <= 0) { left.textContent = '오픈!'; return; }
      const m = Math.floor(diff / 60000);
      const d = Math.floor(m / 1440), h = Math.floor((m % 1440) / 60), mm = m % 60;
      left.textContent = d > 0 ? `${d}일 ${h}시간 후` : h > 0 ? `${h}시간 ${mm}분 후` : `${mm}분 후`;
    });
  }
  updateOpenList();
  setInterval(updateOpenList, 30000);

  syncClock();
  setInterval(syncClock, 60000);
  requestAnimationFrame(tick);
</script>
