---
import BaseLayout from '../layouts/BaseLayout.astro';
import { upcomingTicketOpens, onSaleEvents } from '../lib/events';

const opens = upcomingTicketOpens(8);
const onSale = onSaleEvents(6);
const shortDate = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getMonth() + 1}.${d.getDate()}`;
};

const PLATFORMS = [
  { id: 'yes24', name: 'YES24 티켓', url: 'https://ticket.yes24.com' },
  { id: 'melon', name: '멜론티켓', url: 'https://ticket.melon.com' },
  { id: 'nol', name: 'NOL(인터파크)', url: 'https://nol.interpark.com/ticket' },
  { id: 'ticketlink', name: '티켓링크', url: 'https://www.ticketlink.co.kr' },
];

// FAQ 구조화 데이터 - "nol 티켓팅 시계"처럼 특정 예매 사이트 이름 + "티켓팅 시계"로
// 검색해도 이 페이지가 어떤 사이트에나 쓸 수 있는 범용 도구라는 걸 검색엔진이
// 바로 이해하도록. 실제로 페이지에 보이는 문구와 동일한 내용만 담는다.
const faq = [
  {
    q: 'YES24·멜론티켓·NOL·티켓링크 아무 사이트에나 써도 되나요?',
    a: '네. 특정 예매처 전용이 아니라 표준시에 맞춘 범용 시계예요.',
  },
  {
    q: '자동 예매(매크로)인가요?',
    a: '아니에요. 자동으로 클릭하거나 새로고침하지 않고, 정확한 시각만 보여줘요.',
  },
  {
    q: '예매 사이트의 서버시간과 같은가요?',
    a: '똑같다고 보장하진 못해요. 내 기기 시계보다는 정확하지만 수십~수백 ms 차이가 날 수 있어요. 오픈 시각은 예매처 공지를 기준으로 하세요.',
  },
  {
    q: '티켓팅 몇 분 전부터 준비하면 되나요?',
    a: '로그인·본인인증·결제수단은 전날까지, 예매 페이지는 오픈 10분 전에 띄워두세요.',
  },
  {
    q: '예매시계와 티켓팅 시계는 같은 건가요?',
    a: '네, 같은 도구를 부르는 이름이에요. 예매 오픈 순간에 맞춰 누를 수 있도록 표준시와 동기화한 정확한 시각을 보여줘요.',
  },
  {
    q: '내 기기 시계가 몇 초 틀린지 어떻게 아나요?',
    a: '이 페이지를 열면 표준시 서버와 자동으로 동기화하고, 화면의 시계는 내 기기 오차를 보정한 시각으로 표시돼요. 동기화가 안 되면 수동 보정도 쓸 수 있어요.',
  },
  {
    q: '티켓팅 전에 인터넷 속도도 확인해야 하나요?',
    a: '시계가 정확해도 연결이 느리거나 불안정하면 오픈 순간에 밀릴 수 있어요. 오픈 전에 인터넷 속도 측정으로 지연과 예매처 응답을 한 번 재보세요.',
  },
  {
    q: '연습은 어디서 하나요?',
    a: '티켓팅 연습 페이지에서 버튼 타이밍과 좌석 선택을 연습할 수 있어요. 실제 예매와는 달라서 손풀기용이에요.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="티켓팅 시계 - 밀리초 서버시간·예매시계 (YES24·멜론·NOL)"
  description="티켓팅 시계: 내 폰·PC 시계가 몇 초 어긋났는지 바로 보정해 밀리초까지 보여주는 무료 예매시계 사이트. YES24·멜론티켓·NOL(인터파크)·티켓링크 오픈 카운트다운, 설치·로그인 없이 바로. 이번 주 티켓오픈 일정도 함께."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <h1>티켓팅 시계</h1>
  <p class="intro">예매 오픈 순간에 맞춰 누를 수 있게 표준시와 동기화한 정확한 시각을 보여주는 티켓팅 시계(예매시계) 사이트예요. 내 기기 시계가 얼마나 어긋났는지 보정해서 밀리초 단위로 보여줘요. <strong>자동 예매(매크로)가 아니라 수동 클릭용 시계</strong>예요.</p>

  <div id="clock-stage" class="clock-stage">
    <button id="focus-close" class="focus-close" type="button" aria-label="큰 화면 닫기" hidden>✕</button>
    <div id="countdown-banner" class="countdown-banner" hidden>
      <span id="cd-artist"></span> 티켓 오픈까지
      <span id="cd-time" class="cd-time">--:--:--</span>
    </div>

    <div class="clock-card">
      <div id="clock-display" class="clock-display" aria-live="off">--:--:--.---</div>
      <div id="clock-date" class="clock-date"></div>
      <div id="sync-status" class="sync-status">동기화하는 중...</div>
    </div>
  </div>

  <div class="clock-tools" role="group" aria-label="시계 도구">
    <button type="button" id="sound-btn" class="tool-btn" aria-pressed="false">소리·진동 꺼짐</button>
    <button type="button" id="focus-btn" class="tool-btn">⛶ 큰 화면</button>
    <button type="button" id="share-btn" class="tool-btn" hidden>링크 복사</button>
  </div>
  <p class="tool-note">소리 알림은 이 탭이 보이는 상태에서 가장 정확해요. 다른 탭에서는 브라우저가 타이머를 늦춰서 1초쯤 어긋날 수 있어요.</p>

  <details class="custom-open" id="custom-open">
    <summary>내가 원하는 오픈 시각으로 카운트다운</summary>
    <div class="custom-row">
      <input type="text" id="custom-name" placeholder="공연 이름 (선택)" maxlength="40" />
      <input type="datetime-local" id="custom-at" step="1" aria-label="오픈 시각 (한국 시간)" />
      <button type="button" id="custom-go">시작</button>
    </div>
    <p class="custom-help">한국 시간(KST) 기준이에요. 시작하면 주소가 바뀌어서, 링크를 복사해 친구에게 보낼 수 있어요.</p>
  </details>

  <section class="schedule" aria-label="티켓오픈 일정">
    <h2>곧 오픈하는 티켓</h2>
    {opens.length > 0 ? (
      <ul class="sched-list" id="open-list">
        {opens.map((e) => (
          <li data-open-at={e.ticketOpenAt}>
            <a class="sched-main" href={`/ticketing-clock/?open=${encodeURIComponent(e.ticketOpenAt as string)}&artist=${encodeURIComponent(e.artist)}`}>
              <strong>{e.artist}</strong>
              <span class="sched-when">{e.ticketOpenDate ?? e.ticketOpenAt}</span>
            </a>
            <span class="sched-left" data-left></span>
            <a class="sched-side" href={`/events/${e.id}/`}>상세</a>
            <button class="bookmark-btn" type="button" data-bookmark-id={e.id} aria-label={`${e.artist} 찜하기`} aria-pressed="false">♡</button>
          </li>
        ))}
      </ul>
    ) : (
      <p class="sched-empty">지금 확인된 오픈 예정 티켓은 없어요. 매일 아침 티켓 사이트 공지를 확인해서 새 오픈이 보이는 대로 여기에 올려요.</p>
    )}

    {onSale.length > 0 && (
      <>
        <h2>지금 예매 중인 공연</h2>
        <ul class="sched-list">
          {onSale.map((e) => (
            <li>
              <a class="sched-main" href={`/events/${e.id}/`}>
                <strong>{e.artist}</strong>
                <span class="sched-when">{shortDate(e.startDate)} · {e.venue}</span>
              </a>
              <button class="bookmark-btn" type="button" data-bookmark-id={e.id} aria-label={`${e.artist} 찜하기`} aria-pressed="false">♡</button>
            </li>
          ))}
        </ul>
      </>
    )}
    <p class="sched-more"><a href="/ticket-open/">티켓오픈 일정 전체 보기</a> · <a href="/my/">♥ 내 찜 목록에서 한눈에 보기</a> · <a href="/practice/">티켓팅 연습으로 손풀기</a></p>
  </section>

  <details class="calibrate">
    <summary>수동 보정 (동기화가 안 될 때)</summary>
    <div class="calibrate-row">
      <input type="time" id="calibrate-input" step="1" />
      <button type="button" id="calibrate-btn">지금 이 시각으로 맞추기</button>
    </div>
  </details>

  <h2>예매 사이트 선택</h2>
  <p class="platform-help">예매하는 사이트를 골라두면 바로가기 버튼이 그 사이트를 기억해요.</p>
  <div class="platform-grid" id="platform-grid">
    {PLATFORMS.map((p) => (
      <div class="platform-item" data-platform={p.id}>
        <button type="button" class="platform-select" data-platform-select={p.id} aria-pressed="false">
          <span class="platform-check" aria-hidden="true">✓</span> {p.name}
        </button>
        <a class="platform-open" href={p.url} target="_blank" rel="noopener noreferrer">열기 ↗</a>
      </div>
    ))}
  </div>
  <p id="platform-active-note" class="platform-active-note" hidden></p>
  <p class="platform-pages">예매처별 안내: <a href="/ticketing-clock/yes24/">예스24</a> · <a href="/ticketing-clock/melon/">멜론티켓</a> · <a href="/ticketing-clock/nol/">NOL 티켓</a> · <a href="/ticketing-clock/ticketlink/">티켓링크</a></p>

  <section class="howto" aria-label="티켓팅 시계 사용법">
    <h2>티켓팅 시계(예매시계) 사용법</h2>
    <ol>
      <li>이 페이지를 열면 표준시 서버와 동기화해 내 기기 오차를 자동으로 보정해요.</li>
      <li>위 "곧 오픈하는 티켓"에서 공연을 누르거나, 내가 원하는 오픈 시각을 직접 넣어 카운트다운을 켜요.</li>
      <li>예매 사이트는 따로 열어 두고, 시계가 오픈 시각이 되면 예매 버튼을 눌러요. 시계를 큰 화면으로 띄워 두면 보기 편해요.</li>
      <li>오픈 10분 전에는 <a href="/internet-speed/">인터넷 속도 측정</a>으로 지연과 예매처 응답을 한 번 재보세요.</li>
    </ol>
  </section>

  <section class="guide" id="guide" aria-label="티켓팅 가이드">
    <h2>티켓팅 체크리스트</h2>
    <div class="guide-list">
      <details class="guide-item" open>
        <summary>오픈 전날까지</summary>
        <ul>
          <li>로그인·본인인증·결제수단 등록해두기</li>
          <li>선예매 조건(팬클럽 가입 등) 확인</li>
          <li>가고 싶은 구역 1~3순위 정하기 · <a href="/venues/">공연장 시야 보기</a></li>
        </ul>
      </details>
      <details class="guide-item">
        <summary>오픈 10분 전</summary>
        <ul>
          <li>예매 페이지와 이 시계를 띄워두기</li>
          <li>안정적인 네트워크, 다른 다운로드·영상은 끄기</li>
          <li>같은 계정으로 여러 탭을 쓰면 막히는 사이트도 있어요</li>
        </ul>
      </details>
      <details class="guide-item">
        <summary>오픈 순간</summary>
        <ul>
          <li>정각 직전에 대기하다가 버튼이 열리면 바로 클릭</li>
          <li>대기열에서는 새로고침 금지 (순번이 초기화될 수 있어요)</li>
          <li>좌석을 잡으면 결제 제한시간이 짧으니 바로 결제</li>
        </ul>
      </details>
      <details class="guide-item">
        <summary>실패했다면</summary>
        <ul>
          <li>취소표가 풀리는 시간대(결제·취소 마감 직전)에 다시 확인</li>
          <li><a href="#open-list">오픈 일정</a>에서 추가 오픈 확인</li>
          <li><a href="/practice/">티켓팅 연습</a>으로 손풀기</li>
        </ul>
      </details>
    </div>
    <p class="guide-note">매크로·부정 거래는 처벌 대상이에요. <a href="/blog/post9/">암표방지법 이야기</a></p>
  </section>

  <h2>자주 묻는 질문</h2>
  <div class="faq">
    {faq.map((f) => (
      <details class="faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>

  <p class="disclaimer">
    동기화도 네트워크를 거치는 이상 수십~수백 ms 오차가 있을 수 있고, 예매 사이트 서버
    시계와의 오차는 저희가 직접 측정하지 않았어요 - "내 기기 시계보다는 믿을 만한 기준"
    정도로 봐주세요. 동기화 실패 시 기기 자체 시계로 표시돼요.
  </p>
</BaseLayout>

<style>
  .sched-list { list-style: none; margin: 0 0 1.2rem; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .sched-list li { position: relative; display: flex; align-items: center; gap: 0.6rem; padding: 0.65rem 2.4rem 0.65rem 0.85rem; background: rgba(255,255,255,0.05); border-radius: 8px; }
  .sched-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; color: inherit; text-decoration: none; }
  .sched-main strong { font-size: 0.96rem; }
  .sched-main:hover strong { color: #ff5fa2; }
  .sched-when { color: #8f8f97; font-size: 0.82rem; }
  .sched-left { color: #c9c9cf; font-size: 0.82rem; font-weight: 700; white-space: nowrap; }
  .sched-side { color: #8f8f97; font-size: 0.8rem; text-decoration: none; padding: 0.2rem 0.5rem; border: 1px solid rgba(255,255,255,0.15); border-radius: 6px; }
  .sched-list li .bookmark-btn { position: absolute; top: 50%; right: 0.5rem; transform: translateY(-50%); }
  .sched-empty { color: #8f8f97; font-size: 0.9rem; line-height: 1.6; padding: 0.85rem 1rem; background: rgba(255,255,255,0.04); border-radius: 8px; margin: 0 0 1.2rem; }
  .sched-more { margin: 0 0 1.5rem; font-size: 0.9rem; }
  .sched-more a { color: #ff5fa2; }
  .intro { color: #c4c4c8; line-height: 1.7; }
  .countdown-banner {
    margin: 1rem 0;
    padding: 0.85rem 1.1rem;
    border-radius: 8px;
    background: rgba(255, 95, 162, 0.14);
    color: #ff8fc0;
    font-weight: 700;
    font-size: 1rem;
    text-align: center;
  }
  .cd-time { font-variant-numeric: tabular-nums; font-size: 1.15rem; margin-left: 0.35rem; }
  .clock-card {
    margin: 1.5rem 0;
    padding: 2rem 1.5rem;
    background: rgba(20, 20, 30, 0.9);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    text-align: center;
  }
  .clock-display {
    font-family: 'SF Mono', 'Menlo', 'Consolas', ui-monospace, monospace;
    font-size: clamp(2.4rem, 10vw, 4.2rem);
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  .clock-date { margin-top: 0.4rem; color: #8f8f97; font-size: 0.95rem; }
  .sync-status { margin-top: 0.9rem; font-size: 0.85rem; color: #c9c9cf; }
  .sync-status.is-error { color: #ffb84c; }
  .calibrate { margin: 1rem 0; padding: 0.9rem 1.1rem; background: rgba(255,255,255,0.05); border-radius: 8px; }
  .calibrate summary { cursor: pointer; font-weight: 700; color: #ededea; }
  .calibrate-row { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-top: 0.7rem; }
  .calibrate-row input {
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.16);
    background: rgba(255,255,255,0.06);
    color: #fff;
    font-size: 0.95rem;
  }
  .calibrate-row button {
    padding: 0.55rem 0.9rem;
    border-radius: 8px;
    border: none;
    background: var(--accent, #ff5fa2);
    color: #151517;
    font-weight: 700;
    cursor: pointer;
  }
  .platform-help { margin: 0 0 0.8rem; color: #8f8f97; font-size: 0.88rem; }
  .platform-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin: 0 0 0.5rem; }
  @media (max-width: 480px) { .platform-grid { grid-template-columns: 1fr; } }
  .platform-item {
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
    border-radius: 8px;
    overflow: hidden;
  }
  .platform-select {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 1rem;
    border-radius: 8px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: #ededea;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    text-align: left;
  }
  .platform-select .platform-check { opacity: 0; color: #0e0e10; }
  .platform-select[aria-pressed="true"] {
    background: #ff5fa2;
    border-color: transparent;
    color: #0e0e10;
  }
  .platform-select[aria-pressed="true"] .platform-check { opacity: 1; }
  .platform-open {
    display: flex;
    align-items: center;
    padding: 0 0.85rem;
    border-radius: 8px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    color: #8f8f97;
    text-decoration: none;
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .platform-open:hover { color: #c9c9cf; border-color: rgba(255,255,255,0.4); }
  .platform-pages { margin: 0 0 1.5rem; font-size: 0.85rem; color: #8f8f97; }
  .platform-pages a { color: #ff5fa2; }
  .platform-active-note {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: #ff5fa2;
    font-weight: 600;
  }
  .clock-stage { position: relative; }
  .clock-stage.is-focus { position: fixed; inset: 0; z-index: 1000; background: #0e0e10; display: flex; flex-direction: column; justify-content: center; padding: 1rem; overflow: auto; }
  .clock-stage.is-focus .clock-display { font-size: clamp(1.8rem, 9vw, 6.5rem); white-space: nowrap; }
  .clock-stage.is-focus .clock-card { padding: 1.5rem 0.75rem; }
  .clock-stage.is-focus .countdown-banner { font-size: clamp(1.1rem, 5vw, 2.2rem); }
  .clock-stage.is-focus .cd-time { font-size: clamp(1.6rem, 8vw, 4rem); display: block; margin: 0.3rem 0 0; }
  .focus-close { position: absolute; top: 0.6rem; right: 0.8rem; z-index: 2; background: rgba(255,255,255,0.1); color: #ededea; border: 0; border-radius: 6px; width: 2.2rem; height: 2.2rem; font-size: 1rem; cursor: pointer; }
  .countdown-banner.is-urgent { background: rgba(255, 70, 70, 0.22); color: #ff8a8a; animation: urgent-pulse 1s ease-in-out infinite; }
  .countdown-banner.is-open { background: rgba(80, 220, 140, 0.2); color: #7dffb6; }
  @keyframes urgent-pulse { 50% { background: rgba(255, 70, 70, 0.4); } }
  .clock-tools { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1rem; }
  .tool-btn { padding: 0.5rem 0.9rem; border-radius: 6px; font-size: 0.86rem; font-weight: 700; color: #ededea; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.16); cursor: pointer; }
  .tool-btn[aria-pressed="true"] { background: #ff5fa2; color: #0e0e10; border-color: transparent; }
  .tool-note { margin: -0.4rem 0 1rem; color: #8f8f97; font-size: 0.78rem; line-height: 1.5; }
  .custom-open { margin: 0 0 1.2rem; padding: 0.8rem 1rem; background: rgba(255,255,255,0.05); border-radius: 8px; }
  .custom-open summary { cursor: pointer; font-weight: 700; color: #ededea; font-size: 0.94rem; }
  .custom-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.7rem; }
  .custom-row input { flex: 1 1 10rem; min-width: 0; padding: 0.55rem 0.7rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.18); background: rgba(0,0,0,0.3); color: #ededea; font-size: 0.9rem; }
  .custom-row button { padding: 0.55rem 1.1rem; border-radius: 8px; border: 0; font-weight: 700; color: #0e0e10; background: #ff5fa2; cursor: pointer; }
  .custom-help { margin: 0.6rem 0 0; color: #8f8f97; font-size: 0.8rem; }
  .howto { margin: 1.5rem 0 0.5rem; }
  .howto h2 { margin-top: 0; }
  .howto ol { margin: 0; padding-left: 1.3rem; color: #c4c4c8; font-size: 0.92rem; line-height: 1.8; }
  .howto a { color: #ff5fa2; }
  .guide { margin: 1.5rem 0 2rem; }
  .guide h2 { margin-top: 0; }
  .guide-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .guide-item { background: rgba(255,255,255,0.05); border-radius: 8px; padding: 0.8rem 1rem; }
  .guide-item summary { cursor: pointer; font-weight: 700; color: #ededea; font-size: 0.94rem; }
  .guide-item ul { margin: 0.6rem 0 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .guide-item li { color: #c4c4c8; font-size: 0.9rem; line-height: 1.55; }
  .guide-item a, .guide-note a { color: #ff5fa2; }
  .guide-note { margin: 0.7rem 0 0; color: #8f8f97; font-size: 0.82rem; }
  .faq { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.5rem; }
  .faq-item { padding: 0.85rem 1rem; background: rgba(255,255,255,0.05); border-radius: 8px; }
  .faq-item summary { cursor: pointer; font-weight: 700; color: #ededea; font-size: 0.94rem; }
  .faq-item p { margin: 0.6rem 0 0; color: #8f8f97; font-size: 0.88rem; line-height: 1.6; }
  .disclaimer { margin-top: 1.5rem; padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 8px; color: #8f8f97; font-size: 0.82rem; line-height: 1.6; }
</style>

<script>
  // Precision synced clock: fetch an accurate KST time once, derive an offset
  // from this device's Date.now(), then keep the display moving locally
  // (no repeated network calls needed for smoothness) and re-sync periodically
  // to correct drift. Manual calibration is the fallback when the network sync
  // fails or the user trusts a different clock more.
  let offsetMs = 0; // serverTime - Date.now() at time of last sync

  function nowSynced() {
    return Date.now() + offsetMs;
  }

  async function syncClock() {
    const statusEl = document.getElementById('sync-status');
    const t0 = Date.now();
    try {
      const res = await fetch('https://timeapi.io/api/Time/current/zone?timeZone=Asia/Seoul', {
        cache: 'no-store',
      });
      const t1 = Date.now();
      if (!res.ok) throw new Error('bad status');
      const data = await res.json();
      // data.dateTime is a local (KST) ISO string without timezone offset - treat
      // it as Asia/Seoul explicitly rather than trusting the browser's default tz.
      const serverMs = new Date(`${data.dateTime}+09:00`).getTime();
      // Roughly correct for one-way network latency using half the round trip.
      const roundTrip = t1 - t0;
      const estServerNow = serverMs + roundTrip / 2;
      offsetMs = estServerNow - t1;
      if (statusEl) {
        statusEl.textContent = `표준시 서버와 동기화됨 · 오차 범위 약 ±${Math.round(roundTrip / 2)}ms · 방금 확인`;
        statusEl.classList.remove('is-error');
      }
    } catch (e) {
      offsetMs = 0;
      if (statusEl) {
        statusEl.textContent = '동기화 실패 - 이 기기 자체 시계로 표시 중입니다. 아래 수동 보정을 이용해보세요.';
        statusEl.classList.add('is-error');
      }
    }
  }

  function pad(n: number, len = 2) {
    return String(n).padStart(len, '0');
  }

  function tick() {
    const d = new Date(nowSynced());
    const display = document.getElementById('clock-display');
    const dateEl = document.getElementById('clock-date');
    if (display) {
      display.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}.${pad(d.getMilliseconds(), 3)}`;
    }
    if (dateEl) {
      const days = ['일', '월', '화', '수', '목', '금', '토'];
      dateEl.textContent = `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())} (${days[d.getDay()]})`;
    }
    updateCountdown(d);
    requestAnimationFrame(tick);
  }

  // ── 카운트다운 대상 (URL ?open=&artist= 또는 직접 입력) ───────────────────
  let target: { at: number; artist: string } | null = null;
  function readTargetFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const openParam = params.get('open');
    if (!openParam) return;
    const at = new Date(openParam).getTime();
    if (isNaN(at)) return;
    target = { at, artist: params.get('artist') ?? '' };
  }
  readTargetFromUrl();

  // ── 소리·진동 (사용자가 켰을 때만. 브라우저 정책상 켜는 클릭에서 오디오를 연다) ──
  let soundOn = false;
  let audioCtx: AudioContext | null = null;
  function beep(freq: number, ms: number) {
    if (!audioCtx) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.frequency.value = freq;
    gain.gain.value = 0.15;
    osc.connect(gain); gain.connect(audioCtx.destination);
    osc.start(); osc.stop(audioCtx.currentTime + ms / 1000);
  }
  document.getElementById('sound-btn')?.addEventListener('click', (ev) => {
    const btn = ev.currentTarget as HTMLButtonElement;
    soundOn = !soundOn;
    if (soundOn) {
      try {
        const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        audioCtx = audioCtx ?? new AC();
        void audioCtx.resume();
        beep(660, 120); // 켜졌는지 확인용 짧은 소리
        navigator.vibrate?.(60);
      } catch { /* 소리를 못 켜는 환경이면 화면 표시만 */ }
    }
    btn.setAttribute('aria-pressed', String(soundOn));
    btn.textContent = soundOn ? '소리·진동 켜짐 (3초 전부터)' : '소리·진동 꺼짐';
  });

  let lastBeepSec = -1;
  let firedOpen = false;
  function updateCountdown(now: Date) {
    const banner = document.getElementById('countdown-banner');
    const artistEl = document.getElementById('cd-artist');
    const timeEl = document.getElementById('cd-time');
    if (!target || !banner || !timeEl) return;
    banner.hidden = false;
    if (artistEl) artistEl.textContent = target.artist || '이 공연';
    const diff = target.at - now.getTime();
    if (diff <= 0) {
      timeEl.textContent = '오픈 시각이 지났어요';
      banner.classList.remove('is-urgent');
      banner.classList.add('is-open');
      if (!firedOpen && diff > -3000) {
        firedOpen = true;
        if (soundOn) { beep(1000, 600); navigator.vibrate?.([200, 100, 200]); }
      }
      return;
    }
    firedOpen = false;
    banner.classList.remove('is-open');
    const totalSec = Math.floor(diff / 1000);
    banner.classList.toggle('is-urgent', totalSec < 10);
    if (soundOn && totalSec < 3 && totalSec !== lastBeepSec) {
      lastBeepSec = totalSec;
      beep(660, 150);
      navigator.vibrate?.(40);
    }
    const days = Math.floor(totalSec / 86400);
    const hours = Math.floor((totalSec % 86400) / 3600);
    const minutes = Math.floor((totalSec % 3600) / 60);
    const seconds = totalSec % 60;
    const ms = diff % 1000;
    timeEl.textContent = days > 0
      ? `${days}일 ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`
      : `${pad(hours)}:${pad(minutes)}:${pad(seconds)}.${pad(ms, 3)}`;
  }

  // ── 직접 입력 / 링크 복사 / 큰 화면 ───────────────────────────────────────
  // 다른 탭(예매 사이트)을 보는 동안에는 requestAnimationFrame이 멈추므로, 카운트다운·소리 알림은
  // 타이머로도 돌린다. 백그라운드에서는 브라우저가 1초 단위로 늦출 수 있어 소리는 약간 어긋날 수 있다.
  setInterval(() => updateCountdown(new Date(nowSynced())), 250);

  const shareBtn = document.getElementById('share-btn') as HTMLButtonElement | null;
  function refreshShare() { if (shareBtn) shareBtn.hidden = !target; }
  refreshShare();

  document.getElementById('custom-go')?.addEventListener('click', () => {
    const at = (document.getElementById('custom-at') as HTMLInputElement).value; // YYYY-MM-DDTHH:mm(:ss), 한국 시간으로 해석
    const name = (document.getElementById('custom-name') as HTMLInputElement).value.trim();
    if (!at) return;
    const iso = `${at.length === 16 ? at + ':00' : at}+09:00`;
    const ms = new Date(iso).getTime();
    if (isNaN(ms)) return;
    target = { at: ms, artist: name };
    lastBeepSec = -1; firedOpen = false;
    const url = new URL(window.location.href);
    url.searchParams.set('open', iso);
    if (name) url.searchParams.set('artist', name); else url.searchParams.delete('artist');
    history.replaceState(null, '', url);
    refreshShare();
    document.getElementById('clock-stage')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    try {
      if (navigator.share) { await navigator.share({ url, title: target?.artist ? `${target.artist} 티켓 오픈 시계` : '티켓팅 시계' }); return; }
    } catch { return; }
    try {
      await navigator.clipboard.writeText(url);
      shareBtn.textContent = '✓ 복사됐어요';
      setTimeout(() => { shareBtn.textContent = '링크 복사'; }, 1800);
    } catch { /* 복사 불가 환경이면 주소창 링크를 직접 복사 */ }
  });

  const stage = document.getElementById('clock-stage');
  const focusClose = document.getElementById('focus-close');
  function setFocus(on: boolean) {
    stage?.classList.toggle('is-focus', on);
    if (focusClose) focusClose.hidden = !on;
    document.body.style.overflow = on ? 'hidden' : '';
  }
  document.getElementById('focus-btn')?.addEventListener('click', () => setFocus(true));
  focusClose?.addEventListener('click', () => setFocus(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setFocus(false); });

  document.getElementById('calibrate-btn')?.addEventListener('click', () => {
    const input = document.getElementById('calibrate-input') as HTMLInputElement | null;
    if (!input || !input.value) return;
    const [h, m, s] = input.value.split(':').map(Number);
    const now = new Date();
    now.setHours(h || 0, m || 0, s || 0, 0);
    offsetMs = now.getTime() - Date.now();
    const statusEl = document.getElementById('sync-status');
    if (statusEl) {
      statusEl.textContent = '수동 보정된 시각으로 표시 중';
      statusEl.classList.remove('is-error');
    }
  });

  // 예매 사이트 선택 - 누르면 그 사이트를 "내가 쓰는 사이트"로 저장하고(다음
  // 방문에도 기억), 버튼 스타일이 활성화된다. 실제 예매창 이동은 별도의
  // "열기" 링크가 담당 - 선택 버튼 자체는 페이지를 벗어나지 않는다.
  const PLATFORM_KEY = 'krconcerts:ticketing-clock-platform';
  const PLATFORM_NAMES: Record<string, string> = {
    yes24: 'YES24 티켓',
    melon: '멜론티켓',
    nol: 'NOL(인터파크)',
    ticketlink: '티켓링크',
  };

  function applyPlatformSelection(id: string | null) {
    document.querySelectorAll<HTMLButtonElement>('[data-platform-select]').forEach((btn) => {
      const active = btn.dataset.platformSelect === id;
      btn.setAttribute('aria-pressed', String(active));
    });
    const note = document.getElementById('platform-active-note');
    if (note) {
      if (id && PLATFORM_NAMES[id]) {
        note.hidden = false;
        note.textContent = `✓ ${PLATFORM_NAMES[id]} 기준으로 설정했어요. 다음에 다시 와도 기억해요.`;
      } else {
        note.hidden = true;
      }
    }
  }

  function getSavedPlatform() {
    try {
      return localStorage.getItem(PLATFORM_KEY);
    } catch {
      return null;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-platform-select]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.platformSelect ?? null;
      const current = getSavedPlatform();
      const next = current === id ? null : id; // 다시 누르면 선택 해제
      try {
        if (next) localStorage.setItem(PLATFORM_KEY, next);
        else localStorage.removeItem(PLATFORM_KEY);
      } catch {
        // storage unavailable - selection just won't persist, no need to surface an error
      }
      applyPlatformSelection(next);
    });
  });
  // 예매처별 안내 페이지에서 ?platform=yes24 로 들어오면 그 예매처를 선택해둔다
  const qp = new URLSearchParams(window.location.search).get('platform');
  if (qp && PLATFORM_NAMES[qp]) {
    try { localStorage.setItem(PLATFORM_KEY, qp); } catch { /* 저장 불가 환경이면 이번 방문에만 적용 */ }
  }
  applyPlatformSelection(qp && PLATFORM_NAMES[qp] ? qp : getSavedPlatform());

  // 곧 오픈하는 티켓 목록: 남은 시간 표시, 이미 지난 건 숨김 (빌드 이후 시간이 흘렀을 수 있으므로).
  function updateOpenList() {
    document.querySelectorAll<HTMLElement>('#open-list li[data-open-at]').forEach((li) => {
      const t = new Date(li.dataset.openAt ?? '').getTime();
      const left = li.querySelector<HTMLElement>('[data-left]');
      if (isNaN(t) || !left) return;
      const diff = t - nowSynced();
      if (diff < -3600_000) { li.style.display = 'none'; return; }
      if (diff <= 0) { left.textContent = '오픈!'; return; }
      const m = Math.floor(diff / 60000);
      const d = Math.floor(m / 1440), h = Math.floor((m % 1440) / 60), mm = m % 60;
      left.textContent = d > 0 ? `${d}일 ${h}시간 후` : h > 0 ? `${h}시간 ${mm}분 후` : `${mm}분 후`;
    });
  }
  updateOpenList();
  setInterval(updateOpenList, 30000);

  syncClock();
  setInterval(syncClock, 60000);
  requestAnimationFrame(tick);
</script>
