---
// 직관 비용 계산기 - 티켓·수수료·교통·숙박·식비·굿즈를 넣고 한 번 가는 데 드는 총비용과 1인 부담액을 계산한다.
// 금액 기본값은 비워 둔다(예매처·공연마다 달라서 우리가 추정값을 넣지 않는다). 공연장 선택 시에는
// venues.json에 확인해 둔 교통·주차 안내만 보여주고, 금액 칸은 사용자가 직접 채운다.
import BaseLayout from '../layouts/BaseLayout.astro';
import { allVenueNames, getVenueInfo, venueSlug } from '../lib/venues';

const seen = new Set<string>();
const venues = allVenueNames()
  .filter((n) => { const s = venueSlug(n); if (seen.has(s)) return false; seen.add(s); return true; })
  .map((name) => {
    const info = getVenueInfo(name);
    return { name, slug: venueSlug(name), transit: (info?.transit ?? []).slice(0, 2), parking: info?.parking ?? '', rate: info?.parkingRate ?? null };
  });

const faqs = [
  { q: '직관 비용에는 어떤 것들이 들어가나요?', a: '티켓 가격과 예매 수수료가 기본이고, 공연장까지 오가는 교통비, 지방이라면 숙박비, 공연 전후 식비, 굿즈와 응원 도구 비용이 더해져요. 자가용이라면 주차비와 기름값도 들어가요.' },
  { q: '예매 수수료는 얼마인가요?', a: '예매처와 공연마다 달라요. 결제 화면의 최종 금액에서 티켓 가격을 뺀 값을 넣으면 가장 정확해요.' },
  { q: '같이 가는 사람과 비용을 나누려면요?', a: '주차·택시와 숙박은 함께 나누는 비용이라 "함께 가는 인원"으로 나눠서 계산해요. 티켓, 교통, 식비, 굿즈는 각자 쓰는 비용으로 봐요.' },
  { q: '입력한 값은 저장되나요?', a: '내 브라우저에만 저장돼요. 서버로 보내지 않아요.' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  title="직관 비용 계산기 - 콘서트 티켓·교통·숙박·굿즈 총비용"
  description="콘서트 한 번 보러 가는 데 얼마나 들까? 티켓, 예매 수수료, 교통, 숙박, 식비, 굿즈를 넣으면 총비용과 항목별 비중, 함께 가는 사람과 나눈 1인 부담액을 계산해 줘요."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="head">
    <h1>직관 비용 계산기</h1>
    <p class="lead">티켓값만 보면 놓치는 비용이 많아요. 교통과 숙박, 굿즈까지 넣어서 이번 직관에 실제로 얼마가 드는지 계산해 보세요.</p>
  </section>

  <form class="calc" id="calc" autocomplete="off" onsubmit="return false">
    <label class="f wide">
      <span>공연장 <em>(선택 · 교통·주차 안내만 보여줘요)</em></span>
      <select id="venue">
        <option value="">선택 안 함</option>
        {venues.map((v) => <option value={v.slug}>{v.name}</option>)}
      </select>
    </label>
    <div class="venue-info" id="venue-info"></div>
    <div class="rate-box" id="rate-box" hidden>
      <label class="f"><span>주차 시간 <em>(시간)</em></span><input type="number" id="park-hours" value="5" min="0" max="24" step="0.5" inputmode="decimal" /></label>
      <button type="button" id="park-fill">주차비 계산해서 채우기</button>
      <p id="rate-note"></p>
    </div>

    <h2 class="grp">티켓</h2>
    <label class="f"><span>티켓 가격 <em>(장당 · 원)</em></span><input type="number" id="price" min="0" step="1000" inputmode="numeric" placeholder="예: 154000" /></label>
    <label class="f"><span>예매 수수료 <em>(장당 · 원)</em></span><input type="number" id="fee" min="0" step="100" inputmode="numeric" placeholder="결제 화면 기준" /></label>
    <label class="f"><span>내가 결제하는 매수</span><input type="number" id="qty" value="1" min="0" max="10" step="1" inputmode="numeric" /></label>

    <h2 class="grp">가는 길</h2>
    <label class="f"><span>교통비 <em>(왕복 · 나 혼자 · 원)</em></span><input type="number" id="transport" min="0" step="1000" inputmode="numeric" /></label>
    <label class="f"><span>주차·택시 <em>(총액 · 함께 나눠요)</em></span><input type="number" id="parking" min="0" step="1000" inputmode="numeric" /></label>

    <h2 class="grp">머무는 동안</h2>
    <label class="f"><span>숙박 <em>(1박 방값 · 함께 나눠요)</em></span><input type="number" id="stay" min="0" step="10000" inputmode="numeric" /></label>
    <label class="f"><span>숙박 일수 <em>(박)</em></span><input type="number" id="nights" value="0" min="0" max="10" step="1" inputmode="numeric" /></label>
    <label class="f"><span>함께 가는 인원 <em>(나 포함)</em></span><input type="number" id="people" value="1" min="1" max="10" step="1" inputmode="numeric" /></label>
    <label class="f"><span>식비 <em>(나 혼자 · 원)</em></span><input type="number" id="food" min="0" step="1000" inputmode="numeric" /></label>

    <h2 class="grp">쓰는 것들</h2>
    <label class="f"><span>굿즈·MD <em>(원)</em></span><input type="number" id="goods" min="0" step="1000" inputmode="numeric" /></label>
    <label class="f"><span>기타 <em>(응원봉·옷·짐 보관 등)</em></span><input type="number" id="etc" min="0" step="1000" inputmode="numeric" /></label>
  </form>

  <section class="result" id="result" aria-live="polite" hidden>
    <p class="verdict" id="total"></p>
    <p class="sub" id="sub"></p>
    <table class="rows mono" id="rows"><caption>항목별 내 부담</caption><tbody></tbody></table>
    <p class="actions"><button type="button" id="copy">결과 복사하기</button><button type="button" id="reset" class="ghost">입력 지우기</button><span id="copied" hidden>복사했어요</span></p>
  </section>

  <section class="faq">
    <h2 class="sec mono">FAQ</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <p class="note">계산 결과는 입력하신 값으로 더한 참고용이에요. 티켓 가격과 수수료는 예매처 결제 화면의 금액을 기준으로 넣어 주세요. 공연장별 교통·주차 정보는 <a href="/venues/">공연장 가이드</a>에서, 막차가 걱정된다면 <a href="/return-trip/">막차 계산기</a>에서 확인할 수 있어요.</p>
</BaseLayout>

<script id="venue-data" type="application/json" set:html={JSON.stringify(venues)} />
<script>
  type Rate = { label: string; unitMin: number; unitWon: number; freeMin: number; dayMax: number };
  type V = { name: string; slug: string; transit: string[]; parking: string; rate: Rate | null };
  const venues: V[] = JSON.parse(document.getElementById('venue-data')!.textContent || '[]');
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const KEY = 'krconcerts:trip-cost';
  const IDS = ['venue', 'price', 'fee', 'qty', 'transport', 'parking', 'stay', 'nights', 'people', 'food', 'goods', 'etc'];
  const won = (n: number) => `${Math.round(n).toLocaleString('ko-KR')}원`;
  const num = (id: string) => Math.max(0, Number($(id).value) || 0);

  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || '{}');
    for (const k of IDS) if (saved[k] !== undefined) $(k).value = saved[k];
  } catch {}
  const qv = new URLSearchParams(location.search).get('venue');
  if (qv) { const hit = venues.find((v) => v.name === qv || v.slug === qv); if (hit) $('venue').value = hit.slug; }

  let lastText = '';
  function venueBlock() {
    const v = venues.find((x) => x.slug === $('venue').value);
    const box = document.getElementById('venue-info')!;
    const rb = document.getElementById('rate-box')!;
    rb.hidden = !v?.rate;
    if (v?.rate) document.getElementById('rate-note')!.textContent = v.rate.label;
    if (!v) { box.innerHTML = ''; return; }
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c] as string));
    const lines = [...v.transit, v.parking].filter(Boolean).map((t) => `<li>${esc(t)}</li>`).join('');
    box.innerHTML = (lines ? `<ul>${lines}</ul>` : '') + `<a href="/venues/${v.slug}/">공연장 상세 보기 →</a>`;
  }

  function calc() {
    venueBlock();
    try { const o: Record<string, string> = {}; for (const k of IDS) o[k] = $(k).value; localStorage.setItem(KEY, JSON.stringify(o)); } catch {}
    const people = Math.max(1, num('people'));
    const ticket = (num('price') + num('fee')) * num('qty');
    const transport = num('transport');
    const parking = num('parking') / people;
    const stay = (num('stay') * num('nights')) / people;
    const food = num('food');
    const goods = num('goods');
    const etc = num('etc');
    const items: Array<[string, number]> = [
      ['티켓 (수수료 포함)', ticket], ['교통', transport], ['주차·택시', parking], ['숙박', stay], ['식비', food], ['굿즈·MD', goods], ['기타', etc],
    ];
    const total = items.reduce((a, [, v]) => a + v, 0);
    const res = document.getElementById('result')!;
    if (total <= 0) { res.hidden = true; return; }
    res.hidden = false;
    document.getElementById('total')!.textContent = `이번 직관, 내가 ${won(total)}`;
    const qty = num('qty');
    const sub = document.getElementById('sub')!;
    sub.textContent = qty > 0 && ticket > 0
      ? `티켓이 전체의 ${Math.round((ticket / total) * 100)}%예요. 티켓 말고 ${won(total - ticket)}이 더 들어요.`
      : '티켓을 빼고 계산한 금액이에요.';
    const max = Math.max(...items.map(([, v]) => v));
    document.querySelector('#rows tbody')!.innerHTML = items.filter(([, v]) => v > 0).map(([n, v]) =>
      `<tr><td>${n}</td><td class="bar"><i style="width:${Math.max(2, Math.round((v / max) * 100))}%"></i></td><td class="amt">${won(v)}</td></tr>`).join('');
    lastText = `직관 비용 ${won(total)}\n` + items.filter(([, v]) => v > 0).map(([n, v]) => `- ${n} ${won(v)}`).join('\n') + `\n직관냥 직관 비용 계산기 https://jikgwannyang.com/trip-cost/`;
  }
  document.getElementById('calc')!.addEventListener('input', calc);
  document.getElementById('park-fill')!.addEventListener('click', () => {
    const v = venues.find((x) => x.slug === $('venue').value);
    if (!v?.rate) return;
    const min = Math.round((Number($('park-hours').value) || 0) * 60);
    const r = v.rate;
    const cost = min <= r.freeMin ? 0 : Math.min(Math.ceil(min / r.unitMin) * r.unitWon, r.dayMax);
    $('parking').value = String(cost);
    calc();
  });
  document.getElementById('copy')!.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(lastText); const c = document.getElementById('copied')!; c.hidden = false; setTimeout(() => (c.hidden = true), 1800); } catch {}
  });
  document.getElementById('reset')!.addEventListener('click', () => {
    for (const k of IDS) $(k).value = k === 'qty' || k === 'people' ? '1' : k === 'nights' ? '0' : '';
    try { localStorage.removeItem(KEY); } catch {}
    calc();
  });
  calc();
</script>
<style>
  .head h1 { margin: 0 0 0.6rem; }
  .lead { margin: 0 0 1.6rem; color: var(--fg-3); max-width: 40rem; }
  .calc { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.9rem 0.8rem; padding: 1.1rem; border: 1px solid var(--line); border-radius: 4px; }
  .grp { grid-column: 1 / -1; margin: 0.6rem 0 0; padding-top: 0.8rem; border-top: 1px solid var(--card-2); font-size: 0.8rem; letter-spacing: .14em; color: var(--muted); font-weight: 700; }
  .f { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.82rem; color: var(--muted); }
  .f.wide { grid-column: 1 / -1; }
  .f em { font-style: normal; color: var(--faint); }
  .f input, .f select { background: var(--card); border: 1px solid var(--line-2); border-radius: 4px; color: var(--fg); padding: 0.7rem 0.75rem; font: inherit; font-size: 1rem; }
  .f input:focus, .f select:focus { outline: none; border-color: var(--cheese); }
  .venue-info { grid-column: 1 / -1; font-size: 0.86rem; color: var(--fg-3); }
  .venue-info:empty { display: none; }
  .venue-info ul { margin: 0 0 0.4rem; padding-left: 1.1rem; }
  .venue-info a { color: var(--fg); }
  .rate-box { grid-column: 1 / -1; display: flex; gap: 0.8rem; align-items: flex-end; flex-wrap: wrap; }
  .rate-box[hidden] { display: none; }
  .rate-box .f { width: 9rem; }
  .rate-box button { background: transparent; color: var(--fg); border: 1px solid var(--line-2); border-radius: 4px; padding: 0.7rem 0.9rem; font: inherit; cursor: pointer; }
  .rate-box button:hover { border-color: var(--cheese); }
  .rate-box p { flex-basis: 100%; margin: 0; font-size: 0.8rem; color: var(--muted); }
  .result { padding: 1.2rem; border: 1px solid var(--line-2); border-radius: 4px; margin: 1.4rem 0 2rem; }
  .verdict { margin: 0 0 0.4rem; font-size: clamp(1.4rem, 4.6vw, 2.2rem); font-weight: 900; letter-spacing: -.04em; line-height: 1.15; }
  .sub { margin: 0 0 1.1rem; color: var(--fg-2); }
  .rows { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .rows caption { text-align: left; font-size: 0.7rem; letter-spacing: .12em; color: var(--muted); padding-bottom: 0.4rem; }
  .rows td { padding: 0.5rem 0; border-bottom: 1px solid var(--card-2); }
  .rows td:first-child { width: 9rem; color: var(--fg-2); }
  .rows .bar { padding: 0.5rem 0.8rem; }
  .rows .bar i { display: block; height: 6px; background: #5a5a63; border-radius: 1px; }
  .rows .amt { text-align: right; white-space: nowrap; color: var(--fg); font-weight: 700; }
  .actions { margin: 1rem 0 0; display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  .actions button { background: var(--btn); color: var(--ink); border: 1px solid var(--btn); border-radius: 4px; padding: 0.6rem 1rem; font: inherit; font-weight: 700; cursor: pointer; }
  .actions button.ghost { background: transparent; color: var(--fg); border-color: var(--line-2); }
  .actions span { color: var(--muted); font-size: 0.84rem; }
  .sec { margin: 0 0 0.6rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--line); font-size: 0.8rem; letter-spacing: .14em; color: var(--muted); font-weight: 700; }
  .faq details { border-bottom: 1px solid var(--card-2); padding: 0.7rem 0; }
  .faq summary { cursor: pointer; color: var(--fg); font-weight: 600; }
  .faq p { margin: 0.5rem 0 0; color: var(--fg-2); font-size: 0.92rem; line-height: 1.6; }
  .note { margin: 1.6rem 0 0; font-size: 0.82rem; color: var(--muted); line-height: 1.6; }
  .note a { color: var(--fg); }
  @media (max-width: 560px) { .rows td:first-child { width: 6.5rem; } }
</style>
