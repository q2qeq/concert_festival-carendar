---
// Standalone per-venue page: address/transit/parking/food (already researched,
// same source as VenueInfoBox) plus every upcoming show at that venue and a
// generic "시야/후기 검색" deep link to X search (no scraping, no fabricated
// per-section seat data - just a search query built from the venue's own name).
// Two or more event.venue spellings can point at the same physical place (e.g.
// "파주 임진각 평화누리" vs "임진각 평화누리") - matching is done by venueSlug()
// on both sides so an alias never produces a duplicate page or a missed event.
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getVenueInfo, allVenueNames, venueSlug, venueFromSlug, mapLinks } from '../../lib/venues';
import RouteFinder from '../../components/RouteFinder.astro';
import SightlineSearch from '../../components/SightlineSearch.astro';
import { upcomingEvents } from '../../lib/events';

export function getStaticPaths() {
  const uniqueSlugs = Array.from(new Set(allVenueNames().map(venueSlug)));
  return uniqueSlugs.map((slug) => ({
    params: { slug },
    props: { venueName: venueFromSlug(slug)! },
  }));
}

const { venueName } = Astro.props as { venueName: string };
const info = getVenueInfo(venueName);
const slug = venueSlug(venueName);
const venueEvents = upcomingEvents().filter((e) => venueSlug(e.venue) === slug);
const city = venueEvents[0]?.city;

const hasParking = Boolean(info?.parking);
const pageTitle = hasParking ? `${venueName} 주차장 요금·주차 팁·오시는 길` : `${venueName} 오시는 길·좌석·시야 정보`;
const pageDescription = hasParking
  ? `${venueName} 공연 보러 갈 때 주차장 요금과 주차 팁, 대중교통 오시는 길, 주변 편의시설, 예정된 공연 목록을 정리했어요.`
  : `${venueName} 공연 관람 전 알아두면 좋은 오시는 길, 구역별 시야, 주변 편의시설 정보와 예정된 공연 목록이에요.`;
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <p class="breadcrumb"><a href="/">← 전체 일정</a></p>

  <section class="intro">
    {info?.imageUrl && (
      <>
        <img class="venue-hero" src={info.imageUrl} alt={`${venueName} 전경`} loading="lazy" width="960" height="540" />
        {info.imageCredit && (
          <p class="venue-hero-credit">
            사진: {info.imageSourceUrl ? <a href={info.imageSourceUrl} target="_blank" rel="noopener noreferrer">{info.imageCredit}</a> : info.imageCredit}
          </p>
        )}
      </>
    )}
    <h1>{venueName}</h1>
    {city && <p class="city-tag">{city}</p>}
    {info?.address && <p class="address">{info.address}</p>}
  </section>

  <RouteFinder venue={venueName} address={info?.address} />

  <section class="venue-sightline-section" id="sightline">
    <h2>구역별 시야 (View Guide)</h2>
    <SightlineSearch venue={venueName} />
  </section>

  <AdSlot slot="venue-top" />

  {info ? (
    <>
      {info.transit && info.transit.length > 0 && (
        <section class="info-block">
          <h2>오시는 길</h2>
          <ul>{info.transit.map((t) => <li>{t}</li>)}</ul>
        </section>
      )}

      {info.parking && (
        <section class="info-block">
          <h2>주차</h2>
          <p>{info.parking}</p>
          {info.parkingTips && info.parkingTips.length > 0 && (
            <ul>{info.parkingTips.map((t) => <li>{t}</li>)}</ul>
          )}
          {info.parkingCheckedAt && (
            <p class="parking-note">{info.parkingCheckedAt} 확인 · 요금과 운영 방식은 바뀔 수 있어요. 공연 당일 공식·예매처 공지를 우선 확인하세요.</p>
          )}
        </section>
      )}

      {(info.coinLocker || info.restroom || info.smokingArea) && (
        <section class="info-block">
          <h2>편의시설</h2>
          <ul>
            {info.coinLocker && <li><strong>코인락커</strong> — {info.coinLocker}</li>}
            {info.restroom && <li><strong>화장실</strong> — {info.restroom}</li>}
            {info.smokingArea && <li><strong>흡연장</strong> — {info.smokingArea}</li>}
          </ul>
        </section>
      )}

      {info.nearbyFood && info.nearbyFood.length > 0 && (
        <section class="info-block">
          <h2>주변 맛집</h2>
          <ul class="food-list">
            {info.nearbyFood.map((f) => {
              const links = mapLinks(`${f.name} ${venueName}`);
              return (
                <li>
                  <strong>{f.name}</strong>
                  <span>{f.desc}</span>
                  <span class="food-map-links">
                    <a href={links.naver} target="_blank" rel="noopener noreferrer">네이버지도</a>
                    <a href={links.google} target="_blank" rel="noopener noreferrer">구글지도</a>
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {info.tip && <p class="tip">{info.tip}</p>}
    </>
  ) : (
    <p class="empty">아직 이 공연장의 상세 정보를 정리하지 못했어요. 공식 채널에서 최신 정보를 확인해주세요.</p>
  )}

  <section class="info-block">
    <h2>{venueName}의 예정된 공연{venueEvents.length > 0 ? ` (${venueEvents.length}건)` : ''}</h2>
    {venueEvents.length > 0 ? (
      <div class="event-list">
        {venueEvents.map((e) => <EventCard event={e} />)}
      </div>
    ) : (
      <p class="empty">현재 예정된 공연이 없어요.</p>
    )}
  </section>
</BaseLayout>
<style>
  .breadcrumb { margin: 0 0 1rem; font-size: 0.88rem; }
  .breadcrumb a { color: #8f8f97; text-decoration: none; }
  .breadcrumb a:hover { color: #fff; }
  .intro { padding: 0.25rem 0 0.75rem; }
  .venue-hero {
    display: block;
    width: 100%;
    max-height: 320px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 0.4rem;
  }
  .venue-hero-credit { margin: 0 0 0.9rem; font-size: 0.72rem; color: rgba(169,164,201,0.7); }
  .venue-hero-credit a { color: inherit; }
  .venue-hero-credit a:hover { color: #c9c9cf; }
  .intro h1 { font-size: 1.7rem; margin-bottom: 0.35rem; }
  .city-tag {
    display: inline-block;
    font-size: 0.78rem;
    color: #c9c9cf;
    border: 1px solid rgba(255,255,255,0.4);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }
  .address { color: #8f8f97; margin: 0; }
  .venue-sightline-section { margin: 1.5rem 0; scroll-margin-top: 5rem; }
  .venue-sightline-section h2 { font-size: 1.05rem; margin: 0 0 0.6rem; color: #dcdcd8; }
  .info-block { margin: 1.75rem 0; }
  .info-block h2 { font-size: 1.05rem; margin: 0 0 0.6rem; color: #dcdcd8; }
  .info-block ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .info-block p, .info-block li { color: #c4c4c8; font-size: 0.92rem; line-height: 1.55; margin: 0; }
  .info-block li strong { color: #ededea; }
  .food-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.5rem 1rem; padding-left: 0 !important; list-style: none; }
  .food-list li { display: flex; flex-direction: column; gap: 0.1rem; }
  .food-list strong { color: #ededea; font-size: 0.92rem; }
  .food-list span { color: #8f8f97; font-size: 0.82rem; }
  .food-map-links { display: flex; gap: 0.5rem; margin-top: 0.15rem; }
  .food-map-links a {
    font-size: 0.76rem;
    color: #c9c9cf;
    text-decoration: none;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.25);
    padding: 0.12rem 0.5rem;
    border-radius: 6px;
  }
  .food-map-links a:hover { background: rgba(255,255,255,0.16); }
  .parking-note { margin-top: 0.6rem !important; font-size: 0.78rem !important; color: #8f8f97 !important; }
  .tip { margin-top: 1rem; padding: 0.7rem 0.9rem; background: rgba(255,255,255,0.08); border-radius: 8px; color: #dcdcd8; font-size: 0.85rem; }
  .event-list { display: flex; flex-direction: column; }
  .empty { color: #8f8f97; }
</style>
