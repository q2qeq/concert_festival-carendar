---
// Standalone per-venue page: address/transit/parking/food (already researched,
// same source as VenueInfoBox) plus every upcoming show at that venue and a
// generic "시야/후기 검색" deep link to X search (no scraping, no fabricated
// per-section seat data - just a search query built from the venue's own name).
// Two or more event.venue spellings can point at the same physical place (e.g.
// "파주 임진각 평화누리" vs "임진각 평화누리") - matching is done by venueSlug()
// on both sides so an alias never produces a duplicate page or a missed event.
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getVenueInfo, allVenueNames, venueSlug, venueFromSlug, mapLinks } from '../../lib/venues';
import RouteFinder from '../../components/RouteFinder.astro';
import SightlineSearch from '../../components/SightlineSearch.astro';
import { upcomingEvents, pastEvents } from '../../lib/events';
import { regionOf, isShuttleLikely } from '../../lib/venues';
import { postsMentioningVenue, postDateLabel } from '../../lib/posts';
import { SITE_URL } from '../../../astro.config.mjs';

export function getStaticPaths() {
  const uniqueSlugs = Array.from(new Set(allVenueNames().map(venueSlug)));
  return uniqueSlugs.map((slug) => ({
    params: { slug },
    props: { venueName: venueFromSlug(slug)! },
  }));
}

const { venueName } = Astro.props as { venueName: string };
const info = getVenueInfo(venueName);
const slug = venueSlug(venueName);
const venueEvents = upcomingEvents().filter((e) => venueSlug(e.venue) === slug);
const city = venueEvents[0]?.city;
const guidePosts = await postsMentioningVenue(slug, 4);
// 지난 공연 - 이 공연장이 어떤 공연을 치러 왔는지 보여주는 이력(최근 순, 최대 8건).
const pastHere = pastEvents().filter((e) => venueSlug(e.venue) === slug).reverse().slice(0, 8);
// 같은 지역의 다른 공연장 - 주소 앞부분(시/도)이 같은 곳.
const region = regionOf(info?.address);
const sameRegion = Array.from(new Set(allVenueNames().map(venueSlug)))
  .filter((s2) => s2 !== slug)
  .map((s2) => ({ slug: s2, name: venueFromSlug(s2)! }))
  .filter((v) => region !== '기타' && regionOf(getVenueInfo(v.name)?.address) === region)
  .slice(0, 8);

// 자주 묻는 질문 - 이미 확인해 둔 정보에서만 만든다(없는 항목은 질문 자체를 빼서 빈 답을 만들지 않는다).
const faqs: Array<{ q: string; a: string }> = [];
if (info?.address) faqs.push({ q: `${venueName} 주소가 어떻게 되나요?`, a: info.address });
if (info?.transit?.length) faqs.push({ q: `${venueName}에 대중교통으로 어떻게 가나요?`, a: info.transit.join(' / ') });
if (info?.parking) faqs.push({ q: `${venueName}에 주차할 수 있나요?`, a: [info.parking, ...(info.parkingTips ?? [])].join(' ') });
if (info?.capacity) faqs.push({ q: `${venueName}은 몇 명까지 들어가나요?`, a: `${info.capacity}${info.capacityNote ? ` ${info.capacityNote}` : ''}` });
if (isShuttleLikely(venueName)) faqs.push({ q: `${venueName} 공연에 셔틀버스가 있나요?`, a: '공연마다 달라요. 공연 상세 페이지의 셔틀 안내와 예매처 공지를 먼저 확인하고, 없으면 카카오 T 셔틀·콘서트 셔틀 업체에서 검색해 보세요.' });
if (info?.coinLocker) faqs.push({ q: `${venueName}에 코인락커가 있나요?`, a: info.coinLocker });
faqs.push({ q: `${venueName} 공연이 끝난 뒤 막차를 탈 수 있을까요?`, a: '공연 종료 시각은 공연마다 달라요. 막차 계산기에서 공연 끝나는 시간과 출발지를 넣어 확인해 보세요.' });

const pageUrl = new URL(`/venues/${slug}/`, SITE_URL).toString();
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '직관냥', item: SITE_URL + '/' },
      { '@type': 'ListItem', position: 2, name: '공연장', item: SITE_URL + '/venues/' },
      { '@type': 'ListItem', position: 3, name: venueName, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'PerformingArtsTheater',
    name: venueName,
    url: pageUrl,
    ...(info?.address ? { address: { '@type': 'PostalAddress', streetAddress: info.address, addressCountry: 'KR' } } : {}),
    ...(info?.imageUrl ? { image: new URL(info.imageUrl, SITE_URL).toString() } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const hasParking = Boolean(info?.parking);
// "주차장 요금"을 제목에 쓰려면 실제로 요금·팁 정보가 있어야 한다. 주차 가능 여부만 아는 곳은 문구를 낮춘다.
const hasParkingFee = Boolean(info?.parkingTips?.length) || /\d\s*원/.test(info?.parking ?? '');
const pageTitle = hasParkingFee
  ? `${venueName} 주차장 요금·주차 팁·오시는 길`
  : hasParking
    ? `${venueName} 주차·오시는 길·좌석·시야 정보`
    : `${venueName} 오시는 길·좌석·시야 정보`;
const pageDescription = hasParkingFee
  ? `${venueName} 공연 보러 갈 때 주차장 요금과 주차 팁, 대중교통 오시는 길, 주변 편의시설, 예정된 공연 목록을 정리했어요.`
  : hasParking
    ? `${venueName} 공연 관람 전 알아두면 좋은 주차 안내와 오시는 길, 구역별 시야, 예정된 공연 목록이에요.`
    : `${venueName} 공연 관람 전 알아두면 좋은 오시는 길, 구역별 시야, 주변 편의시설 정보와 예정된 공연 목록이에요.`;
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <p class="breadcrumb"><a href="/events/">← 전체 일정</a></p>

  <section class="intro">
    {info?.imageUrl && (
      <>
        <img class="venue-hero" src={info.imageUrl} alt={`${venueName} 전경`} loading="lazy" width="960" height="540" />
        {info.imageCredit && (
          <p class="venue-hero-credit">
            사진: {info.imageSourceUrl ? <a href={info.imageSourceUrl} target="_blank" rel="noopener noreferrer">{info.imageCredit}</a> : info.imageCredit}
          </p>
        )}
      </>
    )}
    <h1>{venueName}</h1>
    {city && <p class="city-tag">{city}</p>}
    {info?.address && <p class="address">{info.address}</p>}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="at-a-glance" aria-label={`${venueName} 한눈에 보기`}>
    <dl>
      {region !== '기타' && <div><dt>지역</dt><dd>{region}</dd></div>}
      {info?.capacity && <div><dt>수용 인원</dt><dd>{info.capacity}</dd></div>}
      <div><dt>주차</dt><dd>{hasParking ? '안내 있음' : '정보 확인 중'}</dd></div>
      <div><dt>셔틀버스</dt><dd>{isShuttleLikely(venueName) ? '공연별 확인 필요' : '대중교통 이용이 일반적'}</dd></div>
      <div><dt>예정 공연</dt><dd>{venueEvents.length}건</dd></div>
    </dl>
    {info?.capacityNote && <p class="glance-note">{info.capacityNote}{info.capacitySource && <> · 출처: <a href={info.capacitySource.url} target="_blank" rel="noopener noreferrer">{info.capacitySource.label}</a></>}</p>}
  </section>

  <RouteFinder venue={venueName} address={info?.address} />
  <p class="return-link"><a href={`/return-trip/?venue=${encodeURIComponent(venueName)}`}>공연 끝나고 막차 탈 수 있을까? 막차 계산하기 →</a></p>

  <section class="venue-sightline-section" id="sightline">
    <h2>구역별 시야 (View Guide)</h2>
    <SightlineSearch venue={venueName} />
  </section>

  <AdSlot slot="venue-top" />

  {info ? (
    <>
      {info.transit && info.transit.length > 0 && (
        <section class="info-block">
          <h2>오시는 길</h2>
          <ul>{info.transit.map((t) => <li>{t}</li>)}</ul>
        </section>
      )}

      {info.parking && (
        <section class="info-block">
          <h2>주차</h2>
          <p>{info.parking}</p>
          {info.parkingTips && info.parkingTips.length > 0 && (
            <ul>{info.parkingTips.map((t) => <li>{t}</li>)}</ul>
          )}
          {info.parkingCheckedAt && (
            <p class="parking-note">{info.parkingCheckedAt} 확인 · 요금과 운영 방식은 바뀔 수 있어요. 공연 당일 공식·예매처 공지를 우선 확인하세요.</p>
          )}
        </section>
      )}

      {(info.coinLocker || info.restroom || info.smokingArea) && (
        <section class="info-block">
          <h2>편의시설</h2>
          <ul>
            {info.coinLocker && <li><strong>코인락커</strong> — {info.coinLocker}</li>}
            {info.restroom && <li><strong>화장실</strong> — {info.restroom}</li>}
            {info.smokingArea && <li><strong>흡연장</strong> — {info.smokingArea}</li>}
          </ul>
        </section>
      )}

      {info.nearbyFood && info.nearbyFood.length > 0 && (
        <section class="info-block">
          <h2>주변 맛집</h2>
          <ul class="food-list">
            {info.nearbyFood.map((f) => {
              const links = mapLinks(`${f.name} ${venueName}`);
              return (
                <li>
                  <strong>{f.name}</strong>
                  <span>{f.desc}</span>
                  <span class="food-map-links">
                    <a href={links.naver} target="_blank" rel="noopener noreferrer">네이버지도</a>
                    <a href={links.google} target="_blank" rel="noopener noreferrer">구글지도</a>
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {info.tip && <p class="tip">{info.tip}</p>}
    </>
  ) : (
    <p class="empty">아직 이 공연장의 상세 정보를 정리하지 못했어요. 공식 채널에서 최신 정보를 확인해주세요.</p>
  )}

  <section class="info-block">
    <h2>{venueName}의 예정된 공연{venueEvents.length > 0 ? ` (${venueEvents.length}건)` : ''}</h2>
    {venueEvents.length > 0 ? (
      <div class="event-list">
        {venueEvents.map((e) => <EventCard event={e} />)}
      </div>
    ) : (
      <p class="empty">현재 예정된 공연이 없어요.</p>
    )}
  </section>

  {pastHere.length > 0 && (
    <section class="info-block">
      <h2>이곳에서 열렸던 공연</h2>
      <ul class="past-list">
        {pastHere.map((e) => (
          <li><a href={`/events/${e.id}/`}>{e.artist}</a><span>{e.startDate}{e.endDate !== e.startDate ? ` ~ ${e.endDate}` : ''}</span></li>
        ))}
      </ul>
    </section>
  )}

  {guidePosts.length > 0 && (
    <section class="info-block">
      <h2>{venueName} 관련 글</h2>
      <ul class="past-list">
        {guidePosts.map((p) => (
          <li><a href={`/blog/${p.id}/`}>{p.data.title}</a><span>{postDateLabel(p.data.pubDate)}</span></li>
        ))}
      </ul>
    </section>
  )}

  <section class="info-block faq">
    <h2>자주 묻는 질문</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  {sameRegion.length > 0 && (
    <section class="info-block">
      <h2>{region}의 다른 공연장</h2>
      <ul class="past-list">
        {sameRegion.map((v) => <li><a href={`/venues/${v.slug}/`}>{v.name}</a></li>)}
      </ul>
    </section>
  )}
</BaseLayout>
<style>
  .at-a-glance { margin: 1rem 0 0.5rem; padding: 0.8rem 1rem; background: rgba(255,255,255,0.05); border-radius: 8px; }
  .at-a-glance dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 0.6rem 1rem; margin: 0; }
  .at-a-glance dt { font-size: 0.74rem; color: #8f8f97; }
  .at-a-glance dd { margin: 0.1rem 0 0; font-size: 0.92rem; color: #ededea; font-weight: 600; }
  .glance-note { margin: 0.6rem 0 0; font-size: 0.78rem; color: #8f8f97; line-height: 1.5; }
  .glance-note a { color: inherit; }
  .past-list { list-style: none; padding-left: 0 !important; }
  .past-list li { display: flex; gap: 0.7rem; align-items: baseline; }
  .past-list a { color: #ededea; text-decoration: none; font-weight: 600; }
  .past-list a:hover { color: #ff5fa2; }
  .past-list span { color: #8f8f97; font-size: 0.82rem; }
  .faq details { border-top: 1px solid rgba(255,255,255,0.12); padding: 0.6rem 0; }
  .faq summary { cursor: pointer; color: #ededea; font-size: 0.94rem; font-weight: 600; }
  .faq details p { margin-top: 0.5rem; }
  .breadcrumb { margin: 0 0 1rem; font-size: 0.88rem; }
  .breadcrumb a { color: #8f8f97; text-decoration: none; }
  .breadcrumb a:hover { color: #fff; }
  .intro { padding: 0.25rem 0 0.75rem; }
  .venue-hero {
    display: block;
    width: 100%;
    max-height: 320px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 0.4rem;
  }
  .venue-hero-credit { margin: 0 0 0.9rem; font-size: 0.72rem; color: rgba(169,164,201,0.7); }
  .venue-hero-credit a { color: inherit; }
  .venue-hero-credit a:hover { color: #c9c9cf; }
  .intro h1 { margin-bottom: 0.6rem; }
  .city-tag {
    display: inline-block;
    font-size: 0.78rem;
    color: #c9c9cf;
    border: 1px solid rgba(255,255,255,0.4);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }
  .address { color: #8f8f97; margin: 0; }
  .venue-sightline-section { margin: 1.5rem 0; scroll-margin-top: 5rem; }
  .venue-sightline-section h2 { font-size: 1.05rem; margin: 0 0 0.6rem; color: #dcdcd8; }
  .info-block { margin: 1.75rem 0; }
  .info-block h2 { font-size: 1.05rem; margin: 0 0 0.6rem; color: #dcdcd8; }
  .info-block ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .info-block p, .info-block li { color: #c4c4c8; font-size: 0.92rem; line-height: 1.55; margin: 0; }
  .info-block li strong { color: #ededea; }
  .food-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.5rem 1rem; padding-left: 0 !important; list-style: none; }
  .food-list li { display: flex; flex-direction: column; gap: 0.1rem; }
  .food-list strong { color: #ededea; font-size: 0.92rem; }
  .food-list span { color: #8f8f97; font-size: 0.82rem; }
  .food-map-links { display: flex; gap: 0.5rem; margin-top: 0.15rem; }
  .food-map-links a {
    font-size: 0.76rem;
    color: #c9c9cf;
    text-decoration: none;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.25);
    padding: 0.12rem 0.5rem;
    border-radius: 6px;
  }
  .food-map-links a:hover { background: rgba(255,255,255,0.16); }
  .parking-note { margin-top: 0.6rem !important; font-size: 0.78rem !important; color: #8f8f97 !important; }
  .tip { margin-top: 1rem; padding: 0.7rem 0.9rem; background: rgba(255,255,255,0.08); border-radius: 8px; color: #dcdcd8; font-size: 0.85rem; }
  .event-list { display: flex; flex-direction: column; }
  .empty { color: #8f8f97; }
  .return-link { margin: 0.8rem 0 0; font-size: 0.92rem; }
  .return-link a { color: #f4f4f0; font-weight: 700; }
  .return-link a:hover { color: #ff5fa2; }
</style>
