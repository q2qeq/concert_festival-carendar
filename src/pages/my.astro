---
import Mascot from '../components/Mascot.astro';
// "내 찜" - 사이트 어디서든 ♡로 찜해둔 공연을 한곳에 모아 보여준다.
// 찜 목록은 이 브라우저의 localStorage('krconcerts:bookmarks')에만 있고 서버로 가지 않는다
// (로그인 없음). 그래서 페이지는 예정된 공연 전부를 미리 렌더링해두고, 브라우저에서
// 찜한 것만 남기고 "곧 오픈하는 티켓 → 공연일 가까운 순"으로 정렬한다.
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { upcomingEvents } from '../lib/events';

const list = upcomingEvents();
---
<BaseLayout
  noindex
  title="내 찜 - 티켓팅·공연 일정 한눈에"
  description="♡로 찜한 공연의 D-day와 티켓오픈 일정을 한곳에서 확인하세요. 로그인 없이 이 기기에만 저장돼요."
>
  <h1>내 찜</h1>
  <p class="intro">♡로 찜한 공연을 모아서, 티켓오픈이 가까운 순 → 공연일이 가까운 순으로 보여드려요. 찜 목록은 이 기기(브라우저)에만 저장되고 서버로 보내지지 않아요.</p>

  <p id="my-alert" class="my-alert" hidden>
    <button type="button" id="my-alert-btn">찜한 공연 티켓오픈 알림 저장 (.ics)</button>
    <small>캘린더 앱에 넣으면 오픈 하루 전·10분 전에 알려줘요.</small>
  </p>

  <div id="my-list" class="my-list">
    {list.map((e) => (
      <div class="my-item" data-id={e.id} data-start={e.startDate} data-open-at={e.ticketOpenAt ?? ''} data-artist={e.artist} hidden>
        <p class="my-news" data-my-news hidden></p>
        {e.ticketOpenAt && (
          <p class="my-open" data-my-open>티켓오픈 {e.ticketOpenDate ?? e.ticketOpenAt}</p>
        )}
        <EventCard event={e} />
      </div>
    ))}
  </div>

  <div id="my-empty" class="my-empty" hidden>
    <Mascot size={180} pose="heart" />
    <p>아직 찜한 공연이 없어요. 공연 카드의 ♡를 누르면 티켓오픈 일정과 D-day가 여기에 모여요.</p>
    <p><a href="/events/">전체 일정 보러가기</a> · <a href="/ticketing-clock/">티켓팅 시계</a></p>
  </div>
</BaseLayout>

<style>
  .intro { color: var(--fg-2); line-height: 1.7; }
  .my-list { margin-top: 1rem; }
  .my-open { margin: 0.6rem 0 0; font-size: 0.82rem; font-weight: 700; color: var(--fg-2); }
  .my-news { margin: 0.6rem 0 0; font-size: 0.84rem; font-weight: 700; color: var(--cheese); line-height: 1.5; }
  .my-news small { color: var(--muted); font-weight: 400; margin-right: 0.4rem; }
  .my-alert { margin: 0.8rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.8rem; }
  .my-alert button { padding: 0.5rem 0.9rem; border-radius: 4px; font-size: 0.88rem; font-weight: 700; color: var(--ink); background: var(--btn); border: 0; cursor: pointer; }
  .my-alert small { color: var(--muted); }
  /* display:flex가 hidden 속성을 덮어써서 찜이 없어도 버튼이 보였다 */
  .my-alert[hidden], .my-empty[hidden] { display: none; }
  .my-empty { margin-top: 1.5rem; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.4rem; padding: 1.6rem 1.2rem; background: var(--card); border-radius: 8px; color: var(--fg-2); line-height: 1.7; }
  .my-empty a { color: var(--cheese); }
</style>

<script>
  import { ticketOpenIcs } from '../lib/ticketAlert';
  import { findNews, markSeen } from '../lib/bookmarkUpdates';

  function getBookmarks(): Set<string> {
    try {
      const raw = localStorage.getItem('krconcerts:bookmarks');
      return new Set<string>(raw ? JSON.parse(raw) : []);
    } catch {
      return new Set<string>();
    }
  }

  function render() {
    const ids = getBookmarks();
    const now = Date.now();
    const list = document.getElementById('my-list');
    const items = Array.from(document.querySelectorAll<HTMLElement>('.my-item'));
    const shown = items.filter((el) => ids.has(el.dataset.id ?? ''));

    items.forEach((el) => {
      el.hidden = !ids.has(el.dataset.id ?? '');
      // 이미 지난 오픈 시각 안내는 숨긴다
      const open = el.dataset.openAt ? new Date(el.dataset.openAt).getTime() : NaN;
      const line = el.querySelector<HTMLElement>('[data-my-open]');
      if (line) line.hidden = isNaN(open) || open < now - 3600_000;
    });

    // 곧 오픈하는 티켓 먼저(오픈 임박순), 그다음 공연일 가까운 순
    const key = (el: HTMLElement) => {
      const open = el.dataset.openAt ? new Date(el.dataset.openAt).getTime() : NaN;
      const upcomingOpen = !isNaN(open) && open >= now - 3600_000;
      return { upcomingOpen, open, start: el.dataset.start ?? '' };
    };
    shown
      .sort((a, b) => {
        const ka = key(a), kb = key(b);
        if (ka.upcomingOpen !== kb.upcomingOpen) return ka.upcomingOpen ? -1 : 1;
        if (ka.upcomingOpen && kb.upcomingOpen) return ka.open - kb.open;
        return ka.start.localeCompare(kb.start);
      })
      .forEach((el) => list?.appendChild(el));

    const alertBox = document.getElementById('my-alert');
    if (alertBox) alertBox.hidden = !shown.some((el) => key(el).upcomingOpen);

    const empty = document.getElementById('my-empty');
    if (empty) empty.hidden = shown.length > 0;
  }

  document.getElementById('my-alert-btn')?.addEventListener('click', () => {
    const ids = getBookmarks();
    const now = Date.now();
    const events = Array.from(document.querySelectorAll<HTMLElement>('.my-item'))
      .filter((el) => ids.has(el.dataset.id ?? '') && el.dataset.openAt && new Date(el.dataset.openAt).getTime() >= now - 3600_000)
      .map((el) => ({ id: el.dataset.id as string, artist: el.dataset.artist ?? '', ticketOpenAt: el.dataset.openAt as string }));
    if (events.length === 0) return;
    const blob = new Blob([ticketOpenIcs(events)], { type: 'text/calendar;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'jikgwannyang-ticket-open.ics';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // 마지막 방문 이후 올라온 업데이트를 카드 위에 보여주고, 보여준 뒤에는 '확인함'으로 기록한다.
  async function showNews() {
    const news = await findNews();
    for (const n of news) {
      const el = document.querySelector<HTMLElement>(`.my-item[data-id="${CSS.escape(n.id)}"] [data-my-news]`);
      if (!el) continue;
      el.textContent = '';
      const when = document.createElement('small');
      when.textContent = `새 소식 ${n.date.slice(5).replace('-', '.')}`;
      el.append(when, n.text);
      el.hidden = false;
    }
    markSeen(news);
  }

  render();
  showNews();
  window.addEventListener('bookmarks:changed', render);
</script>
