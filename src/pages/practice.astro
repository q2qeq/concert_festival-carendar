---
// 티켓팅 연습 (2026-11-02). 실제 티켓팅 순서를 그대로 연습한다.
//   1단계) 모의 예매 사이트 - 서버 시간을 보고 오픈 시각에 "예매하기" 버튼 누르기 (3회 시도)
//          -> 버튼 반응속도가 "대기 순번"을 정한다 (연습용 시뮬레이션)
//   2단계) 좌석 선택 - 대기 순번이 좋을수록 빈 좌석이 많고 오래 남는다. 신호 뒤에 뜨는 빈 좌석을 잡는다 (3라운드)
// 클릭마다 즉시 피드백(빠름/느림/일찍/더블클릭/오클릭)을 보여주고, 끝나면 시도별 기록과 맞춤 팁을 준다.
// 자동 예매/매크로가 아니라 순수한 반응속도 연습이다. 최고 기록은 이 기기(localStorage)에만 저장.
import BaseLayout from '../layouts/BaseLayout.astro';

// 검색용 FAQ: 화면에 실제로 보이는 문구와 동일한 내용만 담는다.
// 특정 예매처 화면을 복제한다고 주장하지 않고, 예매처 공통 흐름을 연습한다고 정직하게 쓴다.
const faq = [
  {
    q: 'NOL(인터파크)·예스24·멜론티켓·티켓링크 티켓팅 연습에 쓸 수 있나요?',
    a: '네. 특정 예매처 화면을 그대로 복제한 건 아니지만, 어느 예매처든 공통인 핵심 흐름 - 서버 시간을 보고 예매하기 버튼 누르기, 대기열, 구역 고르기, 빈 좌석 잡기 - 를 그대로 연습할 수 있어요. 연습할 예매처를 골라두면 연습 화면에 그 이름이 표시돼요.',
  },
  {
    q: '티켓팅 연습은 어떻게 하나요?',
    a: '시작을 누르면 모의 예매 사이트가 열려요. 서버 시간이 오픈 시각이 되는 순간 예매하기 버튼을 3번 연습하고, 버튼 반응속도로 대기 순번이 정해지고, 목표 구역을 빠르게 골라 좌석 선택 3라운드를 진행해요. 구역을 빠르고 정확하게 고를수록 좌석이 더 많이 남아 있어요. 누를 때마다 빠름·느림·일찍 누름·더블클릭을 바로 알려줘요.',
  },
  {
    q: '피켓팅이 뭐예요?',
    a: '피 튀기는 티켓팅의 줄임말로, 예매 오픈 직후 몇 초 만에 좌석이 모두 사라지는 치열한 티켓팅을 말해요. 이 연습은 그 몇 초에 필요한 손과 눈의 반응속도를 미리 익히는 용도예요.',
  },
  {
    q: '서버 시간은 어디서 확인하나요?',
    a: '예매처 화면이나 별도 서버 시간 확인 사이트로 볼 수 있어요. 직관냥 티켓팅 시계는 표준시에 동기화해서 오픈 직전까지 켜두기 좋아요.',
  },
  {
    q: '더블클릭하면 왜 안 좋은가요?',
    a: '실제 예매 사이트에서는 같은 요청이 중복으로 전달돼 대기열이 꼬이거나 오류가 날 수 있어요. 연습에서는 감점 없이 경고만 해드려요.',
  },
  {
    q: '자동 예매(매크로)인가요?',
    a: '아니에요. 자동으로 클릭하는 기능은 없고, 순수한 반응속도 연습 게임이에요. 대기 순번도 연습을 위한 시뮬레이션이고 실제 예매처와는 관련이 없어요.',
  },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '직관냥 티켓팅 연습',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    inLanguage: 'ko',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    description: 'NOL·예스24·멜론티켓·티켓링크 티켓팅 연습 게임. 서버 시간 보고 예매하기 버튼 누르기, 대기열, 구역 고르기, 좌석 잡기를 연습하고 상위 몇 %인지 확인해요.',
  },
];
---
<BaseLayout
  title="티켓팅 연습 게임 - NOL·예스24·멜론티켓·티켓링크 피켓팅 연습"
  description="NOL(인터파크)·예스24·멜론티켓·티켓링크 티켓팅 연습 게임. 서버 시간 보고 예매하기 버튼 누르기 → 대기열 → 구역 고르기 → 좌석 잡기까지 피켓팅 연습하고, 내 반응속도가 상위 몇 %인지 확인해보세요.">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <h1>티켓팅 연습 게임</h1>
  <p class="kicker">NOL(인터파크) · 예스24 · 멜론티켓 · 티켓링크 티켓팅 연습 · 피켓팅 손풀기</p>

  <!-- 시작 화면: 플래시 게임처럼 바로 START -->
  <section id="start-screen" class="arcade" aria-label="티켓팅 연습 시작 화면">
    <div class="arcade-title">티켓팅 연습</div>
    <div class="arcade-sub">서버 시간 보고 예매하기 → 대기열 → 구역 고르기 → 빈 좌석 잡기</div>
    <ol class="steps">
      <li><b>①</b><span>서버 시간 보고<br />예매하기 3번</span></li>
      <li><b>②</b><span>버튼 반응으로<br />대기 순번 결정</span></li>
      <li><b>③</b><span>목표 구역<br />빨리 고르기</span></li>
      <li><b>④</b><span>빈 좌석<br />3라운드</span></li>
    </ol>
    <div class="plat" role="group" aria-label="연습할 예매처">
      <button type="button" class="chip" data-plat="nol" aria-pressed="false">NOL 티켓</button>
      <button type="button" class="chip" data-plat="yes24" aria-pressed="false">예스24</button>
      <button type="button" class="chip" data-plat="melon" aria-pressed="false">멜론티켓</button>
      <button type="button" class="chip" data-plat="ticketlink" aria-pressed="false">티켓링크</button>
    </div>
    <button id="g-start" type="button" class="start-btn">▶ START</button>
    <div class="arcade-best">최고 기록 <b id="start-best">-</b> · Enter 키로도 시작해요</div>
  </section>

  <div id="game-area" hidden>
    <div class="hud">
      <span>단계 <b id="g-stage">-</b></span>
      <span>점수 <b id="g-score">0</b></span>
      <span>최고 <b id="g-best">-</b></span>
    </div>
    <div id="g-msg" class="g-msg"></div>
    <div id="g-feedback" class="g-feedback" aria-live="polite"></div>
  </div>

  <div id="g-result" class="result" hidden>
    <h2 id="g-grade"></h2>
    <p id="g-detail"></p>
    <p id="g-rank" class="rank" hidden></p>
    <ul id="g-tips" class="tips"></ul>
    <div class="g-actions">
      <button id="g-retry" type="button" class="btn primary">▶ 다시 도전 (Enter)</button>
      <button id="g-share" type="button" class="btn">결과 공유하기</button>
    </div>
    <p class="after">
      진짜 티켓팅 전에는 <a href="/ticketing-clock/">티켓팅 시계</a>로 오픈 시각을 맞추고,
      <a href="/my/">내 찜</a>에서 일정을 확인하세요.
    </p>
  </div>

  <!-- 1단계: 모의 예매 사이트 -->
  <section id="stage-site" class="site" hidden aria-label="모의 예매 사이트">
    <div class="site-bar">
      <span class="site-logo" id="site-logo">연습티켓</span>
      <span class="srv">서버 시간 <b id="srv-time">--:--:--.---</b></span>
    </div>
    <div class="site-body">
      <h2>직관냥 연습 콘서트 LIVE</h2>
      <p class="site-sub">2026 연습 투어 · 연습 아레나 · 전석 지정석</p>
      <p class="site-open">예매 오픈 <b id="open-at">--:--:--</b> <span id="attempt-no" class="attempt-no"></span></p>
      <button id="book-btn" type="button" class="book is-wait">오픈 대기중</button>
      <p id="site-note" class="site-note">서버 시간이 오픈 시각이 되는 순간 버튼을 누르세요</p>
      <div id="queue-box" class="queue-box" hidden></div>
    </div>
  </section>

  <!-- 2단계: 구역 선택 -->
  <section id="stage-zones" class="zones" hidden aria-label="구역 선택">
    <p id="zone-target" class="zone-target"></p>
    <div id="zone-map" class="zone-map" role="group" aria-label="좌석 구역도"></div>
    <p class="zone-legend">회색 구역은 매진이에요 · 목표 구역만 누르세요</p>
  </section>

  <!-- 3단계: 좌석 선택 -->
  <section id="stage-seats" hidden aria-label="좌석 선택">
    <div id="g-grid" class="grid" role="grid" aria-label="좌석표"></div>
  </section>

  <section id="log-box" class="log" hidden aria-label="시도 기록">
    <h2>시도 기록</h2>
    <ol id="g-log"></ol>
  </section>

  <section class="seo" aria-label="티켓팅 연습 안내">
    <h2>티켓팅 연습, 이렇게 해보세요</h2>
    <p>
      티켓팅은 예매 오픈 직후 몇 초에서 승패가 갈려요. <strong>NOL(인터파크), 예스24, 멜론티켓, 티켓링크</strong> 어느 예매처든
      서버 시간을 보고 예매하기 버튼을 누르고, 대기열을 지나 빈 좌석을 잡는 흐름은 같아요.
      피켓팅 전에 이 연습 게임으로 손을 풀어보세요. 진짜 티켓팅 전에는 <a href="/ticketing-clock/">티켓팅 시계</a>로 오픈 시각을 맞추고,
      <a href="/events/">공연 일정</a>에서 예매 오픈일을 확인하세요.
    </p>
    <h2>자주 묻는 질문</h2>
    <div class="faq">
      {faq.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <p class="disclaimer">
    연습용 게임이에요. NOL·예스24·멜론티켓·티켓링크는 각 사의 상표이며, 이 게임은 해당 예매처와 관련이 없고 예매처의 화면을 복제하지 않았어요. 대기 순번은 연습을 위한 시뮬레이션이에요.
    자동 클릭·매크로를 제공하지 않아요. 순위를 위해 점수만 익명으로 전송하고, 닉네임·개인정보는 저장하지 않아요.
  </p>
</BaseLayout>

<style>
  .kicker { margin: -0.4rem 0 1rem; color: #8f8f97; font-size: 0.9rem; }
  .arcade { position: relative; text-align: center; padding: 2rem 1rem 1.6rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.14); background: #151517; margin-bottom: 1.2rem; overflow: hidden; }
  .arcade-title { font-size: clamp(2rem, 8vw, 3.2rem); font-weight: 900; letter-spacing: -0.02em; color: #fff;}
  .arcade-sub { margin: 0.5rem 0 1.2rem; color: #c4c4c8; font-weight: 700; }
  .steps { list-style: none; display: flex; justify-content: center; gap: 0.6rem; margin: 0 0 1.2rem; padding: 0; flex-wrap: wrap; }
  .steps li { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.8rem; border-radius: 8px; background: rgba(255,255,255,0.07); font-size: 0.82rem; color: #c4c4c8; line-height: 1.35; text-align: left; }
  .steps b { color: #ffd166; font-size: 1.2rem; }
  .plat { display: flex; justify-content: center; gap: 0.4rem; flex-wrap: wrap; margin: 0 0 1.3rem; }
  .chip { padding: 0.4rem 0.85rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.22); background: transparent; color: #c4c4c8; font-size: 0.85rem; font-weight: 700; cursor: pointer; }
  .chip[aria-pressed="true"] { background: #ffd166; color: #151517; border-color: transparent; }
  .start-btn { position: relative; z-index: 1; padding: 1rem 3.2rem; border: none; border-radius: 6px; font-size: 1.5rem; font-weight: 900; letter-spacing: 0.04em; color: #151517; background: #ff5fa2;cursor: pointer; animation: bob 1.1s ease-in-out infinite; }
  .start-btn:active { transform: translateY(4px);animation: none; }
  @keyframes bob { 50% { transform: translateY(-4px); } }
  .arcade-best { margin-top: 1.1rem; color: #8f8f97; font-size: 0.85rem; }
  .arcade-best b { color: #ffd166; }
  .seo { margin-top: 1.8rem; }
  .seo h2 { font-size: 1.15rem; margin: 1.4rem 0 0.6rem; }
  .seo p { color: #c4c4c8; line-height: 1.8; }
  .seo a { color: #ff5fa2; }
  .faq { display: flex; flex-direction: column; gap: 0.6rem; }
  .faq-item { padding: 0.8rem 1rem; background: rgba(255,255,255,0.05); border-radius: 8px; }
  .faq-item summary { cursor: pointer; font-weight: 700; color: #ededea; font-size: 0.95rem; }
  .faq-item p { margin: 0.6rem 0 0; color: #8f8f97; font-size: 0.9rem; line-height: 1.7; }
  .hud { display: flex; gap: 1.2rem; margin: 1rem 0 0.4rem; color: #8f8f97; font-size: 0.92rem; flex-wrap: wrap; }
  .hud b { color: #ededea; }
  .g-msg { min-height: 1.6rem; margin: 0.4rem 0 0.3rem; font-weight: 700; color: #ff5fa2; }
  .g-feedback { min-height: 2.1rem; margin: 0 0 0.7rem; padding: 0.35rem 0.8rem; border-radius: 8px; font-weight: 800; font-size: 1rem; background: rgba(255,255,255,0.04); color: #8f8f97; }
  .g-feedback.good { color: #7ed957; background: rgba(126,217,87,0.12); }
  .g-feedback.ok { color: #c9c9cf; background: rgba(255,255,255,0.1); }
  .g-feedback.slow { color: #ffb84c; background: rgba(255,184,76,0.12); }
  .g-feedback.warn { color: #ff7a7a; background: rgba(255,107,107,0.13); }
  .g-actions { display: flex; gap: 0.6rem; margin: 1rem 0; flex-wrap: wrap; }
  .btn { padding: 0.65rem 1.2rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2); background: transparent; color: #ededea; font-weight: 700; cursor: pointer; font-size: 0.95rem; }
  .btn.primary { background: #ff5fa2; color: #0e0e10; border-color: transparent; }
  .btn:disabled { opacity: 0.5; cursor: default; }

  .site { border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.12); background: #f4f4f7; color: #151517; margin-bottom: 1rem; }
  .site-bar { display: flex; justify-content: space-between; align-items: center; gap: 0.8rem; padding: 0.7rem 1rem; background: #1c1c20; color: #fff; }
  .site-logo { font-weight: 800; }
  .srv { font-size: 0.82rem; color: #c4c4c8; }
  .srv b { color: #fff; font-variant-numeric: tabular-nums; font-size: 1.05rem; }
  .site-body { padding: 1.4rem 1.2rem 1.6rem; text-align: center; }
  .site-body h2 { margin: 0 0 0.3rem; font-size: 1.25rem; color: #151517; }
  .site-sub { margin: 0 0 1rem; color: #667; font-size: 0.88rem; }
  .site-open { margin: 0 0 1.1rem; font-size: 1rem; }
  .site-open b { font-size: 1.5rem; color: #d62d6f; font-variant-numeric: tabular-nums; }
  .attempt-no { display: inline-block; margin-left: 0.4rem; padding: 0.1rem 0.5rem; border-radius: 6px; background: #e7e9f2; color: #556; font-size: 0.78rem; font-weight: 700; }
  .book { width: 100%; max-width: 360px; padding: 1rem; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 800; cursor: pointer; }
  .book.is-wait { background: #c4c4c8; color: #fff; }
  .book.is-open { background: #e0245e; color: #fff;}
  .book.is-done { background: #2e7d4f; color: #fff; }
  .book.shake { animation: shake 0.3s; }
  @keyframes shake { 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
  .site-note { margin: 0.9rem 0 0; font-size: 0.84rem; color: #667; min-height: 1.2rem; }
  .queue-box { margin: 1rem auto 0; max-width: 360px; padding: 0.9rem 1rem; border-radius: 8px; background: #1c1c20; color: #fff; line-height: 1.6; }
  .queue-box b { color: #ffd166; font-size: 1.3rem; }
  .queue-box small { color: #c4c4c8; display: block; margin-top: 0.3rem; }

  .grid { display: grid; grid-template-columns: repeat(16, 1fr); gap: 4px; padding: 0.8rem; background: rgba(255,255,255,0.05); border-radius: 8px; user-select: none; touch-action: manipulation; margin-bottom: 1rem; }
  /* 좌석은 스크립트가 만들기 때문에 Astro 스코프 스타일이 안 붙는다 - :global로 지정 */
  .grid :global(.seat) { aspect-ratio: 1; border-radius: 3px; border: none; padding: 0; margin: 0; min-width: 0; background: #6a4fd6; cursor: default; appearance: none; -webkit-appearance: none; }
  .grid :global(.seat.open) { background: #7ed957;cursor: pointer; animation: pulse 0.4s infinite alternate; }
  .grid :global(.seat.got) { background: #ff5fa2; }
  .grid :global(.seat.lost) { background: #3b2f7a; }
  @keyframes pulse { to { transform: scale(1.15); } }

  .log { margin: 1rem 0; padding: 0.9rem 1.1rem; border-radius: 8px; background: rgba(255,255,255,0.05); }
  .log h2 { margin: 0 0 0.5rem; font-size: 1rem; color: #ededea; }
  .log ol { margin: 0; padding-left: 1.3rem; display: flex; flex-direction: column; gap: 0.35rem; color: #c4c4c8; font-size: 0.9rem; line-height: 1.5; }
  .log :global(.t-good) { color: #7ed957; font-weight: 800; }
  .log :global(.t-ok) { color: #c9c9cf; font-weight: 800; }
  .log :global(.t-slow) { color: #ffb84c; font-weight: 800; }
  .log :global(.t-warn) { color: #ff7a7a; font-weight: 700; }

  .result { margin-top: 1rem; padding: 1.1rem 1.2rem; border-radius: 8px; background: rgba(255,255,255,0.06); }
  .result h2 { margin: 0 0 0.4rem; }
  .result p { margin: 0.3rem 0; color: #c4c4c8; line-height: 1.7; }
  .rank { font-size: 1.15rem; font-weight: 800; color: #ffd166 !important; }
  .tips { margin: 0.6rem 0 0; padding-left: 1.2rem; color: #c4c4c8; line-height: 1.7; }
  .tips :global(li) { margin: 0.2rem 0; }
  .after a { color: #ff5fa2; }
  .disclaimer { margin-top: 1.5rem; color: #8f8f97; font-size: 0.82rem; line-height: 1.6; }

  /* 구역 선택 단계 */
  .zones { margin-bottom: 1rem; }
  .zone-target { margin: 0 0 0.7rem; padding: 0.8rem 1rem; border-radius: 6px; background: #1c1c20; color: #c4c4c8; font-size: 0.95rem; text-align: center; }
  .zone-target b { color: #ff5fa2; font-size: 1.35rem; margin: 0 0.2rem; }
  .zone-map { display: grid; grid-template-columns: repeat(12, 1fr); gap: 6px; padding: 0.8rem; background: rgba(255,255,255,0.05); border-radius: 8px; user-select: none; touch-action: manipulation; }
  .zone-map :global(.stage-bar) { grid-column: 3 / 11; padding: 0.5rem; text-align: center; font-size: 0.75rem; letter-spacing: .2em; color: #8f8f97; border: 1px dashed #4a4a52; border-radius: 4px; margin-bottom: 0.3rem; }
  .zone-map :global(.zone) { padding: 0.9rem 0.2rem; border: 0; border-radius: 4px; background: #3b3f6e; color: #fff; font: inherit; font-size: 0.82rem; font-weight: 700; line-height: 1.3; cursor: pointer; appearance: none; -webkit-appearance: none; }
  .zone-map :global(.zone small) { display: block; font-weight: 500; opacity: .75; font-size: 0.7rem; }
  .zone-map :global(.zone.floor) { background: #5a3d6e; }
  .zone-map :global(.zone.soldout) { background: #26262b; color: #55555d; cursor: default; }
  .zone-map :global(.zone.right) { background: #2e7d4f; }
  .zone-map :global(.zone.wrong) { background: #8a3a3a; }
  .zone-legend { margin: 0.5rem 0 0; font-size: 0.8rem; color: #6f6f77; text-align: center; }
  .zone-load { padding: 2.2rem 1rem; text-align: center; color: #8f8f97; }
</style>

<script>
  const COLS = 16, ROWS = 10;
  const BTN_ATTEMPTS = 3;
  const BTN_MAX_PER = 1333;        // 시도 1회 최대 점수 (3회 합계 약 4000)
  const BTN_ZERO_MS = 500;         // 이 시간 이상 늦으면 0점
  const BTN_GIVEUP_MS = 4000;      // 오픈 후 이 시간 안에 못 누르면 놓친 것
  const DBL_WINDOW_MS = 600;       // 이 시간 안의 추가 클릭은 더블클릭으로 본다
  const EARLY_PENALTY = 300;       // 오픈 전 클릭 감점
  const SEAT_EARLY_PENALTY = 100;  // 신호 전 좌석 클릭 감점
  // 좌석 라운드 기본값: 빈 좌석 개수, 빈 좌석이 남아있는 시간(ms). 대기 순번(q)에 따라 보정된다.
  const BASE_ROUNDS = [
    { n: 3, life: 1500 },
    { n: 4, life: 1150 },
    { n: 5, life: 900 },
  ];
  const BEST_KEY = 'krconcerts:practice-best';
  // 구역 선택: 목표 구역을 빨리·정확하게 고를수록 좌석 단계의 빈 좌석이 늘어난다(점수에는 직접 더하지 않는다 - 순위 집계 유지).
  const ZONE_ROUNDS = 2;
  const ZONE_WRONG_DELAY = 500;    // 오클릭하면 이만큼 화면이 먹통(재로딩 시뮬레이션)
  const ZONES = [
    ...['A', 'B', 'C'].map((n) => ({ id: `F${n}`, name: `스탠딩 ${n}`, tier: 'VIP', floor: true, span: 4 })),
    ...['A', 'B', 'C', 'D'].map((n) => ({ id: `1${n}`, name: `1층 ${n}구역`, tier: 'R석', floor: false, span: 3 })),
    ...['A', 'B', 'C', 'D', 'E', 'F'].map((n) => ({ id: `2${n}`, name: `2층 ${n}구역`, tier: 'S석', floor: false, span: 2 })),
  ];

  const $ = (id: string) => document.getElementById(id)!;
  const grid = $('g-grid');
  const msg = $('g-msg');
  const feedbackEl = $('g-feedback');
  const startBtn = $('g-start') as HTMLButtonElement;
  const result = $('g-result');
  const stageEl = $('g-stage');
  const scoreEl = $('g-score');
  const bestEl = $('g-best');
  const siteEl = $('stage-site');
  const seatsEl = $('stage-seats');
  const bookBtn = $('book-btn') as HTMLButtonElement;
  const srvTime = $('srv-time');
  const openAtEl = $('open-at');
  const attemptNo = $('attempt-no');
  const siteNote = $('site-note');
  const queueBox = $('queue-box');
  const logBox = $('log-box');
  const logList = $('g-log');

  const seats: HTMLButtonElement[] = [];
  for (let i = 0; i < COLS * ROWS; i++) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'seat';
    b.setAttribute('aria-label', '좌석');
    b.tabIndex = -1;
    grid.appendChild(b);
    seats.push(b);
  }

  function getBest(): number {
    try { return Number(localStorage.getItem(BEST_KEY)) || 0; } catch { return 0; }
  }
  function setBest(v: number) {
    try { localStorage.setItem(BEST_KEY, String(v)); } catch { /* 저장 불가 환경이면 기록만 안 남는다 */ }
  }
  function renderBest() {
    const b = getBest();
    bestEl.textContent = b ? String(b) : '-';
    $('start-best').textContent = b ? String(b) : '-';
  }
  renderBest();

  const pad = (n: number, l = 2) => String(n).padStart(l, '0');
  const fmtClock = (ms: number, withMs = true) => {
    const d = new Date(ms);
    const base = `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    return withMs ? `${base}.${pad(d.getMilliseconds(), 3)}` : base;
  };
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // ── 연습할 예매처 선택 (이름 표시용) ───────────────────────────────────
  // 특정 예매처 화면을 복제하지 않는다. 고른 이름이 모의 사이트 상단과 공유 문구에만 쓰인다.
  // 티켓팅 시계 페이지와 같은 저장 키를 써서 한쪽에서 고르면 다른 쪽에도 기억된다.
  const PLATFORM_KEY = 'krconcerts:ticketing-clock-platform';
  const PLATFORM_NAMES: Record<string, string> = { nol: 'NOL 티켓', yes24: '예스24', melon: '멜론티켓', ticketlink: '티켓링크' };
  let platform: string | null = null;
  try { platform = localStorage.getItem(PLATFORM_KEY); } catch { /* 저장 불가 환경이면 기억만 안 된다 */ }
  // 예매처별 안내 페이지에서 ?platform=yes24 로 들어오면 그 예매처를 고른 상태로 시작
  const qp = new URLSearchParams(window.location.search).get('platform');
  if (qp && PLATFORM_NAMES[qp]) {
    platform = qp;
    try { localStorage.setItem(PLATFORM_KEY, qp); } catch { /* 저장 불가 환경이면 이번 방문에만 적용 */ }
  }
  if (platform && !PLATFORM_NAMES[platform]) platform = null;
  const platformLabel = () => (platform ? PLATFORM_NAMES[platform] : '');
  function applyPlatform() {
    document.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => {
      c.setAttribute('aria-pressed', String(c.dataset.plat === platform));
    });
    $('site-logo').textContent = platform ? `${PLATFORM_NAMES[platform]} 연습` : '연습티켓';
  }
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => {
    c.addEventListener('click', () => {
      const id = c.dataset.plat ?? null;
      platform = platform === id ? null : id; // 다시 누르면 해제
      try {
        if (platform) localStorage.setItem(PLATFORM_KEY, platform);
        else localStorage.removeItem(PLATFORM_KEY);
      } catch { /* 저장 불가 */ }
      applyPlatform();
    });
  });
  applyPlatform();

  // ── 즉시 피드백 ─────────────────────────────────────────────────────────
  type Tone = 'good' | 'ok' | 'slow' | 'warn';
  function feedback(tone: Tone | '', text: string) {
    feedbackEl.className = 'g-feedback' + (tone ? ' ' + tone : '');
    feedbackEl.textContent = text;
  }
  // 반응속도(ms) 판정. 버튼과 좌석은 허용 시간이 달라서 기준을 따로 둔다.
  function judgeBtn(ms: number): { tone: Tone; label: string } {
    if (ms < 150) return { tone: 'good', label: '번개같아요' };
    if (ms < 300) return { tone: 'good', label: '빨라요' };
    if (ms < 600) return { tone: 'ok', label: '보통이에요' };
    return { tone: 'slow', label: '늦었어요' };
  }
  function judgeSeat(ms: number): { tone: Tone; label: string } {
    if (ms < 350) return { tone: 'good', label: '번개같아요' };
    if (ms < 600) return { tone: 'good', label: '빨라요' };
    if (ms < 900) return { tone: 'ok', label: '보통이에요' };
    return { tone: 'slow', label: '늦었어요' };
  }
  // 구역 선택은 목표를 읽고 구역도를 훑는 시간이 있어 좌석보다 기준이 느슨하다.
  function judgeZone(ms: number): { tone: Tone; label: string } {
    if (ms < 700) return { tone: 'good', label: '번개같아요' };
    if (ms < 1100) return { tone: 'good', label: '빨라요' };
    if (ms < 1700) return { tone: 'ok', label: '보통이에요' };
    return { tone: 'slow', label: '늦었어요' };
  }
  function addLog(html: string) {
    const li = document.createElement('li');
    li.innerHTML = html;
    logList.appendChild(li);
  }
  const tag = (tone: Tone, text: string) => `<span class="t-${tone}">${text}</span>`;

  // ── 게임 상태 ───────────────────────────────────────────────────────────
  let running = false;
  let score = 0;
  let resultText = '';
  const stats = {
    btnMs: [] as number[],     // 정상 클릭한 버튼 시도의 반응시간
    btnMissed: 0,
    btnEarly: 0,
    btnDouble: 0,
    seatRt: [] as number[],    // 잡은 좌석 반응시간
    seatTotal: 0,
    seatEarly: 0,
    seatMiss: 0,
    seatDouble: 0,
    zoneRt: [] as number[],    // 목표 구역을 제대로 고른 반응시간
    zoneMiss: 0,               // 오클릭(다른 구역/매진 구역)
    zoneRounds: 0,
  };

  function addScore(d: number) {
    score = Math.max(0, score + d);
    scoreEl.textContent = String(score);
  }

  // ── 1단계: 모의 예매 사이트 (3회 시도) ───────────────────────────────────
  // 반환: 이 시도의 유효 반응시간(ms), 놓쳤으면 -1
  async function playButtonAttempt(i: number): Promise<number> {
    stageEl.textContent = `1/3 예매 버튼 ${i + 1}/${BTN_ATTEMPTS}`;
    attemptNo.textContent = `${i + 1}/${BTN_ATTEMPTS}회`;
    bookBtn.className = 'book is-wait';
    bookBtn.textContent = '오픈 대기중';
    siteNote.textContent = '서버 시간이 오픈 시각이 되는 순간 버튼을 누르세요';
    msg.textContent = i === 0
      ? '서버 시간을 잘 보세요! 오픈 전에 누르면 감점이에요'
      : `${i + 1}번째 시도 - 이번에는 더 빠르게!`;

    // 오픈 시각은 몇 초 뒤의 "정각 초"로 잡아서, 화면의 오픈 시각 숫자와 서버 시간이 정확히 맞아떨어지게 한다.
    const wait = i === 0 ? 7000 + Math.random() * 2000 : 5000 + Math.random() * 2000;
    const openAt = Math.ceil((Date.now() + wait) / 1000) * 1000;
    openAtEl.textContent = fmtClock(openAt, false);

    let raf = 0;
    const tick = () => {
      srvTime.textContent = fmtClock(Date.now());
      if (Date.now() >= openAt && bookBtn.classList.contains('is-wait')) {
        bookBtn.className = 'book is-open';
        bookBtn.textContent = '예매하기';
        siteNote.textContent = '지금이에요!';
      }
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);

    let ms = -1;
    let early = 0;
    let dbl = 0;
    await new Promise<void>((resolve) => {
      let clicked = false;
      let finished = false;
      const finish = () => { if (finished) return; finished = true; bookBtn.onpointerdown = null; resolve(); };
      bookBtn.onpointerdown = () => {
        const now = Date.now();
        if (!clicked) {
          if (now < openAt) {
            early++;
            addScore(-EARLY_PENALTY);
            bookBtn.classList.remove('shake'); void bookBtn.offsetWidth; bookBtn.classList.add('shake');
            const sec = ((openAt - now) / 1000).toFixed(2);
            siteNote.textContent = '아직 예매 시간이 아닙니다!';
            feedback('warn', `${sec}초 일찍 눌렀어요 (-${EARLY_PENALTY}) · 서버 시간이 ${fmtClock(openAt, false)}가 되면 누르세요`);
            return;
          }
          clicked = true;
          ms = now - openAt;
          const pts = Math.max(0, Math.round(BTN_MAX_PER * (1 - ms / BTN_ZERO_MS)));
          addScore(pts);
          bookBtn.className = 'book is-done';
          bookBtn.textContent = '대기열 진입!';
          const j = judgeBtn(ms);
          feedback(j.tone, `${j.label} · 오픈 후 ${ms}ms (+${pts}점)`);
          // 더블클릭 감지 창: 잠깐 더 기다리며 추가 클릭을 센다
          setTimeout(finish, DBL_WINDOW_MS);
        } else if (now - (openAt + ms) <= DBL_WINDOW_MS) {
          dbl++;
          feedback('warn', '더블클릭 감지! 실제 사이트에서는 중복 요청으로 대기열이 꼬일 수 있어요. 한 번만 누르세요 (감점은 없어요)');
        }
      };
      const giveUp = setInterval(() => {
        if (finished || clicked) { if (finished) clearInterval(giveUp); return; }
        if (Date.now() >= openAt + BTN_GIVEUP_MS) {
          clearInterval(giveUp);
          siteNote.textContent = '너무 늦었어요 ';
          feedback('slow', '놓쳤어요! 오픈 4초가 지나도록 누르지 못했어요');
          finish();
        }
      }, 100);
    });
    cancelAnimationFrame(raf);

    stats.btnEarly += early; stats.btnDouble += dbl;
    if (ms >= 0) stats.btnMs.push(ms); else stats.btnMissed++;
    const j = ms >= 0 ? judgeBtn(ms) : null;
    addLog(
      `예매 버튼 ${i + 1}/${BTN_ATTEMPTS} · ` +
      (j ? `${ms}ms ${tag(j.tone, j.label)}` : tag('slow', '놓침')) +
      (early ? ` · ${tag('warn', `일찍 누름 ${early}회`)}` : '') +
      (dbl ? ` · ${tag('warn', '더블클릭')}` : '')
    );
    await sleep(900);
    return ms;
  }

  // 대기 순번 시뮬레이션: 버튼 반응이 느릴수록(놓침/일찍 누름 포함) 순번이 뒤로 간다.
  // q는 0(최악)~1(최고) - 좌석 단계의 빈 좌석 수/지속시간을 조절한다.
  function computeQueue(attemptMs: number[]) {
    const eff = attemptMs.map((m) => (m < 0 ? 1500 : m));
    const avg = eff.reduce((a, b) => a + b, 0) / eff.length + stats.btnEarly * 150;
    const q = Math.max(0, Math.min(1, 1 - avg / 700));
    const pos = Math.max(1, Math.round((60 + avg * 7) * (0.85 + Math.random() * 0.3)));
    return { avg, q, pos };
  }

  async function playSite(): Promise<{ q: number; pos: number }> {
    seatsEl.hidden = true;
    siteEl.hidden = false;
    queueBox.hidden = true;
    const attempts: number[] = [];
    for (let i = 0; i < BTN_ATTEMPTS; i++) attempts.push(await playButtonAttempt(i));
    const { q, pos } = computeQueue(attempts);
    stageEl.textContent = '대기열';
    msg.textContent = '예매 버튼 반응으로 대기 순번이 정해졌어요';
    queueBox.hidden = false;
    const hint = q >= 0.66 ? '앞 순번이라 빈 좌석이 넉넉해요 '
      : q >= 0.33 ? '중간 순번이라 빈 좌석이 보통이에요 '
      : '뒤쪽 순번이라 빈 좌석이 적고 금방 사라져요 ';
    queueBox.innerHTML = `내 앞에 <b>${pos.toLocaleString()}명</b><small>${hint}</small><small>(연습용 시뮬레이션이에요)</small>`;
    addLog(`대기 순번 <b>${pos.toLocaleString()}번째</b> · ${hint}`);
    await sleep(2200);
    siteEl.hidden = true;
    return { q, pos };
  }

  // ── 2단계: 구역 선택 ────────────────────────────────────────────────
  // 목표 구역이 제시되고, 구역도가 뜨면 그 구역을 누른다. 매진 구역·다른 구역을 누르면 오클릭(잠깐 먹통).
  const zonesEl = $('stage-zones');
  const zoneMap = $('zone-map');
  const zoneTarget = $('zone-target');
  async function playZoneRound(idx: number): Promise<void> {
    stageEl.textContent = `2/3 구역 선택 ${idx + 1}/${ZONE_ROUNDS}`;
    feedback('', '');
    const pool = ZONES.filter((z) => !z.floor);
    const target = pool[Math.floor(Math.random() * pool.length)];
    // 목표를 뺀 나머지 중 일부는 매진 처리
    const soldout = new Set(ZONES.filter((z) => z.id !== target.id).sort(() => Math.random() - 0.5).slice(0, 5).map((z) => z.id));
    msg.textContent = `구역 ${idx + 1}라운드 - 구역도가 뜨면 목표 구역을 누르세요`;
    zoneTarget.innerHTML = `목표 <b>${target.name}</b> (${target.tier})`;
    zoneMap.innerHTML = '<div class="zone-load" style="grid-column:1/-1">구역도를 불러오는 중…</div>';
    await sleep(500 + Math.random() * 900); // 페이지 로딩 느낌
    zoneMap.innerHTML = '<div class="stage-bar">STAGE</div>';
    const buttons: HTMLButtonElement[] = [];
    ZONES.slice().sort((a, b) => (a.floor === b.floor ? 0 : a.floor ? -1 : 1)).forEach((z) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'zone' + (z.floor ? ' floor' : '') + (soldout.has(z.id) ? ' soldout' : '');
      b.dataset.id = z.id;
      b.style.gridColumn = `span ${z.span}`;
      b.innerHTML = `${z.name}<small>${soldout.has(z.id) ? '매진' : z.tier}</small>`;
      zoneMap.appendChild(b);
      buttons.push(b);
    });
    const t0 = performance.now();
    let misses = 0;
    let locked = false;
    await new Promise<void>((resolve) => {
      zoneMap.onpointerdown = (e) => {
        const b = (e.target as HTMLElement).closest?.('.zone') as HTMLButtonElement | null;
        if (!b || locked) return;
        if (b.dataset.id === target.id) {
          locked = true;
          const rt = Math.round(performance.now() - t0);
          b.classList.add('right');
          stats.zoneRt.push(rt);
          const j = judgeZone(rt);
          feedback(j.tone, `${j.label} · ${rt}ms`);
          setTimeout(resolve, 500);
        } else {
          misses++;
          stats.zoneMiss++;
          locked = true;
          b.classList.add('wrong');
          feedback('warn', b.classList.contains('soldout')
            ? '매진 구역이에요! 다시 불러오는 중… (오클릭)'
            : '목표와 다른 구역이에요! 다시 불러오는 중… (오클릭)');
          setTimeout(() => { b.classList.remove('wrong'); locked = false; }, ZONE_WRONG_DELAY);
        }
      };
    });
    zoneMap.onpointerdown = null;
    stats.zoneRounds++;
    const rt = stats.zoneRt[stats.zoneRt.length - 1];
    const j = judgeZone(rt);
    addLog(`구역 ${idx + 1}/${ZONE_ROUNDS} · ${target.name} · ${rt}ms ${tag(j.tone, j.label)}` + (misses ? ` · ${tag('warn', `오클릭 ${misses}회`)}` : ''));
    await sleep(500);
  }

  // 구역을 빨리·정확하게 골랐는지가 좌석 단계의 q(빈 좌석 수/지속시간)에 반영된다.
  async function playZones(): Promise<number> {
    zonesEl.hidden = false;
    for (let i = 0; i < ZONE_ROUNDS; i++) await playZoneRound(i);
    zonesEl.hidden = true;
    const avg = stats.zoneRt.length ? stats.zoneRt.reduce((a, b) => a + b, 0) / stats.zoneRt.length : 1500;
    const dq = Math.max(-0.2, Math.min(0.15, (1200 - avg) / 1200 * 0.2 - stats.zoneMiss * 0.06));
    const hint = dq > 0.05 ? '구역을 빨리 골라서 좌석이 더 많이 남았어요' : dq < -0.05 ? '구역을 고르는 사이 좌석이 줄었어요' : '구역 선택 영향은 보통이에요';
    addLog(`구역 선택 결과 · ${hint}`);
    return dq;
  }

  // ── 2단계: 좌석 선택 ────────────────────────────────────────────────────
  function resetSeats() { seats.forEach((s) => { s.className = 'seat'; }); }

  async function playSeatRound(idx: number, cfg: { n: number; life: number }) {
    stageEl.textContent = `3/3 좌석 ${idx + 1}라운드`;
    resetSeats();
    msg.textContent = `좌석 ${idx + 1}라운드 - 곧 열려요. 신호 전에 누르면 감점!`;
    feedback('', '');

    let signaled = false;
    let early = 0, miss = 0, dbl = 0;
    const gotAt = new Map<HTMLElement, number>();
    const rts: number[] = [];
    let t0 = 0;
    let remaining = cfg.n;
    let resolveRound: () => void = () => {};
    const roundDone = new Promise<void>((r) => { resolveRound = r; });
    const timers: ReturnType<typeof setTimeout>[] = [];

    grid.onpointerdown = (e) => {
      const seat = (e.target as HTMLElement).closest?.('.seat') as HTMLButtonElement | null;
      if (!seat) return;
      const now = performance.now();
      if (!signaled) {
        early++;
        addScore(-SEAT_EARLY_PENALTY);
        feedback('warn', `신호 전에 눌렀어요! (-${SEAT_EARLY_PENALTY}) · 초록색이 뜰 때까지 기다리세요`);
        return;
      }
      if (seat.classList.contains('open')) {
        const rt = now - t0;
        rts.push(rt);
        const pts = Math.max(50, Math.round(1000 - rt * 0.5));
        addScore(pts);
        seat.classList.remove('open');
        seat.classList.add('got');
        gotAt.set(seat, now);
        const j = judgeSeat(rt);
        feedback(j.tone, `${j.label} · ${Math.round(rt)}ms (+${pts}점)`);
        if (--remaining === 0) resolveRound();
      } else if (seat.classList.contains('got')) {
        if (now - (gotAt.get(seat) ?? 0) <= DBL_WINDOW_MS) {
          dbl++;
          feedback('warn', '더블클릭 감지! 이미 잡은 좌석이에요. 한 번이면 충분해요 (감점은 없어요)');
        }
      } else {
        miss++;
        feedback('warn', seat.classList.contains('lost')
          ? '이미 다른 사람이 채간 좌석이에요 (오클릭)'
          : '매진된 좌석이에요 - 초록색만 누르세요 (오클릭)');
      }
    };

    await sleep(1200 + Math.random() * 1800);

    const pool = seats.map((_, i) => i).sort(() => Math.random() - 0.5).slice(0, cfg.n);
    signaled = true;
    msg.textContent = '오픈! 초록 좌석을 눌러요!';
    t0 = performance.now();
    pool.forEach((i) => {
      const seat = seats[i];
      seat.classList.add('open');
      // 다른 사람이 채가는 시점은 좌석마다 조금씩 다르다
      timers.push(setTimeout(() => {
        if (!seat.classList.contains('open')) return;
        seat.classList.remove('open');
        seat.classList.add('lost');
        if (--remaining === 0) resolveRound();
      }, cfg.life * (0.7 + Math.random() * 0.6)));
    });

    await roundDone;
    timers.forEach(clearTimeout);
    grid.onpointerdown = null;

    const avg = rts.length ? Math.round(rts.reduce((a, b) => a + b, 0) / rts.length) : 0;
    stats.seatRt.push(...rts);
    stats.seatTotal += cfg.n;
    stats.seatEarly += early; stats.seatMiss += miss; stats.seatDouble += dbl;
    const j = rts.length ? judgeSeat(avg) : null;
    addLog(
      `좌석 ${idx + 1}라운드 · ${cfg.n}개 중 ${rts.length}개 ` +
      (j ? `(평균 ${avg}ms ${tag(j.tone, j.label)})` : tag('slow', '(전부 놓침)')) +
      (early ? ` · ${tag('warn', `신호 전 클릭 ${early}회`)}` : '') +
      (miss ? ` · ${tag('warn', `오클릭 ${miss}회`)}` : '') +
      (dbl ? ` · ${tag('warn', '더블클릭')}` : '')
    );
    await sleep(900);
  }

  function gradeFor(total: number) {
    if (total >= 13000) return '피켓팅 신';
    if (total >= 10000) return '티켓팅 고수';
    if (total >= 6500) return '티켓팅 중수';
    if (total >= 3500) return '티켓팅 초보';
    return '오늘은 손이 느렸어요';
  }

  // 결과 기반 맞춤 팁 (최대 2개)
  function buildTips(btnAvg: number, seatAvg: number): string[] {
    const tips: string[] = [];
    if (stats.btnEarly > 0) tips.push('오픈 전에 누르는 경향이 있어요. 숫자가 바뀌는 순간을 보고 누르세요. 실제 사이트도 일찍 누르면 그냥 새로고침만 돼요.');
    if (stats.btnMissed > 0 || btnAvg > 600) tips.push('예매 버튼이 늦은 편이에요. 오픈 0.5초 전부터 마우스를 버튼 위에 올리고 서버 시계를 보세요. 여기서 대기 순번이 갈려요.');
    if (stats.btnDouble + stats.seatDouble > 0) tips.push('더블클릭이 있었어요. 실제 사이트에서는 중복 요청으로 대기열이 꼬이거나 오류가 날 수 있으니 한 번만 누르세요.');
    if (stats.seatMiss > 1) tips.push('오클릭이 많았어요. 좌석표 전체를 훑다 보면 이미 팔린 좌석을 누르게 돼요. 초록색이 뜨는 곳만 보고 누르세요.');
    if (stats.seatEarly > 0) tips.push('좌석 신호 전에 눌렀어요. 좌석 선택 화면이 열려도 바로 누르지 말고 빈 좌석이 보일 때까지 기다리세요.');
    if (stats.zoneMiss > 0) tips.push('구역을 잘못 눌렀어요. 예매 전에 좌석 배치도를 보고 원하는 구역 후보를 2~3개 정해 두면 헤매지 않아요. 준비 점검의 체크리스트에도 있어요.');
    if (seatAvg > 800) tips.push('좌석 선택이 느린 편이에요. 구역을 한 번에 훑으려 하지 말고 한 곳을 정해서 보세요.');
    if (tips.length === 0) tips.push('손이 정말 빨라요! 기록을 공유하고 친구와 비교해보세요.');
    return tips.slice(0, 2);
  }

  // 순위(상위 N%): 서버가 준비돼 있지 않거나 실패하면 순위 줄만 조용히 숨긴다.
  async function submitScore(sc: number, got: number, avg: number, btn: number) {
    const rankEl = $('g-rank');
    rankEl.hidden = true;
    try {
      const r = await fetch('/api/score', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ score: sc, got, avg, btn }),
      });
      if (!r.ok) return;
      const d = await r.json();
      if (d.estimated) {
        rankEl.textContent = `상위 약 ${d.top}%`;
        resultText = resultText.replace('\n나도', ` · 상위 약 ${d.top}%\n나도`);
      } else {
        rankEl.textContent = `전체 ${d.total.toLocaleString()}명 중 상위 ${d.top}%`;
        resultText = resultText.replace('\n나도', ` · 상위 ${d.top}%\n나도`);
      }
      rankEl.hidden = false;
    } catch { /* 순위 없이도 게임은 정상 */ }
  }

  async function start() {
    if (running) return;
    running = true;
    $('start-screen').hidden = true;
    $('game-area').hidden = false;
    $('game-area').scrollIntoView({ behavior: 'smooth', block: 'start' });
    score = 0;
    stats.btnMs = []; stats.btnMissed = 0; stats.btnEarly = 0; stats.btnDouble = 0;
    stats.seatRt = []; stats.seatTotal = 0; stats.seatEarly = 0; stats.seatMiss = 0; stats.seatDouble = 0;
    stats.zoneRt = []; stats.zoneMiss = 0; stats.zoneRounds = 0;
    scoreEl.textContent = '0';
    result.hidden = true;
    logList.innerHTML = '';
    logBox.hidden = false;
    feedback('', '');
    startBtn.disabled = true;

    const { q: q0, pos } = await playSite();
    const dq = await playZones();
    const q = Math.max(0, Math.min(1, q0 + dq));

    // 대기 순번이 좋을수록 빈 좌석이 많고 오래 남는다 (q: 0~1)
    const rounds = BASE_ROUNDS.map((r) => ({
      n: Math.max(2, r.n + Math.round(q * 2) - 1),
      life: Math.round(r.life * (0.75 + 0.5 * q)),
    }));
    seatsEl.hidden = false;
    for (let i = 0; i < rounds.length; i++) await playSeatRound(i, rounds[i]);
    seatsEl.hidden = true;

    const got = stats.seatRt.length;
    const seatAvg = got ? Math.round(stats.seatRt.reduce((a, b) => a + b, 0) / got) : 0;
    const btnAvg = stats.btnMs.length ? Math.round(stats.btnMs.reduce((a, b) => a + b, 0) / stats.btnMs.length) : -1;
    const zoneAvg = stats.zoneRt.length ? Math.round(stats.zoneRt.reduce((a, b) => a + b, 0) / stats.zoneRt.length) : 0;
    const best = getBest();
    const isBest = score > best;
    if (isBest) setBest(score);
    renderBest();
    const grade = gradeFor(score);
    $('g-grade').textContent = grade;
    $('g-detail').textContent =
      `대기 ${pos.toLocaleString()}번째 · 예매 버튼 평균 ${btnAvg >= 0 ? btnAvg + 'ms' : '놓침'}` +
      ` · 구역 평균 ${zoneAvg}ms${stats.zoneMiss ? ` (오클릭 ${stats.zoneMiss})` : ''}` +
      ` · 좌석 ${stats.seatTotal}개 중 ${got}개 · 점수 ${score}점${isBest ? ' · 최고 기록!' : ''}`;
    const tipsEl = $('g-tips');
    tipsEl.innerHTML = '';
    buildTips(btnAvg, seatAvg).forEach((t) => {
      const li = document.createElement('li');
      li.textContent = t;
      tipsEl.appendChild(li);
    });
    result.hidden = false;
    stageEl.textContent = '끝';
    msg.textContent = '끝! 아래 시도 기록과 팁을 확인하세요';
    feedback('', '');
    resultText = `직관냥 ${platformLabel() ? platformLabel() + ' ' : ''}티켓팅 연습 ${grade} · 대기 ${pos.toLocaleString()}번째 · 예매 버튼 ${btnAvg >= 0 ? btnAvg + 'ms' : '놓침'} · 좌석 ${got}/${stats.seatTotal} · ${score}점\n나도 해보기 ${location.origin}/practice/`;
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    submitScore(score, got, seatAvg, btnAvg);
    startBtn.disabled = false;
    startBtn.textContent = '다시 시작';
    running = false;
  }

  startBtn.addEventListener('click', start);
  // 플래시 게임처럼 Enter/Space로도 바로 시작 (시작 화면 또는 결과 화면이 보일 때만)
  document.addEventListener('keydown', (e) => {
    // 시작 화면이 보이거나, 한 판이 끝나 결과 화면이 떠 있을 때만 (플레이 중엔 무시)
    if (running || ($('start-screen').hidden && result.hidden)) return;
    if (e.key === 'Enter' || e.key === ' ') {
      if ((e.target as HTMLElement)?.closest?.('.chip, summary, a, input, textarea, #g-share')) return;
      e.preventDefault();
      start();
    }
  });
  $('g-retry').addEventListener('click', start);
  $('g-share').addEventListener('click', async () => {
    try {
      if (navigator.share) { await navigator.share({ text: resultText }); return; }
    } catch { return; } // 사용자가 공유 창을 닫은 경우
    try {
      await navigator.clipboard.writeText(resultText);
      feedback('ok', '결과가 복사됐어요. 붙여넣어 공유하세요!');
    } catch {
      msg.textContent = resultText;
    }
  });
</script>
