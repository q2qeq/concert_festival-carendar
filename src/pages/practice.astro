---
// 티켓팅 연습 (2026-11-02). 실제 티켓팅 순서를 그대로 연습한다.
//   1단계) 모의 예매 사이트 - 서버 시간을 보고 오픈 시각에 맞춰 "예매하기" 버튼 누르기 (너무 빨리 누르면 감점)
//   2단계) 좌석 선택 - 신호 뒤에 뜨는 빈 좌석을 다른 사람이 채가기 전에 잡기 (3라운드, 갈수록 빨라짐)
// 자동 예매/매크로가 아니라 순수한 반응속도 연습이다. 최고 기록은 이 기기(localStorage)에만 저장.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="티켓팅 연습 - 서버시간 보고 예매 버튼 누르기"
  description="서버 시간을 보고 예매하기 버튼을 누르고, 빈 좌석을 잡는 티켓팅 연습. 내 반응속도가 상위 몇 %인지 확인하고 공유해보세요."
>
  <h1>🎫 티켓팅 연습</h1>
  <p class="intro">
    진짜 티켓팅처럼 <strong>① 서버 시간을 보고 예매하기 버튼 누르기 → ② 빈 좌석 잡기</strong> 순서로 연습해요.
    오픈 전에 누르면 감점이니, 시계를 잘 보세요.
  </p>

  <div class="hud">
    <span>단계 <b id="g-stage">-</b></span>
    <span>점수 <b id="g-score">0</b></span>
    <span>최고 <b id="g-best">-</b></span>
  </div>

  <div class="g-actions">
    <button id="g-start" type="button" class="btn primary">연습 시작</button>
  </div>
  <div id="g-msg" class="g-msg">시작을 누르면 모의 예매 사이트가 열려요</div>

  <div id="g-result" class="result" hidden>
    <h2 id="g-grade"></h2>
    <p id="g-detail"></p>
    <p id="g-rank" class="rank" hidden></p>
    <p id="g-rank-note" class="rank-note" hidden></p>
    <div class="g-actions">
      <button id="g-share" type="button" class="btn primary">결과 공유하기</button>
      <button id="g-retry" type="button" class="btn">다시 하기</button>
    </div>
    <p class="after">
      진짜 티켓팅 전에는 <a href="/ticketing-clock/">티켓팅 시계</a>로 오픈 시각을 맞추고,
      <a href="/my/">내 찜</a>에서 일정을 확인하세요.
    </p>
  </div>

  <!-- 1단계: 모의 예매 사이트 -->
  <section id="stage-site" class="site" hidden aria-label="모의 예매 사이트">
    <div class="site-bar">
      <span class="site-logo">🎟 연습티켓</span>
      <span class="srv">서버 시간 <b id="srv-time">--:--:--.---</b></span>
    </div>
    <div class="site-body">
      <h2>직관냥 연습 콘서트 LIVE</h2>
      <p class="site-sub">2026 연습 투어 · 연습 아레나 · 전석 지정석</p>
      <p class="site-open">예매 오픈 <b id="open-at">--:--:--</b></p>
      <button id="book-btn" type="button" class="book is-wait">오픈 대기중</button>
      <p id="site-note" class="site-note">서버 시간이 오픈 시각이 되는 순간 버튼을 누르세요</p>
    </div>
  </section>

  <!-- 2단계: 좌석 선택 -->
  <section id="stage-seats" hidden aria-label="좌석 선택">
    <div id="g-grid" class="grid" role="grid" aria-label="좌석표"></div>
  </section>

  <p class="disclaimer">
    연습용 게임이에요. 자동 클릭·매크로를 제공하지 않고, 실제 예매와는 아무 관련이 없어요.
    순위를 위해 점수만 익명으로 전송하고, 닉네임·개인정보는 저장하지 않아요.
  </p>
</BaseLayout>

<style>
  .intro { color: #d9d6ee; line-height: 1.7; }
  .hud { display: flex; gap: 1.2rem; margin: 1rem 0 0.4rem; color: #a9a4c9; font-size: 0.92rem; }
  .hud b { color: #f5f3ff; }
  .g-msg { min-height: 1.6rem; margin: 0.4rem 0 0.7rem; font-weight: 700; color: #ff8fbe; }
  .g-actions { display: flex; gap: 0.6rem; margin: 1rem 0; flex-wrap: wrap; }
  .btn { padding: 0.65rem 1.2rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.2); background: transparent; color: #f5f3ff; font-weight: 700; cursor: pointer; font-size: 0.95rem; }
  .btn.primary { background: linear-gradient(120deg, #ff5fa2, #ff8fbe); color: #101018; border-color: transparent; }
  .btn:disabled { opacity: 0.5; cursor: default; }

  .site { border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.12); background: #f4f4f7; color: #1a1a24; margin-bottom: 1rem; }
  .site-bar { display: flex; justify-content: space-between; align-items: center; gap: 0.8rem; padding: 0.7rem 1rem; background: #1f2a44; color: #fff; }
  .site-logo { font-weight: 800; }
  .srv { font-size: 0.82rem; color: #b8c4e8; }
  .srv b { color: #fff; font-variant-numeric: tabular-nums; font-size: 1.05rem; }
  .site-body { padding: 1.4rem 1.2rem 1.6rem; text-align: center; }
  .site-body h2 { margin: 0 0 0.3rem; font-size: 1.25rem; color: #1a1a24; }
  .site-sub { margin: 0 0 1rem; color: #667; font-size: 0.88rem; }
  .site-open { margin: 0 0 1.1rem; font-size: 1rem; }
  .site-open b { font-size: 1.5rem; color: #d62d6f; font-variant-numeric: tabular-nums; }
  .book { width: 100%; max-width: 360px; padding: 1rem; border: none; border-radius: 10px; font-size: 1.1rem; font-weight: 800; cursor: pointer; }
  .book.is-wait { background: #c9ccd6; color: #fff; }
  .book.is-open { background: #e0245e; color: #fff; box-shadow: 0 4px 14px rgba(224,36,94,0.45); }
  .book.shake { animation: shake 0.3s; }
  @keyframes shake { 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
  .site-note { margin: 0.9rem 0 0; font-size: 0.84rem; color: #667; min-height: 1.2rem; }

  .grid { display: grid; grid-template-columns: repeat(16, 1fr); gap: 4px; padding: 0.8rem; background: rgba(255,255,255,0.05); border-radius: 12px; user-select: none; touch-action: manipulation; margin-bottom: 1rem; }
  /* 좌석은 스크립트가 만들기 때문에 Astro 스코프 스타일이 안 붙는다 - :global로 지정 */
  .grid :global(.seat) { aspect-ratio: 1; border-radius: 3px; border: none; padding: 0; margin: 0; min-width: 0; background: #6a4fd6; cursor: default; appearance: none; -webkit-appearance: none; }
  .grid :global(.seat.open) { background: #7ed957; box-shadow: 0 0 8px #7ed957; cursor: pointer; animation: pulse 0.4s infinite alternate; }
  .grid :global(.seat.got) { background: #ff5fa2; }
  .grid :global(.seat.lost) { background: #3b2f7a; }
  @keyframes pulse { to { transform: scale(1.15); } }

  .result { margin-top: 1rem; padding: 1.1rem 1.2rem; border-radius: 12px; background: rgba(255,255,255,0.06); }
  .result h2 { margin: 0 0 0.4rem; }
  .result p { margin: 0.3rem 0; color: #d9d6ee; line-height: 1.7; }
  .rank { font-size: 1.15rem; font-weight: 800; color: #ffd166 !important; }
  .rank-note { font-size: 0.8rem; color: #a9a4c9 !important; }
  .after a { color: #ff8fbe; }
  .disclaimer { margin-top: 1.5rem; color: #a9a4c9; font-size: 0.82rem; }
</style>

<script>
  const COLS = 16, ROWS = 10;
  // 좌석 라운드별: 빈 좌석 개수, 빈 좌석이 남아있는 시간(ms) - 갈수록 많이/빨리 사라진다.
  const ROUNDS = [
    { n: 3, life: 1500 },
    { n: 4, life: 1150 },
    { n: 5, life: 900 },
  ];
  const TOTAL_SEATS = ROUNDS.reduce((a, r) => a + r.n, 0);
  const BEST_KEY = 'krconcerts:practice-best';
  const BTN_GIVEUP_MS = 4000; // 오픈 후 이 시간 안에 못 누르면 놓친 걸로 친다

  const $ = (id: string) => document.getElementById(id)!;
  const grid = $('g-grid');
  const msg = $('g-msg');
  const startBtn = $('g-start') as HTMLButtonElement;
  const result = $('g-result');
  const stageEl = $('g-stage');
  const scoreEl = $('g-score');
  const bestEl = $('g-best');
  const siteEl = $('stage-site');
  const seatsEl = $('stage-seats');
  const bookBtn = $('book-btn') as HTMLButtonElement;
  const srvTime = $('srv-time');
  const openAtEl = $('open-at');
  const siteNote = $('site-note');

  const seats: HTMLButtonElement[] = [];
  for (let i = 0; i < COLS * ROWS; i++) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'seat';
    b.setAttribute('aria-label', '좌석');
    b.tabIndex = -1;
    grid.appendChild(b);
    seats.push(b);
  }

  function getBest(): number {
    try { return Number(localStorage.getItem(BEST_KEY)) || 0; } catch { return 0; }
  }
  function setBest(v: number) {
    try { localStorage.setItem(BEST_KEY, String(v)); } catch { /* 저장 불가 환경이면 기록만 안 남는다 */ }
  }
  function renderBest() {
    const b = getBest();
    bestEl.textContent = b ? String(b) : '-';
  }
  renderBest();

  const pad = (n: number, l = 2) => String(n).padStart(l, '0');
  const fmtClock = (ms: number, withMs = true) => {
    const d = new Date(ms);
    const base = `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    return withMs ? `${base}.${pad(d.getMilliseconds(), 3)}` : base;
  };
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  let running = false;
  let score = 0;
  let btnMs = -1;          // 예매 버튼 반응시간 (-1 = 놓침)
  let earlyClicks = 0;
  const reactions: number[] = [];
  let seatsEarly = 0;
  let resultText = '';

  function addScore(d: number) {
    score = Math.max(0, score + d);
    scoreEl.textContent = String(score);
  }

  // ── 1단계: 모의 예매 사이트 ─────────────────────────────────────────────
  async function playSite() {
    stageEl.textContent = '1/2 예매 버튼';
    seatsEl.hidden = true;
    siteEl.hidden = false;
    bookBtn.className = 'book is-wait';
    bookBtn.textContent = '오픈 대기중';
    siteNote.textContent = '서버 시간이 오픈 시각이 되는 순간 버튼을 누르세요';
    msg.textContent = '서버 시간을 잘 보세요! 오픈 전에 누르면 -300';

    // 오픈 시각은 9~12초 뒤의 "정각 초"로 잡아서, 화면의 오픈 시각 숫자와 서버 시간이 정확히 맞아떨어지게 한다.
    const openAt = Math.ceil((Date.now() + 9000 + Math.random() * 3000) / 1000) * 1000;
    openAtEl.textContent = fmtClock(openAt, false);

    let raf = 0;
    const tick = () => {
      srvTime.textContent = fmtClock(Date.now());
      if (Date.now() >= openAt && !bookBtn.classList.contains('is-open')) {
        bookBtn.className = 'book is-open';
        bookBtn.textContent = '예매하기';
        siteNote.textContent = '지금이에요!';
      }
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);

    await new Promise<void>((resolve) => {
      let finished = false;
      const finish = () => { if (finished) return; finished = true; bookBtn.onpointerdown = null; resolve(); };
      bookBtn.onpointerdown = () => {
        const now = Date.now();
        if (now < openAt) {
          earlyClicks++;
          addScore(-300);
          bookBtn.classList.remove('shake'); void bookBtn.offsetWidth; bookBtn.classList.add('shake');
          siteNote.textContent = '아직 예매 시간이 아닙니다! (-300)';
          return;
        }
        btnMs = now - openAt;
        addScore(Math.max(0, Math.round(2000 - btnMs * 4)));
        finish();
      };
      // 오픈 후 일정 시간 안에 못 누르면 놓친 것
      const giveUp = setInterval(() => {
        if (finished) { clearInterval(giveUp); return; }
        if (Date.now() >= openAt + BTN_GIVEUP_MS) { clearInterval(giveUp); siteNote.textContent = '너무 늦었어요 😭'; finish(); }
      }, 100);
    });
    cancelAnimationFrame(raf);
    msg.textContent = btnMs >= 0 ? `예매 버튼 반응 ${btnMs}ms! 좌석 선택으로 이동해요...` : '버튼을 놓쳤어요. 좌석 선택으로 이동해요...';
    await sleep(1100);
    siteEl.hidden = true;
  }

  // ── 2단계: 좌석 선택 ────────────────────────────────────────────────────
  function resetSeats() { seats.forEach((s) => { s.className = 'seat'; }); }

  async function playSeatRound(idx: number) {
    const cfg = ROUNDS[idx];
    stageEl.textContent = `2/2 좌석 ${idx + 1}라운드`;
    resetSeats();
    msg.textContent = `좌석 ${idx + 1}라운드 - 곧 열려요. 신호 전에 누르면 감점!`;

    const wait = 1200 + Math.random() * 1800;
    let signaled = false;
    const onEarly = (e: Event) => {
      if (signaled) return;
      if ((e.target as HTMLElement).classList.contains('seat')) {
        seatsEarly++;
        addScore(-100);
        msg.textContent = '앗, 너무 일찍 눌렀어요! -100';
      }
    };
    grid.addEventListener('pointerdown', onEarly);
    await sleep(wait);
    grid.removeEventListener('pointerdown', onEarly);

    const pool = seats.map((_, i) => i).sort(() => Math.random() - 0.5).slice(0, cfg.n);
    signaled = true;
    msg.textContent = '오픈! 초록 좌석을 눌러요!';
    const t0 = performance.now();

    await new Promise<void>((resolve) => {
      let remaining = cfg.n;
      const finishOne = () => { remaining--; if (remaining === 0) resolve(); };
      pool.forEach((i) => {
        const seat = seats[i];
        seat.classList.add('open');
        let done = false;
        // 다른 사람이 채가는 시점은 좌석마다 조금씩 다르다
        const timer = setTimeout(() => {
          if (done) return;
          done = true;
          seat.classList.remove('open');
          seat.classList.add('lost');
          finishOne();
        }, cfg.life * (0.7 + Math.random() * 0.6));
        seat.onpointerdown = () => {
          if (done || !seat.classList.contains('open')) return;
          done = true;
          clearTimeout(timer);
          const rt = performance.now() - t0;
          reactions.push(rt);
          addScore(Math.max(50, Math.round(1000 - rt * 0.5)));
          seat.classList.remove('open');
          seat.classList.add('got');
          finishOne();
        };
      });
    });
    seats.forEach((s) => { s.onpointerdown = null; });
    await sleep(700);
  }

  function gradeFor(total: number) {
    if (total >= 10500) return '🏆 피켓팅 신';
    if (total >= 8000) return '🎫 티켓팅 고수';
    if (total >= 5000) return '🙂 티켓팅 중수';
    if (total >= 2500) return '🌱 티켓팅 초보';
    return '😭 오늘은 손이 느렸어요';
  }

  // 순위(상위 N%): 서버가 준비돼 있지 않거나 실패하면 순위 줄만 조용히 숨긴다.
  async function submitScore(sc: number, got: number, avg: number, btn: number) {
    const rankEl = $('g-rank');
    const noteEl = $('g-rank-note');
    rankEl.hidden = true; noteEl.hidden = true;
    try {
      const r = await fetch('/api/score', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ score: sc, got, avg, btn }),
      });
      if (!r.ok) return;
      const d = await r.json();
      if (d.estimated) {
        rankEl.textContent = `🏅 상위 약 ${d.top}%`;
        noteEl.textContent = '아직 참가자가 적어서, 일반적인 반응속도 샘플 분포를 함께 반영한 추정치예요. 참가자가 쌓이면 실제 순위로 바뀌어요.';
        noteEl.hidden = false;
        resultText = resultText.replace('\n나도', ` · 상위 약 ${d.top}%\n나도`);
      } else {
        rankEl.textContent = `🏅 전체 ${d.total.toLocaleString()}명 중 상위 ${d.top}%`;
        resultText = resultText.replace('\n나도', ` · 상위 ${d.top}%\n나도`);
      }
      rankEl.hidden = false;
    } catch { /* 순위 없이도 게임은 정상 */ }
  }

  async function start() {
    if (running) return;
    running = true;
    score = 0; btnMs = -1; earlyClicks = 0; seatsEarly = 0; reactions.length = 0;
    scoreEl.textContent = '0';
    result.hidden = true;
    startBtn.disabled = true;

    await playSite();
    seatsEl.hidden = false;
    for (let i = 0; i < ROUNDS.length; i++) await playSeatRound(i);
    seatsEl.hidden = true;

    const got = reactions.length;
    const avg = got ? Math.round(reactions.reduce((a, b) => a + b, 0) / got) : 0;
    const best = getBest();
    const isBest = score > best;
    if (isBest) setBest(score);
    renderBest();
    const grade = gradeFor(score);
    $('g-grade').textContent = grade;
    $('g-detail').textContent =
      `예매 버튼 ${btnMs >= 0 ? btnMs + 'ms' : '놓침'}${earlyClicks ? ` (일찍 누름 ${earlyClicks}회)` : ''}` +
      ` · 좌석 ${TOTAL_SEATS}개 중 ${got}개 (평균 ${avg || '-'}ms)` +
      ` · 점수 ${score}점${isBest ? ' · 🎉 최고 기록!' : ''}`;
    result.hidden = false;
    stageEl.textContent = '끝';
    msg.textContent = '끝! 결과를 공유해보세요';
    resultText = `직관냥 티켓팅 연습 ${grade} · 예매 버튼 ${btnMs >= 0 ? btnMs + 'ms' : '놓침'} · 좌석 ${got}/${TOTAL_SEATS} · ${score}점\n나도 해보기 👉 ${location.origin}/practice/`;
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    submitScore(score, got, avg, btnMs);
    startBtn.disabled = false;
    startBtn.textContent = '다시 시작';
    running = false;
  }

  startBtn.addEventListener('click', start);
  $('g-retry').addEventListener('click', start);
  $('g-share').addEventListener('click', async () => {
    try {
      if (navigator.share) { await navigator.share({ text: resultText }); return; }
    } catch { return; } // 사용자가 공유 창을 닫은 경우
    try {
      await navigator.clipboard.writeText(resultText);
      msg.textContent = '결과가 복사됐어요. 붙여넣어 공유하세요!';
    } catch {
      msg.textContent = resultText;
    }
  });
</script>
