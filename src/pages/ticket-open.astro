---
import Mascot from '../components/Mascot.astro';
// 티켓오픈 일정 - 공식 공지로 오픈 시각이 확인된 공연만 모아 보여준다 (없는 시각을 지어내지 않음).
// 정적 빌드라서 "곧 오픈" 목록은 브라우저에서 아직 안 지난 것만 남기고 카운트다운을 붙인다.
import BaseLayout from '../layouts/BaseLayout.astro';
import { upcomingOpenStages, onSaleEvents, upcomingEvents } from '../lib/events';
import { kstDayDiff } from '../lib/openPhase';
import { ticketOpenIcs, ticketOpenGoogleUrl, icsDataUri } from '../lib/ticketAlert';

function openParts(iso: string) {
  const k = new Date(new Date(iso).getTime() + 9 * 3600_000);
  return {
    md: `${k.getUTCMonth() + 1}.${String(k.getUTCDate()).padStart(2, '0')}`,
    hm: `${String(k.getUTCHours()).padStart(2, '0')}:${String(k.getUTCMinutes()).padStart(2, '0')}`,
  };
}
// 선예매·일반예매를 각각 한 줄로. 묶음(오늘/내일/이번 주/그 이후)은 빌드 시점으로 먼저 나누고 브라우저가 다시 나눈다.
const soon = upcomingOpenStages(60).map(({ event, stage, multi }) => ({
  ...event,
  ticketOpenAt: stage.at,
  stageLabel: multi ? stage.label : '',
}));
const groupOf = (iso: string, now = Date.now()) => {
  const d = kstDayDiff(iso, now);
  return d <= 0 ? '오늘' : d === 1 ? '내일' : d <= 7 ? '이번 주' : '그 이후';
};
const nowMs = Date.now();
// 최근 2주 안에 막 오픈했고 아직 공연이 안 끝난 공연
const recent = upcomingEvents()
  .filter((e) => e.ticketOpenAt)
  .filter((e) => {
    const t = new Date(e.ticketOpenAt as string).getTime();
    return t < nowMs && t >= nowMs - 14 * 86400_000;
  })
  .sort((a, b) => (b.ticketOpenAt as string).localeCompare(a.ticketOpenAt as string))
  .slice(0, 8);
const onSale = onSaleEvents(12);

const shortDate = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getMonth() + 1}.${d.getDate()}`;
};
const clockHref = (e: { ticketOpenAt?: string; artist: string }) =>
  `/ticketing-clock/?open=${encodeURIComponent(e.ticketOpenAt as string)}&artist=${encodeURIComponent(e.artist)}`;
const alertOf = (e: { id: string; artist: string; ticketOpenAt?: string; stageLabel?: string }) =>
  ({ id: e.id, artist: e.stageLabel ? `${e.artist} ${e.stageLabel}` : e.artist, ticketOpenAt: e.ticketOpenAt as string });
---
<BaseLayout
  title="티켓오픈 일정 - 내한공연 예매 오픈 캘린더"
  description="곧 열리는 내한공연·페스티벌 티켓오픈 일정을 카운트다운과 캘린더 알림으로 한눈에. 오픈 시각은 예매처 공식 공지로 확인된 것만 올려요."
>
  <h1>티켓오픈 일정</h1>
  <div class="intro-row">
  <p class="intro">예매처 공지로 오픈 시각이 확인된 공연만 모아요. 오픈 전에 <a href="/ticketing-clock/">티켓팅 시계</a>를 켜고 <a href="/practice/">연습</a>으로 손을 풀어보세요.</p>
    <figure class="nooeul"><Mascot size={92} pose="wave" who="cheese" /><figcaption>오픈 시각은 노을이가 매일 확인해요</figcaption></figure>
  </div>
  <p class="push-guide">휴대폰으로 오픈 알림을 받으려면 각 공연의 <b>알림 받기</b>를 눌러요. 아이폰은 먼저 홈 화면에 추가해야 해요. <a href="/alerts/">알림 받는 법</a></p>
  <p class="push-msg" data-push-msg role="status" hidden></p>

  <section aria-label="곧 오픈하는 티켓">
    <h2 class="sec mono">곧 열리는 티켓</h2>
    {soon.length > 0 ? (
      <>
        <ul class="open-list" id="soon-list">
          {soon.map((e, i) => (
            <>
            {(i === 0 || groupOf(soon[i - 1].ticketOpenAt) !== groupOf(e.ticketOpenAt)) && (
              <li class="grp mono" data-grp>{groupOf(e.ticketOpenAt)}</li>
            )}
            <li data-open-at={e.ticketOpenAt} data-id={e.id} data-artist={e.stageLabel ? `${e.artist} ${e.stageLabel}` : e.artist}>
              <p class="open-when mono">{openParts(e.ticketOpenAt as string).md} <span>{openParts(e.ticketOpenAt as string).hm}</span></p>
              <div class="open-body">
              <div class="open-head">
                <a class="open-title" href={`/events/${e.id}/`}>{e.artist}{e.stageLabel && <>{' '}<em class="open-stage">{e.stageLabel}</em></>}</a>
                <span class="open-left" data-left></span>
              </div>
              <p class="open-meta">공연 {shortDate(e.startDate)} · {e.venue}</p>
              <div class="open-actions">
                <a class="oa primary" href={clockHref(e)}>시계</a>
                <a class="oa" href={ticketOpenGoogleUrl(alertOf(e))} target="_blank" rel="noopener noreferrer">구글</a>
                <a class="oa" href={icsDataUri(ticketOpenIcs([alertOf(e)]))} download={`${e.id}-ticket-open.ics`}>.ics</a>
                <button class="oa oa-push" type="button" data-push-id={e.id} aria-pressed="false" hidden>알림 받기</button>
                <button class="bookmark-btn" type="button" data-bookmark-id={e.id} aria-label={`${e.artist} 찜하기`} aria-pressed="false">♡</button>
              </div>
              </div>
            </li>
            </>
          ))}
        </ul>
        <p class="bulk"><a class="oa" href="/calendar/">캘린더로 구독하기</a> <button type="button" id="bulk-ics" class="oa primary">곧 오픈 전체를 캘린더에 저장 (.ics)</button> <small>하루 전·10분 전에 알려줘요</small></p>
      </>
    ) : (
      <p class="empty">지금 확인된 오픈 예정은 없어요. 매일 예매처 공지를 확인해서 새 오픈이 보이면 바로 올려요.</p>
    )}
    <p id="soon-empty" class="empty" hidden>곧 열리는 오픈은 모두 지났어요. 새 일정이 확인되면 여기에 올라와요.</p>
  </section>

  {recent.length > 0 && (
    <section aria-label="최근 오픈한 티켓">
      <h2 class="sec mono">최근에 열린 예매</h2>
      <ul class="plain-list">
        {recent.map((e) => (
          <li>
            <a href={`/events/${e.id}/`}><strong>{e.artist}</strong></a>
            <span>{e.ticketOpenDate ?? ''} 오픈 · 공연 {shortDate(e.startDate)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {onSale.length > 0 && (
    <section aria-label="지금 예매 중인 공연">
      <h2 class="sec">지금 예매 중</h2>
      <ul class="plain-list">
        {onSale.map((e) => (
          <li>
            <a href={`/events/${e.id}/`}><strong>{e.artist}</strong></a>
            <span>{shortDate(e.startDate)} · {e.venue}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="note">오픈 시각은 예매처 사정으로 바뀔 수 있어요. 예매 전에 꼭 공식 공지를 다시 확인하세요. 새 오픈 소식은 직관냥이 매일 확인해 이 페이지에 올려요.</p>
</BaseLayout>

<style>
  .intro { color: var(--fg-2); line-height: 1.7; }
  .intro a { color: var(--cheese); }
  .intro-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.2rem; }
  .intro-row .intro { margin-bottom: 0; }
  .nooeul { flex: none; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
  .nooeul figcaption { font-size: 0.75rem; color: var(--muted); white-space: nowrap; }
  @media (max-width: 560px) { .nooeul :global(svg) { width: 70px; height: auto; } .nooeul figcaption { display: none; } }
  h2 { margin: 1.6rem 0 0.7rem; }
  .open-list { list-style: none; margin: 0 0 0.9rem; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .open-list li { padding: 0.8rem 0.95rem; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); }
  .open-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; }
  .open-title { color: var(--fg); font-weight: 800; font-size: 1rem; text-decoration: none; min-width: 0; }
  .open-title:hover { color: var(--cheese); }
  .open-left { color: var(--fg-2); font-weight: 700; font-size: 0.86rem; white-space: nowrap; }
  .open-meta { margin: 0.3rem 0 0.6rem; color: var(--muted); font-size: 0.84rem; line-height: 1.5; }
  .open-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .oa { padding: 0.35rem 0.8rem; border-radius: 6px; font-size: 0.82rem; font-weight: 700; text-decoration: none; color: var(--fg); border: 1px solid var(--line-2); background: transparent; cursor: pointer; }
  .oa.primary { background: var(--btn); color: var(--ink); border-color: transparent; }
  .open-actions .bookmark-btn { margin-left: auto; }
  .oa-push.is-on { border-color: var(--eye); color: var(--eye); }
  .oa-push:disabled { opacity: 0.6; cursor: default; }
  .push-guide { margin: 1rem 0 0; font-size: 0.9rem; color: var(--fg-3); line-height: 1.65; }
  .push-guide b { color: var(--fg); }
  .push-guide a { color: var(--cheese); font-weight: 700; white-space: nowrap; }
  .push-msg { position: sticky; top: 4.6rem; z-index: 5; margin: 0.6rem 0 0; padding: 0.7rem 0.9rem; background: var(--card); border: 1px solid var(--line-2); border-radius: 4px; font-size: 0.88rem; color: var(--fg-2); line-height: 1.55; }
  .push-msg[hidden] { display: none; }
  .push-msg a { color: var(--cheese); font-weight: 700; }
  .bulk { margin: 0 0 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .bulk small { color: var(--muted); }
  .plain-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .plain-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.7rem; padding: 0.55rem 0.85rem; background: rgba(255,255,255,0.04); border-radius: 8px; }
  .plain-list a { color: var(--fg); text-decoration: none; }
  .plain-list a:hover { color: var(--cheese); }
  .plain-list span { color: var(--muted); font-size: 0.84rem; }
  .empty { color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding: 0.85rem 1rem; background: rgba(255,255,255,0.04); border-radius: 8px; }
  .note { margin-top: 1.8rem; padding: 0.9rem 1rem; background: rgba(255,255,255,0.05); border-radius: 8px; color: var(--muted); font-size: 0.82rem; line-height: 1.6; }
  /* ── 랜딩 톤: 큰 시간 숫자 행 ── */
  .intro { max-width: 40rem; color: var(--fg-3); }
  h2.sec { margin: 2.4rem 0 0; padding-bottom: 0.7rem; border-bottom: 1px solid var(--line); font-size: 1.05rem; letter-spacing: -.02em; color: var(--fg); font-weight: 800; }
  .open-list { gap: 0; margin: 0 0 1rem; }
  .open-list li { display: grid; grid-template-columns: 8.2em 1fr; font-size: clamp(1.5rem, 3.6vw, 2.6rem); column-gap: 1.6rem; align-items: start; padding: 1.2rem 0.2rem; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; background: transparent; }
  .open-when { margin: 0; font-weight: 900; letter-spacing: -.02em; line-height: 1.05; white-space: nowrap; }
  .open-when span { color: var(--eye); }
  .open-body { min-width: 0; font-size: 1rem; padding-top: 0.2em; }
  .open-title { font-size: clamp(1.05rem, 2vw, 1.4rem); }
  .open-left { color: var(--eye); font-variant-numeric: tabular-nums; font-size: 0.85rem; }
  .oa { border-radius: 4px; }
  .oa.primary { border-color: transparent; }
  .empty, .note { border-radius: 4px; }
  /* 목록은 상자를 반복하지 않고 선으로만 나눈다 */
  .plain-list { gap: 0; }
  .plain-list li { padding: 0.75rem 0.2rem; background: transparent; border-radius: 0; border-bottom: 1px solid var(--line); }
  .plain-list span { font-variant-numeric: tabular-nums; }
  .note { background: transparent; border-top: 1px solid var(--line); border-radius: 0; padding: 1rem 0.2rem 0; }
  .open-list li.grp { display: block; font-size: 0.8rem; color: var(--muted); font-weight: 700; padding: 1.4rem 0.2rem 0.3rem; border-bottom: 1px solid var(--line); }
  /* 단계 이름은 한 덩어리로 줄바꿈한다("선예/매"처럼 쪼개지지 않게) */
  .open-stage { display: inline-block; white-space: nowrap; font-style: normal; font-size: 0.8em; color: var(--fg-2); font-weight: 700; padding: 0.1em 0.45em; border: 1px solid var(--line-2); border-radius: 4px; vertical-align: 0.1em; }
  @media (max-width: 560px) { .open-list li.grp { grid-template-columns: none; } .open-list li { grid-template-columns: 1fr; row-gap: 0.5rem; } .open-body { padding-top: 0; } }
</style>

<script>
  import { pushSupport, serverKey, alertEvents, enableAlert, disableAlert } from '../lib/pushClient';

  // 공연마다 '알림 받기'. 지금 기기에서 바로 켤 수 없으면(아이폰 사파리, 앱 안 브라우저 등) 안내 페이지로 보낸다.
  const pushBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-push-id]'));
  const pushMsg = document.querySelector<HTMLElement>('[data-push-msg]');
  const sayPush = (html: string) => { if (!pushMsg) return; pushMsg.innerHTML = html; pushMsg.hidden = !html; };
  const paintPush = () => {
    const on = new Set(alertEvents());
    pushBtns.forEach((b) => {
      const x = on.has(b.dataset.pushId ?? '');
      b.classList.toggle('is-on', x);
      b.setAttribute('aria-pressed', String(x));
      b.textContent = x ? '알림 켜짐 ✓' : '알림 받기';
    });
  };
  serverKey().then((key) => {
    if (!key) return; // 서버에 알림 기능이 없으면 버튼을 숨긴 채 둔다
    pushBtns.forEach((b) => { b.hidden = false; });
    paintPush();
  });
  window.addEventListener('push-alerts:changed', paintPush);
  const GUIDE_HASH: Record<string, string> = { 'ios-install': '#ios-1', 'inapp-ios': '#ios-0', 'inapp-android': '#android', denied: '#trouble', unsupported: '' };
  pushBtns.forEach((b) => b.addEventListener('click', async () => {
    const support = pushSupport();
    if (support !== 'ok') { location.href = `/alerts/${GUIDE_HASH[support] ?? ''}`; return; }
    const id = b.dataset.pushId ?? '';
    const on = alertEvents().includes(id);
    b.disabled = true;
    const r = on ? await disableAlert(id) : await enableAlert(id);
    b.disabled = false;
    paintPush();
    if (r === 'on') sayPush('알림을 켰어요. 오픈 하루 전, 30분 전, 10분 전에 이 기기로 알려드려요.');
    else if (r === 'off') sayPush('이 공연 알림을 껐어요.');
    else if (r === 'denied') sayPush('알림 권한이 허용되지 않았어요. <a href="/alerts/#trouble">다시 허용하는 방법</a>');
    else sayPush('알림을 설정하지 못했어요. 잠시 뒤 다시 시도해 주세요.');
  }));

  import { ticketOpenIcs } from '../lib/ticketAlert';
  import { kstDayDiff } from '../lib/openPhase';

  const list = document.getElementById('soon-list');
  const items = Array.from(document.querySelectorAll<HTMLElement>('#soon-list > li[data-open-at]'));
  const groupOf = (t: number, now: number) => {
    const d = kstDayDiff(new Date(t).toISOString(), now);
    return d <= 0 ? '오늘' : d === 1 ? '내일' : d <= 7 ? '이번 주' : '그 이후';
  };
  // 오늘/내일/이번 주/그 이후 묶음을 지금 시각 기준으로 다시 만든다
  function regroup(now: number) {
    if (!list) return;
    list.querySelectorAll('[data-grp]').forEach((g) => g.remove());
    let prev = '';
    items.forEach((li) => {
      if (li.hidden) return;
      const g = groupOf(new Date(li.dataset.openAt ?? '').getTime(), now);
      if (g !== prev) {
        const h = document.createElement('li');
        h.className = 'grp mono';
        h.dataset.grp = '';
        h.textContent = g;
        list.insertBefore(h, li);
        prev = g;
      }
    });
  }
  const bulk = document.getElementById('bulk-ics') as HTMLButtonElement | null;
  const emptyMsg = document.getElementById('soon-empty');

  function render() {
    const now = Date.now();
    let alive = 0;
    items.forEach((li) => {
      const t = new Date(li.dataset.openAt ?? '').getTime();
      const left = li.querySelector<HTMLElement>('[data-left]');
      if (isNaN(t)) return;
      if (t < now - 3600_000) { li.hidden = true; return; } // 오픈 1시간 지난 건 숨김
      alive++;
      if (!left) return;
      const diff = t - now;
      if (diff <= 0) { left.textContent = '오픈!'; return; }
      const s = Math.floor(diff / 1000);
      const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
      left.textContent = d > 0 ? `${d}일 ${h}시간 후` : h > 0 ? `${h}시간 ${m}분 후` : `${m}분 후`;
    });
    regroup(now);
    if (emptyMsg) emptyMsg.hidden = items.length === 0 || alive > 0;
    if (bulk) bulk.hidden = alive === 0;
  }
  render();
  setInterval(render, 30_000);

  bulk?.addEventListener('click', () => {
    const now = Date.now();
    const events = items
      .filter((li) => new Date(li.dataset.openAt ?? '').getTime() >= now - 3600_000)
      .map((li) => ({
        id: li.dataset.id as string,
        artist: li.dataset.artist ?? '',
        ticketOpenAt: li.dataset.openAt as string,
        key: (li.dataset.openAt as string).replace(/\D/g, '').slice(0, 12),
      }));
    if (events.length === 0) return;
    const blob = new Blob([ticketOpenIcs(events)], { type: 'text/calendar;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'jikgwannyang-ticket-open.ics';
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
