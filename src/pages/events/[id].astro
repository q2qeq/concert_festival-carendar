    </div>
  )}
</BaseLayout>

<script>
  // Right-side TOC scrollspy: highlight whichever section is currently
  // nearest the top of the viewport. Purely cosmetic - safe no-op if the
  // nav or sections aren't present (e.g. short pages skip the TOC).
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.event-toc a[data-toc-for]');
  if (tocLinks.length > 0) {
    const sections = Array.from(tocLinks)
      .map((a) => document.getElementById(a.dataset.tocFor || ''))
      .filter((el): el is HTMLElement => !!el);

    const setActive = (id: string) => {
      tocLinks.forEach((a) => a.classList.toggle('active', a.dataset.tocFor === id));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) {
          const topMost = visible.reduce((a, b) => (a.boundingClientRect.top < b.boundingClientRect.top ? a : b));
          setActive((topMost.target as HTMLElement).id);
        }
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: 0 }
    );
    sections.forEach((el) => observer.observe(el));
  }

  // Toggle-button + popover behaviour shared by "캘린더 추가" and "티켓 예매" in
  // the sticky action bar - opens on click, closes on outside click, Escape, or
  // re-toggling. Set up once per (toggle id, popover id) pair.
  function setupActionPopover(toggleId: string, popoverId: string) {
    const toggle = document.getElementById(toggleId);
    const popover = document.getElementById(popoverId);
    if (!toggle || !popover) return;
    const close = () => {
      popover.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', (ev) => {
      ev.stopPropagation();
      if (popover.hidden) {
        popover.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
      } else {
        close();
      }
    });
    document.addEventListener('click', (ev) => {
      if (!popover.hidden && !popover.contains(ev.target as Node) && ev.target !== toggle) {
        close();
      }
    });
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') close();
    });
  }
  setupActionPopover('calendar-toggle', 'calendar-popover');
  setupActionPopover('ticket-toggle', 'ticket-popover');

  // 모바일 하단 고정 예매 버튼: 액션바가 화면 위로 지나가면 보이고, 다시 보이면 숨긴다.
  (() => {
    const bar = document.querySelector<HTMLElement>('.ev-info .action-bar');
    const cta = document.getElementById('m-cta');
    if (!bar || !cta) return;
    const sheet = document.getElementById('m-sheet');
    const toggle = document.getElementById('m-toggle');
    const close = () => { if (sheet) sheet.hidden = true; toggle?.setAttribute('aria-expanded', 'false'); };
    const io = new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      cta.hidden = !show;
      document.body.classList.toggle('has-mcta', show);
      if (!show) close();
    }, { threshold: 0 });
    io.observe(bar);
    toggle?.addEventListener('click', () => {
      if (!sheet) return;
      sheet.hidden = !sheet.hidden;
      toggle.setAttribute('aria-expanded', String(!sheet.hidden));
    });
    document.addEventListener('click', (e) => { if (!cta.contains(e.target as Node)) close(); });
  })();
</script>

