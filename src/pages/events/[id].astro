---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import CharacterNote from '../../components/CharacterNote.astro';
import UpdateLog from '../../components/UpdateLog.astro';
import VenueInfoBox from '../../components/VenueInfoBox.astro';
import ShuttleInfo from '../../components/ShuttleInfo.astro';
import SourceList from '../../components/SourceList.astro';
import MerchGrid from '../../components/MerchGrid.astro';
import PresaleInfo from '../../components/PresaleInfo.astro';
import PreviousEditionCompare from '../../components/PreviousEditionCompare.astro';
import AddToCalendar from '../../components/AddToCalendar.astro';
import SetlistBox from '../../components/SetlistBox.astro';
import YoutubeEmbeds from '../../components/YoutubeEmbeds.astro';
import { events, festivalLineupDays, allTicketLinks, TICKETING_DIFFICULTY_LABEL } from '../../lib/events';
import { isShuttleLikely } from '../../lib/venues';

export function getStaticPaths() {
  return events.map((e) => ({ params: { id: e.id }, props: { event: e } }));
}

const { event } = Astro.props;

const WEEKDAYS = ['일', '월', '화', '수', '목', '금', '토'];

function fmtFull(iso: string) {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일`;
}
function fmtDay(iso: string) {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getMonth() + 1}월 ${d.getDate()}일 (${WEEKDAYS[d.getDay()]})`;
}
const dateLabel = event.startDate === event.endDate
  ? fmtFull(event.startDate)
  : `${fmtFull(event.startDate)} ~ ${fmtFull(event.endDate)}`;

const pageDescription = event.description
  ? `${event.description} (${dateLabel}, ${event.venue})`
  : `${event.artist} ${event.city} 공연 - ${dateLabel}, ${event.venue}`;

// 한 공연을 여러 사이트에서 판매하는 경우(예: 인터파크 + NOL티켓) 벤더별로
// 버튼을 각각 만든다 - 하나만 대표로 골라 보여주지 않는다.
const ticketLinks = allTicketLinks(event);
const links = [
  ...ticketLinks.map((t, i) => ({
    label: t.note ? `${t.vendor} 예매 (${t.note})` : `${t.vendor} 예매`,
    url: t.url,
    primary: i === 0,
  })),
  // 공식 홈페이지는 원래도 항상 노출되지만, 페스티벌은 라인업 공지 등 최신 정보가
  // 공식 채널에서만 확인 가능한 경우가 많아 primary(강조) 처리한다.
  event.officialUrl && {
    label: '공식 홈페이지·공지',
    url: event.officialUrl,
    primary: ticketLinks.length === 0 && event.genre === '페스티벌',
  },
  event.mdUrl && { label: 'MD·굿즈 스토어', url: event.mdUrl },
  event.fanclubUrl && { label: '팬클럽', url: event.fanclubUrl },
].filter(Boolean) as { label: string; url: string; primary?: boolean }[];

// 페이지 상단 고정 액션바에 노출할 대표 링크 하나 - 예매 링크가 있으면 그게
// 최우선, 없으면 공식 홈페이지 등 links[0]이 이미 그 순서로 정렬돼 있다.
const primaryLink = links.find((l) => l.primary) ?? links[0];

// 공식 홈페이지는 액션바에서 예매 링크와 별개로 항상 눌러볼 수 있게 노출한다 -
// primaryLink로 이미 뽑힌 것과 같은 URL이면 중복 버튼을 만들지 않는다.
const officialActionUrl =
  event.officialUrl && event.officialUrl !== primaryLink?.url ? event.officialUrl : null;

// 액션바에 이미 실제 버튼(예매 대표 링크·공식 홈페이지)으로 떠 있는 URL은
// 아래 예매·티켓팅 섹션에서 또 보여주지 않는다 - 같은 버튼이 화면 안에 두 번
// 뜨는 걸 막기 위함. MD·팬클럽이나 대표가 아닌 다른 예매처 링크는 액션바에
// 없으니 여기서만 보인다.
const actionBarUrls = new Set([primaryLink?.url, officialActionUrl].filter(Boolean));
const ticketSectionLinks = links.filter((l) => !actionBarUrls.has(l.url));

// 셔틀버스 섹션은 (1) 실제 확인된 shuttleBus 데이터가 있거나, (2) 셔틀이 있을
// 확률이 높은 공연장(lib/venues.ts의 isShuttleLikely)이면 항상 노출한다 - 못
// 찾았다고 조용히 섹션 자체를 숨기지 않고, 확인 방법을 안내하는 대체 UI를 보여준다.
const showShuttleSection = (event.shuttleBus && event.shuttleBus.length > 0) || isShuttleLikely(event.venue);

// 페스티벌 라인업이 이 숫자를 넘으면 요약만 먼저 보여주고 <details>로 접어
// 30팀 안팎인 대형 페스티벌 페이지가 아티스트 이름 벽으로 압도하지 않게 한다.
const LINEUP_COLLAPSE_THRESHOLD = 12;
const LINEUP_PREVIEW_COUNT = 6;
const lineupDays = festivalLineupDays(event);
const lineupTotal = lineupDays.reduce((sum, d) => sum + d.acts.length, 0);
const isFestival = event.genre === '페스티벌';

// 이 공연 페이지에 실제로 존재하는 섹션만 골라 오른쪽 목차(TOC)를 만든다 -
// 이벤트마다 보유 정보가 달라서 하드코딩된 고정 목록을 쓰면 빈 링크가 생긴다.
const tocItems = [
  { id: 'overview', label: '공연 정보' },
  (links.length > 0 || (event.presale && event.presale.length > 0)) && { id: 'tickets', label: '예매·티켓팅' },
  isFestival && { id: 'lineup', label: '라인업' },
  event.previousEditions && event.previousEditions.length > 0 && { id: 'compare', label: '이전 회차 비교' },
  event.funFacts && event.funFacts.length > 0 && { id: 'notes', label: '직관냥 포인트' },
  event.merch && event.merch.length > 0 && { id: 'merch', label: '굿즈' },
  event.setlists && event.setlists.length > 0 && { id: 'setlist', label: '셋리스트' },
  event.youtubeVideos && event.youtubeVideos.length > 0 && { id: 'videos', label: '영상' },
  event.updates && event.updates.length > 0 && { id: 'updates', label: '업데이트' },
  showShuttleSection && { id: 'shuttle', label: '셔틀버스' },
  { id: 'venue', label: '공연장 정보' },
  event.sources && event.sources.length > 0 && { id: 'sources', label: '출처' },
].filter(Boolean) as { id: string; label: string }[];

// schema.org structured data for Google's Event rich results.
// `offers` is only included when we have a real ticket URL - never fabricated.
// Google's structured data guidance: for a postponed event with no new date,
// omit startDate/endDate and use previousStartDate instead; for a cancelled
// event, keep the original startDate. https://schema.org/EventPostponed
const EVENT_STATUS_MAP = {
  scheduled: 'https://schema.org/EventScheduled',
  postponed: 'https://schema.org/EventPostponed',
  cancelled: 'https://schema.org/EventCancelled',
};
const status = event.status ?? 'scheduled';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  name: event.artist,
  eventStatus: EVENT_STATUS_MAP[status],
  ...(status === 'postponed'
    ? { previousStartDate: event.startDate }
    : { startDate: event.startDate, endDate: event.endDate }),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: event.venue,
    address: {
      '@type': 'PostalAddress',
      addressLocality: event.city,
      addressCountry: 'KR',
    },
  },
  description: event.description ?? pageDescription,
  performer: {
    '@type': 'PerformingGroup',
    name: event.artist,
  },
  ...(event.posterUrl ? { image: event.posterUrl } : {}),
  ...(ticketLinks.length > 0 && status === 'scheduled'
    ? {
        offers: ticketLinks.map((t) => ({
          '@type': 'Offer',
          url: t.url,
          availability: 'https://schema.org/InStock',
        })),
      }
    : {}),
};
---
<BaseLayout
  title={`${event.artist} 내한공연 일정 및 예매 팁`}
  description={pageDescription}
  image={event.posterUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {tocItems.length > 2 && (
    <nav class="event-toc" aria-label="이 페이지의 정보">
      <ul>
        {tocItems.map((item) => (
          <li><a href={`#${item.id}`} data-toc-for={item.id}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  )}

  <article>
    <p class="breadcrumb"><a href="/">← 전체 일정</a></p>

    {event.posterUrl && (
      <img
        class="poster"
        src={event.posterUrl}
        alt={`${event.artist} 공식 포스터`}
        loading="lazy"
        width="400"
        height="560"
      />
    )}

    <header class="event-header">
      <div class="dday-badge big" data-dday-start={event.startDate} data-dday-end={event.endDate} data-status={status}>—</div>
      <div>
        <h1>{event.artist}</h1>
        <p class="meta">{dateLabel} · {event.venue} ({event.city})</p>
      </div>
    </header>

    {status === 'postponed' && (
      <p class="status-banner status-postponed">
        이 공연은 연기되었습니다. 재개최 일정이 정해지지 않았다면 아래 안내를 확인하세요.
      </p>
    )}
    {status === 'cancelled' && (
      <p class="status-banner status-cancelled">이 공연은 취소되었습니다.</p>
    )}
    {event.ticketingAnnounced && ticketLinks.length === 0 && (
      <p class="status-banner status-announced">
        티켓 오픈 예정 공연이에요{event.ticketOpenDate ? ` — 오픈: ${event.ticketOpenDate}` : ''}. 오픈되면 이 페이지에 바로 예매 링크를 추가할게요.
      </p>
    )}

    <div class="action-bar" aria-label="빠른 이용">
      {primaryLink && (
        <a class="ab-btn ab-primary" href={primaryLink.url} target="_blank" rel="noopener noreferrer">
          {primaryLink.label}
        </a>
      )}
      {officialActionUrl && (
        <a class="ab-btn" href={officialActionUrl} target="_blank" rel="noopener noreferrer">공식 홈페이지</a>
      )}
      {status === 'scheduled' && <a class="ab-btn" href="#calendar">캘린더 추가</a>}
      <a class="ab-btn" href="#sightline">공연장 시야</a>
      {showShuttleSection && (
        <a class="ab-btn" href="#shuttle">셔틀버스</a>
      )}
      <button
        class="ab-btn ab-bookmark bookmark-btn"
        type="button"
        data-bookmark-id={event.id}
        aria-label={`${event.artist} 찜하기`}
        aria-pressed="false"
      >♡</button>
    </div>

    <AdSlot slot="event-top" />

    <section id="overview">
      <h2 class="section-h2">공연 정보</h2>
      {event.description && <p class="lead">{event.description}</p>}
      {/* 일정·장소는 바로 위 헤더(D-day 배지 + {dateLabel} · {event.venue})에 이미
          크게 나와 있으므로 여기서 또 나열하지 않는다 - 헤더에는 없는 정보
          (장르·타임테이블·난이도)만 보여준다. */}
      <dl class="facts">
        <div><dt>장르</dt><dd>{event.genre}</dd></div>
        {event.schedule && <div><dt>타임테이블</dt><dd>{event.schedule}</dd></div>}
        {event.ticketingDifficulty && (
          <div><dt>티켓팅 난이도</dt><dd>{TICKETING_DIFFICULTY_LABEL[event.ticketingDifficulty]}</dd></div>
        )}
      </dl>
      {event.note && <p class="note">{event.note}</p>}
    </section>

    {(links.length > 0 || (event.presale && event.presale.length > 0) || status === 'scheduled') && (
      <section id="tickets">
        <h2 class="section-h2">예매·티켓팅</h2>
        {event.presale && event.presale.length > 0 && <PresaleInfo presale={event.presale} />}
        {ticketSectionLinks.length > 0 && (
          <div class="links">
            {ticketSectionLinks.map((l) => (
              <a
                class={`link-btn ${l.primary ? 'primary' : ''}`}
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {l.label} ↗
              </a>
            ))}
          </div>
        )}
        {status === 'scheduled' && (
          <div id="calendar">
            <AddToCalendar event={event} />
          </div>
        )}
      </section>
    )}

    {isFestival && (
      <section class="lineup-section" id="lineup">
        <h2>라인업{lineupTotal > 0 ? ` (${lineupTotal}팀)` : ''}</h2>
        {lineupDays.length > 0 ? (
          <div class="lineup-days">
            {lineupDays.map((day) => (
              <div class="lineup-day">
                {(day.date || day.label) && (
                  <h3 class="lineup-day-label">{day.date ? fmtDay(day.date) : day.label}</h3>
                )}
                {day.acts.length > LINEUP_COLLAPSE_THRESHOLD ? (
                  <details class="lineup-details">
                    <summary>
                      {day.acts.slice(0, LINEUP_PREVIEW_COUNT).join(' · ')} 외 {day.acts.length - LINEUP_PREVIEW_COUNT}팀
                      <span class="lineup-toggle-hint">전체 라인업 보기</span>
                    </summary>
                    <ul class="lineup-list">
                      {day.acts.map((artist) => <li>{artist}</li>)}
                    </ul>
                  </details>
                ) : (
                  <ul class="lineup-list">
                    {day.acts.map((artist) => <li>{artist}</li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
        ) : (
          <p class="lineup-pending">
            라인업이 아직 이 페이지에 정리되지 않았습니다. 공식 홈페이지·공지에서 최신 라인업을 확인하세요.
          </p>
        )}
      </section>
    )}

    {event.previousEditions && event.previousEditions.length > 0 && (
      <div id="compare">
        <PreviousEditionCompare editions={event.previousEditions} crowdOutlook={event.crowdOutlook} />
      </div>
    )}

    {event.funFacts && event.funFacts.length > 0 && (
      <div id="notes">
        <CharacterNote facts={event.funFacts} />
      </div>
    )}

    {event.merch && event.merch.length > 0 && (
      <div id="merch">
        <MerchGrid items={event.merch} />
      </div>
    )}

    <AdSlot slot="event-mid" />

    {event.setlists && event.setlists.length > 0 && (
      <div id="setlist">
        <SetlistBox setlists={event.setlists} />
      </div>
    )}

    {event.youtubeVideos && event.youtubeVideos.length > 0 && (
      <div id="videos">
        <YoutubeEmbeds videos={event.youtubeVideos} />
      </div>
    )}

    {event.updates && event.updates.length > 0 && (
      <div id="updates">
        <UpdateLog updates={event.updates} />
      </div>
    )}

    {showShuttleSection && (
      <div id="shuttle">
        <ShuttleInfo
          shuttleBus={event.shuttleBus ?? []}
          venue={event.venue}
          artist={event.artist}
          ticketUrl={ticketLinks[0]?.url ?? event.officialUrl}
        />
      </div>
    )}

    <div id="venue">
      <VenueInfoBox venue={event.venue} />
    </div>

    <p class="disclaimer">
      공연 일정·장소·가격 등은 주최측 사정으로 변경될 수 있습니다. 예매 전 반드시 위
      공식 링크 또는 아티스트/기획사 공지에서 최신 정보를 확인하세요.
    </p>

    {event.sources && event.sources.length > 0 && (
      <div id="sources">
        <SourceList sources={event.sources} />
      </div>
    )}

    <AdSlot slot="event-bottom" />
  </article>
</BaseLayout>

<script>
  // Right-side TOC scrollspy: highlight whichever section is currently
  // nearest the top of the viewport. Purely cosmetic - safe no-op if the
  // nav or sections aren't present (e.g. short pages skip the TOC).
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.event-toc a[data-toc-for]');
  if (tocLinks.length > 0) {
    const sections = Array.from(tocLinks)
      .map((a) => document.getElementById(a.dataset.tocFor || ''))
      .filter((el): el is HTMLElement => !!el);

    const setActive = (id: string) => {
      tocLinks.forEach((a) => a.classList.toggle('active', a.dataset.tocFor === id));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) {
          const topMost = visible.reduce((a, b) => (a.boundingClientRect.top < b.boundingClientRect.top ? a : b));
          setActive((topMost.target as HTMLElement).id);
        }
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: 0 }
    );
    sections.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .breadcrumb a { color: #a9a4c9; font-size: 0.9rem; text-decoration: none; }
  .event-header { display: flex; align-items: center; gap: 1.25rem; margin: 1.5rem 0; }
  .dday-badge.big { font-size: 0.95rem; padding: 0.4rem 0.75rem; min-width: 3.75rem; }
  h1 { margin: 0 0 0.25rem; font-size: 1.7rem; }
  .meta { margin: 0; color: #f5f3ff; font-weight: 600; font-size: 1.02rem; }
  .lead { font-size: 1.05rem; color: #e5e2f7; }
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem 1.5rem; margin: 1.5rem 0; }
  .facts dt { color: #a9a4c9; }
  .facts dd { margin: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1rem 0; }
  .link-btn {
    display: inline-block;
    padding: 0.65rem 1.1rem;
    border-radius: 8px;
    background: rgba(255,255,255,0.08);
    color: #f5f3ff;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    transition: background 0.15s, transform 0.15s;
  }
  .link-btn:hover { background: rgba(255,255,255,0.14); transform: translateY(-1px); }
  .link-btn.primary { background: #ff5fa2; color: #101018; }
  .link-btn.primary:hover { background: #ff7bb2; }
  .note { color: #d8d5ef; background: rgba(255,255,255,0.04); padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.9rem; margin-top: 1rem; }
  .disclaimer { margin-top: 2rem; padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 8px; color: #a9a4c9; font-size: 0.85rem; }
  .status-banner {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .status-postponed { background: rgba(255, 184, 76, 0.14); color: #ffb84c; }
  .status-cancelled { background: rgba(255, 95, 95, 0.14); color: #ff6b6b; }
  .status-announced { background: rgba(110, 231, 255, 0.14); color: #6ee7ff; }
  .poster {
    display: block;
    width: 100%;
    max-width: 440px;
    height: auto;
    border-radius: 12px;
    margin: 1.5rem 0 0;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  /* Quick actions bar - sticks under the site header so 캘린더/찜/티켓팅 are
     always reachable without hunting through the page. */
  .action-bar {
    position: sticky;
    top: 3.9rem;
    z-index: 30;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin: 1.1rem 0;
    padding: 0.6rem;
    background: rgba(16, 16, 24, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
  }
  .ab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #f5f3ff;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.14);
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .ab-btn:hover { background: rgba(255,255,255,0.13); }
  .ab-primary { background: #ff5fa2; color: #101018; border-color: #ff5fa2; }
  .ab-primary:hover { background: #ff7bb2; }
  .ab-bookmark { font-size: 1.05rem; padding: 0.4rem 0.7rem; margin-left: auto; }
