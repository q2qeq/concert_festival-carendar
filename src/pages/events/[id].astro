---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import CharacterNote from '../../components/CharacterNote.astro';
import UpdateLog from '../../components/UpdateLog.astro';
import VenueInfoBox from '../../components/VenueInfoBox.astro';
import ShuttleInfo from '../../components/ShuttleInfo.astro';
import SourceList from '../../components/SourceList.astro';
import MerchGrid from '../../components/MerchGrid.astro';
import PreviousEditionCompare from '../../components/PreviousEditionCompare.astro';
import AddToCalendar from '../../components/AddToCalendar.astro';
import TicketBooking from '../../components/TicketBooking.astro';
import FanChantGuide from '../../components/FanChantGuide.astro';
import SetlistBox from '../../components/SetlistBox.astro';
import YoutubeEmbeds from '../../components/YoutubeEmbeds.astro';
import Mascot from '../../components/Mascot.astro';
import NextSteps from '../../components/NextSteps.astro';
import { postsMentioningEvent, postsMentioningVenue, postDateLabel } from '../../lib/posts';
import EventCard from '../../components/EventCard.astro';
import { isShuttleLikely, getVenueInfo, venueSlug } from '../../lib/venues';
import { latestUpdateISO, events, festivalLineupDays, allTicketLinks, festivalHighlightSet, isBuzzing, relatedEvents, isDomestic, artistAliases } from '../../lib/events';

export function getStaticPaths() {
  return events.map((e) => ({ params: { id: e.id }, props: { event: e } }));
}

const { event } = Astro.props;

const WEEKDAYS = ['일', '월', '화', '수', '목', '금', '토'];

function fmtFull(iso: string) {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일`;
}
function fmtDay(iso: string) {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getMonth() + 1}월 ${d.getDate()}일 (${WEEKDAYS[d.getDay()]})`;
}
const dateLabel = event.startDate === event.endDate
  ? fmtFull(event.startDate)
  : `${fmtFull(event.startDate)} ~ ${fmtFull(event.endDate)}`;

const eventYear = event.startDate.slice(0, 4);
// 네이버/구글 검색어("OOO 내한 티켓팅", "OOO 예매처")에 맞춘 제목. 공연 상태에 따라 약속하는 내용이 다르다.
// 국내 아티스트(가요)는 "내한"이 아니라 "콘서트"로 부른다("2026 아이유 콘서트 일정" 검색에 맞춤).
// 같은 이름을 띄어쓰기만 다르게 검색하는 경우("후지이 카제"/"후지이카제")를 위해, 붙여 쓴 표기가 있으면
// 제목 끝(괄호)과 설명·본문에도 넣는다.
const domestic = isDomestic(event);
const aliases = artistAliases(event);
const akaTitle = aliases.length > 0 ? ` (${aliases[0]})` : '';
// 이름에 연도가 이미 들어 있으면(예: "NOL FESTIVAL 2026") 제목에서 연도를 또 붙이지 않는다.
const yp = event.artist.includes(eventYear) ? '' : ` ${eventYear}`;
const titleIsPast = event.endDate < new Date().toISOString().slice(0, 10);
const opensLater = Boolean(event.ticketOpenAt) && new Date(event.ticketOpenAt as string).getTime() > Date.now();
const pageTitle = (event.genre === '페스티벌'
  ? `${event.artist}${yp} 라인업·티켓 예매처 정리`
  : domestic
    ? titleIsPast
      ? `${event.artist}${yp} 콘서트 정보·셋리스트`
      : opensLater
        ? `${event.artist}${yp} 콘서트 일정·티켓오픈·예매처`
        : `${event.artist}${yp} 콘서트 일정·예매처·좌석 시야`
    : titleIsPast
      ? `${event.artist} 내한${yp} 공연 정보·셋리스트`
      : opensLater
        ? `${event.artist} 내한${yp} 티켓오픈 일정·예매처`
        : `${event.artist} 내한${yp} 예매처·좌석·시야 정리`) + akaTitle;

const kindWord = event.genre === '페스티벌' ? '페스티벌' : domestic ? '콘서트' : '내한 공연';
const akaTail = aliases.length > 0 ? ` ${aliases[0]} ${kindWord} 일정·예매 정보.` : '';
const pageDescription = (event.description
  ? `${event.description} (${dateLabel}, ${event.venue})`
  : `${event.artist} ${event.city} 공연 - ${dateLabel}, ${event.venue}`) + akaTail;

// 한 공연을 여러 사이트에서 판매하는 경우(예: 인터파크 + NOL티켓) 벤더별로
// 링크를 전부 모은다 - 액션바의 "티켓 예매" 버튼은 캘린더 추가와 같은
// 토글+팝오버 방식으로, 예매 가능한 모든 사이트를 검색해서 한 번에 목록으로
// 보여준다(사이트 개수만큼 버튼을 늘어놓지 않는다).
const ticketLinks = allTicketLinks(event);
const ticketPopoverLinks = [
  ...ticketLinks.map((t) => ({
    // 레거시 ticketUrl 필드는 vendor가 이미 "티켓 예매"로 채워져 있어(allTicketLinks
    // 참고) 뒤에 "예매"를 또 붙이면 "티켓 예매 예매"처럼 중복된다 - vendor가 이미
    // "예매"로 끝나면 그대로 쓴다.
    label: t.note
      ? `${t.vendor} 예매 (${t.note})`
      : t.vendor.endsWith('예매') ? t.vendor : `${t.vendor} 예매`,
    url: t.url,
  })),
  // 실제 URL이 있는 선예매(presale)는 별도의 "예매·티켓팅" 텍스트 섹션 대신
  // 이 팝오버 안에 함께 보여준다 - 예매 관련 액션을 한 곳에 모아둔다.
  ...(event.presale ?? [])
    .filter((p) => p.url)
    .map((p) => ({ label: `${p.title} (선예매)`, url: p.url as string })),
];

// MD·팬클럽은 "예매"는 아니지만 자주 같이 필요한 액션이라, 있을 때만 액션바에
// 각자 작은 버튼으로 노출한다.
const mdActionUrl = event.mdUrl ?? null;
const fanclubActionUrl = event.fanclubUrl ?? null;

// 예매 가능한 링크가 하나도 없을 때(티켓 오픈 전 페스티벌 등)는 공식
// 홈페이지를 대표 액션으로 쓴다.
const fallbackPrimaryUrl =
  ticketPopoverLinks.length === 0 && event.officialUrl ? event.officialUrl : null;

// 공식 홈페이지는, 이미 대표 액션(fallbackPrimaryUrl)으로 쓰인 게 아니라면
// 티켓 팝오버와 별개로 항상 눌러볼 수 있게 노출한다.
const officialActionUrl =
  event.officialUrl && event.officialUrl !== fallbackPrimaryUrl ? event.officialUrl : null;

// 셔틀버스 섹션 노출 조건 (2026-11-02 변경). 예전에는 모든 공연 페이지에 항상 노출했는데,
// 확정된 셔틀 정보가 있는 공연이 거의 없어서 거의 모든 페이지에 똑같은 3사 안내 박스만 반복돼
// 정보가 아니라 군더더기가 됐다. 그래서 아래 둘 중 하나일 때만 보여준다:
//   1) 확정된 shuttleBus 데이터가 있다 (실제 sourced 셔틀 - 스캔 루틴이 발견한 것 포함)
//   2) 셔틀이 있을 확률이 높은 공연장이다 (isShuttleLikely: 원거리 야외/지방 공연장, 킨텍스·인스파이어 등)
// 그 외(서울 지하철로 바로 가는 공연장)는 섹션과 상단 "셔틀버스" 버튼을 숨긴다.
const hasConfirmedShuttle = (event.shuttleBus?.length ?? 0) > 0;
const showShuttleSection = hasConfirmedShuttle || isShuttleLikely(event.venue);

// 페스티벌 라인업이 이 숫자를 넘으면 요약만 먼저 보여주고 <details>로 접어
// 30팀 안팎인 대형 페스티벌 페이지가 아티스트 이름 벽으로 압도하지 않게 한다.
const LINEUP_COLLAPSE_THRESHOLD = 12;
const LINEUP_PREVIEW_COUNT = 6;
const lineupDays = festivalLineupDays(event);
const lineupTotal = lineupDays.reduce((sum, d) => sum + d.acts.length, 0);
const isFestival = event.genre === '페스티벌';
const highlightSet = festivalHighlightSet(event);
const buzzing = isBuzzing(event);
const buzzHeadlineAct = event.festivalHighlight?.[0]?.act ?? null;
const related = relatedEvents(event);
const lastUpdated = latestUpdateISO(event);
// 큰 제목 + 보조(한글 병기) 분리: "Fujii Kaze (후지이 카제)" → 제목 / 부제
const nameMatch = event.artist.match(/^(.*?)\s*\((.+)\)\s*$/);
const heroName = nameMatch ? nameMatch[1].trim() : event.artist;
const heroSub = nameMatch ? nameMatch[2].trim() : '';
const WD_EN = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
const dotDate = (iso: string) => `${iso.replace(/-/g, '.')} ${WD_EN[new Date(iso + 'T00:00:00').getDay()]}`;
const whenLabel = event.startDate === event.endDate ? dotDate(event.startDate) : `${dotDate(event.startDate)} – ${event.endDate.slice(5).replace('-', '.')}`;
const mentionedEvent = await postsMentioningEvent(event.id);
const mentionedVenue = (await postsMentioningVenue(venueSlug(event.venue))).filter((p) => !mentionedEvent.some((m) => m.id === p.id));
const mentionedIn = [...mentionedEvent, ...mentionedVenue].slice(0, 4);

// 이 공연 페이지에 실제로 존재하는 섹션만 골라 오른쪽 목차(TOC)를 만든다 -
// 이벤트마다 보유 정보가 달라서 하드코딩된 고정 목록을 쓰면 빈 링크가 생긴다.
// 흥미도 높은 걸 위로: 라인업·셋리스트를 먼저, 직관냥 포인트 같은 부가 정보는
// 뒤로 두는 순서가 실제 페이지 본문 순서와 맞춰져 있다.
const tocItems = [
  isFestival && { id: 'lineup', label: '라인업' },
  event.setlists && event.setlists.length > 0 && { id: 'setlist', label: '셋리스트' },
  !isFestival && { id: 'fanchant', label: '떼창·콜 가이드' },
  event.previousEditions && event.previousEditions.length > 0 && { id: 'compare', label: '이전 회차 비교' },
  ((event.merch && event.merch.length > 0) || event.mdUrl) && { id: 'merch', label: 'MD·굿즈' },
  event.funFacts && event.funFacts.length > 0 && { id: 'notes', label: '직관냥 포인트' },
  event.youtubeVideos && event.youtubeVideos.length > 0 && { id: 'videos', label: '영상' },
  event.updates && event.updates.length > 0 && { id: 'updates', label: '업데이트' },
  showShuttleSection && { id: 'shuttle', label: '셔틀버스' },
  { id: 'venue', label: '공연장 정보' },
  mentionedIn.length > 0 && { id: 'issues', label: '관련 이슈' },
  related.length > 0 && { id: 'related', label: '관련 공연' },
  event.sources && event.sources.length > 0 && { id: 'sources', label: '출처' },
].filter(Boolean) as { id: string; label: string }[];

// schema.org structured data for Google's Event rich results.
// `offers` is only included when we have a real ticket URL - never fabricated.
// Google's structured data guidance: for a postponed event with no new date,
// omit startDate/endDate and use previousStartDate instead; for a cancelled
// event, keep the original startDate. https://schema.org/EventPostponed
const EVENT_STATUS_MAP = {
  scheduled: 'https://schema.org/EventScheduled',
  postponed: 'https://schema.org/EventPostponed',
  cancelled: 'https://schema.org/EventCancelled',
};
const status = event.status ?? 'scheduled';
const isPast = event.endDate < new Date().toISOString().slice(0, 10);

// 모바일 하단 고정 예매 버튼 - 액션바가 화면 밖으로 나가면 나타난다.
const openUpcoming = Boolean(event.ticketOpenAt) && new Date(event.ticketOpenAt as string).getTime() > Date.now();
const mobileCtaKind: 'links' | 'official' | 'clock' | null =
  status !== 'scheduled' || isPast ? null
  : ticketPopoverLinks.length > 0 ? 'links'
  : fallbackPrimaryUrl ? 'official'
  : openUpcoming ? 'clock'
  : null;
const mobileClockHref = `/ticketing-clock?open=${encodeURIComponent(event.ticketOpenAt ?? '')}&artist=${encodeURIComponent(event.artist)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  name: event.artist,
  eventStatus: EVENT_STATUS_MAP[status],
  ...(status === 'postponed'
    ? { previousStartDate: event.startDate }
    : { startDate: event.startDate, endDate: event.endDate }),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: event.venue,
    address: {
      '@type': 'PostalAddress',
      ...(getVenueInfo(event.venue)?.address ? { streetAddress: getVenueInfo(event.venue)!.address } : {}),
      addressLocality: event.city,
      addressCountry: 'KR',
    },
  },
  description: event.description ?? pageDescription,
  performer: {
    '@type': 'PerformingGroup',
    name: event.artist,
    ...(aliases.length > 0 ? { alternateName: aliases } : {}),
  },
  ...(event.posterUrl ? { image: new URL(event.posterUrl, Astro.site).toString() } : {}),
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  ...(event.officialUrl ? { sameAs: [event.officialUrl] } : {}),
  ...(ticketLinks.length > 0 && status === 'scheduled'
    ? {
        offers: ticketLinks.map((t) => ({
          '@type': 'Offer',
          url: t.url,
          availability: 'https://schema.org/InStock',
          ...(event.ticketOpenAt ? { validFrom: event.ticketOpenAt } : {}),
        })),
      }
    : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '직관냥', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: '전체 일정', item: new URL('/events/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: event.artist, item: new URL(Astro.url.pathname, Astro.site).toString() },
  ],
};
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={event.posterUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  {tocItems.length > 2 && (
    <nav class="event-toc" aria-label="이 페이지의 정보">
      <ul>
        {tocItems.map((item) => (
          <li><a href={`#${item.id}`} data-toc-for={item.id}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  )}

  <article>
    <p class="breadcrumb"><a href="/events/">← 전체 일정</a></p>

    <div class={`ev-stage${event.posterUrl ? '' : ' no-pic'}`}>
    <div class="ev-info">
    <header class={`event-header${buzzing ? ' is-buzzing' : ''}`}>
      <p class="ev-kicker mono">
        {event.genre} · {event.city}
        {buzzing && <b>{buzzHeadlineAct ? `${buzzHeadlineAct} 화제` : '화제의 공연'}</b>}
      </p>
      <h1 class={heroName.length > 22 ? 'long' : undefined}>{heroName}{heroSub && <small>{heroSub}</small>}</h1>
      <div class="ev-big">
        <div class="dday-badge big" data-dday-start={event.startDate} data-dday-end={event.endDate} data-status={status}>—</div>
        <p class="ev-when mono">{whenLabel}<span>{event.venue}</span></p>
      </div>
      {aliases.length > 0 && <p class="aka">다른 표기: {aliases.join(' · ')}</p>}
      {lastUpdated && <p class="last-updated">최근 업데이트 {lastUpdated.slice(5).replace('-', '.')}</p>}
      {event.description && <p class="event-description">{event.description}</p>}
    </header>

    {status === 'postponed' && (
      <p class="status-banner status-postponed">
        이 공연은 연기되었습니다. 재개최 일정이 정해지지 않았다면 아래 안내를 확인하세요.
      </p>
    )}
    {status === 'cancelled' && (
      <p class="status-banner status-cancelled">이 공연은 취소되었습니다.</p>
    )}
    {event.ticketingAnnounced && ticketLinks.length === 0 && (
      <p class="status-banner status-announced">
        티켓 오픈 예정 공연이에요{event.ticketOpenDate ? ` — 오픈: ${event.ticketOpenDate}` : ''}. 오픈되면 이 페이지에 바로 예매 링크를 추가할게요.
        {event.ticketOpenAt && (
          <>
            {' '}
            <a
              class="clock-link"
              href={`/ticketing-clock?open=${encodeURIComponent(event.ticketOpenAt)}&artist=${encodeURIComponent(event.artist)}`}
            >
              티켓팅 시계로 준비하기 →
            </a>
          </>
        )}
      </p>
    )}

    <div class="action-bar" aria-label="빠른 이용">
      {ticketPopoverLinks.length > 0 ? (
        <div class="ab-ticket">
          <button
            class="ab-btn ab-primary"
            type="button"
            id="ticket-toggle"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="ticket-popover"
          >
            티켓 예매{ticketPopoverLinks.length > 1 ? ` (${ticketPopoverLinks.length}곳)` : ''}
          </button>
          <TicketBooking links={ticketPopoverLinks} />
        </div>
      ) : fallbackPrimaryUrl && (
        <a class="ab-btn ab-primary" href={fallbackPrimaryUrl} target="_blank" rel="noopener noreferrer">
          공식 홈페이지·공지
        </a>
      )}
      {officialActionUrl && (
        <a class="ab-btn" href={officialActionUrl} target="_blank" rel="noopener noreferrer">공식 홈페이지</a>
      )}
      {mdActionUrl && (
        <a class="ab-btn" href="#merch">MD·굿즈</a>
      )}
      {fanclubActionUrl && (
        <a class="ab-btn" href={fanclubActionUrl} target="_blank" rel="noopener noreferrer">팬클럽</a>
      )}
      {status === 'scheduled' && (
        <div class="ab-calendar">
          <button
            class="ab-btn"
            type="button"
            id="calendar-toggle"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="calendar-popover"
          >
            캘린더 추가
          </button>
          <AddToCalendar event={event} />
        </div>
      )}
      <a class="ab-btn" href="#sightline">구역별 시야</a>
      {status === 'scheduled' && !isPast && (
        <a class="ab-btn" href={event.ticketOpenAt && new Date(event.ticketOpenAt).getTime() > Date.now() ? `/ticketing-clock?open=${encodeURIComponent(event.ticketOpenAt)}&artist=${encodeURIComponent(event.artist)}` : '/ticketing-clock'}>티켓팅 시계</a>
      )}
      {showShuttleSection && (
        <a class="ab-btn" href="#shuttle">셔틀버스</a>
      )}
      <button
        class="ab-btn ab-bookmark bookmark-btn"
        type="button"
        data-bookmark-id={event.id}
        aria-label={`${event.artist} 찜하기`}
        aria-pressed="false"
      >♡</button>
    </div>

    </div>
    {event.posterUrl && (
      <div class="ev-pic">
        <img
          class="poster"
          src={event.posterUrl}
          alt={`${event.artist} 공식 포스터`}
          fetchpriority="high"
          onerror="this.style.display='none';"
        />
      </div>
    )}
    </div>

    <NextSteps event={event} />

    <AdSlot slot="event-top" />

    {isFestival && (
      <section class="lineup-section" id="lineup">
        <h2>라인업{lineupTotal > 0 ? ` (${lineupTotal}팀)` : ''}</h2>
        {event.festivalHighlight && event.festivalHighlight.length > 0 && (
          <div class="lineup-highlight-strip">
            <p class="lineup-highlight-kicker"><Mascot size={26} pose="cheer" class="lineup-highlight-mascot" />지금 가장 화제인 라인업</p>
            {event.festivalHighlight.map((h) => (
              <div class="lineup-highlight-item">
                <span class="lineup-highlight-act">{h.act}</span>
                <span class="lineup-highlight-reason">{h.reason}</span>
              </div>
