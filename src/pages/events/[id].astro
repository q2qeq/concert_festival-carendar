---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { events } from '../../lib/events';

export function getStaticPaths() {
  return events.map((e) => ({ params: { id: e.id }, props: { event: e } }));
}

const { event } = Astro.props;

function fmtFull(iso: string) {
  const d = new Date(iso + 'T00:00:00');
  return `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일`;
}
const dateLabel = event.startDate === event.endDate
  ? fmtFull(event.startDate)
  : `${fmtFull(event.startDate)} ~ ${fmtFull(event.endDate)}`;

const pageDescription = event.description
  ? `${event.description} (${dateLabel}, ${event.venue})`
  : `${event.artist} ${event.city} 공연 - ${dateLabel}, ${event.venue}`;

const links = [
  event.ticketUrl && { label: '티켓 예매', url: event.ticketUrl, primary: true },
  event.officialUrl && { label: '공식 홈페이지·공지', url: event.officialUrl },
  event.mdUrl && { label: 'MD·굿즈 스토어', url: event.mdUrl },
  event.fanclubUrl && { label: '팬클럽', url: event.fanclubUrl },
].filter(Boolean) as { label: string; url: string; primary?: boolean }[];

// schema.org structured data for Google's Event rich results.
// `offers` is only included when we have a real ticket URL - never fabricated.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  name: event.artist,
  startDate: event.startDate,
  endDate: event.endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: event.venue,
    address: {
      '@type': 'PostalAddress',
      addressLocality: event.city,
      addressCountry: 'KR',
    },
  },
  description: event.description ?? pageDescription,
  performer: {
    '@type': 'PerformingGroup',
    name: event.artist,
  },
  ...(event.ticketUrl
    ? {
        offers: {
          '@type': 'Offer',
          url: event.ticketUrl,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};
---
<BaseLayout
  title={`${event.artist} 내한공연 일정`}
  description={pageDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article>
    <p class="breadcrumb"><a href="/">← 전체 일정</a></p>

    <header class="event-header">
      <div class="dday-badge big" data-dday-start={event.startDate} data-dday-end={event.endDate}>—</div>
      <div>
        <h1>{event.artist}</h1>
        <p class="meta">{event.genre} · {event.city}</p>
      </div>
    </header>

    <AdSlot slot="event-top" />

    {event.description && <p class="lead">{event.description}</p>}

    <dl class="facts">
      <div><dt>일정</dt><dd>{dateLabel}</dd></div>
      <div><dt>장소</dt><dd>{event.venue} ({event.city})</dd></div>
      <div><dt>장르</dt><dd>{event.genre}</dd></div>
    </dl>

    {links.length > 0 && (
      <div class="links">
        {links.map((l) => (
          <a
            class={`link-btn ${l.primary ? 'primary' : ''}`}
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {l.label} ↗
          </a>
        ))}
      </div>
    )}

    {event.note && <p class="note">{event.note}</p>}

    <p class="disclaimer">
      공연 일정·장소·가격 등은 주최측 사정으로 변경될 수 있습니다. 예매 전 반드시 위
      공식 링크 또는 아티스트/기획사 공지에서 최신 정보를 확인하세요.
    </p>

    <AdSlot slot="event-bottom" />
  </article>
</BaseLayout>

<style>
  .breadcrumb a { color: #a9a4c9; font-size: 0.9rem; text-decoration: none; }
  .event-header { display: flex; align-items: center; gap: 1.25rem; margin: 1.5rem 0; }
  .dday-badge.big { font-size: 1.1rem; padding: 0.5rem 0.9rem; min-width: 4.5rem; }
  h1 { margin: 0 0 0.25rem; font-size: 1.7rem; }
  .meta { margin: 0; color: #a9a4c9; }
  .lead { font-size: 1.05rem; color: #e5e2f7; }
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem 1.5rem; margin: 1.5rem 0; }
  .facts dt { color: #a9a4c9; }
  .facts dd { margin: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.5rem 0; }
  .link-btn {
    display: inline-block;
    padding: 0.65rem 1.1rem;
    border-radius: 8px;
    background: rgba(255,255,255,0.08);
    color: #f5f3ff;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .link-btn:hover { background: rgba(255,255,255,0.14); }
  .link-btn.primary { background: #ff5fa2; color: #101018; }
  .link-btn.primary:hover { background: #ff7bb2; }
  .note { color: #d8d5ef; }
  .disclaimer { margin-top: 2rem; padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 8px; color: #a9a4c9; font-size: 0.85rem; }
</style>
