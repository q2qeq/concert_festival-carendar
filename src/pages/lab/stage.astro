---
// 랜딩 개편 시안 "무대" (2026-11-14). 검색에 안 잡히는 시안 주소(/lab/stage/)로만 열린다.
// 첫 화면을 공연장 무대처럼: 막이 열리고, 조명이 움직이고, 핀 조명이 지금 소개하는 공연 포스터를 비춘다.
// 사이트 디자인 규칙대로 그라데이션·블러·글로우 없이 단색 면과 선, 움직임만으로 만든다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolStrip from '../../components/ToolStrip.astro';
import PosterCard from '../../components/PosterCard.astro';
import RecentIssues from '../../components/RecentIssues.astro';
import { spotlightEvents, hasTicketsOnSale, ticketOpenInDays, upcomingEvents, upcomingOpenStages } from '../../lib/events';
import { kstShort, kstLabel } from '../../lib/openPhase';

const all = upcomingEvents();
const next = all.slice(0, 8);
const picks = spotlightEvents(3, undefined, true);
const WD = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
const shortName = (artist: string) => artist.replace(/\s*\(.*?\)\s*/g, ' ').replace(/\s+/g, ' ').trim();
function splitName(artist: string) {
  const m = artist.match(/^(.*?)\s*\((.+)\)\s*$/);
  return m ? { name: m[1].trim(), sub: m[2].trim() } : { name: artist, sub: '' };
}
const items = picks.map((e) => {
  const d = new Date(e.startDate + 'T00:00:00');
  const { name, sub } = splitName(e.artist);
  const open = ticketOpenInDays(e);
  return {
    href: `/events/${e.id}/`,
    name,
    sub: [sub, e.venue.replace(/\s*\(.*$/, '')].filter(Boolean).join(' · '),
    date: e.startDate,
    dot: `${e.startDate.replace(/-/g, '.')} ${WD[d.getDay()]}`,
    img: e.posterUrl as string,
    note: open !== null && open <= 14 ? (open === 0 ? '오늘 티켓오픈' : `티켓오픈 D-${open}`) : hasTicketsOnSale(e) ? '예매 오픈중' : '',
  };
});
const first = items[0];

// 전광판·타임테이블: 공식 공지로 확인된 티켓오픈 단계만
const opens = upcomingOpenStages(6).map(({ event, stage, multi }) => ({
  href: `/events/${event.id}/`,
  artist: shortName(event.artist),
  label: multi ? stage.label : '티켓 오픈',
  at: stage.at,
  short: kstShort(stage.at),
  long: kstLabel(stage.at),
  venue: event.venue.replace(/\s*\(.*$/, ''),
}));

// 객석 실루엣: 머리·어깨를 겹쳐 그린 한 줄. 몇 명은 응원봉을 든다. 자리마다 조금씩 다르게(난수 대신 고정 수열).
const CROWD_W = 1200;
const crowd = Array.from({ length: 34 }, (_, i) => {
  const r = 15 + ((i * 7) % 5) * 1.6;
  const x = 18 + i * (CROWD_W / 33) + (((i * 13) % 7) - 3) * 2;
  const y = 74 + ((i * 5) % 6) * 3;
  return { x, y, r, stick: i % 3 === 1, arm: i % 2 === 0 ? -1 : 1, delay: (i * 137) % 1600 };
});

// 알림 시안에 돌려 보여줄 문구 (실제 발송 문구와 같은 형식)
const sample = opens[0];
const notiName = sample ? `${sample.artist} ${sample.label}` : '티켓 오픈';
const notiTime = sample ? sample.short.split(' ')[1] : '20:00';
const notis = [
  { when: '하루 전', title: notiName, body: `내일 ${notiTime}에 열려요. 로그인과 결제수단을 미리 확인해 두세요.` },
  { when: '30분 전', title: notiName, body: `오늘 ${notiTime} 오픈, 약 30분 남았어요. 예매 창을 띄워 두세요.` },
  { when: '10분 전', title: notiName, body: `오늘 ${notiTime} 오픈, 약 10분 남았어요. 예매 창을 띄워 두세요.` },
];
---
<BaseLayout wide noindex title="랜딩 시안 - 무대" description="직관냥 랜딩 개편 시안">
  <script is:inline>document.documentElement.classList.add('js');</script>

  {first && (
    <section class="st" id="st" data-items={JSON.stringify(items)}>
      <!-- 무대 장치: 트러스와 조명기, 천천히 움직이는 빛줄기 -->
      <svg class="rig" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
        <g class="beams">
          {[150, 420, 780, 1050].map((x, i) => (
            <polygon class={`beam b${i}`} points={`${x - 7},52 ${x + 7},52 ${x + 150},900 ${x - 150},900`} />
          ))}
        </g>
        <g class="truss">
          <line x1="0" y1="22" x2="1200" y2="22" />
          <line x1="0" y1="40" x2="1200" y2="40" />
          {Array.from({ length: 34 }, (_, i) => (
            <line x1={i * 36} y1={i % 2 ? 22 : 40} x2={(i + 1) * 36} y2={i % 2 ? 40 : 22} />
          ))}
        </g>
        <g class="lamps">
          {[150, 420, 600, 780, 1050].map((x) => (
            <g><rect x={x - 3} y="40" width="6" height="6" /><rect x={x - 11} y="46" width="22" height="12" rx="2" /></g>
          ))}
        </g>
      </svg>
      <div class="floor" aria-hidden="true"></div>

      <div class="st-in">
        <div class="info">
          <p class="kicker mono"><span class="live" aria-hidden="true"></span>NOW ON STAGE <b id="st-idx">01</b><span> / {String(items.length).padStart(2, '0')}</span></p>
          <h1 class="name"><span class="mask"><span class="rise" id="st-name">{first.name}</span></span></h1>
          <p class="sub"><span class="mask"><span class="rise" id="st-sub">{first.sub}</span></span></p>
          <div class="big">
            <div class="n mono" id="st-num" data-date={first.date}>—</div>
            <div class="u mono">DAYS LEFT<b id="st-dot">{first.dot}</b><i id="st-note">{first.note}</i></div>
          </div>
          <div class="act">
            <a class="btn p" id="st-link" href={first.href}>공연 정보 보기 →</a>
            <a class="btn" href="/events/">전체 공연 {all.length}개</a>
          </div>
          {items.length > 1 && (
            <ol class="setlist" id="st-tabs" role="tablist" aria-label="지금 많이 보는 공연">
              {items.map((it, i) => (
                <li>
                  <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>
                    <span class="no mono">{String(i + 1).padStart(2, '0')}</span>
                    <span class="tt">{it.name}</span>
                    <span class="bar" aria-hidden="true"><i></i></span>
                  </button>
                </li>
              ))}
            </ol>
          )}
        </div>

        <div class="riser">
          <div class="spot" id="st-spot" aria-hidden="true"></div>
          <div class="pool" aria-hidden="true"></div>
          <a class="pic" id="st-pic-link" href={first.href} aria-label={`${first.name} 공연 정보`}>
            <img id="st-pic" src={first.img} alt={`${first.name} 포스터`} fetchpriority="high" />
          </a>
        </div>
      </div>

      <!-- 객석: 응원봉이 파도처럼 흔들린다 -->
      <svg class="crowd" viewBox={`0 0 ${CROWD_W} 120`} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        {crowd.map((c) => (
          <g>
            {c.stick && (
              <g class="stick" style={`animation-delay:${c.delay}ms`}>
                <line x1={c.x + c.arm * (c.r + 2)} y1={c.y + 20} x2={c.x + c.arm * (c.r + 9)} y2={c.y - c.r - 12} />
                <rect class="tip" x={c.x + c.arm * (c.r + 9) - 3.5} y={c.y - c.r - 26} width="7" height="15" rx="3.5" />
              </g>
            )}
            <circle cx={c.x} cy={c.y} r={c.r} />
            <rect x={c.x - c.r * 1.55} y={c.y + c.r - 3} width={c.r * 3.1} height="70" rx={c.r * 0.9} />
          </g>
        ))}
      </svg>

      <!-- 막 -->
      <div class="curtain cl" aria-hidden="true"></div>
      <div class="curtain cr" aria-hidden="true"></div>
    </section>
  )}

  <!-- 전광판 -->
  {opens.length > 0 && (
    <div class="led" aria-label="다가오는 티켓 오픈">
      <span class="led-tag mono"><span class="live" aria-hidden="true"></span>TICKET OPEN</span>
      <div class="led-win">
        <div class="led-run mono">
          {[0, 1].map((k) => (
            <span class="led-set" aria-hidden={k === 1 ? 'true' : undefined}>
              {opens.map((o) => (
                <a href={o.href} tabindex={k === 1 ? -1 : undefined}><b>{o.short}</b> {o.artist} <i>{o.label}</i></a>
              ))}
            </span>
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="wrap">
    {opens.length > 0 && (
      <section class="tt-sec" aria-labelledby="tt-title">
        <div class="sec-head rv">
          <h2 id="tt-title" class="mono">TIMETABLE</h2>
          <a href="/ticket-open/">티켓오픈 일정 전체 →</a>
        </div>
        <div class="rows">
          {opens.slice(0, 4).map((o, i) => (
            <a class="rv" style={`--d:${i * 70}ms`} href={o.href}>
              <span class="t mono">{o.short.split(' ')[0]} <span>{o.short.split(' ')[1]}</span></span>
              <span class="nm">{o.artist}<small>{o.label} · {o.venue}</small></span>
              <span class="cd mono" data-at={o.at}>—</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 알림·앱 설치 소개 -->
    <section class="app" aria-labelledby="app-title">
      <div class="app-copy rv">
        <p class="eyebrow mono">TICKET OPEN ALERT</p>
        <h2 id="app-title">오픈 10분 전,<br />폰이 먼저 알려줘요.</h2>
        <p class="lead">공연 페이지에서 "오픈 알림 받기"만 눌러 두면 하루 전, 30분 전, 10분 전에 알림이 가요. 가입도 앱 설치도 필요 없어요.</p>
        <ol class="steps">
          <li><span class="mono">01</span>보고 싶은 공연의 "오픈 알림 받기"를 눌러요</li>
          <li><span class="mono">02</span>선예매·일반예매 단계마다 따로 알려드려요</li>
          <li><span class="mono">03</span>홈 화면에 추가하면 앱처럼 바로 열려요</li>
        </ol>
        <div class="act">
          <a class="btn p" href="/ticket-open/">알림 켤 공연 고르기 →</a>
          <a class="btn" href="/calendar/">캘린더로 받기</a>
        </div>
        <p class="fine">아이폰은 사파리에서 공유 → "홈 화면에 추가"로 설치한 뒤에 알림을 켤 수 있어요.</p>
      </div>
      <div class="phone rv" style="--d:120ms" id="phone" data-notis={JSON.stringify(notis)} aria-hidden="true">
        <div class="ph-notch"></div>
        <p class="ph-date mono">12월 3일 목요일</p>
        <p class="ph-clock mono" id="ph-clock">19:50</p>
        <div class="noti" id="noti">
          <span class="noti-ic"></span>
          <div>
            <p class="noti-top"><b>직관냥</b><span id="noti-when">{notis[2].when}</span></p>
            <p class="noti-title" id="noti-title">{notis[2].title}</p>
            <p class="noti-body" id="noti-body">{notis[2].body}</p>
          </div>
        </div>
        <div class="ph-bar"></div>
      </div>
    </section>

    <div class="tools rv"><ToolStrip /></div>

    <section class="next" aria-labelledby="next-title">
      <div class="sec-head rv">
        <h2 id="next-title" class="mono">LINEUP</h2>
        <a href="/events/">전체 {all.length}개 →</a>
      </div>
      <div class="poster-grid">
        {next.map((e, i) => (
          <div class="card-wrap rv" style={`--d:${(i % 4) * 70}ms`}><PosterCard event={e} /></div>
        ))}
      </div>
      <a class="more rv" href="/events/">전체 공연 일정 보기 →</a>
    </section>

    <div class="rv"><RecentIssues limit={3} heading="공연 소식·이슈" compact /></div>
  </div>
</BaseLayout>

<script>
  import { hms, kstDayDiff } from '../../lib/openPhase';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  // ── 무대: 막 열기 + 공연 전환 ─────────────────────────────
  const st = document.getElementById('st');
  if (st) {
    type Item = { href: string; name: string; sub: string; date: string; dot: string; img: string; note: string };
    const items: Item[] = JSON.parse(st.dataset.items || '[]');
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#st-tabs button'));
    const HOLD = 6500; // 한 공연을 비추는 시간
    let cur = 0;
    let timer = 0;
    let raf = 0;

    const daysLeft = (iso: string) => {
      const t = new Date(); t.setHours(0, 0, 0, 0);
      return Math.ceil((new Date(iso + 'T00:00:00').getTime() - t.getTime()) / 86400000);
    };
    // D-day 숫자가 0에서 올라오며 멈춘다
    const countTo = (n: number) => {
      const el = $('st-num');
      cancelAnimationFrame(raf);
      if (n <= 0) { el.textContent = 'D-DAY'; return; }
      if (reduce) { el.textContent = String(n); return; }
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 700);
        el.textContent = String(Math.round(n * (1 - Math.pow(1 - p, 3))));
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const paint = (i: number) => {
      const it = items[i];
      $('st-name').textContent = it.name;
      $('st-sub').textContent = it.sub;
      $('st-dot').textContent = it.dot;
      $('st-note').textContent = it.note;
      $('st-idx').textContent = String(i + 1).padStart(2, '0');
      ($('st-link') as HTMLAnchorElement).href = it.href;
      ($('st-pic-link') as HTMLAnchorElement).href = it.href;
      const img = $('st-pic') as HTMLImageElement;
      img.src = it.img; img.alt = `${it.name} 포스터`;
      countTo(daysLeft(it.date));
      tabs.forEach((b, j) => b.setAttribute('aria-selected', String(j === i)));
    };
    // 전환: 핀 조명이 꺼지고 → 내용이 바뀌고 → 조명이 깜빡이며 다시 켜진다
    const show = (i: number) => {
      cur = i;
      if (reduce) { paint(i); return; }
      st.classList.add('is-dark');
      window.setTimeout(() => {
        paint(i);
        st.classList.remove('is-dark');
        st.classList.remove('is-cue');
        void st.offsetWidth; // 같은 애니메이션을 다시 시작시키기 위해
        st.classList.add('is-cue');
      }, 260);
    };
    const schedule = () => {
      window.clearTimeout(timer);
      if (reduce || items.length < 2) return;
      st.style.setProperty('--hold', `${HOLD}ms`);
      st.classList.remove('is-running'); void st.offsetWidth; st.classList.add('is-running');
      timer = window.setTimeout(() => { show((cur + 1) % items.length); schedule(); }, HOLD);
    };
    const pause = () => { window.clearTimeout(timer); st.classList.remove('is-running'); };

    items.forEach((it) => { const im = new Image(); im.src = it.img; });
    tabs.forEach((b) => b.addEventListener('click', () => { show(Number(b.dataset.i)); schedule(); }));
    st.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') pause(); });
    st.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') schedule(); });
    st.addEventListener('focusin', pause);
    st.addEventListener('focusout', schedule);
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : schedule()));

    paint(0);
    // 막은 방문(탭)마다 한 번만 연다 - 뒤로 가기로 돌아올 때마다 기다리게 하지 않는다
    let seen = false;
    try { seen = sessionStorage.getItem('krconcerts:curtain') === '1'; sessionStorage.setItem('krconcerts:curtain', '1'); } catch { /* 저장소를 못 쓰면 매번 연다 */ }
    if (reduce || seen) {
      st.classList.add('is-open', 'no-curtain', 'is-cue');
      schedule();
    } else {
      requestAnimationFrame(() => requestAnimationFrame(() => st.classList.add('is-open')));
      window.setTimeout(() => { st.classList.add('is-cue'); schedule(); }, 900);
    }
  }

  // ── 스크롤하면 아래 구역이 차례로 올라온다 ─────────────────
  const rv = Array.from(document.querySelectorAll<HTMLElement>('.rv'));
  if (reduce || !('IntersectionObserver' in window)) {
    rv.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    rv.forEach((el) => io.observe(el));
  }

  // ── 타임테이블 남은 시간 ───────────────────────────────────
  const cds = Array.from(document.querySelectorAll<HTMLElement>('.cd[data-at]'));
  const tickCd = () => {
    const now = Date.now();
    cds.forEach((el) => {
      const at = new Date(el.dataset.at || '').getTime();
      const left = at - now;
      el.classList.toggle('hot', left > 0 && left < 86400_000);
      el.textContent = left <= 0 ? '오픈' : left < 86400_000 ? hms(left) : `D-${kstDayDiff(el.dataset.at || '', now)}`;
    });
  };
  if (cds.length > 0) { tickCd(); window.setInterval(tickCd, 1000); }

  // ── 폰 화면: 알림 세 가지가 차례로 내려온다 ─────────────────
  const phone = document.getElementById('phone');
  if (phone && !reduce) {
    const list: { when: string; title: string; body: string }[] = JSON.parse(phone.dataset.notis || '[]');
    const clocks = ['20:00', '19:30', '19:50'];
    const noti = $('noti');
    let k = 0;
    let started = false;
    const play = () => {
      const n = list[k % list.length];
      $('noti-when').textContent = n.when;
      $('noti-title').textContent = n.title;
      $('noti-body').textContent = n.body;
      $('ph-clock').textContent = clocks[k % clocks.length];
      noti.classList.remove('drop'); void noti.offsetWidth; noti.classList.add('drop');
      k += 1;
    };
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting) && !started) {
        started = true; io.disconnect();
        play(); window.setInterval(play, 3600);
      }
    }, { threshold: 0.4 }).observe(phone);
  }
</script>

<style>
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
  .live { display: inline-block; width: 7px; height: 7px; margin-right: 0.6rem; background: #ff5fa2; animation: blink 1.4s steps(2, jump-none) infinite; }
  @keyframes blink { 50% { opacity: 0.15; } }

  /* ── 무대 ── */
  .st {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: max(660px, calc(100svh - 68px));
    background: #121215;
    display: flex; flex-direction: column;
  }
  .rig { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .truss line { stroke: #34343b; stroke-width: 1.5; }
  .lamps rect { fill: #3a3a42; }
  .beam { fill: #ededea; opacity: 0.045; transform-box: fill-box; transform-origin: 50% 0; animation: sweep 9s ease-in-out infinite alternate; }
  .beam.b0 { animation-duration: 11s; --a: -6deg; --b: 22deg; }
  .beam.b1 { animation-duration: 8s; --a: -18deg; --b: 12deg; animation-delay: -3s; }
  .beam.b2 { animation-duration: 9.5s; --a: -12deg; --b: 18deg; animation-delay: -5s; }
  .beam.b3 { animation-duration: 12s; --a: -22deg; --b: 6deg; animation-delay: -2s; }
  @keyframes sweep { from { transform: rotate(var(--a, -14deg)); } to { transform: rotate(var(--b, 14deg)); } }
  /* 무대 바닥: 뒷벽보다 어두운 단색 면과 경계선 */
  .floor { position: absolute; left: 0; right: 0; bottom: 0; height: 21%; background: #0b0b0d; border-top: 1px solid #2a2a30; z-index: 0; }

  .st-in {
    position: relative; z-index: 2; flex: 1;
    display: grid; grid-template-columns: 1fr minmax(280px, 34%); gap: 3rem; align-items: center;
    padding: 5.2rem max(24px, calc((100vw - 1180px) / 2)) 7.5rem;
  }
  .info { min-width: 0; }
